{
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lilosgrowth.com"
        }
      ],
      "destination": "https://lilosgrowth.com/:path*",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/blog/local-seo-vs-gbp-management-hvac-san-diego-comparison-guide",
      "destination": "/blog/local-seo-vs-gbp-management-hvac-san-diego-comparison-guide-2",
      "permanent": true
    },
    {
      "source": "/blog/local-seo-vs-gbp-management-hvac-san-diego-comparison-guide-3",
      "destination": "/blog/local-seo-vs-gbp-management-hvac-san-diego-comparison-guide-2",
      "permanent": true
    },
    {
      "source": "/blog/emergency-plumber-seo-san-marcos-guide",
      "destination": "/blog/emergency-plumber-seo-san-marcos-guide-3",
      "permanent": true
    },
    {
      "source": "/blog/emergency-plumber-seo-san-marcos-guide-2",
      "destination": "/blog/emergency-plumber-seo-san-marcos-guide-3",
      "permanent": true
    },
    {
      "source": "/blog/restoration-company-seo-guide-2",
      "destination": "/blog/restoration-company-seo-guide",
      "permanent": true
    },
    {
      "source": "/blog/emergency-electrician-seo-san-marcos-guide-2",
      "destination": "/blog/emergency-electrician-seo-san-marcos-guide",
      "permanent": true
    },
    {
      "source": "/blog/local-seo-for-roofing-companies-guide",
      "destination": "/blog/local-seo-for-roofing-company-guide",
      "permanent": true
    },
    {
      "source": "/blog/roofing-company-local-seo-marketing-guide",
      "destination": "/blog/local-seo-for-roofing-company-guide",
      "permanent": true
    },
    {
      "source": "/blog/roofing-company-local-seo-services-guide",
      "destination": "/blog/local-seo-for-roofing-company-guide",
      "permanent": true
    },
    {
      "source": "/blog/roofing-local-seo-services-guide",
      "destination": "/blog/local-seo-for-roofing-company-guide",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/google-business-profile-offer/",
      "destination": "/google-business-profile-offer",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/:path*\\.(jpg|jpeg|png|webp|avif|gif|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*\\.(woff|woff2|ttf|otf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/:path*\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/offers/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/offline",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}

---
import Logo from "../Logo.astro";
import { Icon } from "astro-icon/components";
import { getPermalink } from "~/utils/permalinks";
import { business } from "~/data/business";
import { locations } from "~/data/locations";
import { INDUSTRIES_INDEX, LOCATIONS_INDEX, industryPath, locationPath } from "~/lib/routes";

const footerIndustries = [
  { slug: "plumbers", label: "Plumbers" },
  { slug: "electricians", label: "Electricians" },
  { slug: "hvac", label: "HVAC" },
  { slug: "pest-control", label: "Pest Control" },
  { slug: "roofing", label: "Roofing" },
  { slug: "water-damage-restoration", label: "Restoration" },
  { slug: "cleaning", label: "Cleaning" },
  { slug: "party-rentals", label: "Party Rentals" },
  { slug: "landscaping", label: "Landscaping" },
  { slug: "painters", label: "Painters" },
  { slug: "restaurants", label: "Restaurants" },
];

const footerLinkClass =
  "rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary";
---

<footer class="border-t-2 border-primary bg-secondary text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-14 md:px-6 md:py-16">
    <!-- 2-column layout at md+: Brand/Contact + Links grid (4 cols) -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.1fr,1.8fr] md:gap-12">
      <!-- Brand / Contact / CTA -->
      <section aria-labelledby="footer-brand">
        <Logo class="mb-3 w-28" />
        <h2 id="footer-brand" class="font-heading text-xl font-bold">{business.name}</h2>
        <p class="mt-2 text-white/85">Home Service Marketing Experts</p>

        <!-- Contact -->
        <div class="mt-4 space-y-1 text-[15px] leading-6 text-white/80">
          <a
            data-evt="contact_phone_click"
            href={`tel:${business.phoneE164}`}
            class="text-white/90 hover:text-white">{business.phoneDisplay}</a
          >
          <a
            data-evt="contact_email_click"
            href={`mailto:${business.email}`}
            class="text-primary underline">{business.email}</a
          >
          <div class="text-white/80">{business.name}</div>
          <div class="text-white/80">{business.locality}, {business.region}</div>
          <div class="flex items-center gap-3 pt-1">
            <a
              href={business.gbpUrl}
              target="_blank"
              rel="noopener"
              class="text-white/90 underline underline-offset-4 hover:text-white"
              >Find us on Google</a
            >
            <a
              href={business.youtubeUrl}
              target="_blank"
              rel="noopener"
              aria-label="Lilos Growth on YouTube"
              class="text-white/80 hover:text-white"
            >
              <Icon name="tabler:brand-youtube" class="h-5 w-5" />
            </a>
            <a
              href={business.facebookUrl}
              target="_blank"
              rel="noopener"
              aria-label="Lilos Growth on Facebook"
              class="text-white/80 hover:text-white"
            >
              <Icon name="tabler:brand-facebook" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <!-- CTA -->
        <div class="mt-5">
          <a
            href={getPermalink("/contact#book")}
            class="inline-flex items-center gap-2 rounded-full border border-primary bg-[#fff4ed] px-5 py-2.5 text-[15px] font-semibold text-primary shadow-[0_1px_0_rgba(0,0,0,0.02)] transition hover:bg-primary hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >
            <span>Book a Call</span>
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Links grid: Services + Industries + Locations + Company -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        <!-- Services -->
        <nav aria-labelledby="footer-services">
          <h3
            id="footer-services"
            class="mb-3 text-[15px] font-semibold tracking-wide text-primary"
          >
            Services
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            <li>
              <a href={getPermalink("/services/local-seo")} class={footerLinkClass}>Local SEO</a>
            </li>
            <li>
              <a
                href={getPermalink("/services/google-business-profile-optimization")}
                class={footerLinkClass}>Google Business Profile</a
              >
            </li>
            <li>
              <a href={getPermalink("/services/web-design")} class={footerLinkClass}
                >Website Design</a
              >
            </li>
            <li>
              <a href={getPermalink("/services/ai-search-optimization")} class={footerLinkClass}
                >AI Search Optimization</a
              >
            </li>
          </ul>
          <div class="mt-4 border-t border-white/10 pt-4">
            <ul class="space-y-2 leading-6 text-white/80">
              <li><a href={getPermalink("/blog")} class={footerLinkClass}>Blog</a></li>
              <li>
                <a href={getPermalink("/local-seo-tools")} class={footerLinkClass}
                  >Local SEO Tools</a
                >
              </li>
            </ul>
          </div>
        </nav>

        <!-- Industries -->
        <nav aria-labelledby="footer-industries">
          <h3
            id="footer-industries"
            class="mb-3 text-[15px] font-semibold tracking-wide text-primary"
          >
            Industries
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            {
              footerIndustries.map(({ slug, label }) => (
                <li>
                  <a href={getPermalink(industryPath(slug))} class={footerLinkClass}>
                    {label}
                  </a>
                </li>
              ))
            }
            <li>
              <a href={getPermalink(INDUSTRIES_INDEX)} class={footerLinkClass}>All industries</a>
            </li>
          </ul>
        </nav>

        <!-- Locations -->
        <nav aria-labelledby="footer-locations">
          <h3
            id="footer-locations"
            class="mb-3 text-[15px] font-semibold tracking-wide text-primary"
          >
            Locations
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            {
              locations.map((location) => (
                <li>
                  <a href={getPermalink(locationPath(location.slug))} class={footerLinkClass}>
                    {location.city} SEO
                  </a>
                </li>
              ))
            }
            <li>
              <a href={getPermalink(LOCATIONS_INDEX)} class={footerLinkClass}>All locations</a>
            </li>
          </ul>
        </nav>

        <!-- Company -->
        <nav aria-labelledby="footer-company">
          <h3 id="footer-company" class="mb-3 text-[15px] font-semibold tracking-wide text-primary">
            Company
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            <li><a href={getPermalink("/packages")} class={footerLinkClass}>Packages</a></li>
            <li><a href={getPermalink("/about")} class={footerLinkClass}>About</a></li>
            <li><a href={getPermalink("/contact")} class={footerLinkClass}>Contact</a></li>
            <li><a href={getPermalink("/privacy")} class={footerLinkClass}>Privacy Policy</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Meta row -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-[13px] text-white/70 sm:flex-row"
    >
      <div>© {new Date().getFullYear()} Lilos Growth. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a
          href={getPermalink("/privacy")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Privacy Policy</a
        >
        <a
          href={getPermalink("/terms")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Terms of Service</a
        >
        <a
          href={getPermalink("/contact")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Contact</a
        >
      </div>
    </div>
  </div>
</footer>

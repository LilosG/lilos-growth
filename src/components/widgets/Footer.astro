---
import Logo from '../Logo.astro'; // Adjust path if needed
---

<footer class="bg-[#1f2d3d] border-t-4 border-[#f56b2a] shadow-md pt-10 pb-6 text-white">
  <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row md:justify-between md:items-start gap-10">
    <!-- Left: Logo & Tagline -->
    <div class="flex flex-col items-start mb-8 md:mb-0">
      <Logo class="w-28 mb-2" />
      <span class="font-heading text-2xl font-bold">Lilos Growth</span>
      <span class="text-base mt-2 mb-2 text-white/70">Growth Marketing for Home Service Businesses</span>
      <div class="flex items-center gap-2 mt-1">
        <svg class="h-5 w-5 text-[#f56b2a]" fill="currentColor" viewBox="0 0 20 20">
          <path
            d="M10 15l-4.472 2.951 1.352-4.76L3 9.549l4.902-.426L10 4.5l2.098 4.623 4.902.426-3.88 3.642 1.352 4.76z"
          ></path>
        </svg>
        <span class="text-[#f56b2a] text-sm font-semibold">5.0 Google Rated</span>
      </div>
    </div>

    <!-- Middle: Quick Links -->
    <nav class="flex flex-col gap-1 min-w-[170px]">
      <h4 class="font-heading font-semibold mb-2 text-lg text-[#f56b2a]">Quick Links</h4>
      <a href="/services" class="hover:text-[#f56b2a] transition">Services</a>
      <a href="/packages" class="hover:text-[#f56b2a] transition">Packages</a>
      <a href="/about" class="hover:text-[#f56b2a] transition">About</a>
      <a href="/faq" class="hover:text-[#f56b2a] transition">FAQ</a>
      <a href="/contact" class="hover:text-[#f56b2a] transition">Contact</a>
    </nav>

    <!-- Right: Contact -->
    <div class="flex flex-col gap-2 min-w-[200px]">
      <h4 class="font-heading font-semibold mb-2 text-lg text-[#f56b2a]">Contact</h4>
      <a href="mailto:hello@lilosgrowth.com" class="hover:text-[#f56b2a] transition flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 4h16v16H4z"></path>
          <path d="M22 6l-10 7L2 6"></path>
        </svg>
        hello@lilosgrowth.com
      </a>
      <div class="mt-2 flex space-x-4 text-sm">
        <a href="/privacy-policy" class="hover:text-[#f56b2a] text-white/80 transition">Privacy Policy</a>
        <a href="/contact" class="hover:text-[#f56b2a] text-white/80 transition">Contact</a>
      </div>
    </div>
  </div>

  <div class="mt-10 text-center text-white/60 text-sm">
    &copy; {new Date().getFullYear()} Lilos Growth. All rights reserved.
  </div>
</footer>

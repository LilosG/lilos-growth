---
import Logo from '../Logo.astro';
import { getPermalink } from '~/utils/permalinks';
---

<footer class="bg-[#253242] text-white border-t-4 border-[#f56b2a]">
  <div class="max-w-6xl mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand / Info -->
      <section aria-labelledby="footer-brand">
        <Logo class="w-28 mb-3" />
        <h2 id="footer-brand" class="text-xl font-heading font-bold">Lilos Growth</h2>
        <p class="mt-2 text-white/85">Home Service Marketing Experts</p>

        <div class="mt-3 inline-flex items-center gap-2">
          <svg class="w-5 h-5 text-[#f56b2a]" viewBox="0 0 20 20" fill="currentColor">
            <path
              d="M10 1.5 12.6 7.4l6.38.36-4.78 4.38 1.46 6.26L10 15.18 4.34 18.4l1.46-6.26L1.02 7.76l6.38-.36L10 1.5z"
            ></path>
          </svg>
          <span class="text-[#f56b2a] font-medium">5.0 Google Rated</span>
        </div>

        <div class="mt-4 space-y-1 text-sm text-white/75">
          <a href="mailto:hello@lilosgrowth.com" class="hover:underline">hello@lilosgrowth.com</a>
          <div>Based in San Diego, CA</div>
        </div>
      </section>

      <!-- Quick Links -->
      <nav aria-labelledby="footer-quick">
        <h3 id="footer-quick" class="text-lg font-semibold text-[#f56b2a] mb-3">Quick Links</h3>
        <ul class="space-y-2 text-white/90">
          <li><a href={getPermalink('/services')} class="hover:underline">Services</a></li>
          <li><a href={getPermalink('/packages')} class="hover:underline">Packages</a></li>
          <li><a href={getPermalink('/local-seo-tools')} class="hover:underline">Local SEO Tools</a></li>
          <li><a href={getPermalink('/about')} class="hover:underline">About</a></li>
          <li><a href={getPermalink('/contact')} class="hover:underline">Contact</a></li>
          <li><a href={getPermalink('/faq')} class="hover:underline">FAQ</a></li>
        </ul>
      </nav>

      <!-- Core Services -->
      <nav aria-labelledby="footer-services">
        <h3 id="footer-services" class="text-lg font-semibold text-[#f56b2a] mb-3">Services</h3>
        <ul class="space-y-2 text-white/90">
          <li><a href={getPermalink('/services/local-seo')} class="hover:underline">Local SEO</a></li>
          <li>
            <a href={getPermalink('/services/google-business-profile-optimization')} class="hover:underline"
              >Google Business Profile</a
            >
          </li>
          <li><a href={getPermalink('/services/web-design')} class="hover:underline">Website Design</a></li>
          <li><a href={getPermalink('/additional-services')} class="hover:underline">Additional Services</a></li>
        </ul>
      </nav>

      <!-- Additional Services (deep links) -->
      <nav aria-labelledby="footer-additional">
        <h3 id="footer-additional" class="text-lg font-semibold text-[#f56b2a] mb-3">Additional Services</h3>
        <ul class="space-y-2 text-white/90">
          <li><a href={getPermalink('/additional-services#citation')} class="hover:underline">Citation Builder</a></li>
          <li>
            <a href={getPermalink('/additional-services#gbp-setup')} class="hover:underline"
              >Google Business Profile Setup</a
            >
          </li>
          <li>
            <a href={getPermalink('/additional-services#gbp-30')} class="hover:underline">GBP 30-Day Optimization</a>
          </li>
          <li>
            <a href={getPermalink('/additional-services#seo-tune')} class="hover:underline"
              >SEO Consulting &amp; Website Tune-Up</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/70"
    >
      <div>© 2025 Lilos Growth. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a href={getPermalink('/privacy-policy')} class="hover:underline">Privacy Policy</a>
        <a href={getPermalink('/contact')} class="hover:underline">Contact</a>
      </div>
    </div>
  </div>
</footer>

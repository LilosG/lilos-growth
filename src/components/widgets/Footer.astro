---
import Logo from '../Logo.astro';
import { getPermalink } from '~/utils/permalinks';
---

<footer class="bg-[#253242] text-white border-t-2 border-[#f56b2a]">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-6 py-14 md:py-16">
    <!-- 2-column layout at md+: Brand/Contact (wide) + Links grid (Services + Company) -->
    <div class="grid grid-cols-1 md:grid-cols-[1.1fr,1.4fr] gap-10 md:gap-12">
      <!-- Brand / Contact / CTA -->
      <section aria-labelledby="footer-brand">
        <Logo class="w-28 mb-3" />
        <h2 id="footer-brand" class="text-xl font-heading font-bold">Lilos Growth</h2>
        <p class="mt-2 text-white/85">Home Service Marketing Experts</p>

        <!-- Contact -->
        <div class="mt-4 space-y-1 text-[15px] leading-6 text-white/80">
          <a data-evt="contact_email_click" href="mailto:hello@lilosgrowth.com" class="text-primary underline"
            >hello@lilosgrowth.com</a
          >
        </div>

        <!-- CTA -->
        <div class="mt-5">
          <a
            href={getPermalink('/contact#book')}
            class="inline-flex items-center gap-2 rounded-full border border-[#f56b2a] bg-[#fff4ed] px-5 py-2.5
                   text-[15px] font-semibold text-[#f56b2a] shadow-[0_1px_0_rgba(0,0,0,0.02)] transition
                   hover:bg-[#f56b2a] hover:text-white focus:outline-none
                   focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242] focus-visible:ring-[#f56b2a]"
          >
            <span>Book a Call</span>
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Links grid: Services + Company -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
        <!-- Services -->
        <nav aria-labelledby="footer-services">
          <h3 id="footer-services" class="text-[15px] font-semibold tracking-wide text-[#f56b2a] mb-3">Services</h3>
          <ul class="space-y-2 text-white/90 leading-6">
            <li>
              <a
                href={getPermalink('/services/local-seo')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Local SEO</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/services/google-business-profile-optimization')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Google Business Profile</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/services/web-design')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Website Design</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/additional-services')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Additional Services</a
              >
            </li>
          </ul>

          <!-- Subtle divider + tool link -->
          <div class="mt-4 pt-4 border-t border-white/10">
            <ul class="space-y-2 text-white/80 leading-6">
              <li>
                <a
                  href={getPermalink('/local-seo-tools')}
                  class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                  >Local SEO Tools</a
                >
              </li>
            </ul>
          </div>
        </nav>

        <!-- Company -->
        <nav aria-labelledby="footer-company">
          <h3 id="footer-company" class="text-[15px] font-semibold tracking-wide text-[#f56b2a] mb-3">Company</h3>
          <ul class="space-y-2 text-white/90 leading-6">
            <li>
              <a
                href={getPermalink('/packages')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Packages</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/about')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >About</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/contact')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Contact</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/faq')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >FAQ</a
              >
            </li>
            <li>
              <a
                href={getPermalink('/privacy-policy')}
                class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
                >Privacy Policy</a
              >
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Meta row -->
    <div
      class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-[13px] text-white/70"
    >
      <div>© 2025 Lilos Growth. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a
          href={getPermalink('/privacy-policy')}
          class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
          >Privacy Policy</a
        >
        <a
          href={getPermalink('/contact')}
          class="hover:text-white hover:underline focus:underline focus-visible:underline underline-offset-4 decoration-1 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2 focus-visible:ring-offset-[#253242]"
          >Contact</a
        >
      </div>
    </div>
  </div>
</footer>

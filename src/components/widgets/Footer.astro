---
import Logo from "../Logo.astro";
import { getPermalink } from "~/utils/permalinks";
---

<footer class="border-t-2 border-primary bg-secondary text-white">
  <div class="mx-auto w-full max-w-7xl px-4 py-14 md:px-6 md:py-16">
    <!-- 2-column layout at md+: Brand/Contact (wide) + Links grid (Services + Company) -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-[1.1fr,1.4fr] md:gap-12">
      <!-- Brand / Contact / CTA -->
      <section aria-labelledby="footer-brand">
        <Logo class="mb-3 w-28" />
        <h2 id="footer-brand" class="font-heading text-xl font-bold">Lilos Growth</h2>
        <p class="mt-2 text-white/85">Home Service Marketing Experts</p>

        <!-- Contact -->
        <div class="mt-4 space-y-1 text-[15px] leading-6 text-white/80">
          <a
            data-evt="contact_email_click"
            href="mailto:hello@lilosgrowth.com"
            class="text-primary underline">hello@lilosgrowth.com</a
          >
          <div class="text-white/80">Lilos Growth, LLC</div>
          <div class="text-white/80">401 West A St, Ste 200</div>
          <div class="text-white/80">San Diego, CA 92101</div>
        </div>

        <!-- CTA -->
        <div class="mt-5">
          <a
            href={getPermalink("/contact#book")}
            class="inline-flex items-center gap-2 rounded-full border border-primary bg-[#fff4ed] px-5 py-2.5 text-[15px] font-semibold text-primary shadow-[0_1px_0_rgba(0,0,0,0.02)] transition hover:bg-primary hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >
            <span>Book a Call</span>
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </section>

      <!-- Links grid: Services + Company -->
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">
        <!-- Services -->
        <nav aria-labelledby="footer-services">
          <h3
            id="footer-services"
            class="mb-3 text-[15px] font-semibold tracking-wide text-primary"
          >
            Services
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            <li>
              <a
                href={getPermalink("/services/local-seo")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Local SEO</a
              >
            </li>
            <li>
              <a
                href={getPermalink("/services/google-business-profile-optimization")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Google Business Profile</a
              >
            </li>
            <li>
              <a
                href={getPermalink("/services/web-design")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Website Design</a
              >
            </li>
          </ul>

          <!-- Subtle divider + tool link -->
          <div class="mt-4 border-t border-white/10 pt-4">
            <ul class="space-y-2 leading-6 text-white/80">
              <li>
                <a
                  href={getPermalink("/local-seo-tools")}
                  class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                  >Local SEO Tools</a
                >
              </li>
            </ul>
          </div>
        </nav>

        <!-- Company -->
        <nav aria-labelledby="footer-company">
          <h3 id="footer-company" class="mb-3 text-[15px] font-semibold tracking-wide text-primary">
            Company
          </h3>
          <ul class="space-y-2 leading-6 text-white/90">
            <li>
              <a
                href={getPermalink("/packages")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Packages</a
              >
            </li>
            <li>
              <a
                href={getPermalink("/about")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >About</a
              >
            </li>
            <li>
              <a
                href={getPermalink("/contact")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Contact</a
              >
            </li>

            <li>
              <a
                href={getPermalink("/privacy-policy")}
                class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
                >Privacy Policy</a
              >
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Meta row -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-[13px] text-white/70 sm:flex-row"
    >
      <div>© {new Date().getFullYear()} Lilos Growth. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a
          href={getPermalink("/privacy-policy")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Privacy Policy</a
        >
        <a
          href={getPermalink("/terms")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Terms of Service</a
        >
        <a
          href={getPermalink("/contact")}
          class="rounded decoration-1 underline-offset-4 hover:text-white hover:underline focus:underline focus:outline-none focus-visible:underline focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
          >Contact</a
        >
      </div>
    </div>
  </div>
</footer>

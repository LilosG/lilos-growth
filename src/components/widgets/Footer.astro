---
import Logo from '../Logo.astro';
import { getPermalink } from '~/utils/permalinks';
---

<footer class="bg-[#253242] text-white border-t-2 border-[#f56b2a]">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-6 py-14 md:py-16">
    <!-- Clean 3-column layout: Brand/Contact | Services | Company -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 md:pl-8 lg:pl-12">
      <!-- Brand / Contact -->
      <section aria-labelledby="footer-brand">
        <Logo class="w-28 mb-3" />
        <h2 id="footer-brand" class="text-xl font-heading font-bold">Lilos Growth</h2>
        <p class="mt-2 text-white/85">Home Service Marketing Experts</p>

        <!-- rating chip removed by request -->

        <div class="mt-4 space-y-1 text-sm text-white/75">
          <a
            href="mailto:hello@lilosgrowth.com"
            class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
            >hello@lilosgrowth.com</a
          >
          <div>Based in San Diego, CA</div>
        </div>
      </section>

      <!-- Services (core) + subtle addendum list -->
      <nav aria-labelledby="footer-services">
        <h3 id="footer-services" class="text-base font-semibold tracking-wide text-[#f56b2a] mb-3">Services</h3>
        <ul class="space-y-2 text-white/90 leading-7">
          <li>
            <a
              href={getPermalink('/services/local-seo')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Local SEO</a>
          </li>
          <li>
            <a
              href={getPermalink('/services/google-business-profile-optimization')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Google Business Profile</a>
          </li>
          <li>
            <a
              href={getPermalink('/services/web-design')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Website Design</a>
          </li>
          <li>
            <a
              href={getPermalink('/additional-services')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Additional Services</a>
          </li>
        </ul>

        <!-- Subtle divider + single tool link to balance columns -->
        <div class="mt-4 pt-4 border-t border-white/10">
          <ul class="space-y-2 text-white/80 leading-7">
            <li>
              <a
                href={getPermalink('/local-seo-tools')}
                class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
                >Local SEO Tools</a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Company -->
      <nav aria-labelledby="footer-company">
        <h3 id="footer-company" class="text-base font-semibold tracking-wide text-[#f56b2a] mb-3">Company</h3>
        <ul class="space-y-2 text-white/90 leading-7">
          <li>
            <a
              href={getPermalink('/packages')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Packages</a>
          </li>
          <li>
            <a
              href={getPermalink('/about')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >About</a>
          </li>
          <li>
            <a
              href={getPermalink('/contact')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Contact</a>
          </li>
          <li>
            <a
              href={getPermalink('/faq')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >FAQ</a>
          </li>
          <li>
            <a
              href={getPermalink('/privacy-policy')}
              class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
              >Privacy Policy</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Meta row -->
    <div
      class="mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-white/70"
    >
      <div>© 2025 Lilos Growth. All rights reserved.</div>
      <div class="flex items-center gap-4">
        <a
          href={getPermalink('/privacy-policy')}
          class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
          >Privacy Policy</a
        >
        <a
          href={getPermalink('/contact')}
          class="hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] rounded"
          >Contact</a
        >
      </div>
    </div>
  </div>
</footer>

---
import { headerData } from '~/navigation';
import FloatingCalendlyButton from '~/components/widgets/FloatingCalendlyButton.astro';

type NavLink = { text: string; href: string };
type Action = { text: string; href: string };
type UnknownRecord = Record<string, unknown>;

const FALLBACK_LINKS: NavLink[] = [
  { text: 'Services', href: '/services' },
  { text: 'Packages', href: '/packages' },
  { text: 'Additional Services', href: '/additional-services' },
  { text: 'Local SEO Tools', href: '/local-seo-tools' },
  { text: 'About', href: '/about' },
  { text: 'Contact', href: '/contact' },
];

const FALLBACK_ACTIONS: Action[] = [
  { text: 'Book a Call', href: '/contact' },
  { text: 'Services', href: '/services' },
];

const s = (v: unknown, d = '') => (typeof v === 'string' && v.trim() ? v : d);

const normalizeLinks = (input: unknown): NavLink[] => {
  if (!Array.isArray(input)) return FALLBACK_LINKS;
  const out: NavLink[] = [];
  for (const item of input) {
    const o = (item ?? {}) as UnknownRecord;
    const text = s(o.text);
    const href = s(o.href, '#');
    if (text) out.push({ text, href });
  }
  return out.length ? out : FALLBACK_LINKS;
};

const normalizeActions = (input: unknown): Action[] => {
  if (!Array.isArray(input)) return FALLBACK_ACTIONS;
  const out: Action[] = [];
  for (const item of input) {
    const o = (item ?? {}) as UnknownRecord;
    const text = s(o.text);
    const href = s(o.href, '#');
    if (text) out.push({ text, href });
  }
  return out.length ? out : FALLBACK_ACTIONS;
};

const links: NavLink[] = normalizeLinks((headerData as UnknownRecord | undefined)?.['links']);
const actions: Action[] = normalizeActions((headerData as UnknownRecord | undefined)?.['actions']);

const currentPath = Astro.url.pathname;
const isActive = (href: string) => !!href && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));

const primary: Action = actions[0] ?? { text: 'Book a Call', href: '/contact' };
const secondary: Action = actions[1] ?? { text: 'Services', href: '/services' };
const showSecondary = secondary.href !== primary.href;
---

<header
  class="site-header fixed inset-x-0 top-0 z-[99999] isolate w-full transition-[box-shadow,transform] will-change-transform"
  role="banner"
>
  <!-- Backplate drives the background; surface stays transparent -->
  <div class="header-backplate" aria-hidden="true"></div>

  <div class="header-surface relative z-[1]">
    <div class="mx-auto w-full max-w-7xl px-6 md:px-8">
      <div class="header-bar flex items-center justify-between gap-4 py-4 md:py-5">
        <!-- Brand -->
        <a href="/" class="inline-flex items-center shrink-0" aria-label="Lilos Growth — Home">
          <img
            src="/Lilos_Growth_Logo_White.svg"
            alt="Lilos Growth"
            class="logo logo--white h-12 md:h-14 w-auto object-contain"
            loading="eager"
            decoding="async"
            width="176"
            height="48"
          />
          <img
            src="/Lilos_Growth_Logo_Corrected.svg"
            alt="Lilos Growth"
            class="logo logo--color h-12 md:h-14 w-auto object-contain"
            loading="eager"
            decoding="async"
            width="176"
            height="48"
          />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden sm:flex" aria-label="Primary">
          <div class="flex items-center gap-7 lg:gap-9">
            {
              links.map((item) => (
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class={`nav-link py-2 text-[15px] leading-[22px] font-medium tracking-[0.005em] transition
                           hover:underline underline-offset-4 decoration-2 decoration-[#f56b2a]/70
                           focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-0
                           ${isActive(item.href) ? 'active' : ''}`}
                >
                  {item.text}
                </a>
              ))
            }
          </div>
        </nav>

        <!-- Actions + Mobile -->
        <div class="flex items-center justify-end gap-3">
          {
            showSecondary ? (
              <a
                href={secondary.href}
                class="hidden sm:inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-4 py-2 text-[14px] leading-[22px] font-semibold text-[#1f2d3d] shadow-sm transition hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-white"
              >
                <span>{secondary.text}</span>
              </a>
            ) : null
          }

          <a
            href={primary.href}
            class="hidden sm:inline-flex group items-center gap-2 rounded-full border border-transparent bg-[#f56b2a] px-5 py-2.5 text-[15px] leading-[22px] font-semibold text-white shadow transition hover:bg-[#e85718] focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-white"
          >
            <span>{primary.text}</span>
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 transform transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobileMenuBtn"
            class="sm:hidden inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-3.5 py-2 text-[15px] leading-[22px] font-medium text-[#1f2d3d] shadow-sm transition hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-white"
            aria-controls="mobileMenu"
            aria-expanded="false"
            aria-label="Open menu"
          >
            <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <circle cx="3" cy="3" r="1.5"></circle>
              <circle cx="10" cy="3" r="1.5"></circle>
              <circle cx="17" cy="3" r="1.5"></circle>
              <circle cx="3" cy="10" r="1.5"></circle>
              <circle cx="10" cy="10" r="1.5"></circle>
              <circle cx="17" cy="10" r="1.5"></circle>
              <circle cx="3" cy="17" r="1.5"></circle>
              <circle cx="10" cy="17" r="1.5"></circle>
              <circle cx="17" cy="17" r="1.5"></circle>
            </svg>
            <span>Menu</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobileMenu" class="fixed inset-0 z-[110] hidden" aria-hidden="true">
    <div id="mobileMenuOverlay" class="absolute inset-0 bg-black/40"></div>
    <div class="absolute right-0 top-0 h-full w-[88%] max-w-[22rem] bg-white shadow-xl p-6 overflow-y-auto">
      <div class="flex items-center justify-between">
        <a href="/" class="inline-flex items-center" aria-label="Lilos Growth — Home">
          <img
            src="/Lilos_Growth_Logo_Corrected.svg"
            alt="Lilos Growth"
            class="h-11 w-auto object-contain"
            loading="eager"
            decoding="async"
          />
        </a>
        <button
          id="mobileMenuClose"
          class="inline-flex h-10 items-center justify-center rounded-full border border-gray-300 px-4 text-[#253242] bg-white shadow-sm hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]"
          aria-label="Close menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mt-6 space-y-2">
        {
          links.map((item) => (
            <a href={item.href} class="block rounded-xl px-3 py-3 text-[15px] text-[#253242] hover:bg-gray-50">
              {item.text}
            </a>
          ))
        }

        <a
          href={primary.href}
          class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-[#f56b2a] px-4 py-3 text-white text-sm font-semibold shadow-md hover:bg-[#e85718] transition"
        >
          {primary.text}
        </a>
      </div>
    </div>
  </div>

  <!-- Controllers -->
  <script type="module" src="/scripts/mobile-menu.js"></script>
  <script type="module" src="/scripts/header-scroll.js"></script>
</header>

<!-- Spacer kept in sync by header-scroll.js -->
<div id="header-spacer" aria-hidden="true" style="height: var(--header-h, 84px)"></div>

<!-- Floating CTA (Calendly safe) -->
<FloatingCalendlyButton href={import.meta.env.PUBLIC_CALENDLY_URL} />

<style>
  /* ——— Theming via CSS variables (no new classes) ——— */
  header.site-header {
    /* Top-of-page (overlay) defaults */
    --hdr-bg: rgba(31, 45, 61, 0.92); /* navy with alpha */
    --hdr-border: rgba(255, 255, 255, 0.14);
    --hdr-link: rgba(255, 255, 255, 0.92);
    --hdr-link-hover: #ffffff;
    --hdr-shadow: 0 2px 10px rgba(0, 0, 0, 0.04);
  }
  header.site-header.is-shrunk {
    /* Scrolled (solid) */
    --hdr-bg: rgba(255, 255, 255, 0.98);
    --hdr-border: rgba(2, 6, 23, 0.08);
    --hdr-link: #1f2d3d;
    --hdr-link-hover: #1f2d3d;
    --hdr-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
  }

  /* Keep surface transparent (overrides any global CSS that adds bg on first child) */
  header.site-header .header-surface {
    background: transparent !important;
  }

  /* Backplate drives visuals (blur only on overlay) */
  header.site-header .header-backplate {
    position: absolute;
    inset: 0;
    background: var(--hdr-bg) !important;
    border-bottom: 1px solid var(--hdr-border) !important;
    box-shadow: var(--hdr-shadow) !important;
    z-index: 0;
    pointer-events: none;
    -webkit-backdrop-filter: saturate(120%) blur(10px);
    backdrop-filter: saturate(120%) blur(10px);
    transition:
      background 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }
  header.site-header.is-shrunk .header-backplate {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Nav link colors adapt to the variables above */
  header.site-header .nav-link {
    color: var(--hdr-link);
  }
  header.site-header .nav-link:hover,
  header.site-header .nav-link.active {
    color: var(--hdr-link-hover);
    text-decoration-color: rgba(245, 107, 42, 0.8);
  }

  /* Typography + motion polish */
  header.site-header .logo {
    transition: height 180ms ease;
  }
  header.site-header .header-bar {
    transition: padding 180ms ease;
  }

  /* Shrink states (gentle, no jump) */
  @media (min-width: 1024px) {
    header.site-header.is-shrunk .logo {
      height: 3.25rem !important;
    } /* 52px */
    header.site-header.is-shrunk .header-bar {
      padding-top: 0.75rem;
      padding-bottom: 0.75rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    header.site-header.is-shrunk .logo {
      height: 2.75rem !important;
    } /* 44px */
    header.site-header.is-shrunk .header-bar {
      padding-top: 0.625rem;
      padding-bottom: 0.625rem;
    }
  }
  @media (max-width: 767.98px) {
    header.site-header.is-shrunk .logo {
      height: 2.5rem !important;
    } /* 40px */
    header.site-header.is-shrunk .header-bar {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    header.site-header .logo,
    header.site-header .header-bar,
    header.site-header .header-backplate {
      transition: none !important;
    }
  }

  /* Logo swap visibility */
  header.site-header:not(.is-shrunk) .logo--color {
    display: none;
  }
  header.site-header.is-shrunk .logo--white {
    display: none;
  }
  /* Neutralize blend/filter for the white asset */
  header.site-header:not(.is-shrunk) .logo--white {
    mix-blend-mode: normal;
    opacity: 1;
    filter: none;
  }
</style>

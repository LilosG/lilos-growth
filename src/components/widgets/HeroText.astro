---
import type { CallToAction } from "~/types";
import Button from "~/components/ui/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
}

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  content = await Astro.slots.render("content"),
  callToAction = await Astro.slots.render("callToAction"),
  callToAction2 = await Astro.slots.render("callToAction2"),
} = Astro.props;
---

<section class="not-prose relative md:-mt-[76px]">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
    <div class="py-12 pb-8 md:py-20 md:pb-8">
      <div class="mx-auto max-w-5xl text-center">
        {
          tagline && (
            <p
              class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade text-base font-bold uppercase tracking-wide text-secondary dark:text-blue-200 motion-safe:md:opacity-0"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="leading-tighter intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-4 font-heading text-5xl font-bold tracking-tighter dark:text-gray-200 md:text-6xl motion-safe:md:opacity-0"
              set:html={title}
            />
          )
        }
        <div class="mx-auto max-w-3xl">
          {
            subtitle && (
              <p
                class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-6 text-xl text-muted dark:text-slate-300 motion-safe:md:opacity-0"
                set:html={subtitle}
              />
            )
          }
          <div
            class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade m-auto flex max-w-xs flex-col flex-nowrap gap-4 sm:max-w-md sm:flex-row sm:justify-center motion-safe:md:opacity-0"
          >
            {
              callToAction && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction === "string" ? (
                    <Fragment set:html={callToAction} />
                  ) : (
                    <Button
                      variant={callToAction?.variant ?? "primary"}
                      href={callToAction?.href}
                      target={callToAction?.target}
                      icon={callToAction?.icon}
                    >
                      {callToAction?.text}
                    </Button>
                  )}
                </div>
              )
            }
            {
              callToAction2 && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction2 === "string" ? (
                    <Fragment set:html={callToAction2} />
                  ) : (
                    <Button
                      variant={callToAction2?.variant ?? "primary"}
                      href={callToAction2?.href}
                      target={callToAction2?.target}
                      icon={callToAction2?.icon}
                    >
                      {callToAction2?.text}
                    </Button>
                  )}
                </div>
              )
            }
          </div>
        </div>
        {content && <Fragment set:html={content} />}
      </div>
    </div>
  </div>
</section>

---
import Button from "~/components/ui/Button.astro";

interface Props {
  ctaHref?: string;
  ctaText?: string;
  ctaTracking?: string;
}

const { ctaHref = "#request", ctaText = "Get offer details", ctaTracking } = Astro.props;
---

<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex min-h-16 max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="inline-flex min-w-0 items-center gap-2 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      aria-label="Lilos Growth home"
    >
      <img
        src="/logo-lcp-160.webp"
        alt=""
        width="48"
        height="48"
        class="h-10 w-10 shrink-0 object-contain"
      />
      <span class="font-heading text-lg font-extrabold text-heading">Lilos Growth</span>
    </a>
    <Button
      href={ctaHref}
      variant="primary"
      size="sm"
      class="shrink-0 text-center"
      data-offer-cta={ctaTracking ?? ""}>{ctaText}</Button
    >
  </div>
</header>

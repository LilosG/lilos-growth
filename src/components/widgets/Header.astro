---
import { headerData } from "~/navigation";

// active route (no trailing slash)
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
function isActive(href?: string) {
  if (!href) return false;
  const clean = href.replace(/\/+$/, "") || "/";
  if (clean === "/") return pathname === "/";
  return pathname === clean || pathname.startsWith(clean + "/");
}
---

<header class="sticky top-0 z-50 bg-white">
  <!-- Desktop -->
  <nav class="hidden md:block">
    <div class="container mx-auto px-6">
      <div class="flex h-16 items-center">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3">
          <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-8 w-auto" />
        </a>

        <!-- Primary nav (center) -->
        <ul class="mx-auto flex items-center gap-8">
          {headerData.links?.map((item) => (
            <li class="relative group">
              {item.links ? (
                <>
                  {/* parent is a REAL LINK; clicking navigates */}
                  <a
                    href={item.href ?? "/services"}
                    class={`inline-flex items-center gap-1.5 py-2 text-[15px] leading-[22px] font-medium tracking-[0.005em] transition
                            ${isActive(item.href) ? "text-[#f56b2a]" : "text-[#1f2d3d] hover:text-[#f56b2a]"}`}
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {item.text}
                    <svg class="h-4 w-4 opacity-70 group-hover:opacity-100 transition" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                    </svg>
                  </a>

                  <!-- Dropdown -->
                  <div
                    class="absolute left-0 top-full z-20 mt-2 min-w-[16rem] rounded-xl border border-gray-200 bg-white p-2 shadow-xl
                           invisible opacity-0 translate-y-1 transition
                           group-hover:visible group-hover:opacity-100 group-hover:translate-y-0
                           group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0"
                  >
                    <ul class="flex flex-col">
                      {item.links.map((sub) => (
                        <li>
                          <a
                            href={sub.href ?? "#"}
                            class={`block rounded-lg px-3 py-2 text-[15px] leading-6 transition
                                    ${isActive(sub.href) ? "bg-gray-100 text-[#1f2d3d]" : "text-[#1f2d3d] hover:bg-gray-50"}`}
                          >
                            {sub.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </>
              ) : (
                <a
                  href={item.href ?? "#"}
                  class={`inline-flex items-center py-2 text-[15px] leading-[22px] font-medium tracking-[0.005em] transition
                          ${isActive(item.href) ? "text-[#f56b2a]" : "text-[#1f2d3d] hover:text-[#f56b2a]"}`}
                >
                  {item.text}
                </a>
              )}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        {headerData.actions?.[0] && (
          <a
            href={headerData.actions[0].href}
            class="inline-flex items-center rounded-full bg-[#f56b2a] px-4 py-2 text-white font-semibold shadow hover:bg-[#f34e00] transition"
          >
            {headerData.actions[0].text}
            <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M5 12h14M13 18l6-6-6-6" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </nav>

  <!-- Mobile -->
  <nav class="md:hidden">
    <div class="container mx-auto px-6">
      <div class="flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-8 w-auto" />
        </a>

        <details class="relative">
          <summary class="list-none inline-flex items-center rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-[#1f2d3d]">
            Menu
            <svg class="ml-2 h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
            </svg>
          </summary>

          <div class="absolute right-0 mt-2 w-[92vw] max-w-sm rounded-2xl border border-gray-200 bg-white p-2 shadow-xl">
            <ul class="flex flex-col divide-y divide-gray-100">
              {headerData.links?.map((item) => (
                <li class="py-1">
                  {item.links ? (
                    <details>
                      <summary class="flex cursor-pointer items-center justify-between rounded-lg px-3 py-2 text-[15px] font-medium text-[#1f2d3d] hover:bg-gray-50">
                        <span>{item.text}</span>
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                        </svg>
                      </summary>
                      <ul class="mt-1 mb-2 pl-2">
                        {item.links.map((sub) => (
                          <li>
                            <a href={sub.href ?? "#"} class="block rounded-lg px-3 py-2 text-[15px] text-[#1f2d3d] hover:bg-gray-50">
                              {sub.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                      {item.href && (
                        <a href={item.href} class="mx-2 mb-2 block rounded-lg bg-gray-50 px-3 py-2 text-[15px] text-[#1f2d3d] hover:bg-gray-100">
                          View {item.text}
                        </a>
                      )}
                    </details>
                  ) : (
                    <a href={item.href ?? "#"} class="block rounded-lg px-3 py-2 text-[15px] text-[#1f2d3d] hover:bg-gray-50">
                      {item.text}
                    </a>
                  )}
                </li>
              ))}

              {headerData.actions?.[0] && (
                <li class="pt-2">
                  <a
                    href={headerData.actions[0].href}
                    class="mt-1 inline-flex w-full items-center justify-center rounded-full bg-[#f56b2a] px-4 py-2 text-white font-semibold shadow hover:bg-[#f34e00] transition"
                  >
                    {headerData.actions[0].text}
                  </a>
                </li>
              )}
            </ul>
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>

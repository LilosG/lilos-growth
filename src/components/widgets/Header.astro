---
/* -nocheck */
import { headerData } from '~/navigation';

type Link = { text: string; href: string; description?: string };
type Menu = { text: string; links: Link[] };
type Item = Link | Menu;
type UnknownRecord = Record<string, unknown>;

const isMenu = (x: unknown): x is Menu => !!x && typeof x === 'object' && Array.isArray((x as any).links);
const isLink = (x: unknown): x is Link => !!x && typeof x === 'object' && typeof (x as any).href === 'string';

const coerceLink = (x: unknown): Link | null => {
  if (!isLink(x)) return null;
  const href = String((x as any).href).trim();
  const text = String((x as any).text ?? '').trim();
  if (!text) return null;
  if (!href || href === '#') return null;
  return { text, href, description: (x as any).description };
};

const FALLBACK_LINKS: Link[] = [
  { text: 'Services', href: '/services' },
  { text: 'Packages', href: '/packages' },
  { text: 'Additional Services', href: '/additional-services' },
  { text: 'Resources', href: '/resources' },
  { text: 'Local SEO Tools', href: '/local-seo-tools' },
  { text: 'About', href: '/about' },
  { text: 'Contact', href: '/contact' },
];

const FALLBACK_ACTION: Link = { text: 'Book a Call', href: '/contact#book' };

// Normalize nav config
const rawItems = ((headerData as UnknownRecord)?.links as unknown[]) ?? [];
const items: Item[] = rawItems
  .map((it) => {
    if (isMenu(it)) {
      const text = String((it as any).text ?? '').trim() || 'Menu';
      const links = ((it as any).links as unknown[]).map(coerceLink).filter(Boolean) as Link[];
      const lower = text.toLowerCase();
      const parentHref =
        lower === 'services' ? '/services'
        : lower === 'resources' ? '/resources'
        : (links[0]?.href ?? '/');
      return { text, links: links.length ? links : [{ text, href: parentHref }] } as Menu;
    }
    const link = coerceLink(it);
    return link ?? null;
  })
  .filter(Boolean) as Item[];

const navItems: Item[] = items.length ? items : FALLBACK_LINKS;

const rawActions = ((headerData as UnknownRecord)?.actions as unknown[]) ?? [];
const firstAction = coerceLink(rawActions[0]) ?? FALLBACK_ACTION;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => !!href && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));
---

<header class="site-header fixed inset-x-0 top-0 z-[99999] isolate w-full transition-[box-shadow]">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="header-backplate" aria-hidden="true"></div>

  <div class="header-surface relative z-[1]">
    <div class="mx-auto w-full max-w-7xl px-6 md:px-8">
      <div class="header-bar flex items-center justify-between gap-4 py-4 md:py-5">
        <!-- Brand -->
        <a href="/" class="inline-flex items-center shrink-0" aria-label="Lilos Growth — Home">
          <img
            src="/Lilos_Growth_Logo_Corrected.svg"
            alt="Lilos Growth"
            class="logo logo--color h-12 md:h-14 w-auto object-contain"
            loading="eager"
            decoding="async"
            width="176"
            height="48"
            fetchpriority="high"
          />
        </a>

        <!-- Desktop nav -->
        <nav class="hidden md:flex" aria-label="Primary">
          <ul class="flex items-center gap-7 lg:gap-9">
            {
              navItems.map((item) => {
                if ('links' in (item as any)) {
                  const menu = item as Menu;
                  const lower = menu.text.toLowerCase();
                  const parentHref =
                    lower === 'services' ? '/services'
                    : lower === 'resources' ? '/resources'
                    : (menu.links[0]?.href ?? '/');

                  return (
                    <li class="relative group">
                      <!-- Parent is a LINK (click goes to parent page). Hover shows submenu. -->
                      <a
                        href={parentHref}
                        class="inline-flex items-center gap-1 py-2 text-[15px] leading-[22px] font-medium tracking-[0.005em]
                               text-[#1f2d3d] rounded-md transition
                               hover:underline underline-offset-4 decoration-2 decoration-[#f56b2a]/70
                               focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a]/60"
                      >
                        {menu.text}
                        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" />
                        </svg>
                      </a>

                      <!-- Submenu: appears on hover/focus of the LI -->
                      <div
                        class="submenu absolute left-0 top-[calc(100%+10px)] min-w-[16rem] rounded-xl border border-gray-200 bg-white shadow-xl
                               opacity-0 pointer-events-none translate-y-1 transition
                               group-hover:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0
                               group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 z-[60]"
                      >
                        <ul class="py-2">
                          <li>
                            <a href={parentHref} class="block px-4 py-2.5 text-[14px] font-medium text-[#1f2d3d] rounded-md hover:bg-gray-50">
                              All {menu.text}
                            </a>
                          </li>
                          {menu.links.map((lnk) => (
                            <li>
                              <a
                                href={lnk.href}
                                aria-current={isActive(lnk.href) ? 'page' : undefined}
                                class={`block px-4 py-2.5 text-[14px] leading-5 text-[#1f2d3d] rounded-md transition
                                        hover:bg-gray-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a]/60
                                        ${isActive(lnk.href) ? 'active' : ''}`}
                              >
                                <span class="font-medium">{lnk.text}</span>
                                {lnk.description && (
                                  <span class="block text-[12px] text-gray-500 mt-0.5">{lnk.description}</span>
                                )}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </li>
                  );
                }

                const link = item as Link;
                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive(link.href) ? 'page' : undefined}
                      class={`py-2 text-[15px] leading-[22px] font-medium tracking-[0.005em] transition
                              hover:underline underline-offset-4 decoration-2 decoration-[#f56b2a]/70
                              focus:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a]/60 focus-visible:rounded-md
                              ${isActive(link.href) ? 'active' : ''}`}
                    >
                      {link.text}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        <!-- Actions + Mobile trigger -->
        <div class="flex items-center justify-end gap-3">
          <a
            href={firstAction.href}
            class="hidden md:inline-flex items-center gap-2 rounded-full border border-transparent bg-[#f56b2a]
                   px-5 py-2.5 text-[15px] leading-[22px] font-semibold text-white shadow transition hover:bg-[#e85718]
                   focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-white"
          >
            <span>{firstAction.text}</span>
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6"></path>
            </svg>
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobileMenuBtn"
            class="md:hidden inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-3.5 py-2
                   text-[15px] leading-[22px] font-medium text-[#1f2d3d] shadow-sm transition hover:bg-gray-50
                   focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]/60 focus-visible:ring-offset-white"
            aria-controls="mobileMenu"
            aria-expanded="false"
            aria-label="Open menu"
          >
            <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true">
              <circle cx="3" cy="3" r="1.5"></circle><circle cx="10" cy="3" r="1.5"></circle><circle cx="17" cy="3" r="1.5"></circle>
              <circle cx="3" cy="10" r="1.5"></circle><circle cx="10" cy="10" r="1.5"></circle><circle cx="17" cy="10" r="1.5"></circle>
              <circle cx="3" cy="17" r="1.5"></circle><circle cx="10" cy="17" r="1.5"></circle><circle cx="17" cy="17" r="1.5"></circle>
            </svg>
            <span>Menu</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobileMenu" class="fixed inset-0 z-[110] hidden" aria-hidden="true">
    <div id="mobileMenuOverlay" class="absolute inset-0 bg-black/40"></div>
    <div class="absolute right-0 top-0 h-full w-[88%] max-w-[22rem] bg-white shadow-xl p-6 overflow-y-auto">
      <div class="flex items-center justify-between">
        <a href="/" class="inline-flex items-center" aria-label="Lilos Growth — Home">
          <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-11 w-auto object-contain" loading="eager" decoding="async" />
        </a>
        <button
          id="mobileMenuClose"
          class="inline-flex h-10 items-center justify-center rounded-full border border-gray-300 px-4 text-[#253242] bg-white shadow-sm hover:bg-gray-50
                 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]"
          aria-label="Close menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mt-6 space-y-2">
        {
          navItems.map((item) => {
            if ('links' in (item as any)) {
              const menu = item as Menu;
              const lower = menu.text.toLowerCase();
              const parentHref =
                lower === 'services' ? '/services'
                : lower === 'resources' ? '/resources'
                : (menu.links[0]?.href ?? '/');
              return (
                <details class="rounded-xl border border-gray-200">
                  <summary class="cursor-pointer select-none px-3 py-3 text-[15px] text-[#253242] rounded-lg">
                    {menu.text}
                  </summary>
                  <div class="px-2 pb-2">
                    <ul class="space-y-1">
                      <li><a href={parentHref} class="block rounded-lg px-3 py-2 text-[14px] text-[#253242] hover:bg-gray-50">All {menu.text}</a></li>
                      {menu.links.map((lnk) => (
                        <li>
                          <a href={lnk.href} class="block rounded-lg px-3 py-2 text-[14px] text-[#253242] hover:bg-gray-50">{lnk.text}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              );
            }
            const link = item as Link;
            return <a href={link.href} class="block rounded-xl px-3 py-3 text-[15px] text-[#253242] hover:bg-gray-50">{link.text}</a>;
          })
        }

        <a
          href={firstAction.href}
          class="mt-4 inline-flex w-full items-center justify-center rounded-full bg-[#f56b2a] px-4 py-3 text-white text-sm font-semibold shadow-md hover:bg-[#e85718] transition"
        >
          {firstAction.text}
        </a>
      </div>
    </div>
  </div>

  <!-- Controllers -->
  <script type="module" src="/scripts/mobile-menu.js" is:inline></script>
  <script type="module" src="/scripts/header-scroll.js" is:inline></script>
  <script type="module" src="/scripts/header-a11y.js" is:inline></script>
</header>

<style>
  header.site-header { --hdr-bg: rgba(255,255,255,0.98); --hdr-border: rgba(2,6,23,0.08); --hdr-shadow: 0 8px 24px rgba(0,0,0,0.06); }
  header.site-header.is-shrunk { --hdr-shadow: 0 10px 28px rgba(0,0,0,0.08); }
  .header-surface { background: transparent !important; }
  .header-backplate { position:absolute; inset:0; background:var(--hdr-bg)!important; border-bottom:1px solid var(--hdr-border)!important; box-shadow:var(--hdr-shadow)!important; z-index:0; pointer-events:none!important; -webkit-backdrop-filter:saturate(120%) blur(10px); backdrop-filter:saturate(120%) blur(10px); transition:background .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .skip-link { position:absolute; left:-9999px; top:0; z-index:100000; background:#1f2d3d; color:#fff; padding:.5rem .75rem; border-radius:.5rem; box-shadow:0 4px 14px rgba(0,0,0,.2); }
  .skip-link:focus { left:1rem; top:.75rem; outline:2px solid #f56b2a; outline-offset:2px; }
  .site-header a.active { color:#f56b2a; text-decoration:underline; text-underline-offset:4px; text-decoration-thickness:2px; text-decoration-color:rgba(245,107,42,.7); }
</style>

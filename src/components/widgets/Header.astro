---
const routes = {
  home: '/',
  services: '/services',
  gbp: '/services/google-business-profile-optimization',
  localSeo: '/services/local-seo',
  webDesign: '/services/web-design',
  additional: '/services#additional-services',
  seoTools: '/seo-tools',
  about: '/about',
  contact: '/contact',
};
---

<header class="relative z-40 bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={routes.home} class="flex items-center gap-2">
      <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-7 w-auto" />
    </a>

    <!-- DESKTOP NAV (restored) -->
    <nav class="hidden lg:flex items-center gap-8 text-[15px] font-medium text-heading">
      <a href={routes.services} class="hover:text-primary">Services</a>
      <a href={routes.additional} class="hover:text-primary">Additional Services</a>
      <a href={routes.seoTools} class="hover:text-primary">Free SEO Tools</a>
      <a href={routes.about} class="hover:text-primary">About</a>
      <a href={routes.contact} class="hover:text-primary">Contact</a>
      <a
        href="#contact"
        class="ml-2 inline-flex items-center px-4 py-2 rounded-xl bg-primary text-white hover:bg-primaryHover transition"
      >
        Schedule a Call
      </a>
    </nav>

    <!-- MOBILE TOGGLE -->
    <button
      id="navToggle"
      class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl bg-secondary/90 text-white shadow focus:outline-none focus:ring-2 focus:ring-primary"
      aria-controls="mobileMenu"
      aria-expanded="false"
      aria-label="Open menu"
      type="button"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- MOBILE OVERLAY MENU -->
<div id="mobileMenu" class="fixed inset-0 z-[80] hidden">
  <!-- Scrim -->
  <div class="absolute inset-0 bg-[#0b1522]/70 backdrop-blur-sm" data-close></div>

  <!-- Sheet -->
  <div class="absolute inset-x-0 top-0 mx-auto w-full max-w-xl bg-[#1b2a3b] text-white rounded-b-3xl shadow-2xl">
    <div class="flex items-center justify-between px-5 h-14">
      <span class="text-base font-semibold">Menu</span>
      <button
        id="navClose"
        class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-primary"
        aria-label="Close menu"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6l-12 12"></path>
        </svg>
      </button>
    </div>

    <div class="border-t border-white/10"></div>

    <!-- Links -->
    <nav class="px-5 py-4">
      <ul class="space-y-2 text-[17px]">
        <li><a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.services}>All Services</a></li>

        <li class="mt-2 text-xs uppercase tracking-wide text-white/60 px-3">Core Services</li>
        <li>
          <a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.gbp}
            >Google Business Profile Optimization</a>
        </li>
        <li><a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.localSeo}>Local SEO</a></li>
        <li>
          <a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.webDesign}
            >Website Design & Development</a>
        </li>

        <li class="mt-4 text-xs uppercase tracking-wide text-white/60 px-3">Company</li>
        <li>
          <a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.additional}>Additional Services</a>
        </li>
        <li><a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.seoTools}>Free SEO Tools</a></li>
        <li><a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.about}>About</a></li>
        <li><a class="block px-3 py-2 rounded-lg hover:bg-white/10" href={routes.contact}>Contact</a></li>
      </ul>

      <a
        href="#contact"
        class="mt-5 mb-4 block text-center px-5 py-3 rounded-xl bg-primary font-semibold hover:bg-primaryHover transition"
      >
        Schedule a Call
      </a>
    </nav>
  </div>
</div>

<!-- LINT-SAFE SCRIPT (no IIFE, no TS casts) -->
<script is:inline>
  function lgSetupMobileNav() {
    const btn = document.getElementById('navToggle');
    const menu = document.getElementById('mobileMenu');
    const closeBtn = document.getElementById('navClose');

    if (!btn || !menu) return;
    if (btn.dataset.bound === '1') return; // prevent double-binding on SPA transitions
    btn.dataset.bound = '1';

    const open = () => {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      open();
    });
    if (closeBtn) closeBtn.addEventListener('click', close);

    // Click scrim to close
    menu.addEventListener('click', (e) => {
      const t = e.target;
      if (t && t instanceof HTMLElement && t.hasAttribute('data-close')) close();
    });

    // Navigate closes menu
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    // ESC to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Astro view transitions
    document.addEventListener('astro:before-swap', close);
    document.addEventListener('astro:page-load', close);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', lgSetupMobileNav, { once: true });
  } else {
    lgSetupMobileNav();
  }
</script>

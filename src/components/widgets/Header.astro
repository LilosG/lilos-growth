---
import { headerData } from "~/navigation";

const { url } = Astro;
const pathname = url.pathname;

const navItems = headerData.links as ReadonlyArray<{
  text: string;
  href: string;
  links?: ReadonlyArray<{ text: string; href: string }>;
}>;

function isActive(href: string) {
  const norm = (s: string) => (s.endsWith("/") && s.length > 1 ? s.slice(0, -1) : s);
  return norm(pathname) === norm(href);
}
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white pb-px">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between md:h-20">
      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Lilos Growth">
        <img
          src="/Lilos_Growth_Logo_Corrected.svg"
          alt="Lilos Growth"
          class="h-12 w-auto md:h-14 lg:h-16 logo--halo"
        />
      </a>

      <nav class="ml-6 hidden items-center gap-2 lg:flex">
        {
          navItems.map((item) => (
            <div class="group relative">
              {item.links ? (
                <div>
                  <a
                    href={item.href}
                    class={`rounded-md px-3 py-2 text-[15px] font-semibold leading-6 tracking-tight no-underline transition ${isActive(item.href) ? "text-[#1f2d3d]" : "text-gray-700 hover:bg-gray-50 hover:text-[#1f2d3d]"}`}
                  >
                    {item.text}
                  </a>

                  <div class="supports-backdrop:bg-white/90 absolute left-0 z-50 mt-2 hidden w-72 rounded-2xl border border-gray-200 bg-white/95 p-2 shadow-xl ring-1 ring-black/5 backdrop-blur before:absolute before:inset-x-0 before:top-0 before:h-1 before:rounded-t-2xl before:bg-[#f56b2a] group-hover:block">
                    <ul class="py-1">
                      {(item.links ?? []).map((sub: { text: string; href: string }) => (
                        <li class="first:pt-0">
                          <a
                            href={sub.href ?? "#"}
                            class={`group/sub flex items-center gap-3 rounded-xl px-3 py-2 text-[14px] no-underline transition ${
                              isActive(sub.href)
                                ? "bg-gray-50 text-[#1f2d3d] shadow-sm"
                                : "text-[#1f2d3d] hover:translate-x-[2px] hover:bg-gray-50 hover:shadow-sm"
                            }`}
                          >
                            <span class="h-1.5 w-1.5 rounded-full bg-gray-300 transition group-hover/sub:bg-[#f56b2a]" />
                            <span class="font-medium">{sub.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class={`rounded-md px-3 py-2 text-[15px] font-semibold leading-6 tracking-tight no-underline transition ${isActive(item.href) ? "text-[#1f2d3d]" : "text-gray-700 hover:bg-gray-50 hover:text-[#1f2d3d]"}`}
                >
                  {item.text}
                </a>
              )}
            </div>
          ))
        }

        {
          headerData.actions?.[0] && (
            <a
              href={headerData.actions[0].href}
              class="ml-3 inline-flex items-center rounded-lg bg-[#f56b2a] px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              {headerData.actions[0].text}
            </a>
          )
        }
      </nav>

      <details class="ml-auto lg:hidden">
        <summary
          class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 hover:bg-gray-100 hover:text-gray-900"
          aria-label="Open Menu"
        >
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>

        <nav
          class="mt-2 rounded-2xl border border-gray-200 bg-white p-2 shadow-xl ring-1 ring-black/5"
        >
          <ul class="flex flex-col">
            {
              navItems.map((item) => (
                <li class="w-full">
                  <a
                    href={item.href}
                    class={`block w-full rounded-xl px-3 py-2 text-sm no-underline ${isActive(item.href) ? "bg-gray-100 text-[#1f2d3d]" : "text-gray-800 hover:bg-gray-50"}`}
                  >
                    {item.text}
                  </a>

                  {(item.links ?? []).length > 0 && (
                    <ul class="ml-2 mt-1 space-y-1 border-l border-gray-200 pl-3">
                      {(item.links ?? []).map((sub: { text: string; href: string }) => (
                        <li>
                          <a
                            href={sub.href ?? "#"}
                            class={`group/sub block rounded-xl px-3 py-1.5 text-sm no-underline transition ${
                              isActive(sub.href)
                                ? "bg-gray-100 text-[#1f2d3d]"
                                : "text-[#1f2d3d] hover:translate-x-[2px] hover:bg-gray-50"
                            }`}
                          >
                            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-gray-300 align-middle transition group-hover/sub:bg-[#f56b2a]" />
                            {sub.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }

            {
              headerData.actions?.[0] && (
                <li class="mt-2">
                  <a
                    href={headerData.actions[0].href}
                    class="block w-full rounded-lg bg-[#f56b2a] px-4 py-2 text-center text-sm font-semibold text-white"
                  >
                    {headerData.actions[0].text}
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

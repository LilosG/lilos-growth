---
const nav = [
  { label: 'All Services', href: '/services' },
  { label: 'Google Business Profile Optimization', href: '/services/google-business-profile-optimization' },
  { label: 'Local SEO', href: '/services/local-seo' }, // ← change to /services/local-seo-content if that’s your slug
  { label: 'Website Design & Development', href: '/services/web-design' },
];
---

<header class="sticky top-0 z-[60] bg-white/80 backdrop-blur border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-8 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {
        nav.map((n) => (
          <a href={n.href} class="text-sm font-semibold text-heading hover:text-primary transition-colors">
            {n.label}
          </a>
        ))
      }
      <a
        href="#contact"
        class="px-4 py-2 rounded-xl bg-primary text-white font-semibold hover:bg-primaryHover transition"
        >Schedule a Call</a
      >
    </nav>

    <!-- Mobile button -->
    <button
      id="menuBtn"
      class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white/70 shadow border border-gray-200"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileDrawer"
      type="button"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-heading">
        <path stroke-width="2.2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile drawer (outside page scale) -->
  <div id="mobileDrawer" data-open="false" class="fixed inset-0 z-[100] pointer-events-none">
    <!-- Backdrop -->
    <div
      id="drawerBackdrop"
      class="absolute inset-0 opacity-0 transition-opacity duration-300 bg-secondary/80 backdrop-blur-sm"
    >
    </div>

    <!-- Panel -->
    <aside
      id="drawerPanel"
      class="absolute right-0 top-0 h-full w-[86%] max-w-[420px] translate-x-full transition-transform duration-300
             bg-[#253242] text-white shadow-2xl"
    >
      <div class="p-5 flex items-center justify-between border-b border-white/10">
        <span class="text-base font-semibold">Menu</span>
        <button
          id="closeBtn"
          class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white/10"
          aria-label="Close menu"
          type="button"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-width="2.2" stroke-linecap="round" d="M6 6l12 12M18 6l-12 12"></path>
          </svg>
        </button>
      </div>

      <nav class="px-5 py-4 space-y-4">
        {
          nav.map((n) => (
            <a href={n.href} class="block text-lg font-semibold text-white/90 hover:text-white">
              {n.label}
            </a>
          ))
        }
        <a
          href="#contact"
          class="mt-2 inline-flex items-center justify-center w-full px-5 py-3 rounded-xl bg-primary font-semibold hover:bg-primaryHover"
        >
          Schedule a Call
        </a>
      </nav>
    </aside>
  </div>

  <script is:inline>
    (() => {
      const btn = document.getElementById('menuBtn');
      const drawer = document.getElementById('mobileDrawer');
      const panel = document.getElementById('drawerPanel');
      const backdrop = document.getElementById('drawerBackdrop');
      const closeBtn = document.getElementById('closeBtn');
      if (!btn || !drawer || !panel || !backdrop || !closeBtn) return;

      let open = false;

      const setOpen = (v) => {
        open = v;
        drawer.dataset.open = String(v);
        btn.setAttribute('aria-expanded', String(v));
        // visuals
        panel.style.transform = v ? 'translateX(0)' : 'translateX(100%)';
        backdrop.style.opacity = v ? '1' : '0';
        drawer.style.pointerEvents = v ? 'auto' : 'none';
        // lock body scroll
        document.documentElement.classList.toggle('overflow-hidden', v);
        document.body.classList.toggle('overflow-hidden', v);
      };

      const onKey = (e) => {
        if (e.key === 'Escape' && open) setOpen(false);
      };

      btn.addEventListener('click', () => setOpen(true));
      closeBtn.addEventListener('click', () => setOpen(false));
      backdrop.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', onKey, { passive: true });

      // Close on route change (Astro view transitions)
      document.addEventListener('astro:after-swap', () => setOpen(false));
    })();
  </script>
</header>

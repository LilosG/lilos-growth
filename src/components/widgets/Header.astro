---
import { headerData } from "~/navigation";

const { url } = Astro;
const pathname = url.pathname;

const navItems = headerData.links as ReadonlyArray<{
  text: string;
  href: string;
  links?: ReadonlyArray<{ text: string; href: string }>;
}>;

function isActive(href: string) {
  const norm = (s: string) => (s.endsWith("/") && s.length > 1 ? s.slice(0, -1) : s);
  return norm(pathname) === norm(href);
}
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between md:h-20">
      <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Lilos Growth Home">
        <img
          src="/logo-lcp-320.webp"
          alt="Lilos Growth"
          class="logo--halo h-12 w-auto md:h-14 lg:h-16"
          width="48"
          height="48"
        />
      </a>

      <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="Main navigation">
        {
          navItems.map((item, index) => (
            <div class="relative" data-dropdown={item.links ? "true" : undefined}>
              {item.links ? (
                <>
                  <a
                    href={item.href}
                    class:list={[
                      "nav-link inline-flex items-center gap-1 rounded-lg px-3 py-2 text-[15px] font-semibold leading-6 tracking-tight no-underline transition-colors",
                      isActive(item.href)
                        ? "bg-gray-100 text-heading"
                        : "text-gray-700 hover:bg-gray-50 hover:text-heading",
                    ]}
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls={`dropdown-${index}`}
                  >
                    {item.text}
                    <svg
                      class="dropdown-chevron h-4 w-4 text-gray-400 transition-transform duration-200"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </a>

                  <div
                    id={`dropdown-${index}`}
                    class="dropdown-panel absolute left-0 top-full z-50 hidden pt-2"
                    role="menu"
                  >
                    <div class="relative w-72 rounded-2xl border border-gray-200 bg-white p-2 shadow-xl ring-1 ring-black/5">
                      <div
                        class="absolute inset-x-2 top-2 h-1 rounded-t-xl bg-primary"
                        aria-hidden="true"
                      />
                      <ul class="mt-2 space-y-1">
                        {(item.links ?? []).map((sub) => (
                          <li role="none">
                            <a
                              href={sub.href ?? "#"}
                              role="menuitem"
                              tabindex="-1"
                              class:list={[
                                "flex items-center gap-3 rounded-xl px-3 py-2 text-sm no-underline transition-colors",
                                isActive(sub.href)
                                  ? "bg-gray-100 text-heading"
                                  : "text-gray-700 hover:bg-gray-50 hover:text-heading",
                              ]}
                            >
                              <span class="h-1 w-1 rounded-full bg-gray-300" aria-hidden="true" />
                              <span class="font-medium">{sub.text}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={[
                    "nav-link rounded-lg px-3 py-2 text-[15px] font-semibold leading-6 tracking-tight no-underline transition-colors",
                    isActive(item.href)
                      ? "bg-gray-100 text-heading"
                      : "text-gray-700 hover:bg-gray-50 hover:text-heading",
                  ]}
                >
                  {item.text}
                </a>
              )}
            </div>
          ))
        }

        {
          headerData.actions?.[0] && (
            <a
              href={headerData.actions[0].href}
              class="ml-4 inline-flex items-center rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-hover"
            >
              {headerData.actions[0].text}
            </a>
          )
        }
      </nav>

      <button
        type="button"
        class="mobile-menu-btn ml-auto inline-flex items-center justify-center rounded-lg p-2 text-gray-700 hover:bg-gray-100 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg
          class="menu-icon h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          class="close-icon hidden h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-gray-200 bg-white lg:hidden">
    <div class="mx-auto max-w-7xl px-4 py-4">
      <ul class="space-y-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block rounded-xl px-4 py-3 text-base font-semibold no-underline",
                  isActive(item.href)
                    ? "bg-gray-100 text-heading"
                    : "text-gray-700 hover:bg-gray-50",
                ]}
              >
                {item.text}
              </a>
              {(item.links ?? []).length > 0 && (
                <ul class="ml-4 mt-1 space-y-1 border-l-2 border-gray-100 pl-4">
                  {(item.links ?? []).map((sub) => (
                    <li>
                      <a
                        href={sub.href ?? "#"}
                        class:list={[
                          "block rounded-lg px-3 py-2 text-sm no-underline",
                          isActive(sub.href)
                            ? "bg-gray-100 text-heading"
                            : "text-gray-600 hover:bg-gray-50",
                        ]}
                      >
                        {sub.text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        {
          headerData.actions?.[0] && (
            <li class="pt-4">
              <a
                href={headerData.actions[0].href}
                class="block w-full rounded-full bg-primary px-4 py-3 text-center font-semibold text-white hover:bg-primary-hover"
              >
                {headerData.actions[0].text}
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  const HOVER_DELAY = 80;
  const LEAVE_DELAY = 120;

  document.querySelectorAll('[data-dropdown="true"]').forEach((container) => {
    const trigger = container.querySelector('a[aria-haspopup="true"]');
    const panel = container.querySelector(".dropdown-panel");
    const chevron = container.querySelector(".dropdown-chevron");
    if (!trigger || !panel) return;

    let openTimer = null;
    let closeTimer = null;

    const open = () => {
      if (closeTimer) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      openTimer = setTimeout(() => {
        panel.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
        if (chevron) chevron.style.transform = "rotate(180deg)";
      }, HOVER_DELAY);
    };

    const close = () => {
      if (openTimer) {
        clearTimeout(openTimer);
        openTimer = null;
      }
      closeTimer = setTimeout(() => {
        panel.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        if (chevron) chevron.style.transform = "";
      }, LEAVE_DELAY);
    };

    container.addEventListener("mouseenter", open);
    container.addEventListener("mouseleave", close);

    trigger.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === " ") {
        e.preventDefault();
        panel.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
        const first = panel.querySelector('a[role="menuitem"]');
        if (first) first.focus();
      }
      if (e.key === "Escape") {
        panel.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
      }
    });

    panel.addEventListener("keydown", (e) => {
      const items = Array.from(panel.querySelectorAll('a[role="menuitem"]'));
      const idx = items.indexOf(document.activeElement);
      if (e.key === "ArrowDown") {
        e.preventDefault();
        const next = items[idx + 1] || items[0];
        if (next) next.focus();
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        const prev = items[idx - 1] || items[items.length - 1];
        if (prev) prev.focus();
      }
      if (e.key === "Escape") {
        panel.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      }
    });
  });

  const mobileBtn = document.querySelector(".mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.querySelector(".menu-icon");
  const closeIcon = document.querySelector(".close-icon");

  if (mobileBtn) {
    mobileBtn.addEventListener("click", () => {
      const isOpen = mobileBtn.getAttribute("aria-expanded") === "true";
      mobileBtn.setAttribute("aria-expanded", String(!isOpen));
      if (mobileMenu) mobileMenu.classList.toggle("hidden");
      if (menuIcon) menuIcon.classList.toggle("hidden");
      if (closeIcon) closeIcon.classList.toggle("hidden");
    });
  }
</script>

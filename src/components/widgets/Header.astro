---
import { headerData } from '~/navigation';

const { url } = Astro;
const pathname = url.pathname;

const navItems = headerData.links as ReadonlyArray<{
  text: string;
  href: string;
  links?: ReadonlyArray<{ text: string; href: string }>;
}>;

function isActive(href: string) {
  const norm = (s: string) => (s.endsWith('/') && s.length > 1 ? s.slice(0, -1) : s);
  return norm(pathname) === norm(href);
}
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 pb-px">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 md:h-20 items-center justify-between">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="Lilos Growth">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-12 md:h-14 lg:h-16 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-2 ml-6">
        {
          navItems.map((item) => (
            <div class="relative group">
              {item.links ? (
                <div>
                  <a
                    href={item.href}
                    class={`px-3 py-2 rounded-md text-[15px] leading-6 font-semibold tracking-tight no-underline transition
                           ${isActive(item.href) ? 'text-[#1f2d3d]' : 'text-gray-700 hover:text-[#1f2d3d] hover:bg-gray-50'}`}
                  >
                    {item.text}
                  </a>

                  <div
                    class="absolute left-0 mt-2 w-72 rounded-2xl border border-gray-200 shadow-xl ring-1 ring-black/5
                         bg-white/95 backdrop-blur supports-backdrop:bg-white/90 p-2 z-50
                         hidden group-hover:block before:absolute before:inset-x-0 before:top-0 before:h-1 before:rounded-t-2xl before:bg-[#f56b2a]"
                  >
                    <ul class="py-1">
                      {(item.links ?? []).map((sub: { text: string; href: string }) => (
                        <li class="first:pt-0">
                          <a
                            href={sub.href ?? '#'}
                            class={`group/sub flex items-center gap-3 rounded-xl px-3 py-2 text-[14px] no-underline transition
                                  ${
                                    isActive(sub.href)
                                      ? 'bg-gray-50 text-[#1f2d3d] shadow-sm'
                                      : 'text-[#1f2d3d] hover:bg-gray-50 hover:shadow-sm hover:translate-x-[2px]'
                                  }`}
                          >
                            <span class="h-1.5 w-1.5 rounded-full bg-gray-300 group-hover/sub:bg-[#f56b2a] transition" />
                            <span class="font-medium">{sub.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class={`px-3 py-2 rounded-md text-[15px] leading-6 font-semibold tracking-tight no-underline transition
                         ${isActive(item.href) ? 'text-[#1f2d3d]' : 'text-gray-700 hover:text-[#1f2d3d] hover:bg-gray-50'}`}
                >
                  {item.text}
                </a>
              )}
            </div>
          ))
        }

        {
          headerData.actions?.[0] && (
            <a
              href={headerData.actions[0].href}
              class="ml-3 inline-flex items-center rounded-lg bg-[#f56b2a] px-4 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90 transition"
            >
              {headerData.actions[0].text}
            </a>
          )
        }
      </nav>

      <details class="lg:hidden ml-auto">
        <summary
          class="inline-flex items-center justify-center rounded-md p-2 text-gray-700 hover:bg-gray-100 hover:text-gray-900"
          aria-label="Open Menu"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>

        <nav class="mt-2 rounded-2xl border border-gray-200 bg-white p-2 shadow-xl ring-1 ring-black/5">
          <ul class="flex flex-col">
            {
              navItems.map((item) => (
                <li class="w-full">
                  <a
                    href={item.href}
                    class={`block w-full rounded-xl px-3 py-2 text-sm no-underline
                           ${isActive(item.href) ? 'bg-gray-100 text-[#1f2d3d]' : 'text-gray-800 hover:bg-gray-50'}`}
                  >
                    {item.text}
                  </a>

                  {(item.links ?? []).length > 0 && (
                    <ul class="mt-1 ml-2 space-y-1 border-l border-gray-200 pl-3">
                      {(item.links ?? []).map((sub: { text: string; href: string }) => (
                        <li>
                          <a
                            href={sub.href ?? '#'}
                            class={`group/sub block rounded-xl px-3 py-1.5 text-sm no-underline transition
                                   ${
                                     isActive(sub.href)
                                       ? 'bg-gray-100 text-[#1f2d3d]'
                                       : 'text-[#1f2d3d] hover:bg-gray-50 hover:translate-x-[2px]'
                                   }`}
                          >
                            <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full align-middle bg-gray-300 group-hover/sub:bg-[#f56b2a] transition" />
                            {sub.text}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }

            {
              headerData.actions?.[0] && (
                <li class="mt-2">
                  <a
                    href={headerData.actions[0].href}
                    class="block w-full rounded-lg bg-[#f56b2a] px-4 py-2 text-center text-sm font-semibold text-white"
                  >
                    {headerData.actions[0].text}
                  </a>
                </li>
              )
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

---
const navLinks = [
  { text: 'Home', href: '/' },
  { text: 'Services', href: '/services' },
  { text: 'Packages', href: '/packages' },
  { text: 'About', href: '/about' },
  { text: 'Contact', href: '/contact' }, // Remove if you don't want it
];
---

<header class="sticky top-0 z-50 bg-white/95 shadow-md border-b border-gray-100 transition-all duration-200">
  <div class="relative">
    <!-- Orange accent bar (brand underline) -->
    <div class="absolute bottom-0 left-0 w-full h-1 bg-[#f56b2a]"></div>
    <div class="max-w-7xl mx-auto flex items-center justify-between px-4 py-2 md:py-3 relative z-10">
      <!-- Logo Left -->
      <a href="/" class="flex items-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="w-24 md:w-28" />
      </a>
      <!-- Navigation Center/Right -->
      <nav class="hidden md:flex space-x-10">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-heading font-medium text-lg hover:text-primary transition-colors duration-150"
          >
            {link.text}
          </a>
        ))}
      </nav>
      <!-- CTA Button Right -->
      <div class="hidden md:flex items-center space-x-2">
        <a
          href="#book"
          class="bg-primary text-white px-7 py-3 rounded-full font-semibold text-base shadow hover:bg-secondary transition-all duration-150 flex items-center"
        >
          Book a Call
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"/></svg>
        </a>
      </div>
      <!-- Mobile Menu Placeholder -->
      <div class="md:hidden">
        {/* Mobile nav/menu toggle goes here */}
      </div>
    </div>
  </div>
</header>

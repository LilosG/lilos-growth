---
import { headerData } from '~/navigation';

/** Types matching your navigation structure */
type SubLink = { text: string; href: string; description?: string };
type FlatLink = { text: string; href: string; links?: never };
type GroupLink = { text: string; href?: never; links: readonly SubLink[] };
type NavItem = FlatLink | GroupLink;
type Action = { text: string; href: string };

const topLinks = (headerData.links ?? []) as readonly NavItem[];
const actions = (headerData.actions ?? []) as readonly Action[];

/** Type guard */
const hasChildren = (i: NavItem): i is GroupLink => 'links' in i && Array.isArray(i.links);
---

<!-- Light header bar with primary underline; centered nav; CTA on right -->
<header class="relative z-[80] w-full bg-white">
  <div class="absolute inset-x-0 bottom-0 h-[2px] bg-primary/90 pointer-events-none"></div>

  <div class="mx-auto w-full max-w-7xl px-4">
    <div class="flex h-16 items-center gap-4">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img
          src="/Lilos_Growth_Logo_Corrected.svg"
          alt="Lilos Growth"
          class="h-10 w-auto md:h-12"
          loading="eager"
          decoding="async"
        />
        <span class="sr-only">Lilos Growth</span>
      </a>

      <!-- Desktop: centered nav -->
      <nav class="hidden md:flex flex-1 items-center justify-center gap-8">
        {
          topLinks.map((item) =>
            hasChildren(item) ? (
              <div class="relative group">
                <button
                  class="inline-flex items-center gap-1.5 text-[15px] font-medium text-[#253242] hover:text-black transition"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {item.text}
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" stroke-width="2" />
                  </svg>
                </button>
                <div
                  class="invisible absolute left-0 mt-3 w-[320px] rounded-2xl border border-gray-200 bg-white shadow-xl opacity-0 transition
                       group-hover:visible group-hover:opacity-100"
                >
                  <div class="p-2">
                    {item.links.map((sub) => (
                      <a href={sub.href} class="block rounded-xl px-4 py-3 hover:bg-gray-50">
                        <div class="text-sm font-semibold text-[#253242]">{sub.text}</div>
                        {sub.description ? <div class="text-xs text-gray-500">{sub.description}</div> : null}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class="text-[15px] font-medium text-[#253242] hover:text-black transition">
                {item.text}
              </a>
            )
          )
        }
      </nav>

      <!-- Desktop: CTA on the far right -->
      <div class="hidden md:flex shrink-0">
        {
          actions.map((a) => (
            <a
              href={a.href}
              class="inline-flex items-center rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:shadow transition"
            >
              {a.text}
            </a>
          ))
        }
      </div>

      <!-- Mobile: hamburger (right aligned) -->
      <div class="md:hidden ml-auto">
        <input id="nav-open" type="checkbox" class="peer hidden" />
        <label
          for="nav-open"
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-white shadow-sm"
          aria-label="Open menu"
        >
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" stroke-width="2"></path>
          </svg>
        </label>

        <!-- Solid overlay -->
        <div class="fixed inset-0 z-[100] hidden bg-[#253242] peer-checked:block" aria-hidden="true"></div>

        <!-- Mobile panel -->
        <nav
          class="fixed inset-0 z-[110] hidden flex-col gap-6 p-6 text-white peer-checked:flex"
          role="dialog"
          aria-label="Mobile Navigation"
        >
          <div class="flex items-center justify-between">
            <a href="/" class="flex items-center gap-3">
              <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth" class="h-9 w-auto" />
              <span class="sr-only">Lilos Growth</span>
            </a>

            <label
              for="nav-open"
              class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/20 bg-white/10"
              aria-label="Close menu"
            >
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
                <path d="M6 6l12 12M6 18L18 6" stroke-width="2"></path>
              </svg>
            </label>
          </div>

          <div class="mt-4 grid gap-4">
            {
              topLinks.map((item) =>
                hasChildren(item) ? (
                  <div class="rounded-2xl border border-white/15 bg-white/5">
                    <div class="px-4 pb-2 pt-4 text-xs font-semibold uppercase tracking-wide text-white/70">
                      {item.text}
                    </div>
                    <div class="p-2">
                      {item.links.map((sub) => (
                        <a href={sub.href} class="block rounded-xl px-4 py-3 hover:bg-white/10">
                          {sub.text}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a
                    href={item.href}
                    class="block rounded-2xl border border-white/15 bg-white/5 px-4 py-3 hover:bg-white/10"
                  >
                    {item.text}
                  </a>
                )
              )
            }
          </div>

          <div class="mt-auto grid gap-3">
            {
              actions.map((a) => (
                <a
                  href={a.href}
                  class="inline-flex items-center justify-center rounded-2xl bg-white px-4 py-3 font-semibold text-[#253242] shadow-sm"
                >
                  {a.text}
                </a>
              ))
            }
            <label for="nav-open" class="text-center text-sm text-white/70">Close</label>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

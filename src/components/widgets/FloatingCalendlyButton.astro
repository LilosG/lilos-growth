PATH: src/components/widgets/FloatingCalendlyButton.astro

/* @ts-nocheck */ /* No front-matter vars; reference Astro.props directly in the template */
<button
  type="button"
  class={`fixed ${Astro.props.showOnMobile === false ? 'hidden md:flex' : ''} bottom-4 md:bottom-6 ${Astro.props.position === 'left' ? 'left-4 md:left-6' : 'right-4 md:right-6'} z-50 shadow-lg rounded-full px-5 py-3 text-white bg-[#f56b2a] hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]`}
  data-evt="cta_floating_calendly"
  data-url={Astro.props.href ?? '/contact'}
  aria-label={Astro.props.label ?? 'Book a Call'}
>
  {Astro.props.label ?? 'Book a Call'}
</button>

<script is:inline>
  (() => {
    const btn = document.currentScript?.previousElementSibling;
    if (!btn) return;

    const openCalendly = (url) => {
      try {
        if (window.Calendly && typeof window.Calendly.initPopupWidget === 'function') {
          window.Calendly.initPopupWidget({ url });
          return true;
        }
      } catch {}
      return false;
    };

    const ensureCalendlyLoaded = () => {
      try {
        if (window.__calendlyLoaded) return Promise.resolve(true);
        const existing =
          document.querySelector('script[src*="assets.calendly.com/assets/external/widget.js"]') ||
          document.querySelector('script[data-calendly-widget]');
        if (existing) {
          window.__calendlyLoaded = true;
          return Promise.resolve(true);
        }
        return new Promise((resolve) => {
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.async = true;
          s.setAttribute('data-calendly-widget', 'true');
          s.onload = () => {
            window.__calendlyLoaded = true;
            resolve(true);
          };
          document.head.appendChild(s);
        });
      } catch {}
      return Promise.resolve(false);
    };

    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url') || '/contact';
      if (openCalendly(url)) return;
      await ensureCalendlyLoaded();
      if (!openCalendly(url)) window.open(url, '_blank', 'noopener,noreferrer');
    });
  })();
</script>

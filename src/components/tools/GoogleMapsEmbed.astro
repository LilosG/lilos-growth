---
/**
 * Google Maps Embed Generator
 * Creates embed code for Google Maps
 * Uses site design system: .btn, .btn-primary, .btn-secondary
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">Google Maps Embed</h2>
  <p class="text-body/80 mb-5 text-sm">
    Generate an embed code to add an interactive Google Map to your website.
  </p>

  <form id="maps-form" class="grid gap-4">
    <div>
      <label class="mb-1 block text-xs font-semibold text-muted">
        Address or Place Name <span class="text-red-500">*</span>
      </label>
      <input
        id="maps-address"
        type="text"
        required
        placeholder="123 Main St, Denver, CO 80202"
        class="focus:ring-primary/40 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
      <p class="mt-1 text-xs text-muted">Enter your business address or search for a landmark</p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="mb-1 block text-xs font-semibold text-muted">Width</label>
        <input
          id="maps-width"
          type="text"
          value="100%"
          placeholder="600 or 100%"
          class="focus:ring-primary/40 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold text-muted">Height</label>
        <input
          id="maps-height"
          type="text"
          value="450"
          placeholder="450"
          class="focus:ring-primary/40 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
    </div>

    <button type="submit" class="btn btn-primary w-full"> Generate Embed Code </button>
  </form>

  <div id="maps-result" class="mt-5 hidden">
    <div class="mb-3 flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wide text-muted">Embed Code</span>
      <button id="maps-copy" type="button" class="btn btn-sm btn-secondary">
        Copy to Clipboard
      </button>
    </div>
    <pre
      id="maps-output"
      class="overflow-auto whitespace-pre-wrap rounded-xl border border-gray-200 bg-gray-50 p-4 text-sm text-body">
    </pre>

    <div class="mt-4">
      <span class="mb-2 block text-xs font-semibold uppercase tracking-wide text-muted"
        >Preview</span
      >
      <div id="maps-preview" class="overflow-hidden rounded-xl border border-gray-200"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const form = document.getElementById("maps-form");
      const resultEl = document.getElementById("maps-result");
      const outputEl = document.getElementById("maps-output");
      const previewEl = document.getElementById("maps-preview");
      const copyBtn = document.getElementById("maps-copy");

      form.addEventListener("submit", function (e) {
        e.preventDefault();

        const address = document.getElementById("maps-address").value.trim();
        const width = document.getElementById("maps-width").value.trim() || "100%";
        const height = document.getElementById("maps-height").value.trim() || "450";

        if (!address) return;

        const encodedAddress = encodeURIComponent(address);
        const embedUrl = `https://www.google.com/maps?q=${encodedAddress}&output=embed`;

        const iframe = `<iframe
  src="${embedUrl}"
  width="${width}"
  height="${height}"
  style="border:0;"
  allowfullscreen=""
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"
  title="Google Maps - ${address}"
></iframe>`;

        outputEl.textContent = iframe;
        previewEl.innerHTML = `<iframe
          src="${embedUrl}"
          width="100%"
          height="300"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>`;
        resultEl.classList.remove("hidden");
      });

      copyBtn.addEventListener("click", function () {
        navigator.clipboard.writeText(outputEl.textContent).then(function () {
          const original = copyBtn.textContent;
          copyBtn.textContent = "Copied!";
          setTimeout(function () {
            copyBtn.textContent = original;
          }, 2000);
        });
      });
    })();
  </script>
</div>

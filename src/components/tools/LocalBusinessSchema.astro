---
/**
 * Local Business Schema Generator - Headless
 */
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
---

<div class="flex flex-1 flex-col">
  <form id="schema-form" class="flex flex-1 flex-col gap-4">
    <Input id="schema-name" label="Business Name" required placeholder="Acme Plumbing" />
    <div class="grid gap-3 sm:grid-cols-2">
      <Input
        id="schema-phone"
        label="Phone"
        type="tel"
        required
        placeholder="+1-555-123-4567"
      />
      <Input
        id="schema-url"
        label="Website URL"
        type="url"
        required
        placeholder="https://example.com"
      />
    </div>
    <Input id="schema-street" label="Street Address" required placeholder="123 Main Street" />
    <div class="grid gap-3 sm:grid-cols-3">
      <Input id="schema-city" label="City" required placeholder="Denver" />
      <Input id="schema-state" label="State" required placeholder="CO" />
      <Input id="schema-zip" label="ZIP" required placeholder="80202" />
    </div>
    <div class="space-y-1.5">
      <label for="schema-type" class="block text-sm font-medium text-heading">Business Type</label>
      <select id="schema-type" class="input">
        <option value="LocalBusiness">Local Business</option>
        <option value="Plumber">Plumber</option>
        <option value="Electrician">Electrician</option>
        <option value="HVACBusiness">HVAC Business</option>
        <option value="RoofingContractor">Roofing Contractor</option>
        <option value="PestControlCompany">Pest Control</option>
        <option value="LandscapingBusiness">Landscaping</option>
        <option value="CleaningCompany">Cleaning Company</option>
      </select>
    </div>
    <div class="space-y-1.5">
      <label for="schema-desc" class="block text-sm font-medium text-heading">Description</label>
      <textarea
        id="schema-desc"
        rows="2"
        placeholder="Brief description of your business..."
        class="input"></textarea>
    </div>
    <Button type="submit" variant="primary" size="md" fullWidth class="mt-auto"
      >Generate Schema</Button
    >
  </form>
  <div id="schema-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-muted">JSON-LD Output</span>
      <button
        id="schema-copy"
        type="button"
        class="text-xs font-semibold text-primary hover:underline">Copy</button
      >
    </div>
    <pre
      id="schema-output"
      class="max-h-64 overflow-auto rounded-lg bg-gray-900 p-4 text-xs text-green-400">
    </pre>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("schema-form");
    const resultEl = document.getElementById("schema-result");
    const outputEl = document.getElementById("schema-output");
    const copyBtn = document.getElementById("schema-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const schema = {
        "@context": "https://schema.org",
        "@type": document.getElementById("schema-type").value,
        name: document.getElementById("schema-name").value.trim(),
        telephone: document.getElementById("schema-phone").value.trim(),
        url: document.getElementById("schema-url").value.trim(),
        address: {
          "@type": "PostalAddress",
          streetAddress: document.getElementById("schema-street").value.trim(),
          addressLocality: document.getElementById("schema-city").value.trim(),
          addressRegion: document.getElementById("schema-state").value.trim(),
          postalCode: document.getElementById("schema-zip").value.trim(),
          addressCountry: "US",
        },
      };
      const desc = document.getElementById("schema-desc").value.trim();
      if (desc) schema.description = desc;
      outputEl.textContent = JSON.stringify(schema, null, 2);
      resultEl.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", function () {
      navigator.clipboard.writeText(outputEl.textContent).then(function () {
        copyBtn.textContent = "Copied!";
        setTimeout(function () {
          copyBtn.textContent = "Copy";
        }, 2000);
      });
    });
  })();
</script>

---
// LocalSEOROICalculator.astro
// Self-contained — no props. Uses the site's real Tailwind design tokens
// (same classes as the homepage) instead of hand-rolled CSS, so it
// actually looks like the rest of the site instead of a bolted-on widget.
// Does NOT render its own <h1> — the parent page owns the page heading.
---

<div class="mx-auto max-w-5xl px-6">
  <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2">
    <!-- INPUTS -->
    <div class="rounded-2xl border border-border-subtle bg-white p-8 shadow-sm">
      <h2 class="mb-6 font-heading text-lg font-bold text-heading">Your Business Details</h2>
      <div class="space-y-5">
        <div>
          <label
            class="mb-1.5 block text-xs font-bold uppercase tracking-widest text-muted"
            for="avg-job">Average Job Value</label
          >
          <div class="relative">
            <span
              class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 font-heading text-base font-bold text-muted"
              >$</span
            >
            <input
              id="avg-job"
              type="number"
              min="0"
              inputmode="numeric"
              placeholder="500"
              class="focus:ring-primary/20 w-full rounded-xl border border-border-base bg-white py-3.5 pl-8 pr-4 font-heading text-lg font-bold text-heading transition placeholder:font-normal placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
            />
          </div>
        </div>
        <div>
          <label
            class="mb-1.5 block text-xs font-bold uppercase tracking-widest text-muted"
            for="close-rate">Lead Close Rate</label
          >
          <div class="relative">
            <input
              id="close-rate"
              type="number"
              min="0"
              max="100"
              inputmode="numeric"
              placeholder="40"
              class="focus:ring-primary/20 w-full rounded-xl border border-border-base bg-white px-4 py-3.5 pr-8 font-heading text-lg font-bold text-heading transition placeholder:font-normal placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
            />
            <span
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 font-heading text-base font-bold text-muted"
              >%</span
            >
          </div>
        </div>
        <div>
          <label class="mb-1.5 block text-xs font-bold uppercase tracking-widest text-muted"
            for="monthly-leads">Estimated Monthly Leads from Top 3</label
          >
          <input
            id="monthly-leads"
            type="number"
            min="0"
            inputmode="numeric"
            placeholder="15"
            class="focus:ring-primary/20 w-full rounded-xl border border-border-base bg-white px-4 py-3.5 font-heading text-lg font-bold text-heading transition placeholder:font-normal placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
          />
          <p class="mt-1.5 text-xs text-muted">
            Businesses ranking #1–3 in Maps typically see 15–40 leads/mo.
          </p>
        </div>
        <div>
          <label class="mb-2 block text-xs font-bold uppercase tracking-widest text-muted"
            >Monthly Plan</label
          >
          <div class="grid grid-cols-3 gap-2">
            {
              [
                { label: "Local", val: 599 },
                { label: "Growth", val: 999 },
                { label: "Authority", val: 1499 },
              ].map((p, i) => (
                <button
                  type="button"
                  class={`roi-plan-btn rounded-xl border py-3 text-xs font-bold transition ${i === 1 ? "border-primary bg-primary text-white shadow" : "border-border-base bg-white text-muted hover:border-primary hover:text-primary"}`}
                  data-val={p.val}
                >
                  {p.label}
                  <br />
                  <span class="font-normal opacity-75">${p.val}/mo</span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <div class="flex flex-col gap-4">
      <div class="overflow-hidden rounded-2xl border border-border-subtle bg-white shadow-sm">
        <div class="border-b border-border-subtle bg-background-subtle px-6 py-4">
          <p class="text-xs font-bold uppercase tracking-widest text-muted">Your Projected Results</p>
        </div>
        <div class="p-6">
          <div class="mb-6 text-center">
            <div class="font-heading text-7xl font-extrabold leading-none text-primary" id="roi-pct">
              200%
            </div>
            <div class="mt-2 text-sm font-semibold text-muted">Return on Investment</div>
          </div>
          <div class="mb-4 grid grid-cols-2 gap-3">
            <div class="rounded-xl bg-background-subtle p-4">
              <div class="mb-1 text-xs text-muted">New Customers/Mo</div>
              <div class="font-heading text-2xl font-extrabold text-heading" id="roi-leads">6</div>
            </div>
            <div class="rounded-xl bg-background-subtle p-4">
              <div class="mb-1 text-xs text-muted">Monthly Revenue</div>
              <div class="font-heading text-2xl font-extrabold text-primary" id="roi-revenue">
                $3,000
              </div>
            </div>
            <div class="rounded-xl bg-background-subtle p-4">
              <div class="mb-1 text-xs text-muted">Net Monthly Return</div>
              <div class="font-heading text-2xl font-extrabold text-heading" id="roi-net">$2,001</div>
            </div>
            <div class="rounded-xl bg-background-subtle p-4">
              <div class="mb-1 text-xs text-muted">Payback Period</div>
              <div class="font-heading text-2xl font-extrabold text-heading" id="roi-payback">
                1 mo
              </div>
            </div>
          </div>
        </div>
        <div class="bg-secondary px-6 py-5">
          <span class="text-sm font-bold text-white">Additional Revenue — Year 1</span>
          <div class="font-heading text-4xl font-extrabold text-primary" id="roi-year1">$36,000</div>
          <div class="mt-1 text-xs text-white/50" id="roi-investment">
            Investment: $999/mo · No contracts · Cancel anytime
          </div>
        </div>
      </div>
      <a
        href="/contact#book"
        data-evt="cta_roi_calc_results"
        class="block rounded-xl bg-primary px-6 py-4 text-center font-heading text-base font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.35)] transition hover:bg-primary-dark"
      >
        Get Your Free GBP Audit — See Your Real Numbers →
      </a>
    </div>
  </div>

  <!-- 12-MONTH GROWTH CURVE -->
  <div class="mt-6 rounded-2xl border border-border-subtle bg-white p-6 shadow-sm md:p-8">
    <div class="mb-1 flex items-baseline justify-between">
      <h3 class="font-heading text-lg font-bold text-heading">Your 12-Month Growth Curve</h3>
      <span class="text-xs font-semibold text-muted" id="roi-chart-total">$22,320 total Year 1</span>
    </div>
    <p class="mb-5 text-xs text-muted">
      Realistic ramp, not an instant jump — slow the first couple months, real movement by month
      4–6, near target by month 9–12. Matches the timelines on our FAQ, not a flat projection.
    </p>
    <svg
      id="roi-chart"
      viewBox="0 0 600 220"
      class="h-auto w-full overflow-visible"
      role="img"
      aria-label="Projected monthly revenue ramp over 12 months"
    >
      <defs>
        <linearGradient id="roi-chart-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.22" />
          <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- gridlines -->
      <line x1="0" y1="20" x2="600" y2="20" class="stroke-border-subtle" stroke-width="1" />
      <line x1="0" y1="76.7" x2="600" y2="76.7" class="stroke-border-subtle" stroke-width="1" />
      <line x1="0" y1="133.3" x2="600" y2="133.3" class="stroke-border-subtle" stroke-width="1" />
      <line x1="0" y1="180" x2="600" y2="180" class="stroke-border-base" stroke-width="1.5" />

      <path id="roi-chart-area" fill="url(#roi-chart-gradient)" />
      <path
        id="roi-chart-line"
        fill="none"
        stroke="var(--color-primary)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- milestone markers: month 1, 4, 8, 12 -->
      <g id="roi-chart-milestones"></g>

      <!-- x-axis month ticks -->
      <text x="0" y="208" class="fill-muted text-[11px] font-semibold">M1</text>
      <text x="200" y="208" text-anchor="middle" class="fill-muted text-[11px] font-semibold">M4</text>
      <text x="418" y="208" text-anchor="middle" class="fill-muted text-[11px] font-semibold">M8</text>
      <text x="600" y="208" text-anchor="end" class="fill-muted text-[11px] font-semibold">M12</text>
    </svg>
  </div>
</div>

<script>
  (function () {
    let selectedPlan = 999;

    // Realistic ramp toward the target monthly revenue, month 1-12, as a
    // fraction of the target. Slow start, real movement mid-year, plateau
    // near target by month 9-12 — matches the timelines already stated on
    // this site's FAQ (GBP: 2-4 weeks, on-page/content: 60-90 days).
    const RAMP = [0.05, 0.12, 0.22, 0.35, 0.5, 0.65, 0.78, 0.87, 0.93, 0.97, 0.99, 1.0];

    function drawChart(monthlyTarget: number) {
      const values = RAMP.map((f) => monthlyTarget * f);
      const max = Math.max(monthlyTarget, 1);
      const w = 600;
      const baseline = 180;
      const top = 20;
      const points = values.map((v, i) => {
        const x = (i / (values.length - 1)) * w;
        const y = baseline - (v / max) * (baseline - top);
        return { x, y };
      });

      // Smooth the line with quadratic curves through midpoints (Catmull-Rom-ish
      // approximation) instead of straight polyline segments between months.
      function smoothPath(pts: { x: number; y: number }[]) {
        let d = `M ${pts[0].x},${pts[0].y}`;
        for (let i = 1; i < pts.length; i++) {
          const midX = (pts[i - 1].x + pts[i].x) / 2;
          const midY = (pts[i - 1].y + pts[i].y) / 2;
          d += ` Q ${pts[i - 1].x},${pts[i - 1].y} ${midX},${midY}`;
        }
        const last = pts[pts.length - 1];
        d += ` T ${last.x},${last.y}`;
        return d;
      }

      const linePath = smoothPath(points);
      const areaPath = `${linePath} L${w},${baseline} L0,${baseline} Z`;

      const setAttr = (id: string, attr: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.setAttribute(attr, val);
      };

      setAttr("roi-chart-line", "d", linePath);
      setAttr("roi-chart-area", "d", areaPath);

      // Milestone markers at month 1, 4, 8, 12 with value callouts.
      const milestoneIdx = [0, 3, 7, 11];
      const group = document.getElementById("roi-chart-milestones");
      if (group) {
        group.innerHTML = "";
        const ns = "http://www.w3.org/2000/svg";
        milestoneIdx.forEach((idx, i) => {
          const p = points[idx];
          const isLast = i === milestoneIdx.length - 1;

          const dot = document.createElementNS(ns, "circle");
          dot.setAttribute("cx", String(p.x));
          dot.setAttribute("cy", String(p.y));
          dot.setAttribute("r", isLast ? "5" : "4");
          dot.setAttribute("fill", isLast ? "var(--color-primary)" : "white");
          dot.setAttribute("stroke", "var(--color-primary)");
          dot.setAttribute("stroke-width", "2");
          group.appendChild(dot);

          const label = document.createElementNS(ns, "text");
          const labelX = idx === 0 ? p.x : idx === 11 ? p.x : p.x;
          const anchor = idx === 0 ? "start" : idx === 11 ? "end" : "middle";
          label.setAttribute("x", String(labelX));
          label.setAttribute("y", String(Math.max(p.y - 12, 14)));
          label.setAttribute("text-anchor", anchor);
          label.setAttribute("class", isLast ? "fill-primary" : "fill-heading");
          label.setAttribute(
            "style",
            "font-family: var(--font-heading, inherit); font-weight: 700; font-size: 13px;"
          );
          label.textContent = "$" + Math.round(values[idx]).toLocaleString();
          group.appendChild(label);
        });
      }

      return values.reduce((sum, v) => sum + v, 0);
    }

    function calcROI() {
      const job =
        parseFloat((document.getElementById("avg-job") as HTMLInputElement | null)?.value ?? "") ||
        500;
      const close =
        parseFloat(
          (document.getElementById("close-rate") as HTMLInputElement | null)?.value ?? ""
        ) || 40;
      const leads =
        parseFloat(
          (document.getElementById("monthly-leads") as HTMLInputElement | null)?.value ?? ""
        ) || 15;
      const cost = selectedPlan;
      const jobs = Math.round(leads * (close / 100));
      const revenue = jobs * job;
      const net = revenue - cost;
      const roi = cost > 0 ? Math.round((net / cost) * 100) : 0;
      const year1 = Math.round(drawChart(revenue));
      const payback = revenue > 0 ? Math.ceil((cost / revenue) * 10) / 10 : 0;
      const paybackStr = payback <= 1 ? "< 1 mo" : payback.toFixed(1) + " mo";

      const setText = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setText("roi-pct", roi + "%");
      setText("roi-leads", jobs.toString());
      setText("roi-revenue", "$" + revenue.toLocaleString());
      setText("roi-net", (net >= 0 ? "$" : "-$") + Math.abs(net).toLocaleString());
      setText("roi-payback", paybackStr);
      setText("roi-year1", "$" + year1.toLocaleString());
      setText("roi-chart-total", "$" + year1.toLocaleString() + " total Year 1");
      setText(
        "roi-investment",
        "Investment: $" + cost.toLocaleString() + "/mo · No contracts · Cancel anytime"
      );
    }

    function selectPlan(btn: HTMLElement) {
      document.querySelectorAll(".roi-plan-btn").forEach((b) => {
        b.className =
          "roi-plan-btn rounded-xl border py-3 text-xs font-bold transition border-border-base bg-white text-muted hover:border-primary hover:text-primary";
      });
      btn.className =
        "roi-plan-btn rounded-xl border py-3 text-xs font-bold transition border-primary bg-primary text-white shadow";
      selectedPlan = parseInt(btn.dataset.val ?? "999", 10);
      calcROI();
    }

    document.querySelectorAll<HTMLElement>(".roi-plan-btn").forEach((btn) => {
      btn.addEventListener("click", () => selectPlan(btn));
    });
    document.querySelectorAll<HTMLInputElement>("#avg-job, #close-rate, #monthly-leads").forEach(
      (input) => {
        input.addEventListener("input", calcROI);
      }
    );

    document.addEventListener("DOMContentLoaded", calcROI);
    calcROI();
  })();
</script>

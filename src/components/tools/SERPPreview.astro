---
/**
 * SERP Preview - Headless
 */
---

<div class="flex flex-col">
  <form id="serp-form" class="flex flex-col space-y-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-body"
        >Page Title <span class="text-muted">(~60 chars)</span></label
      >
      <input
        id="serp-title"
        type="text"
        maxlength="70"
        placeholder="Best Plumber in Denver | 24/7 Service"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-border-base px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
      <div class="mt-1 text-xs text-muted"><span id="title-count">0</span>/60</div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-body">Page URL</label>
      <input
        id="serp-url"
        type="url"
        placeholder="https://example.com/plumbing"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-border-base px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-body"
        >Meta Description <span class="text-muted">(~155 chars)</span></label
      >
      <textarea
        id="serp-desc"
        rows="2"
        maxlength="170"
        placeholder="Professional plumbing services in Denver..."
        class="focus:ring-primary/40 w-full rounded-lg border border-border-base px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2"
      ></textarea>
      <div class="mt-1 text-xs text-muted"><span id="desc-count">0</span>/155</div>
    </div>
    <div>
      <span class="mb-2 block text-xs font-medium text-muted">Preview</span>
      <div class="rounded-lg border border-border-subtle bg-white p-4">
        <div id="preview-url" class="truncate text-sm text-green-700">example.com</div>
        <div id="preview-title" class="truncate text-lg text-blue-800 hover:underline">
          Your Page Title
        </div>
        <div id="preview-desc" class="line-clamp-2 text-sm text-body">
          Your meta description appears here.
        </div>
      </div>
    </div>
    <button type="button" id="serp-preview-btn" class="btn btn-primary h-11 w-full"
      >Update Preview</button
    >
  </form>
</div>

<script is:inline>
  /* eslint-disable */
  (function () {
    const titleEl = document.getElementById("serp-title");
    const urlEl = document.getElementById("serp-url");
    const descEl = document.getElementById("serp-desc");
    const titleCount = document.getElementById("title-count");
    const descCount = document.getElementById("desc-count");
    const previewTitle = document.getElementById("preview-title");
    const previewUrl = document.getElementById("preview-url");
    const previewDesc = document.getElementById("preview-desc");

    function update() {
      titleCount.textContent = titleEl.value.length;
      descCount.textContent = descEl.value.length;
      titleCount.className = titleEl.value.length > 60 ? "text-red-500" : "";
      descCount.className = descEl.value.length > 155 ? "text-red-500" : "";
      previewTitle.textContent = titleEl.value || "Your Page Title";
      previewDesc.textContent = descEl.value || "Your meta description appears here.";
      if (urlEl.value) {
        try {
          previewUrl.textContent = new URL(urlEl.value).hostname + new URL(urlEl.value).pathname;
        } catch (e) {
          previewUrl.textContent = urlEl.value;
        }
      } else {
        previewUrl.textContent = "example.com";
      }
    }

    titleEl.addEventListener("input", update);
    urlEl.addEventListener("input", update);
    descEl.addEventListener("input", update);
    document.getElementById("serp-preview-btn").addEventListener("click", update);
  })();
</script>

---
/**
 * FAQ Schema Generator - Headless
 */
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
---

<div class="flex flex-1 flex-col">
  <form id="faq-form" class="flex flex-1 flex-col gap-4">
    <div id="faq-pairs" class="space-y-3">
      <div class="faq-pair rounded-lg border border-border-subtle bg-background-subtle p-3">
        <Input id="faq-q-0" label="Question" required placeholder="Question" class="mb-2" />
        <div class="space-y-1.5">
          <label for="faq-a-0" class="block text-sm font-medium text-heading">Answer</label>
          <textarea id="faq-a-0" rows="2" placeholder="Answer" required class="input resize-none"
          ></textarea>
        </div>
      </div>
    </div>
    <button
      type="button"
      id="add-faq"
      class="w-full rounded-lg border-2 border-dashed border-border-base py-2 text-sm font-medium text-muted transition hover:border-primary hover:text-primary"
      >+ Add Question</button
    >
    <Button type="submit" variant="primary" size="md" fullWidth class="mt-auto"
      >Generate Schema</Button
    >
  </form>
  <div id="faq-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-muted">JSON-LD Output</span>
      <button id="faq-copy" type="button" class="text-xs font-semibold text-primary hover:underline"
        >Copy</button
      >
    </div>
    <pre
      id="faq-output"
      class="max-h-64 overflow-auto rounded-lg bg-gray-900 p-4 text-xs text-green-400">
    </pre>
  </div>
</div>

<script is:inline>
  /* eslint-disable */
  (function () {
    var form = document.getElementById("faq-form");
    var pairsContainer = document.getElementById("faq-pairs");
    var addBtn = document.getElementById("add-faq");
    var resultEl = document.getElementById("faq-result");
    var outputEl = document.getElementById("faq-output");
    var copyBtn = document.getElementById("faq-copy");

    if (!form || !pairsContainer || !addBtn || !resultEl || !outputEl || !copyBtn) return;

    var faqPairCount = 1;

    addBtn.addEventListener("click", function () {
      var index = faqPairCount++;
      var div = document.createElement("div");
      div.className =
        "faq-pair rounded-lg border border-border-subtle bg-background-subtle p-3 relative";
      div.innerHTML =
        '<button type="button" class="absolute top-2 right-2 text-muted hover:text-red-500" onclick="this.parentElement.remove()">×</button>' +
        '<div class="space-y-1.5 mb-2"><label for="faq-q-' +
        index +
        '" class="block text-sm font-medium text-heading">Question</label>' +
        '<input id="faq-q-' +
        index +
        '" type="text" placeholder="Question" required class="input" /></div>' +
        '<div class="space-y-1.5"><label for="faq-a-' +
        index +
        '" class="block text-sm font-medium text-heading">Answer</label>' +
        '<textarea id="faq-a-' +
        index +
        '" rows="2" placeholder="Answer" required class="input resize-none"></textarea></div>';
      pairsContainer.appendChild(div);
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var faqs = [];
      var pairs = pairsContainer.querySelectorAll(".faq-pair");
      for (var i = 0; i < pairs.length; i++) {
        var qEl = pairs[i].querySelector("input");
        var aEl = pairs[i].querySelector("textarea");
        if (!qEl || !aEl) continue;
        var q = qEl.value.trim();
        var a = aEl.value.trim();
        if (q && a)
          faqs.push({
            "@type": "Question",
            name: q,
            acceptedAnswer: { "@type": "Answer", text: a },
          });
      }
      if (faqs.length === 0) return;
      outputEl.textContent = JSON.stringify(
        { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs },
        null,
        2
      );
      resultEl.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", function () {
      if (!outputEl.textContent) return;
      navigator.clipboard.writeText(outputEl.textContent).then(function () {
        copyBtn.textContent = "Copied!";
        setTimeout(function () {
          copyBtn.textContent = "Copy";
        }, 2000);
      });
    });
  })();
</script>

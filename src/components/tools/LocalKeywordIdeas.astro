---
/**
 * Local Keyword Ideas - Headless
 */
---

<div class="local-keyword-ideas flex flex-col">
  <form id="keywords-form" class="flex flex-col space-y-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-body">Primary Service *</label>
      <input
        id="keywords-service"
        type="text"
        required
        placeholder="plumbing, HVAC, pest control"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-border-base px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-body">City/Area *</label>
      <input
        id="keywords-city"
        type="text"
        required
        placeholder="Denver, CO"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-border-base px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-body"
        >Nearby Areas <span class="text-muted">(optional)</span></label
      >
      <input
        id="keywords-nearby"
        type="text"
        placeholder="Aurora, Lakewood, Boulder"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-border-base px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <button type="submit" class="btn btn-primary h-11 w-full">Generate Keywords</button>
  </form>
  <div id="keywords-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-muted">Keyword Ideas</span>
      <button
        id="keywords-copy"
        type="button"
        class="text-xs font-semibold text-primary hover:underline">Copy All</button
      >
    </div>
    <div
      id="keywords-output"
      class="max-h-64 overflow-auto rounded-lg border border-border-subtle bg-background-subtle p-3"
    >
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("keywords-form");
    const resultEl = document.getElementById("keywords-result");
    const outputEl = document.getElementById("keywords-output");
    const copyBtn = document.getElementById("keywords-copy");
    const modifiers = [
      "near me",
      "services",
      "company",
      "contractor",
      "cost",
      "prices",
      "affordable",
      "emergency",
      "24 hour",
      "licensed",
      "best",
      "top rated",
    ];

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const service = document.getElementById("keywords-service").value.trim().toLowerCase();
      const city = document.getElementById("keywords-city").value.trim();
      const nearby = document
        .getElementById("keywords-nearby")
        .value.split(",")
        .map((s) => s.trim())
        .filter(Boolean);
      if (!service || !city) return;

      const areas = [city, ...nearby];
      const keywords = [];
      areas.forEach((area) => {
        keywords.push(service + " " + area, service + " in " + area, area + " " + service);
      });
      modifiers.forEach((mod) => {
        keywords.push(service + " " + mod, service + " " + mod + " " + city);
      });
      keywords.push(
        "how much does " + service + " cost in " + city,
        "best " + service + " in " + city
      );

      const unique = [...new Set(keywords)].sort();
      outputEl.innerHTML = unique
        .map((kw) => '<div class="py-1 text-sm text-body">' + kw + "</div>")
        .join("");
      outputEl.dataset.keywords = unique.join("\n");
      resultEl.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", function () {
      navigator.clipboard.writeText(outputEl.dataset.keywords).then(function () {
        copyBtn.textContent = "Copied!";
        setTimeout(function () {
          copyBtn.textContent = "Copy All";
        }, 2000);
      });
    });
  })();
</script>

---
/**
 * UTM Link Builder - Headless
 */
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";
---

<div class="flex flex-1 flex-col">
  <form id="utm-form" class="flex flex-1 flex-col gap-4">
    <Input
      id="utm-url"
      label="Website URL"
      type="url"
      required
      placeholder="https://example.com/services"
    />
    <div class="grid gap-3 sm:grid-cols-2">
      <Input id="utm-source" label="Source" required placeholder="google, facebook" />
      <Input id="utm-medium" label="Medium" required placeholder="cpc, email, social" />
    </div>
    <Input id="utm-campaign" label="Campaign Name" required placeholder="spring_promo" />
    <div class="grid gap-3 sm:grid-cols-2">
      <Input id="utm-term" label="Term (optional)" placeholder="plumber+denver" />
      <Input id="utm-content" label="Content (optional)" placeholder="header_cta" />
    </div>
    <Button type="submit" variant="primary" size="md" fullWidth class="mt-auto"
      >Generate UTM Link</Button
    >
  </form>
  <div id="utm-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <label for="utm-output" class="text-sm font-medium text-heading">Your UTM Link</label>
      <button id="utm-copy" type="button" class="text-xs font-semibold text-primary hover:underline"
        >Copy</button
      >
    </div>
    <input id="utm-output" type="text" readonly class="input" onclick="this.select()" />
  </div>
</div>

<script is:inline>
  /* eslint-disable */
  (function () {
    const form = document.getElementById("utm-form");
    const resultEl = document.getElementById("utm-result");
    const outputEl = document.getElementById("utm-output");
    const copyBtn = document.getElementById("utm-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      try {
        const url = new URL(document.getElementById("utm-url").value.trim());
        url.searchParams.set("utm_source", document.getElementById("utm-source").value.trim());
        url.searchParams.set("utm_medium", document.getElementById("utm-medium").value.trim());
        url.searchParams.set("utm_campaign", document.getElementById("utm-campaign").value.trim());
        const term = document.getElementById("utm-term").value.trim();
        const content = document.getElementById("utm-content").value.trim();
        if (term) url.searchParams.set("utm_term", term);
        if (content) url.searchParams.set("utm_content", content);
        outputEl.value = url.toString();
        resultEl.classList.remove("hidden");
      } catch (e) {
        outputEl.value = "Invalid URL";
        resultEl.classList.remove("hidden");
      }
    });

    copyBtn.addEventListener("click", function () {
      navigator.clipboard.writeText(outputEl.value).then(function () {
        copyBtn.textContent = "Copied!";
        setTimeout(function () {
          copyBtn.textContent = "Copy";
        }, 2000);
      });
    });
  })();
</script>

---
interface Props {
  title: string;
  subtitle?: string;
  price: string;
  period: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  badgeText?: string;
  highlight?: boolean;
  note?: string;
  accent?: string;
}
const {
  title,
  subtitle,
  price,
  period,
  bullets = [],
  ctaText,
  ctaHref,
  badgeText,
  highlight = false,
  note,
  accent = "#f56b2a",
} = Astro.props;
---

<article
  class={[
    "relative flex flex-col rounded-3xl bg-white border shadow-xl p-8 h-full",
    "border-primary/10 shadow-primary",
    highlight ? "ring-2 ring-primary ring-offset-2 ring-offset-white" : "",
  ].join(" ")}
>
  {
    badgeText && (
      <div class="absolute -top-4 left-1/2 -translate-x-1/2">
        <span class="border-primary/30 inline-flex items-center gap-1 rounded-full border bg-primary-50 px-3 py-1 text-[11px] font-semibold text-primary shadow">
          {badgeText}
        </span>
      </div>
    )
  }
  <header class="mb-5">
    <h3 class="text-2xl font-extrabold text-secondary md:text-[26px]">{title}</h3>
    {subtitle && <p class="mt-1 text-[15px] text-slate-600">{subtitle}</p>}
    <div class="mt-4 flex items-baseline gap-1">
      <div class="text-3xl font-extrabold text-primary md:text-[32px]">{price}</div>
      <div class="font-medium text-slate-500">{period}</div>
    </div>
  </header>

  <ul class="mt-4 flex-1 space-y-3 text-[15px] leading-relaxed text-slate-700">
    {
      bullets.map((b) => (
        <li class="flex gap-2">
          <span
            class="mt-1.5 inline-block h-2 w-2 rounded-full"
            style={accent.startsWith("#") ? `background:${accent}` : ""}
          />
          <span set:html={b} />
        </li>
      ))
    }
  </ul>

  {note && <p class="mt-4 text-[12px] text-slate-500">{note}</p>}

  <div class="mt-6">
    <a
      href={ctaHref}
      class="inline-flex w-full items-center justify-center rounded-xl bg-primary px-6 py-3 font-semibold text-white shadow transition hover:bg-primary-hover"
    >
      {ctaText}
    </a>
  </div>
</article>

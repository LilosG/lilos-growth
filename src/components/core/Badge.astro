---
/**
 * Badge Component
 * 
 * Small status or category indicator following design system.
 * Used for service types, tags, and status labels.
 * 
 * @component
 * @example
 * <Badge variant="primary">Featured</Badge>
 * <Badge variant="primary" size="lg">Website</Badge>
 */

import { Icon } from "astro-icon/components";

export interface Props {
  /** Visual variant */
  variant?: 'primary' | 'secondary' | 'success' | 'info' | 'accent';
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Icon name (from astro-icon) */
  icon?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  class: className = '',
} = Astro.props;

const variantClasses = {
  primary: 'bg-primary/10 text-primary border-primary/20',
  secondary: 'bg-secondary/10 text-secondary border-secondary/20',
  success: 'bg-green-50 text-green-700 border-green-200',
  info: 'bg-blue-50 text-blue-700 border-blue-200',
  accent: 'bg-accent/10 text-accent border-accent/20',
};

const sizeClasses = {
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3 py-1.5 text-sm',
  lg: 'px-4 py-2 text-base',
};

const baseClasses = 'inline-flex items-center gap-1.5 rounded-full border font-heading font-semibold transition-all duration-200 hover:shadow-sm';

const classes = [
  baseClasses,
  variantClasses[variant],
  sizeClasses[size],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  {icon && <Icon name={icon} class="h-3.5 w-3.5" />}
  <slot />
</span>

---
/**
 * Badge Component
 * 
 * Small status or category indicator following design system.
 * Used for service types, tags, and status labels.
 * 
 * @component
 * @example
 * <Badge variant="primary">Featured</Badge>
 * <Badge variant="primary" size="lg">Website</Badge>
 */

import { Icon } from "astro-icon/components";

export interface Props {
  /** Visual variant */
  variant?: 'primary' | 'secondary' | 'success' | 'info' | 'accent' | 'outline' | 'website' | 'gbp' | 'seo';
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Icon name (from astro-icon) */
  icon?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  class: className = '',
} = Astro.props;

const variantClasses = {
  primary: 'bg-white text-primary border-primary/30 shadow-sm hover:shadow-md hover:border-primary/50',
  secondary: 'bg-white text-secondary border-secondary/30 shadow-sm hover:shadow-md hover:border-secondary/50',
  success: 'bg-white text-green-700 border-green-300 shadow-sm hover:shadow-md hover:border-green-400',
  info: 'bg-white text-blue-700 border-blue-300 shadow-sm hover:shadow-md hover:border-blue-400',
  accent: 'bg-white text-accent border-accent/30 shadow-sm hover:shadow-md hover:border-accent/50',
  outline: 'bg-transparent text-primary border-primary hover:bg-primary/5',
  website: 'bg-white text-purple-700 border-purple-300 shadow-sm hover:shadow-md hover:border-purple-400',
  gbp: 'bg-white text-orange-700 border-orange-300 shadow-sm hover:shadow-md hover:border-orange-400',
  seo: 'bg-white text-teal-700 border-teal-300 shadow-sm hover:shadow-md hover:border-teal-400',
};

const sizeClasses = {
  sm: 'px-2.5 py-1 text-xs',
  md: 'px-3.5 py-1.5 text-sm',
  lg: 'px-5 py-2.5 text-base',
};

const baseClasses = 'inline-flex items-center gap-1.5 rounded-xl border-2 font-heading font-semibold transition-all duration-200';

const classes = [
  baseClasses,
  variantClasses[variant as keyof typeof variantClasses],
  sizeClasses[size as keyof typeof sizeClasses],
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  {icon && <Icon name={icon} class="h-3.5 w-3.5" />}
  <slot />
</span>

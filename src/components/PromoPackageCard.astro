---
interface Props {
  title: string;
  subtitle?: string;
  price: string; // promo price, e.g. "$199"
  originalPrice?: string; // crossed-out price, e.g. "$299"
  period?: string; // "/mo"
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  badgeText?: string;
  highlight?: boolean;
  note?: string;
}

const {
  title,
  subtitle,
  price,
  originalPrice,
  period = "/mo",
  bullets = [],
  ctaText,
  ctaHref,
  badgeText,
  highlight = false,
  note,
} = Astro.props;
---

<article
  class={[
    "relative flex flex-col rounded-3xl bg-white border-2 p-8 h-full",
    "border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10",
    highlight ? "ring-2 ring-[#f56b2a] ring-offset-2 ring-offset-white" : "",
  ].join(" ")}
>
  {
    badgeText && (
      <div class="absolute -top-6 left-1/2 -translate-x-1/2">
        <span class="inline-flex items-center gap-1 rounded-full border border-[#f56b2a]/30 bg-[#fff7f0] px-3 py-1 text-[11px] font-semibold text-[#f56b2a] shadow">
          {badgeText}
        </span>
      </div>
    )
  }

  <header class="mb-5">
    <h3 class="text-2xl font-extrabold text-[#253242] md:text-[26px]">{title}</h3>
    {subtitle && <p class="mt-1 text-[15px] text-slate-600">{subtitle}</p>}
    <div class="mt-4 flex items-end gap-3">
      {
        originalPrice && (
          <span class="text-lg text-slate-400 line-through decoration-slate-300 decoration-2 md:text-xl">
            {originalPrice}
          </span>
        )
      }
      <div class="flex items-baseline gap-1">
        <div class="text-3xl font-extrabold leading-none text-[#f56b2a] md:text-[32px]">
          {price}
        </div>
        {period && <div class="font-medium text-slate-500">{period}</div>}
      </div>
    </div>
  </header>

  <ul class="mt-4 flex-1 space-y-3 text-[15px] leading-relaxed text-slate-700">
    {
      bullets.map((b) => (
        <li class="flex gap-2">
          <span class="mt-1.5 inline-block h-2 w-2 rounded-full" style="background:#f56b2a;" />
          <span set:html={b} />
        </li>
      ))
    }
  </ul>

  {note && <p class="mt-4 text-[12px] text-slate-500">{note}</p>}

  <div class="mt-6">
    <a
      href={ctaHref}
      class="inline-flex w-full items-center justify-center rounded-xl bg-[#f56b2a] px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
    >
      {ctaText}
    </a>
  </div>
</article>

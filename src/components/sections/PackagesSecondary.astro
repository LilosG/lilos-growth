---
import PackageCard from "../PackageCard.astro";

interface Props {
  heading?: string;
  subtitle?: string;
  showHeader?: boolean; // set false to hide header entirely
}

const {
  heading = "Add-On & One-Time Options",
  subtitle = "Bundle with any plan or purchase separately.",
  showHeader = true,
} = Astro.props;
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-7xl px-6">
    {
      showHeader && (
        <div class="text-center">
          <h3 class="text-2xl font-extrabold text-[#253242] md:text-3xl">{heading}</h3>
          {subtitle && <p class="mt-2 text-slate-600">{subtitle}</p>}
          <span class="mx-auto mt-3 block h-1 w-12 rounded bg-[#f56b2a]" />
        </div>
      )
    }

    <div
      class="mt-10 grid auto-rows-fr grid-cols-1 items-stretch gap-8 md:grid-cols-2 lg:grid-cols-3"
    >
      <PackageCard
        title="Website-as-a-Service"
        subtitle="Modern, conversion-ready site + support"
        price="$199"
        period="/mo"
        bullets={[
          "<strong>Mobile-first site</strong> with SEO baked in",
          "<strong>Secure hosting & monitoring</strong>",
          "<strong>Unlimited minor edits</strong> via support tickets",
          "<strong>Analytics & lead tracking</strong> set up",
          "<strong>Month-to-month support</strong> — no long contracts",
        ]}
        ctaText="See WaaS Details"
        ctaHref="/contact"
      />

      <PackageCard
        title="Local SEO — Essentials"
        subtitle="Single-location growth plan"
        price="$599"
        period="/mo"
        bullets={[
          "<strong>Site & on-page optimization</strong> (titles, metas, H1–H2, CWV, schema)",
          "<strong>Keyword research & tracking</strong> with quarterly priorities",
          "<strong>Service/location content</strong> & internal-linking scaffold",
          "<strong>Citation cleanup</strong> & foundational listings",
          "<strong>Monthly report</strong> + action checklist",
        ]}
        ctaText="Start Local SEO"
        ctaHref="/contact"
      />

      <PackageCard
        title="Local SEO — Growth"
        subtitle="Higher-volume monthly execution"
        price="$999"
        period="/mo"
        bullets={[
          "<strong>Everything in Essentials</strong>, plus:",
          "<strong>More pages & optimizations</strong> each month",
          "<strong>Expanded citations & link acquisition</strong>",
          "<strong>Quarterly competitor review</strong> & heatmap snapshot",
          "<strong>Monthly report</strong> + strategy call",
        ]}
        ctaText="Choose Growth"
        ctaHref="/contact"
      />
    </div>
  </div>
</section>

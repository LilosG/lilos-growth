---
/**
 * Stat Card Component
 *
 * Displays a metric or statistic with label and optional note.
 * Used on results page and homepage for showcasing performance.
 *
 * @component
 * @example
 * <StatCard
 *   label="Avg. Lead Growth"
 *   value="+142%"
 *   note="12-month median across active clients"
 * />
 */

import Card from "../ui/Card.astro";

export interface Props {
  /** Metric label */
  label: string;
  /** Metric value */
  value: string;
  /** Optional explanatory note */
  note?: string;
  /** Additional CSS classes */
  class?: string;
}

const { label, value, note, class: className = "" } = Astro.props;
---

<Card variant="elevated" size="sm" class={`text-center ${className}`}>
  <div class="relative">
    <!-- Decorative background element -->
    <div
      class="bg-primary/5 absolute -right-4 -top-4 h-20 w-20 rounded-full transition-transform group-hover:scale-110"
      aria-hidden="true"
    >
    </div>

    <div class="relative">
      <p class="text-xs font-semibold uppercase tracking-wider text-body">
        {label}
      </p>

      <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">
        {value}
      </p>

      {note && <p class="mt-1.5 text-xs text-body-light">{note}</p>}
    </div>
  </div>
</Card>

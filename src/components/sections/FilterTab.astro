---
/**
 * Filter Tab Component
 *
 * Tab button for filtering content (used on results page).
 * Handles active/inactive states with proper accessibility.
 *
 * @component
 * @example
 * <FilterTab id="all" label="All Results" active={true} />
 */

export interface Props {
  /** Unique ID for the filter */
  id: string;
  /** Display label */
  label: string;
  /** Is this tab currently active? */
  active?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const { id, label, active = false, class: className = "" } = Astro.props;

const baseClasses =
  "filter-tab rounded-full px-5 py-2 text-sm font-semibold transition-all cursor-pointer";
const activeClasses = active
  ? "bg-primary text-white shadow-md"
  : "bg-background-subtle text-body hover:bg-border-base";

const classes = [baseClasses, activeClasses, className].filter(Boolean).join(" ");
---

<button
  type="button"
  role="tab"
  aria-selected={active}
  aria-controls={`${id}-panel`}
  data-filter={id}
  class={classes}
>
  {label}
</button>

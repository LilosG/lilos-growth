---
/**
 * Service Offering Card Component
 *
 * Displays an individual service offering with icon, title, price, badge, description, and features.
 * Used on additional services page for one-time service offerings.
 *
 * @component
 * @example
 * <ServiceOfferingCard
 *   icon="tabler:map-pin"
 *   title="Citation Builder"
 *   price="$49"
 *   period="month"
 *   badge="Best for: New locations & ranking boosts"
 *   description="List your business on 250+ top directories to build consistent citations."
 *   features={["Clean, accurate NAP across 100+ directories", "Consistent brand & category data"]}
 *   ctaText="Order Now"
 *   ctaHref="#contact"
 * />
 */

import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import { Icon } from "astro-icon/components";

export interface Props {
  /** Icon name from astro-icon */
  icon: string;
  /** Service title */
  title: string;
  /** Price amount (e.g., "$49") */
  price: string;
  /** Price period (e.g., "month", "one-time", "30 days") */
  period: string;
  /** Badge text describing best use case */
  badge: string;
  /** Service description */
  description: string;
  /** Array of feature strings */
  features: string[];
  /** CTA button text */
  ctaText: string;
  /** CTA button href */
  ctaHref: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  icon,
  title,
  price,
  period,
  badge,
  description,
  features,
  ctaText,
  ctaHref,
  class: className = "",
} = Astro.props;
---

<Card
  variant="elevated"
  class={`flex h-full flex-col transition-all duration-300 hover:shadow-xl ${className}`}
>
  <header class="mb-3 flex items-center gap-3">
    <div
      class="flex h-10 w-10 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-primary-dark"
    >
      <Icon name={icon} class="h-5 w-5 text-white" />
    </div>
    <h3 class="font-heading text-lg font-bold text-heading md:text-xl">{title}</h3>
  </header>

  <div class="mb-2">
    <span class="text-2xl font-extrabold text-heading md:text-3xl">{price}</span>
    <span class="text-body/70 text-sm font-medium">/ {period}</span>
  </div>

  <div class="mb-3">
    <Badge variant="primary" size="sm">{badge}</Badge>
  </div>

  <p class="mb-4 text-sm text-body md:text-base">
    {description}
  </p>

  <ul class="mb-6 flex-1 space-y-2 text-sm text-body">
    {
      features.map((feature) => (
        <li class="flex items-start">
          <Icon
            name="tabler:circle-check-filled"
            class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
          />
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-auto">
    <Button href={ctaHref} variant="primary" size="md" class="w-full">
      {ctaText}
    </Button>
  </div>
</Card>

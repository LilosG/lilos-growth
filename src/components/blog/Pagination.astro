---
interface Urls {
  current: string;
  prev?: string;
  next?: string;
}
export interface Props {
  current: number;
  last: number;
  url: Urls;
  base?: string; // default "/blog"
}
const { current, last, url, base = '/blog' } = Astro.props;
const hrefFor = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}/`);
---

<nav class="mt-10 flex items-center justify-between">
  <div>
    {
      url.prev && (
        <a href={url.prev} class="inline-block rounded-lg border px-4 py-2 hover:underline">
          ← Newer
        </a>
      )
    }
  </div>
  <div class="text-sm">Page {current} of {last}</div>
  <div>
    {
      url.next && (
        <a href={url.next} class="inline-block rounded-lg border px-4 py-2 hover:underline">
          Older →
        </a>
      )
    }
  </div>
</nav>

{
  last > 1 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {Array.from({ length: last }, (_, i) => i + 1).map((n) => (
        <li>
          <a
            href={hrefFor(n)}
            class={`inline-block rounded-md border px-3 py-1 ${n === current ? 'font-semibold underline' : 'hover:underline'}`}
            aria-current={n === current ? 'page' : undefined}
          >
            {n}
          </a>
        </li>
      ))}
    </ul>
  )
}

---
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import Image from "~/components/common/Image.astro";
import PostTags from "~/components/blog/Tags.astro";

import { APP_BLOG } from "astrowind:config";
import type { Post } from "~/types";

// Permalinks: try getBlogPermalink if present, else fallback.
let getBlogPermalink: ((slug: string) => string) | undefined;
try {
  // Some Astrowind versions export this helper:
  ({ getBlogPermalink } = await import("~/utils/permalinks"));
} catch {
  /* not available in this project version */
}

export interface Props {
  post: Post;
}

const { post } = Astro.props as Props;

/** Accept several front-matter keys */
function getPostImageCandidate(p: Post): string | ImageMetadata | null | undefined {
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const anyPost = p as any;
  return anyPost.image ?? anyPost.cover ?? anyPost.heroImage ?? null;
}

const candidate = getPostImageCandidate(post);

// If your findImage returns Promise<string | ImageMetadata | null | undefined>, keep it.
// If you don't have it, this still works because we guard below.
let rawImage: string | ImageMetadata | null | undefined = candidate;
try {
  const { findImage } = await import("~/utils/images");
  rawImage = await findImage(candidate);
} catch {
  // no-op: keep candidate
}

/** Normalize for <Image>: must be string (or {src:string}). */
function toSrcString(img: string | ImageMetadata | null | undefined): string | undefined {
  if (!img) return undefined;
  if (typeof img === "string") return img;
  // Astro ImageMetadata usually has .src
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  const maybeSrc = (img as any).src as string | undefined;
  return maybeSrc;
}

const srcString = toSrcString(rawImage);

// Sizes: if we have ImageMetadata, use it; else fall back.
const fallbackWidth = 400;
const fallbackHeight = 225;
const metaWidth =
  typeof rawImage === "object" && rawImage
    ? ((rawImage as ImageMetadata).width ?? fallbackWidth)
    : fallbackWidth;
const metaHeight =
  typeof rawImage === "object" && rawImage
    ? ((rawImage as ImageMetadata).height ?? fallbackHeight)
    : fallbackHeight;

// Permalink: prefer explicit post.permalink, then helper, then slug, else '#'
const slug =
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  ((post as any).slug as string | undefined) ??
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  ((post as any).id as string | undefined);

const permalink =
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  ((post as any).permalink as string | undefined) ??
  (slug && typeof getBlogPermalink === "function"
    ? getBlogPermalink(slug)
    : slug
      ? `/blog/${slug}/`
      : "#");

// Date text using toLocaleDateString; avoids helper arity mismatches.
const dateText = post.publishDate
  ? new Date(post.publishDate).toLocaleDateString(
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      (APP_BLOG as any)?.postDate?.locale,
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      (APP_BLOG as any)?.postDate?.options
    )
  : "";

const altText =
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  ((post as any).imageAlt as string | undefined) ?? post.title ?? "Blog post image";
---

<article class="mb-6 transition motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
  <div class="relative mb-6 rounded bg-gray-400 shadow-lg dark:bg-slate-700 md:h-64">
    <a href={permalink}>
      {
        srcString ? (
          <Image
            src={srcString}
            alt={altText}
            class="w-full rounded shadow-lg md:h-full"
            loading="lazy"
            decoding="async"
            width={metaWidth}
            height={metaHeight}
          />
        ) : (
          /* If no image, render an empty ratio box to keep layout stable */
          <div
            class="w-full rounded bg-gray-300 shadow-lg dark:bg-slate-600 md:h-full"
            style={`aspect-ratio: ${fallbackWidth} / ${fallbackHeight};`}
            aria-hidden="true"
          />
        )
      }
    </a>
  </div>

  <h3 class="mb-2 font-heading text-xl font-bold leading-tight dark:text-slate-300 sm:text-2xl">
    <a href={permalink} class="inline-block transition hover:text-primary dark:hover:text-blue-700">
      {post.title}
    </a>
  </h3>

  {
    dateText && (
      <div class="text-muted mb-2 flex items-center gap-2 text-sm">
        <Icon name="tabler:calendar" class="h-4 w-4" />
        <time datetime={post.publishDate ? new Date(post.publishDate).toISOString() : undefined}>
          {dateText}
        </time>
      </div>
    )
  }

  {post.excerpt && <p class="text-muted flex-grow text-lg dark:text-slate-400">{post.excerpt}</p>}

  {
    post.tags && Array.isArray(post.tags) ? (
      <footer class="mt-5">
        <PostTags tags={post.tags} />
      </footer>
    ) : null
  }
</article>

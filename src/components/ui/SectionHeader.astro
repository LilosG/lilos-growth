---
export interface Props {
  title: string;
  subtitle?: string;
  accent?: "top" | "bottom" | "none";
  align?: "center" | "left";
  id?: string;
}

const { title, subtitle, accent = "top", align = "center", id }: Props = Astro.props;

const alignCls = align === "left" ? "text-left mx-0" : "text-center mx-auto";
---

<div id={id} class={`max-w-3xl ${alignCls}`}>
  {
    accent === "top" && (
      <span class="mx-auto mb-3 block h-1 w-20 rounded bg-primary" aria-hidden="true" />
    )
  }
  <h2 class="text-balance font-heading text-3xl font-bold tracking-tight text-heading md:text-5xl">
    {title}
  </h2>
  {
    accent === "bottom" && (
      <span class="mx-auto mt-3 block h-1 w-20 rounded bg-primary" aria-hidden="true" />
    )
  }
  {subtitle && <p class="mt-3 text-lg text-body">{subtitle}</p>}
</div>

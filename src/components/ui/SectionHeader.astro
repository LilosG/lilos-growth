---
export interface Props {
  title: string;
  subtitle?: string;
  accent?: 'top' | 'bottom' | 'none';
  align?: 'center' | 'left';
  id?: string;
}

const { title, subtitle, accent = 'top', align = 'center', id }: Props = Astro.props;

const alignCls = align === 'left' ? 'text-left mx-0' : 'text-center mx-auto';
---

<div id={id} class={`max-w-3xl ${alignCls}`}>
  {accent === 'top' && <span class="block mx-auto mb-3 h-1 w-20 bg-[#f56b2a] rounded" aria-hidden="true" />}
  <h2 class="text-3xl md:text-5xl font-heading text-heading font-bold tracking-tight text-balance">
    {title}
  </h2>
  {accent === 'bottom' && <span class="block mx-auto mt-3 h-1 w-20 bg-[#f56b2a] rounded" aria-hidden="true" />}
  {subtitle && <p class="mt-3 text-lg text-body">{subtitle}</p>}
</div>

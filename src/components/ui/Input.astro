---
/**
 * Input Component
 *
 * Form input with a built-in label (visible by default), plus error and
 * helper text support. A visible label is the default and accessible
 * convention for this design system — six of the eight tool forms audited
 * used a visible label above the field, and the two that relied on
 * placeholder-only text had no accessible name for screen readers.
 * `labelVisibility="sr-only"` keeps that placeholder-only look while still
 * giving the field a real accessible name.
 *
 * @component
 * @example
 * <Input
 *   id="email"
 *   label="Email Address"
 *   type="email"
 *   required
 *   helperText="We'll never share your email"
 * />
 *
 * @example Placeholder-only visual style, label kept for screen readers
 * <Input id="gbp-cat-input" label="Business type" labelVisibility="sr-only"
 *   placeholder="Type your business type (e.g., plumber, dentist)" />
 *
 * @example Prefix glyph inside the input
 * <Input id="roi-revenue-input" label="Current Monthly Revenue" type="number"
 *   prefix="$" placeholder="15000" />
 */

export interface Props {
  /** Input ID (required for accessibility) */
  id: string;
  /** Input name attribute */
  name?: string;
  /** Input type */
  type?: "text" | "email" | "tel" | "url" | "password" | "number";
  /** Label text. Always rendered for accessibility; see labelVisibility to control whether it's shown visually. */
  label: string;
  /** "visible" (default) renders the label above the input. "sr-only" keeps it for screen readers but hides it visually, for compact placeholder-only layouts. */
  labelVisibility?: "visible" | "sr-only";
  /** Placeholder text */
  placeholder?: string;
  /** Helper text below input */
  helperText?: string;
  /** Error message */
  error?: string;
  /** Required field */
  required?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Autocomplete attribute */
  autocomplete?: string;
  /** Input mode for mobile keyboards */
  inputmode?: "text" | "email" | "tel" | "url" | "numeric";
  /** Default value */
  value?: string;
  /** Maximum character length */
  maxlength?: number;
  /** Minimum value (for type="number") */
  min?: number;
  /** Additional CSS classes for input */
  class?: string;
  /** Short glyph (e.g. "$") rendered inside the input's left edge; adjusts left padding automatically */
  prefix?: string;
}

const {
  id,
  name = id,
  type = "text",
  label,
  labelVisibility = "visible",
  placeholder,
  helperText,
  error,
  required = false,
  disabled = false,
  autocomplete,
  inputmode,
  value,
  maxlength,
  min,
  class: className = "",
  prefix,
} = Astro.props;

const hasError = !!error;
const hasPrefix = !!prefix;
const inputClasses = ["input", hasError && "input-error", hasPrefix && "pl-8", className]
  .filter(Boolean)
  .join(" ");
const labelClasses =
  labelVisibility === "sr-only" ? "sr-only" : "block text-sm font-medium text-heading";
---

<div class="space-y-1.5">
  <label for={id} class={labelClasses}>
    {label}
    {required && <span class="ml-1 text-error">*</span>}
  </label>

  <div class={hasPrefix ? "relative" : undefined}>
    {
      hasPrefix && (
        <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-muted">
          {prefix}
        </span>
      )
    }
    <input
      id={id}
      name={name}
      type={type}
      class={inputClasses}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      autocomplete={autocomplete}
      inputmode={inputmode}
      value={value}
      maxlength={maxlength}
      min={min}
      aria-invalid={hasError}
      aria-describedby={error ? `${id}-error` : helperText ? `${id}-helper` : undefined}
    />
  </div>

  {
    error && (
      <p id={`${id}-error`} class="text-sm text-error">
        {error}
      </p>
    )
  }

  {
    !error && helperText && (
      <p id={`${id}-helper`} class="text-sm text-muted">
        {helperText}
      </p>
    )
  }
</div>

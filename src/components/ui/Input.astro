---
/**
 * Input Component
 *
 * Form input with built-in label, error, and helper text support.
 * Follows design system and accessibility best practices.
 *
 * @component
 * @example
 * <Input
 *   id="email"
 *   label="Email Address"
 *   type="email"
 *   required
 *   helperText="We'll never share your email"
 * />
 */

export interface Props {
  /** Input ID (required for accessibility) */
  id: string;
  /** Input name attribute */
  name?: string;
  /** Input type */
  type?: "text" | "email" | "tel" | "url" | "password" | "number";
  /** Label text */
  label?: string;
  /** Placeholder text */
  placeholder?: string;
  /** Helper text below input */
  helperText?: string;
  /** Error message */
  error?: string;
  /** Required field */
  required?: boolean;
  /** Disabled state */
  disabled?: boolean;
  /** Autocomplete attribute */
  autocomplete?: string;
  /** Input mode for mobile keyboards */
  inputmode?: "text" | "email" | "tel" | "url" | "numeric";
  /** Default value */
  value?: string;
  /** Additional CSS classes for input */
  class?: string;
}

const {
  id,
  name = id,
  type = "text",
  label,
  placeholder,
  helperText,
  error,
  required = false,
  disabled = false,
  autocomplete,
  inputmode,
  value,
  class: className = "",
} = Astro.props;

const hasError = !!error;
const inputClasses = ["input", hasError && "input-error", className].filter(Boolean).join(" ");
---

<div class="space-y-1.5">
  {
    label && (
      <label for={id} class="block text-sm font-medium text-heading">
        {label}
        {required && <span class="ml-1 text-error">*</span>}
      </label>
    )
  }

  <input
    id={id}
    name={name}
    type={type}
    class={inputClasses}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    inputmode={inputmode}
    value={value}
    aria-invalid={hasError}
    aria-describedby={error ? `${id}-error` : helperText ? `${id}-helper` : undefined}
  />

  {
    error && (
      <p id={`${id}-error`} class="text-sm text-error">
        {error}
      </p>
    )
  }

  {
    !error && helperText && (
      <p id={`${id}-helper`} class="text-sm text-muted">
        {helperText}
      </p>
    )
  }
</div>

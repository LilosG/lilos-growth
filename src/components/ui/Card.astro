---
/**
 * Card Component
 *
 * A flexible, reusable card component following atomic design principles.
 * Supports multiple variants and can be composed with other components.
 *
 * @component
 * @example
 * <Card variant="elevated">
 *   <h3>Card Title</h3>
 *   <p>Card content goes here</p>
 * </Card>
 *
 * @example Icon badge (tool-card / feature-card pattern)
 * <Card icon="tabler:search" iconColor="green" iconSize="sm" iconPosition="inline">
 *   <h3>GBP Category Finder</h3>
 *   <p>Search Google's official categories</p>
 * </Card>
 */

import { Icon } from "astro-icon/components";

export interface Props {
  /** Visual variant of the card */
  variant?: "default" | "elevated" | "interactive" | "outlined";
  /** Size variant */
  size?: "default" | "sm";
  /** Additional CSS classes */
  class?: string;
  /** HTML element to render as */
  as?: "div" | "article" | "section";
  /** Optional href to make card a link */
  href?: string;
  /** Link target attribute */
  target?: "_blank" | "_self";
  /** Icon name from astro-icon. Omit for no icon badge. */
  icon?: string;
  /** Icon badge color. "gradient" is the FeatureCard-style primary gradient circle; "onDark" is for cards on a dark/secondary background. */
  iconColor?:
    | "gradient"
    | "primary"
    | "onDark"
    | "green"
    | "blue"
    | "indigo"
    | "purple"
    | "teal"
    | "orange";
  /** Icon badge size: sm=40px, md=48px, lg=56px */
  iconSize?: "sm" | "md" | "lg";
  /** Icon badge shape */
  iconShape?: "circle" | "rounded";
  /** "top" centers the badge above the slot content (feature-card style); "inline" places it beside the slot content in a row (tool-card header style) */
  iconPosition?: "top" | "inline";
}

const {
  variant = "default",
  size = "default",
  class: className = "",
  as: Tag = "div",
  href,
  target,
  icon,
  iconColor = "gradient",
  iconSize = "md",
  iconShape = "circle",
  iconPosition = "top",
} = Astro.props;

// Build class string based on props
const variantClasses = {
  default: "card",
  elevated: "card-elevated",
  interactive: "card-interactive",
  outlined: "card-outlined",
};

const sizeClasses = {
  default: "",
  sm: "card-sm",
};

const baseClass = variantClasses[variant as keyof typeof variantClasses];
const sizeClass = sizeClasses[size as keyof typeof sizeClasses];
const groupClass = variant === "interactive" ? "group" : "";
const combinedClasses = [baseClass, sizeClass, groupClass, className].filter(Boolean).join(" ");

// If href is provided, wrap in link
const isLink = !!href;

// Icon badge classes
const iconBoxSizeClasses = {
  sm: "h-10 w-10",
  md: "h-12 w-12",
  lg: "h-14 w-14",
};
const iconGlyphSizeClasses = {
  sm: "h-5 w-5",
  md: "h-6 w-6",
  lg: "h-7 w-7",
};
const iconShapeClasses = {
  circle: "rounded-full",
  rounded: "rounded-xl",
};
const iconColorClasses = {
  gradient: "bg-gradient-to-br from-primary to-primary-dark text-white",
  primary: "bg-primary/10 text-primary",
  onDark: "bg-white/10 text-primary",
  green: "bg-green-100 text-green-600",
  blue: "bg-blue-100 text-blue-600",
  indigo: "bg-indigo-100 text-indigo-600",
  purple: "bg-purple-100 text-purple-600",
  teal: "bg-teal-100 text-teal-600",
  orange: "bg-orange-100 text-orange-600",
};

const iconBoxClasses = [
  "flex shrink-0 items-center justify-center",
  iconBoxSizeClasses[iconSize as keyof typeof iconBoxSizeClasses],
  iconShapeClasses[iconShape as keyof typeof iconShapeClasses],
  iconColorClasses[iconColor as keyof typeof iconColorClasses],
  iconPosition === "top" ? "shadow-md" : "",
]
  .filter(Boolean)
  .join(" ");
const iconGlyphClasses = iconGlyphSizeClasses[iconSize as keyof typeof iconGlyphSizeClasses];
---

{
  isLink ? (
    <a
      href={href}
      class={combinedClasses}
      {...(target === "_blank" ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      {icon && iconPosition === "top" && (
        <div class="mb-4 flex justify-center">
          <div class={iconBoxClasses}>
            <Icon name={icon} class={iconGlyphClasses} />
          </div>
        </div>
      )}
      {icon && iconPosition === "inline" ? (
        <div class="flex items-center gap-3">
          <div class={iconBoxClasses}>
            <Icon name={icon} class={iconGlyphClasses} />
          </div>
          <div class="min-w-0 flex-1">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </a>
  ) : (
    <Tag class={combinedClasses}>
      {icon && iconPosition === "top" && (
        <div class="mb-4 flex justify-center">
          <div class={iconBoxClasses}>
            <Icon name={icon} class={iconGlyphClasses} />
          </div>
        </div>
      )}
      {icon && iconPosition === "inline" ? (
        <div class="flex items-center gap-3">
          <div class={iconBoxClasses}>
            <Icon name={icon} class={iconGlyphClasses} />
          </div>
          <div class="min-w-0 flex-1">
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </Tag>
  )
}

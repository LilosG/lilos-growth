---
type Related = { slug: string; title: string; category?: string; datePublished?: string };
const { posts } = Astro.props as { posts: Related[] };
---

{
  posts.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl font-semibold">Read next</h2>
      <div class="mt-4 grid grid-cols-1 gap-6 md:grid-cols-3">
        {posts.map((p: Related) => (
          <article class="rounded-2xl border p-5">
            <h3 class="text-lg font-semibold leading-tight">
              <a href={`/blog/${p.slug}`} class="hover:underline">
                {p.title}
              </a>
            </h3>
            <div class="mt-1 text-xs text-gray-500">
              {p.category}
              {p.datePublished && (
                <>
                  {" "}
                  • <time datetime={p.datePublished}>{p.datePublished}</time>
                </>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

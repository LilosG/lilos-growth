---
/**
 * Site-wide progressive enhancements:
 * 1) External link hardening (target=_blank + rel=noopener,noreferrer)
 * 2) CTA click tracking via window.trackEvent() -> Vercel Analytics
 *    - Works on any element with [data-track] or [data-track-event]
 * 3) Page view tracking on load (+ after Astro client navigations)
 * 4) Lightweight UTM/referrer attribution stored in sessionStorage
 *
 * No theme changes. CSP-safe inline script.
 */
---

<script is:inline>
  (function () {
    // ---------- 1) External link normalization ----------
    try {
      const host = location.host;
      document.querySelectorAll('a[href^="http"]').forEach((a) => {
        try {
          const url = new URL(a.href);
          if (url.host !== host) {
            if (!a.target) a.target = '_blank';
            const rel = (a.getAttribute('rel') || '').split(/\s+/);
            if (!rel.includes('noopener')) rel.push('noopener');
            if (!rel.includes('noreferrer')) rel.push('noreferrer');
            a.setAttribute('rel', rel.join(' ').trim());
          }
        } catch {}
      });
    } catch {}

    // ---------- 2) CTA analytics ----------
    const clickHandler = (e) => {
      const el = e.target && (e.target.closest('[data-track]') || e.target.closest('[data-track-event]'));
      if (!el) return;

      const name = el.getAttribute('data-track-event') || 'click_cta';
      const payload = {
        href: el.getAttribute('href') || null,
        id: el.id || null,
        text: (el.textContent || '').trim().slice(0, 120),
        path: location.pathname,
      };

      try {
        window.trackEvent && window.trackEvent(name, payload);
      } catch {}
    };
    document.addEventListener('click', clickHandler, { passive: true });

    // ---------- 3) Page view tracking + UTM/referrer ----------
    const STORAGE_KEY = 'lg_attribution';

    function parseUTM() {
      const p = new URLSearchParams(location.search);
      const keys = [
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content',
        'gclid',
        'fbclid',
        'msclkid',
      ];
      const utm = {};
      keys.forEach((k) => {
        const v = p.get(k);
        if (v) utm[k] = v;
      });
      return utm;
    }

    function updateAttribution() {
      let data = {};
      try {
        data = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '{}');
      } catch {}
      const now = Date.now();
      const utm = parseUTM();
      const ref = document.referrer || null;

      if (!data.firstTouch) {
        data.firstTouch = { ts: now, referrer: ref, landing: location.pathname + location.search, ...utm };
      }
      data.lastTouch = { ts: now, referrer: ref, path: location.pathname, ...utm };

      try {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch {}
      return data;
    }

    function sendPageView() {
      const attrib = updateAttribution();
      const payload = {
        path: location.pathname,
        title: document.title,
        referrer: document.referrer || null,
        utm: attrib.lastTouch || null,
      };
      try {
        window.trackEvent && window.trackEvent('page_view', payload);
      } catch {}
    }

    if (document.readyState !== 'loading') sendPageView();
    else document.addEventListener('DOMContentLoaded', sendPageView, { once: true });

    // Fires after Astro client-side navigations (if used)
    document.addEventListener('astro:page-load', sendPageView);
  })();
</script>

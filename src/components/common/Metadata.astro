---
import merge from "lodash.merge";
type SeoProps = {
  title?: string;
  titleTemplate?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  description?: string;
  openGraph?: {
    url?: string;
    site_name?: string;
    siteName?: string;
    locale?: string;
    type?: string;
    images?: Array<{ url: string; width?: number; height?: number }>;
  };
  twitter?: { cardType?: string; handle?: string; site?: string };
};

import { SITE, METADATA, I18N } from "astrowind:config";
import type { MetaData } from "~/types";
import { getCanonical } from "~/utils/permalinks";

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

let seoProps: SeoProps = merge(
  {
    title: "",
    titleTemplate: "%s",
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || "en",
      type: "website",
    },
    twitter: {
      cardType: openGraph?.images?.length ? "summary_large_image" : "summary",
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== "undefined" ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== "undefined" ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? "%s" : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== "undefined" ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== "undefined" ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);

const MAX_TITLE_LENGTH = 60;
const MAX_DESCRIPTION_LENGTH = 160;

const trimToMax = (value: string, maxLength: number) => {
  const normalized = value.replace(/\s+/g, " ").trim();
  if (normalized.length <= maxLength) return normalized;

  const budget = Math.max(1, maxLength - 1);
  const clipped = normalized.slice(0, budget + 1);
  const lastWordBoundary = clipped.lastIndexOf(" ");
  const safe =
    lastWordBoundary > budget * 0.6 ? clipped.slice(0, lastWordBoundary) : clipped.slice(0, budget);
  return `${safe.trimEnd()}…`;
};

const templateValue = typeof seoProps.titleTemplate === "string" ? seoProps.titleTemplate : "%s";
const baseTitle = typeof seoProps.title === "string" ? seoProps.title : "";
const renderedTitle = templateValue.includes("%s")
  ? templateValue.replace("%s", baseTitle)
  : baseTitle;

if (renderedTitle.length > MAX_TITLE_LENGTH) {
  const suffix = templateValue.replace("%s", "").trim();
  const suffixBudget = suffix ? suffix.length + 3 : 0; // " — Brand" + separator space
  seoProps.titleTemplate = templateValue;
  seoProps.title = trimToMax(baseTitle, MAX_TITLE_LENGTH - suffixBudget);
}

if (typeof seoProps.description === "string") {
  seoProps.description = trimToMax(seoProps.description, MAX_DESCRIPTION_LENGTH);
}
const finalTitle = templateValue.includes("%s")
  ? templateValue.replace("%s", seoProps.title || "")
  : (seoProps.title || "");
const ogSiteName = seoProps.openGraph?.site_name ?? seoProps.openGraph?.siteName;
---

<title>{finalTitle}</title>
{seoProps.description && <meta name="description" content={seoProps.description} />}
{seoProps.canonical && <link rel="canonical" href={seoProps.canonical} />}
<meta name="robots" content={`${seoProps.noindex ? "noindex" : "index"}, ${seoProps.nofollow ? "nofollow" : "follow"}`} />
<meta property="og:title" content={finalTitle} />
{seoProps.description && <meta property="og:description" content={seoProps.description} />}
<meta property="og:url" content={seoProps.openGraph?.url || seoProps.canonical} />
<meta property="og:type" content={seoProps.openGraph?.type || "website"} />
{ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
{seoProps.openGraph?.locale && <meta property="og:locale" content={seoProps.openGraph.locale} />}
{seoProps.openGraph?.images?.map((image) => (
  <>
    <meta property="og:image" content={image.url} />
    {image.width && <meta property="og:image:width" content={String(image.width)} />}
    {image.height && <meta property="og:image:height" content={String(image.height)} />}
  </>
))}
<meta name="twitter:card" content={seoProps.twitter?.cardType || "summary"} />
<meta name="twitter:title" content={finalTitle} />
{seoProps.description && <meta name="twitter:description" content={seoProps.description} />}
{seoProps.twitter?.site && <meta name="twitter:site" content={seoProps.twitter.site} />}
{seoProps.twitter?.handle && <meta name="twitter:creator" content={seoProps.twitter.handle} />}
{seoProps.openGraph?.images?.[0]?.url && <meta name="twitter:image" content={seoProps.openGraph.images[0].url} />

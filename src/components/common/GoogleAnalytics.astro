---
/**
 * Google Analytics (GA4) loader for Astro.
 * Loads only after explicit consent (lg_cookie_consent === "accepted").
 * Works with either:
 *  - prop: <GoogleAnalytics id="G-XXXXXXX" />
 *  - env:  PUBLIC_GA_ID or PUBLIC_GOOGLE_MEASUREMENT_ID
 */
export interface Props {
  id?: string;
}

const propId = (Astro.props as Props).id;
const envId = import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_GOOGLE_MEASUREMENT_ID || "";

const id = (propId && String(propId)) || String(envId);
const enabled = id.length > 0;

// Build inline bootstrap as a string so TS/formatters don't choke
const inlineGA = enabled
  ? `
    (function () {
      const consentKey = "lg_cookie_consent";
      const gaId = "${id}";
      if (!gaId) return;

      function loadGa() {
        if (window.__gaLoaded) return;

        // Use requestIdleCallback to defer GA loading until browser is idle
        const loadScript = function() {
          const s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", gaId, {
            anonymize_ip: true,
            send_page_view: true
          });
          window.__gaLoaded = true;
        };

        // Defer loading until browser is idle (or after 2s fallback)
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadScript, { timeout: 2000 });
        } else {
          setTimeout(loadScript, 2000);
        }
      }

      try {
        if (localStorage.getItem(consentKey) === "accepted") {
          loadGa();
        }
      } catch {}

      window.addEventListener("lg-consent-accepted", loadGa);
    })();
  `
  : "";
---

{enabled && <script is:inline set:html={inlineGA} />}

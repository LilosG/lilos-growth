---
/**
 * Minimal GA4 loader (only when PUBLIC_GOOGLE_MEASUREMENT_ID is present).
 * Pass GA ID via data attribute; read it with document.currentScript.
 */
const GA_ID = (import.meta.env.PUBLIC_GOOGLE_MEASUREMENT_ID ?? '').trim();
const enabled = GA_ID.length > 0;
---

{enabled ? (
  <>
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>

    <script is:inline data-ga-id={GA_ID}>
      (function () {
        var s = document.currentScript;
        var GA_ID = s && s.getAttribute('data-ga-id');
        if (!GA_ID) return;

        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }

        // expose for other scripts (Layout event bridge)
        // @ts-ignore
        window.gtag = window.gtag || gtag;

        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true, transport_type: 'beacon' });
      })();
    </script>
  </>
) : null}

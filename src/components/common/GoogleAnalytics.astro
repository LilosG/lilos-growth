---
/**
 * Minimal GA4 loader (runs only when PUBLIC_GOOGLE_MEASUREMENT_ID exists).
 */
const GA_ID = (import.meta.env.PUBLIC_GOOGLE_MEASUREMENT_ID ?? '').trim();
const enabled = GA_ID.length > 0;
---

{enabled ? (
  <>
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Explicit is:inline silences Astro hint -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>

    <script is:inline data-ga-id={GA_ID}>
      (() => {
        const s = document.currentScript;
        const id = s && s.getAttribute('data-ga-id');
        if (!id) return;

        // dataLayer + gtag (no 'var', no 'arguments')
         
        window.dataLayer = window.dataLayer || [];
        const gtag = (...args) => { window.dataLayer.push(args); };

        // expose for other scripts without ts-ignore
        window.gtag = window.gtag || gtag;

        gtag('js', new Date());
        gtag('config', id, { anonymize_ip: true, transport_type: 'beacon' });
      })();
    </script>
  </>
) : null}

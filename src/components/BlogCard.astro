---
const props = Astro.props as {
  href: string;
  title: string;
  description: string;
  datePublished?: string | Date;
  category?: string;
  tags?: string[];
  icon?: string;
};

function fmtDate(d?: string | Date) {
  if (!d) return "";
  const x = typeof d === "string" ? new Date(d) : d;
  if (isNaN(x.getTime())) return "";
  return x.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
}
const dateText = fmtDate(props.datePublished);

function pickIconName(icon?: string, category?: string) {
  if (icon) return icon.toLowerCase();
  const k = (category || "").toLowerCase();
  if (k.includes("google business") || k.includes("gbp")) return "map";
  if (k.includes("announce")) return "megaphone";
  if (k.includes("website")) return "monitor";
  if (k.includes("seo")) return "search";
  return "star";
}

function iconSvg(name: string) {
  switch (name) {
    case "search":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6"/><path stroke-linecap="round" d="M16 16l5 5"/></svg>`;
    case "map":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7.2 7-12.2A7 7 0 1 0 5 9.8C5 14.8 12 22 12 22Z"/><circle cx="12" cy="9.8" r="2.3"/></svg>`;
    case "megaphone":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10V7l13-4v18L3 17v-3"/><path d="M8 17v2a2 2 0 0 0 2 2h2"/></svg>`;
    case "monitor":
      return `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>`;
    case "star":
    default:
      return `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l2.9 5.9L21 10l-4.8 4.6L17.8 21 12 17.8 6.2 21l1.6-6.4L3 10l6.1-1.1L12 3z" stroke-linejoin="round"/></svg>`;
  }
}
const iconName = pickIconName(props.icon, props.category);
---
<article class="group bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 transition-[transform,box-shadow] duration-200 overflow-hidden hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20">
  <a href={props.href} class="block p-6">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl border border-[#f56b2a]/20 bg-[#fff7f0] shadow-[0_1px_3px_rgba(245,107,42,0.12)]">
      <span set:html={iconSvg(iconName)} />
    </div>

    <div class="mt-4 text-xs text-slate-500">
      {props.category}{dateText && <> • <time datetime={typeof props.datePublished === 'string' ? props.datePublished : ''}>{dateText}</time></>}
    </div>

    <h3 class="mt-1 text-xl font-semibold leading-tight text-slate-900">{props.title}</h3>
    <p class="mt-2 text-slate-700 text-sm">{props.description}</p>
  </a>

  {props.tags && props.tags.length > 0 && (
    <div class="px-6 pb-6 pt-2 flex flex-wrap gap-2">
      {props.tags.slice(0, 3).map((t: string) => (
        <a href={`/blog/tag/${encodeURIComponent(t)}`} class="text-xs rounded-full border border-[#f56b2a]/20 bg-[#fff7f0] px-2 py-1 text-[#f56b2a]">
          {t}
        </a>
      ))}
    </div>
  )}
</article>

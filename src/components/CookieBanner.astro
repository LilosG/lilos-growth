---
/* Simple consent banner: stores choice in localStorage and emits an event. */
export interface Props {
  /** Compact bottom-left card instead of a full-width bar (landing pages). */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div
  id="cookie-banner"
  class:list={[
    "fixed z-50 hidden bg-gray-900 text-white",
    compact
      ? "inset-x-0 bottom-0 md:inset-x-auto md:bottom-4 md:left-4 md:right-4 md:max-w-sm md:rounded-2xl md:border md:border-white/10 md:shadow-2xl"
      : "inset-x-0 bottom-0",
  ]}
>
  <div
    class:list={[
      "mx-auto flex w-full",
      compact
        ? "items-center justify-between gap-3 px-3 py-2 text-[13px] md:flex-col md:items-start md:justify-start md:p-4 md:text-sm"
        : "max-w-5xl items-center gap-3 p-4 text-sm",
    ]}
  >
    {
      compact ? (
        <>
          <span class="md:hidden">We use cookies for analytics.</span>
          <span class="hidden md:inline">
            We use cookies for site functionality and analytics. You can change your preference anytime.
          </span>
        </>
      ) : (
        <span>
          We use cookies for site functionality and analytics. You can change your preference anytime.
        </span>
      )
    }
    <div class:list={["flex items-center gap-2 md:flex-wrap", compact ? "shrink-0" : "ml-auto"]}>
      <button id="cookie-accept" class="min-h-11 rounded bg-white px-3 py-2 text-gray-900">Accept</button>
      <button id="cookie-decline" class="min-h-11 rounded border border-white/40 px-3 py-2">Decline</button>
      <a href="/privacy-policy#cookies" class:list={["underline", compact ? "hidden md:inline" : ""]}>Learn more</a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const key = "lg_cookie_consent";
    const banner = document.getElementById("cookie-banner");
    const existing = localStorage.getItem(key);
    if (!existing) banner.classList.remove("hidden");

    function setConsent(v) {
      localStorage.setItem(key, v);
      banner.classList.add("hidden");
      if (v === "accepted") window.dispatchEvent(new Event("lg-consent-accepted"));
    }
    document
      .getElementById("cookie-accept")
      ?.addEventListener("click", () => setConsent("accepted"));
    document
      .getElementById("cookie-decline")
      ?.addEventListener("click", () => setConsent("declined"));

    // Re-open from links in Privacy page
    document.getElementById("cookie-preferences-link")?.addEventListener("click", (e) => {
      e.preventDefault();
      localStorage.removeItem(key);
      banner.classList.remove("hidden");
      window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
    });
    document.getElementById("cookie-preferences-link-2")?.addEventListener("click", (e) => {
      e.preventDefault();
      localStorage.removeItem(key);
      banner.classList.remove("hidden");
      window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
    });
  })();
</script>

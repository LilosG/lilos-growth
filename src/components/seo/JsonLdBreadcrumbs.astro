---
export interface Crumb {
  name: string;
  item: string;
}
export interface Props {
  items: Crumb[];
  idSuffix?: string;
}
const { items = [], idSuffix = '#bread' } = Astro.props as Props;
const site = Astro.site?.toString() ?? 'https://lilosgrowth.com';
const toAbs = (u: string) => (u?.startsWith('http') ? u : new URL(u || '/', site).toString());
const node =
  Array.isArray(items) && items.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        '@id': `${toAbs('/')}${idSuffix.replace(/^#?/, '#')}`,
        itemListElement: items.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: toAbs(c.item),
        })),
      }
    : null;
---

{node && <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />}

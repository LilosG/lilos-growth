---
export interface Props {
  faqs: import('~/data/results').FaqItem[];
}
const { faqs } = Astro.props;
---

<div class="mx-auto max-w-3xl space-y-4">
  {
    faqs.map((f) => (
      <details class="group rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <summary class="cursor-pointer list-none flex items-center justify-between">
          <span class="text-lg text-heading tracking-tight font-heading font-bold">{f.q}</span>
          <span
            class="ml-4 inline-flex h-7 w-7 items-center justify-center rounded-full border border-gray-300 text-gray-700 transition group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <div class="mt-3 text-body">{f.a}</div>
      </details>
    ))
  }
</div>

---
import type { LogoItem } from '~/data/results';
const { items } = Astro.props as { items: LogoItem[] };
---

<div class="flex flex-wrap justify-center items-center gap-5 md:gap-6">
  {
    items?.map((item) => {
      const box = (
        <div class="h-16 w-[220px] md:h-16 md:w-[220px] flex items-center justify-center rounded-xl border border-gray-200 bg-white/60">
          <img
            src={item.src}
            alt={item.name ?? 'Client logo'}
            width="220"
            height="64"
            loading="lazy"
            decoding="async"
            class="max-h-14 md:max-h-16 w-auto object-contain opacity-80 grayscale hover:grayscale-0 transition"
          />
        </div>
      );
      return item.href ? (
        <a
          href={item.href}
          class="rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#f56b2a]"
        >
          {box}
        </a>
      ) : (
        box
      );
    })
  }
</div>

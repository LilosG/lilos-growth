---
type LogoItem = {
  src?: string;
  href?: string;
  name?: string;
  alt?: string;
  width?: number;
  height?: number;
};

const { items = [] } = Astro.props as { items: LogoItem[] };

type LogoInput = LogoItem & {
  logo?: string;
  image?: string;
  title?: string;
  width?: number | string;
  height?: number | string;
};

const normalize = (it: LogoInput) => {
  const rawSrc: string =
    typeof it?.src === "string"
      ? it.src
      : typeof it?.logo === "string"
        ? it.logo
        : typeof it?.image === "string"
          ? it.image
          : "";

  // Ensure absolute web path (so /results doesn't break relative logo URLs)
  const src = rawSrc ? (rawSrc.startsWith("/") ? rawSrc : "/" + rawSrc.replace(/^\/+/, "")) : "";

  const name = String(it?.name ?? it?.title ?? it?.alt ?? "").trim();
  // ✅ Parenthesized to avoid mixing ?? with || without precedence
  const alt = String((it?.alt ?? name) || "Client logo");

  const href = typeof it?.href === "string" ? it.href : "";
  const width = Number(it?.width ?? 200);
  const height = Number(it?.height ?? 80);

  return { src, name, alt, href, width, height };
};

const logos: LogoItem[] = items.map((item) => normalize(item));
---

<section aria-label="Client logos">
  <ul class="grid grid-cols-2 items-center gap-6 sm:grid-cols-3 md:grid-cols-4 md:gap-8">
    {
      logos.map((l) => (
        <li class="flex">
          <div class="flex w-full items-center justify-center rounded-2xl border border-gray-200 bg-white px-6 py-4">
            {l.src ? (
              l.href ? (
                <a href={l.href} class="inline-flex items-center justify-center">
                  <img
                    src={l.src}
                    alt={l.alt}
                    width={l.width}
                    height={l.height}
                    loading="lazy"
                    decoding="async"
                    class="h-10 w-auto object-contain grayscale md:h-12"
                  />
                </a>
              ) : (
                <img
                  src={l.src}
                  alt={l.alt}
                  width={l.width}
                  height={l.height}
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-auto object-contain grayscale md:h-12"
                />
              )
            ) : (
              <span class="inline-flex items-center justify-center rounded-xl bg-white px-3 py-2 text-sm text-gray-600">
                {l.name || "Client"}
              </span>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>

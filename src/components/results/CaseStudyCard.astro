---
/**
 * CaseStudyCard - Enhanced with service type badges
 */
import { serviceTypeLabels } from "~/data/results";
import type { CaseStudy, ServiceType } from "~/data/results";

export interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

const kpis = Array.isArray(study.kpis) ? study.kpis.slice(0, 3) : [];
const primaryHref = study.ctaHref ?? "/contact";
const primaryText = study.ctaText ?? "View approach";
const screenshot = study.screenshot?.src;
const websiteUrl = study.websiteUrl;
const serviceTypes = study.serviceTypes || [];const normalizeCaseStudyHref = (href?: string | null): string => {
  // Until case study detail pages exist, never emit /results/<slug> links.
  if (typeof href === "string" && href.startsWith("/results/")) return "/results";
  return href ?? "/results";
};


---

<article
  class="group flex h-full flex-col overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm transition-all hover:shadow-lg"
  data-services={serviceTypes.join(",")}
>
  <!-- Screenshot -->
  {
    screenshot && websiteUrl && (
      <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
        <img
          src={screenshot}
          alt={study.screenshot?.alt || `${study.client} website`}
          class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
        <a
          href={websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary/90 absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        >
          <span class="flex items-center gap-2 text-lg font-semibold text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            View Live Site
          </span>
        </a>
      </div>
    )
  }

  <!-- Content -->
  <div class="flex flex-1 flex-col p-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3">
          {
            study.image?.src && (
              <img
                src={study.image.src}
                alt={study.image.alt ?? study.client}
                class="h-8 w-auto object-contain opacity-80"
                loading="lazy"
              />
            )
          }
        </div>
        <h3 class="mt-3 font-heading text-xl font-bold text-heading">
          {study.title ?? study.client}
        </h3>
        <p class="mt-1 text-sm text-gray-500">
          {study.city} · {study.sectorTag}
        </p>
      </div>
    </div>

    <!-- Service Type Badges -->
    {
      serviceTypes.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {serviceTypes.map((type: ServiceType) => (
            <span
              class:list={[
                "inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold",
                type === "website" && "bg-blue-50 text-blue-700",
                type === "gbp" && "bg-green-50 text-green-700",
                type === "local-seo" && "bg-purple-50 text-purple-700",
              ]}
            >
              {type === "website" && (
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              )}
              {type === "gbp" && (
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
              )}
              {type === "local-seo" && (
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  />
                </svg>
              )}
              {serviceTypeLabels[type]}
            </span>
          ))}
        </div>
      )
    }

    <!-- KPIs -->
    {
      kpis.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-3">
          {kpis.map((kpi) => (
            <div class="rounded-xl bg-gray-50 px-3 py-2 text-center">
              <p class="font-heading text-lg font-bold text-primary">{kpi.value}</p>
              <p class="text-xs text-gray-500">{kpi.label}</p>
            </div>
          ))}
        </div>
      )
    }

    <!-- Blurb -->
    {study.blurb && <p class="mt-4 flex-1 text-sm text-body">{study.blurb}</p>}

    <!-- Footer -->
    <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-4">
      <span class="text-xs font-medium uppercase tracking-wider text-gray-400"> Case Study </span>
      <a
        href={primaryHref}
        class="inline-flex items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-hover"
      >
        {primaryText}
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</article>

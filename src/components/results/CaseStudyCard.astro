---
export interface Props {
  study: import('~/data/results').CaseStudy;
}
const { study } = Astro.props;

const kpis = Array.isArray(study.kpis) ? study.kpis.slice(0, 3) : [];
const primaryHref = study.ctaHref ?? '/contact';
const primaryText = study.ctaText ?? 'See details';
---

<article
  class="group h-full rounded-2xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition flex flex-col"
>
  <header class="flex items-center gap-4">
    <div
      class="h-12 w-[160px] flex items-center justify-center rounded-lg border border-gray-100 bg-white/70 overflow-hidden"
    >
      {
        study.image?.src ? (
          <img
            src={study.image.src}
            alt={study.image.alt ?? study.client}
            width="160"
            height="48"
            loading="lazy"
            decoding="async"
            class="max-h-10 w-auto object-contain opacity-90"
          />
        ) : (
          <span class="text-sm font-semibold text-gray-500">{study.client}</span>
        )
      }
    </div>
    <div>
      <h3 class="text-lg md:text-xl font-heading text-heading tracking-tight font-bold">
        {study.title ?? `${study.client} — ${study.city}`}
      </h3>
      <div class="mt-1 flex flex-wrap gap-2">
        {
          study.sectorTag && (
            <span class="px-2.5 py-0.5 rounded-full border border-gray-200 bg-gray-50 text-xs text-body">
              {study.sectorTag}
            </span>
          )
        }
        {
          study.locationTag && (
            <span class="px-2.5 py-0.5 rounded-full border border-gray-200 bg-gray-50 text-xs text-body">
              {study.locationTag}
            </span>
          )
        }
      </div>
    </div>
  </header>

  {
    kpis.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {kpis.map((k) => (
          <li class="text-sm px-2.5 py-1 rounded-full border border-gray-200 bg-gray-50">
            <span class="font-semibold">{k.value}</span>
            <span class="text-gray-600"> {k.label}</span>
            {k.sr && <span class="sr-only">{k.sr}</span>}
          </li>
        ))}
      </ul>
    )
  }

  {study.blurb && <p class="mt-4 text-body">{study.blurb}</p>}

  <footer class="mt-auto pt-6 border-t border-gray-100 flex items-center justify-between">
    <span class="text-sm text-gray-500">Case study</span>
    <a
      href={primaryHref}
      data-astro-prefetch
      class="inline-flex items-center justify-center rounded-2xl px-4 py-2 text-white bg-[#f56b2a] hover:bg-[#f34e00] focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a] shadow-sm font-heading font-semibold"
      aria-label={`${primaryText} for ${study.client}`}
    >
      {primaryText}
    </a>
  </footer>
</article>

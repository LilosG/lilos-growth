---
export interface Props {
  items: import("~/data/results").Testimonial[];
}
const { items } = Astro.props;
---

<section aria-labelledby="testimonials" class="w-full">
  <h2 id="testimonials" class="sr-only">What clients say</h2>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      items.map((t) => (
        <figure class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm">
          <blockquote class="text-heading">&ldquo;{t.quote}&rdquo;</blockquote>
          <figcaption class="mt-4 text-sm text-body">
            <span class="font-semibold text-heading">{t.author}</span>
            {t.role ? ` • ${t.role}` : ""}
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

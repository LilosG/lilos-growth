---
export interface Props {
  stat: import('~/data/results').ResultsStat;
}
const { stat } = Astro.props;
---

<div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition" data-id={stat.id}>
  <div class="text-3xl md:text-4xl font-heading tracking-tight text-heading font-bold">{stat.value}</div>
  <div class="mt-2 text-body">{stat.label}</div>
  {stat.note && <div class="mt-1 text-sm text-gray-500">{stat.note}</div>}
</div>

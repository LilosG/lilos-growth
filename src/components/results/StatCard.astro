---
import type { ResultsStat } from '~/data/results';
const { stat } = Astro.props as { stat: ResultsStat };
---

<figure
  class="h-full min-h-[112px] rounded-2xl border border-gray-200 bg-white px-5 py-5 flex flex-col justify-center shadow-sm"
>
  <figcaption class="text-[11px] uppercase tracking-wide text-gray-500 leading-none">{stat.label}</figcaption>
  <div class="mt-2 text-2xl font-semibold text-gray-900 leading-tight" aria-label={(stat as any).note ?? stat.value}>
    {stat.value}
  </div>
  {(stat as any).note ? <p class="mt-1 text-xs text-gray-500">{(stat as any).note}</p> : null}
</figure>

---
import type { ResultsStat } from "~/data/results";
const { stat } = Astro.props as { stat: ResultsStat };

type StatWithNote = ResultsStat & { note?: string };
const note = (stat as StatWithNote).note;
---

<figure
  class="flex h-full min-h-[128px] flex-col justify-center rounded-3xl border border-gray-100 bg-white px-5 py-5 shadow-sm"
>
  <figcaption class="text-[11px] uppercase leading-none tracking-wide text-gray-500">
    {stat.label}
  </figcaption>
  <div
    class="mt-2 text-[28px] font-semibold leading-tight text-gray-900 md:text-[30px]"
    aria-label={note ?? stat.value}
  >
    {stat.value}
  </div>
  {note ? <p class="mt-1 text-xs text-gray-500">{note}</p> : null}
</figure>

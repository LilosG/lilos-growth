---
export interface Props {
  steps: import("~/data/results").ProcessStep[];
}
const { steps } = Astro.props;
---

<ol class="grid grid-cols-1 gap-6 md:grid-cols-3 xl:grid-cols-5">
  {
    steps.map((s) => (
      <li class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm">
        <div class="font-mono text-sm text-gray-400">{s.step}</div>
        <div class="mt-1 font-heading text-lg font-bold tracking-tight text-heading">{s.title}</div>
        <p class="mt-2 text-body">{s.text}</p>
        {s.desc && <p class="mt-1 text-sm text-gray-600">{s.desc}</p>}
      </li>
    ))
  }
</ol>

---
export interface Props {
  title?: string;
  body?: string;
  primaryHref?: string;
  primaryText?: string;
  secondaryHref?: string;
  secondaryText?: string;
}

const {
  title = 'See what this could look like in your city',
  body = 'We’ll audit your GBP and top pages, outline quick wins, and map a 90-day plan to lift calls.',
  primaryHref = '/contact',
  primaryText = 'Get a Free Growth Plan',
  secondaryHref = '/services',
  secondaryText = 'Explore Services',
} = Astro.props;
---

<section class="py-20 bg-[#253242] text-white border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-balance">
      {title}
    </h2>
    <p class="mt-3 text-white/90 max-w-2xl mx-auto text-lg">
      {body}
    </p>
    <div class="mt-6 flex flex-wrap gap-4 justify-center">
      <a
        href={primaryHref}
        data-astro-prefetch
        aria-label={primaryText}
        class="inline-flex items-center px-7 py-3 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold shadow transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]"
      >
        {primaryText}
      </a>
      <a
        href={secondaryHref}
        data-astro-prefetch
        aria-label={secondaryText}
        class="inline-flex items-center px-7 py-3 rounded-2xl border border-white/30 text-white/95 hover:bg-white/10 font-heading font-semibold shadow transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white/70"
      >
        {secondaryText}
      </a>
    </div>
  </div>
</section>

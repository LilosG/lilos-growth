---
interface Props {
  title: string;
  subtitle?: string;
  price: string;
  period?: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  badgeText?: string;
}
const {
  title,
  subtitle,
  price,
  period = "/mo",
  bullets = [],
  ctaText,
  ctaHref,
  badgeText,
} = Astro.props;
---

<article
  class="relative flex h-full flex-col rounded-2xl border border-[#f56b2a]/10 bg-white p-6 shadow-md shadow-[#f56b2a]/10"
>
  {
    badgeText && (
      <div class="absolute -top-3 left-1/2 -translate-x-1/2">
        <span class="inline-flex items-center rounded-full border border-[#f56b2a]/30 bg-[#fff7f0] px-2.5 py-1 text-[10px] font-semibold text-[#f56b2a] shadow">
          {badgeText}
        </span>
      </div>
    )
  }
  <header class="mb-3">
    <h3 class="text-lg font-extrabold text-[#253242]">{title}</h3>
    {subtitle && <p class="mt-0.5 text-[13px] text-slate-600">{subtitle}</p>}
    <div class="mt-2 flex items-baseline gap-1">
      <div class="text-2xl font-extrabold text-[#f56b2a]">{price}</div>
      {period && <div class="text-sm font-medium text-slate-500">{period}</div>}
    </div>
  </header>

  <ul class="mt-2 flex-1 space-y-2 text-[13px] leading-relaxed text-slate-700">
    {
      bullets.map((b) => (
        <li class="flex gap-2">
          <span class="mt-1 inline-block h-1.5 w-1.5 rounded-full" style="background:#f56b2a;" />
          <span set:html={b} />
        </li>
      ))
    }
  </ul>

  <div class="mt-4">
    <a
      href={ctaHref}
      class="inline-flex w-full items-center justify-center rounded-lg bg-[#f56b2a] px-4 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-[#c9400a]"
    >
      {ctaText}
    </a>
  </div>
</article>

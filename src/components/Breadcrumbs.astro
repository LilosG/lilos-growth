---
interface Crumb {
  name: string;
  url: string;
}
const { items } = Astro.props as { items: Crumb[] };
---

<nav aria-label="Breadcrumb" class="text-sm text-gray-600">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((it: Crumb, idx: number) => (
        <>
          <li>
            <a href={it.url} class="hover:underline">
              {it.name}
            </a>
          </li>
          {idx < items.length - 1 && <li>/</li>}
        </>
      ))
    }
  </ol>
</nav>

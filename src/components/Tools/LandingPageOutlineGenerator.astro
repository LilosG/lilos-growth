---
/**
 * Landing Page Outline Generator
 * Pure client-side utility — no SSR or external deps.
 * Produces a copyable Markdown outline based on service + city.
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading">
    Landing Page Outline Generator
  </h2>
  <p class="mb-5 text-center text-sm leading-relaxed text-body">
    Generate a proven, conversion-friendly outline for a local service landing page.
  </p>

  <form id="lpo-form" class="grid w-full gap-3">
    <input
      id="lpo-service"
      type="text"
      required
      placeholder="Service (e.g., Water Heater Repair)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />
    <input
      id="lpo-city"
      type="text"
      required
      placeholder="City/Area (e.g., Denver, CO)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />
    <input
      id="lpo-audience"
      type="text"
      placeholder="Audience (optional, e.g., homeowners, property managers)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />
    <input
      id="lpo-cta"
      type="text"
      placeholder='Primary CTA (optional, e.g., "Schedule a Call")'
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />

    <button
      type="submit"
      class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
    >
      Generate Outline
    </button>
  </form>

  <div id="lpo-output" class="mt-5 hidden">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="font-semibold text-heading">Result (Markdown)</h3>
      <button
        id="lpo-copy"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50"
      >
        Copy
      </button>
    </div>
    <textarea
      id="lpo-text"
      rows="18"
      readonly
      class="w-full select-all resize-y rounded-xl border-2 border-[#f56b2a]/30 bg-gray-50 p-4 font-mono text-sm leading-5 transition"
      style="min-height:240px"></textarea>
  </div>
</div>

<script is:inline>
  // Plain JS only — keep it simple and lint-friendly.
  (function () {
    const form = document.getElementById("lpo-form");
    const outWrap = document.getElementById("lpo-output");
    const outText = document.getElementById("lpo-text");
    const copyBtn = document.getElementById("lpo-copy");

    function mdEscape(s) {
      return String(s || "").replace(/[<>]/g, (m) => (m === "<" ? "&lt;" : "&gt;"));
    }

    function buildOutline({ service, city, audience, cta }) {
      const svc = mdEscape(service);
      const loc = mdEscape(city);
      const aud = audience ? mdEscape(audience) : "customers";
      const call = cta || "Get a Free Quote";

      // Construct a safe Markdown string with explicit newlines to avoid unterminated literals.
      const lines = [
        `# ${svc} in ${loc}`,
        "",
        `**Dominate your local market.** Professional ${svc.toLowerCase()} for ${aud} in ${loc}. Fast response, upfront pricing, and 5-star service.`,
        "",
        `**Primary CTA:** ${call}`,
        "",
        "---",
        "",
        "## 1) Hero Section",
        `- Headline: "${svc} in ${loc}"`,
        `- Subheadline: Quick, reliable & transparent for ${aud}.`,
        `- CTA Button: ${call}`,
        "- Trust badges (reviews, years in business, licenses)",
        "",
        "## 2) Social Proof",
        "- Star rating + review count",
        "- 2–3 short testimonials with names/neighborhoods",
        "",
        "## 3) Why Choose Us",
        "- Bullet list (fast response, certified techs, honest pricing, guaranteed work)",
        "",
        "## 4) Services We Offer",
        `- Core ${svc.toLowerCase()} solutions (add bullets)`,
        "- Related add-on services",
        "",
        "## 5) How It Works",
        "- Step 1: Call or request a quote",
        "- Step 2: On-site assessment & upfront price",
        "- Step 3: We complete the job right — guaranteed",
        "",
        "## 6) Areas We Serve",
        `- Neighborhoods near ${loc} (3–8 items)`,
        "",
        "## 7) FAQs",
        "- Q1: Pricing & estimates",
        "- Q2: Availability/response time",
        "- Q3: Warranty/guarantees",
        "- Q4: Licensed & insured",
        "",
        "## 8) Final Call-to-Action",
        `- Button: ${call}`,
        `- Alt: Call (phone) | Text | Email`,
        "",
        "---",
        "",
        "### SEO Notes",
        `- Title: ${svc} in ${loc} | Company Name`,
        `- Meta: ${svc} for ${aud} in ${loc}. Same-day service, honest pricing, 5-star reviews.`,
        `- URL: /services/${svc.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-${loc.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`,
      ];

      return lines.join("\n");
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const service = document.getElementById("lpo-service").value.trim();
      const city = document.getElementById("lpo-city").value.trim();
      const audience = document.getElementById("lpo-audience").value.trim();
      const cta = document.getElementById("lpo-cta").value.trim();

      if (!service || !city) return;

      const md = buildOutline({ service, city, audience, cta });
      outText.value = md;
      outWrap.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(outText.value);
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = "Copy"), 900);
      } catch {}
    });
  })();
</script>

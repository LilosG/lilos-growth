---
/**
 * SERP Preview - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="serp-form" class="flex flex-1 flex-col space-y-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Page Title <span class="text-gray-400">(~60 chars)</span></label>
      <input id="serp-title" type="text" maxlength="70" placeholder="Best Plumber in Denver | 24/7 Service" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      <div class="mt-1 text-xs text-gray-500"><span id="title-count">0</span>/60</div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Page URL</label>
      <input id="serp-url" type="url" placeholder="https://example.com/plumbing" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Meta Description <span class="text-gray-400">(~155 chars)</span></label>
      <textarea id="serp-desc" rows="2" maxlength="170" placeholder="Professional plumbing services in Denver..." class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40"></textarea>
      <div class="mt-1 text-xs text-gray-500"><span id="desc-count">0</span>/155</div>
    </div>
    <div>
      <span class="mb-2 block text-xs font-medium text-gray-500">Preview</span>
      <div class="rounded-lg border border-gray-200 bg-white p-4">
        <div id="preview-url" class="truncate text-sm text-green-700">example.com</div>
        <div id="preview-title" class="truncate text-lg text-blue-800 hover:underline">Your Page Title</div>
        <div id="preview-desc" class="line-clamp-2 text-sm text-gray-600">Your meta description appears here.</div>
      </div>
    </div>
    <button type="button" id="serp-preview-btn" class="btn btn-primary mt-auto h-11 w-full">Update Preview</button>
  </form>
</div>

<script>
  (function () {
    var titleEl = document.getElementById('serp-title') as HTMLInputElement | null;
    var urlEl = document.getElementById('serp-url') as HTMLInputElement | null;
    var descEl = document.getElementById('serp-desc') as HTMLTextAreaElement | null;
    var titleCount = document.getElementById('title-count') as HTMLElement | null;
    var descCount = document.getElementById('desc-count') as HTMLElement | null;
    var previewTitle = document.getElementById('preview-title') as HTMLElement | null;
    var previewUrl = document.getElementById('preview-url') as HTMLElement | null;
    var previewDesc = document.getElementById('preview-desc') as HTMLElement | null;

    if (!titleEl || !urlEl || !descEl || !titleCount || !descCount || !previewTitle || !previewUrl || !previewDesc) return;

    function update() {
      if (!titleEl || !urlEl || !descEl || !titleCount || !descCount || !previewTitle || !previewUrl || !previewDesc) return;
      titleCount.textContent = String(titleEl.value.length);
      descCount.textContent = String(descEl.value.length);
      titleCount.className = titleEl.value.length > 60 ? 'text-red-500' : '';
      descCount.className = descEl.value.length > 155 ? 'text-red-500' : '';
      previewTitle.textContent = titleEl.value || 'Your Page Title';
      previewDesc.textContent = descEl.value || 'Your meta description appears here.';
      if (urlEl.value) {
        try { previewUrl.textContent = new URL(urlEl.value).hostname + new URL(urlEl.value).pathname; }
        catch (e) { previewUrl.textContent = urlEl.value; }
      } else { previewUrl.textContent = 'example.com'; }
    }

    titleEl.addEventListener('input', update);
    urlEl.addEventListener('input', update);
    descEl.addEventListener('input', update);
    const btnEl = document.getElementById('serp-preview-btn') as HTMLButtonElement | null;
    if (btnEl) btnEl.addEventListener('click', update);
  })();
</script>
---
/**
 * Review Link + QR generator
 * - Uses /api/places to resolve a single Place (server-side with Places API)
 * - Builds profile & write-review links
 * - Generates a QR via a simple <img> endpoint
 */
---

<section class="rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">Google Review Link &amp; QR</h2>
  <p class="mb-5 text-sm text-body/80">
    Find your business in Google and get one-click links for customers to leave a review. Works best
    when you include city and state/ZIP.
  </p>

  <form id="rev-form" class="grid grid-cols-1 gap-3 md:grid-cols-3">
    <input
      id="rev-name"
      type="text"
      required
      placeholder="Business name (e.g., Acme Plumbing)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />
    <input
      id="rev-city"
      type="text"
      placeholder="City (e.g., Denver)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />
    <input
      id="rev-region"
      type="text"
      placeholder="State or ZIP (e.g., CO or 80202)"
      class="w-full rounded-xl border border-gray-300 px-4 py-2"
    />

    <div class="md:col-span-3">
      <button
        type="submit"
        class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
      >
        Find Place
      </button>
    </div>
  </form>

  <div id="rev-result" class="mt-5 text-sm"></div>

  <script is:inline>
    const form = document.getElementById("rev-form");
    const nameEl = document.getElementById("rev-name");
    const cityEl = document.getElementById("rev-city");
    const regionEl = document.getElementById("rev-region");
    const result = document.getElementById("rev-result");

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function renderError(msg) {
      result.innerHTML =
        '<div class="rounded-xl border border-red-200 p-4 bg-red-50 text-red-700">' +
        escapeHtml(msg) +
        "</div>";
    }

    function renderLinks(place) {
      const placeId = place.place_id;
      const displayName = place.name || "";
      const address = place.address || "";

      const profileUrl =
        "https://www.google.com/maps/place/?q=place_id:" + encodeURIComponent(placeId);
      const reviewUrl =
        "https://search.google.com/local/writereview?placeid=" + encodeURIComponent(placeId);
      const qrUrl =
        "https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=" +
        encodeURIComponent(reviewUrl);

      const html = [
        '<div class="rounded-xl border border-gray-200 p-4 bg-gray-50 space-y-3">',
        '<div class="font-semibold">Match</div>',
        '<div class="text-gray-700">',
        escapeHtml(displayName),
        "</div>",
        '<div class="text-gray-500">',
        escapeHtml(address),
        "</div>",
        '<div class="flex flex-col sm:flex-row gap-3 pt-2">',
        '<a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-white border border-gray-300 hover:bg-gray-50 transition" target="_blank" rel="nofollow noopener" href="',
        profileUrl,
        '" rel="noopener noreferrer" rel="noopener noreferrer">Open Profile</a>',
        '<a class="inline-flex items-center justify-center px-4 py-2 rounded-xl bg-[#f56b2a] text-white hover:bg-[#c9400a] transition" target="_blank" rel="nofollow noopener" href="',
        reviewUrl,
        '" rel="noopener noreferrer" rel="noopener noreferrer">Write a Review</a>',
        "</div>",
        '<div class="pt-4">',
        '<div class="text-xs uppercase tracking-wide text-gray-500 mb-2">QR for review link</div>',
        '<img class="rounded-xl border border-gray-200 bg-white" width="180" height="180" alt="Review QR" src="',
        qrUrl,
        '" />',
        "</div>",
        "</div>",
      ];
      result.innerHTML = html.join("");
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      const name = String(nameEl.value || "").trim();
      const city = String(cityEl.value || "").trim();
      const region = String(regionEl.value || "").trim();

      if (name.length === 0) {
        renderError("Please enter a business name.");
        return;
      }

      let q = name;
      if (city.length > 0) {
        q += " " + city;
      }
      if (region.length > 0) {
        q += " " + region;
      }

      result.innerHTML =
        '<div class="rounded-xl border border-gray-200 p-4 bg-gray-50 text-gray-600">Searching…</div>';

      try {
        const res = await fetch("/api/places?q=" + encodeURIComponent(q));
        if (!res.ok) {
          renderError("Request failed. Please try again.");
          return;
        }
        const data = await res.json();

        if (data && data.place_id) {
          renderLinks(data);
          return;
        }

        if (data && typeof data.error === "string") {
          renderError(data.error);
          return;
        }

        renderError("No matching place found. Try adding city/state or ZIP.");
      } catch {
        // parameter-less catch avoids @typescript-eslint/no-unused-vars
        renderError("Something went wrong. Please try again.");
      }
    });
  </script>
</section>

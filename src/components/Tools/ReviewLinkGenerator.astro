---
/**
 * Review Link + QR Generator
 * - Auto-finds Place ID via /api/places (if GOOGLE_MAPS_API_KEY is set on Vercel)
 * - Otherwise accepts manual Place ID
 * - Generates review link + QR (Google Chart API)
 * - Download gated by a locally stored email (no backend required)
 */
---

<div class="bg-white p-6 rounded-3xl shadow-lg">
  <h3 class="text-xl font-heading font-bold mb-2 text-heading">Google Review Link Generator</h3>
  <p class="text-sm text-body/80 mb-4">Create a direct “Write a review” link and QR code for your GBP.</p>

  <form id="rlg-form" class="grid gap-3">
    <input
      id="rlg-name"
      class="rounded-xl border border-gray-300 px-3 py-2"
      placeholder="Business Name (e.g., Acme Plumbing)"
    />
    <input
      id="rlg-city"
      class="rounded-xl border border-gray-300 px-3 py-2"
      placeholder="City / State (e.g., Denver, CO)"
    />
    <input
      id="rlg-place"
      class="rounded-xl border border-gray-300 px-3 py-2"
      placeholder="Place ID (optional if auto-lookup works)"
    />
    <div class="flex gap-3">
      <button
        type="submit"
        class="rounded-xl bg-[#f56b2a] px-4 py-2 font-semibold text-white shadow-lg hover:bg-[#c9400a]"
        >Generate Link</button
      >
      <button type="button" id="rlg-clear" class="rounded-xl border px-4 py-2">Clear</button>
    </div>
  </form>

  <div id="rlg-result" class="mt-5 hidden">
    <div class="rounded-2xl border border-gray-200 p-4">
      <div class="text-sm text-gray-600 mb-2">Review link</div>
      <div class="flex items-center justify-between gap-3">
        <a id="rlg-link" href="#" target="_blank" rel="noopener" class="truncate text-sm underline text-[#253242]"></a>
        <button id="rlg-copy" class="rounded-lg border px-3 py-1.5 text-sm">Copy</button>
      </div>

      <div class="mt-4 grid md:grid-cols-[200px_1fr] gap-4 items-start">
        <img id="rlg-qr" alt="QR Code" class="h-[200px] w-[200px] rounded-lg border" />
        <div class="grid gap-2">
          <div class="text-sm text-gray-700">Share & download</div>
          <div class="flex flex-wrap gap-2">
            <a
              id="rlg-download"
              download="review-qr.png"
              class="rounded-xl bg-[#f56b2a] px-4 py-2 text-sm font-semibold text-white shadow-lg hover:bg-[#c9400a] cursor-pointer"
              >Download QR</a
            >
            <button id="rlg-email-open" class="rounded-xl border px-4 py-2 text-sm">Email me a printable poster</button>
          </div>
          <div id="rlg-email-wrap" class="hidden mt-2">
            <div class="flex gap-2">
              <input
                id="rlg-email"
                type="email"
                class="flex-1 rounded-xl border px-3 py-2"
                placeholder="you@company.com"
              />
              <button id="rlg-email-save" class="rounded-xl bg-[#253242] text-white px-3 py-2 font-semibold"
                >Save</button
              >
            </div>
            <div class="text-[11px] text-gray-500 mt-1">
              Stored locally to unlock downloads. Hook to your CRM later.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="rlg-msg" class="mt-3 text-sm text-amber-700 hidden"></div>

  <script is:inline>
    (function () {
      const $ = (s, el) => (el || document).querySelector(s);
      const form = $('#rlg-form');
      const name = $('#rlg-name');
      const city = $('#rlg-city');
      const place = $('#rlg-place');
      const msg = $('#rlg-msg');
      const res = $('#rlg-result');
      const link = $('#rlg-link');
      const copy = $('#rlg-copy');
      const qr = $('#rlg-qr');
      const dl = $('#rlg-download');
      const clearBtn = $('#rlg-clear');
      const emailOpen = $('#rlg-email-open');
      const emailWrap = $('#rlg-email-wrap');
      const emailIn = $('#rlg-email');
      const emailSave = $('#rlg-email-save');

      function track(evt, data) {
        try {
          window.trackEvent && window.trackEvent(evt, data || {});
        } catch (_) {}
      }
      function setMsg(t) {
        msg.textContent = t || '';
        msg.classList.toggle('hidden', !t);
      }
      function unlockIfEmail() {
        const saved = localStorage.getItem('tools_email') || '';
        if (saved) {
          emailWrap.classList.add('hidden');
          emailOpen.classList.add('hidden');
          dl.classList.remove('pointer-events-none', 'opacity-60');
        } else {
          emailOpen.classList.remove('hidden');
          dl.classList.add('pointer-events-none', 'opacity-60');
        }
      }
      unlockIfEmail();

      emailOpen.addEventListener('click', () => emailWrap.classList.remove('hidden'));
      emailSave.addEventListener('click', () => {
        const v = (emailIn.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) return setMsg('Please enter a valid email to unlock downloads.');
        localStorage.setItem('tools_email', v);
        setMsg('Saved. Downloads unlocked.');
        unlockIfEmail();
        track('tools_lead_saved', { tool: 'review_link', email: 'stored' });
      });

      function buildReviewURL(pid) {
        return `https://search.google.com/local/writereview?placeid=${encodeURIComponent(pid)}`;
      }
      function setResult(pid) {
        const url = buildReviewURL(pid);
        link.href = url;
        link.textContent = url;
        const qrUrl = `https://chart.googleapis.com/chart?cht=qr&chs=200x200&chl=${encodeURIComponent(url)}`;
        qr.src = qrUrl;
        dl.setAttribute('href', qrUrl);
        res.classList.remove('hidden');
        setMsg('');
        track('tool_result', { tool: 'review_link' });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        res.classList.add('hidden');
        setMsg('');
        track('tool_submit', { tool: 'review_link' });
        const manual = (place.value || '').trim();
        if (manual) return setResult(manual);
        const q = `${(name.value || '').trim()} ${(city.value || '').trim()}`.trim();
        if (!q) return setMsg('Enter business name and city/state, or paste a Place ID.');
        try {
          const r = await fetch(`/api/places?q=${encodeURIComponent(q)}`);
          if (r.status === 501) return setMsg('Auto-lookup disabled. Paste your Place ID to continue.');
          const data = await r.json();
          if (!r.ok || !data.place_id)
            return setMsg('Could not find a Place ID. Try adding state/zip, or paste it manually.');
          setResult(data.place_id);
        } catch {
          setMsg('Lookup failed. Paste your Place ID to continue.');
        }
      });

      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(link.href);
          setMsg('Copied link to clipboard.');
          track('tool_copy', { tool: 'review_link' });
        } catch {}
      });
      clearBtn.addEventListener('click', () => {
        [name, city, place].forEach((i) => (i.value = ''));
        res.classList.add('hidden');
        setMsg('');
      });
    })();
  </script>
</div>

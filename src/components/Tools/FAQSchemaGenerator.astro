\---
/**
 * FAQ Schema Generator - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="faq-form" class="flex flex-1 flex-col space-y-3">
    <div id="faq-pairs" class="space-y-3">
      <div class="faq-pair rounded-lg border border-gray-200 bg-gray-50 p-3">
        <input type="text" placeholder="Question" data-question required class="mb-2 h-10 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
        <textarea rows="2" placeholder="Answer" data-answer required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40"></textarea>
      </div>
    </div>
    <button type="button" id="add-faq" class="w-full rounded-lg border-2 border-dashed border-gray-300 py-2 text-sm font-medium text-gray-500 transition hover:border-primary hover:text-primary">+ Add Question</button>
    <button type="submit" class="btn btn-primary mt-auto h-11 w-full">Generate Schema</button>
  </form>
  <div id="faq-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-gray-500">JSON-LD Output</span>
      <button id="faq-copy" type="button" class="text-xs font-semibold text-primary hover:underline">Copy</button>
    </div>
    <pre id="faq-output" class="max-h-64 overflow-auto rounded-lg bg-gray-900 p-4 text-xs text-green-400"></pre>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('faq-form');
    var pairsContainer = document.getElementById('faq-pairs');
    var addBtn = document.getElementById('add-faq');
    var resultEl = document.getElementById('faq-result');
    var outputEl = document.getElementById('faq-output');
    var copyBtn = document.getElementById('faq-copy');

    addBtn.addEventListener('click', function () {
      var div = document.createElement('div');
      div.className = 'faq-pair rounded-lg border border-gray-200 bg-gray-50 p-3 relative';
      div.innerHTML = '<button type="button" class="absolute top-2 right-2 text-gray-400 hover:text-red-500" onclick="this.parentElement.remove()">×</button><input type="text" placeholder="Question" data-question required class="mb-2 h-10 w-full rounded-lg border border-gray-300 px-3 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" /><textarea rows="2" placeholder="Answer" data-answer required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40"></textarea>';
      pairsContainer.appendChild(div);
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var faqs = [];
      var pairs = pairsContainer.querySelectorAll('.faq-pair');
      for (var i = 0; i < pairs.length; i++) {
        var q = pairs[i].querySelector('[data-question]').value.trim();
        var a = pairs[i].querySelector('[data-answer]').value.trim();
        if (q && a) faqs.push({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } });
      }
      if (faqs.length === 0) return;
      outputEl.textContent = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs }, null, 2);
      resultEl.classList.remove('hidden');
    });

    copyBtn.addEventListener('click', function () {
      navigator.clipboard.writeText(outputEl.textContent).then(function () {
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy'; }, 2000);
      });
    });
  })();
</script>
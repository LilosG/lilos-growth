---
/**
 * FAQ Schema Generator
 * Generates valid FAQPage JSON-LD schema markup
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">FAQ Schema Generator</h2>
  <p class="mb-5 text-sm text-body/80">
    Turn your Q&A content into valid FAQPage JSON-LD schema for better search visibility.
  </p>

  <form id="faq-form" class="grid gap-4">
    <div id="faq-pairs" class="space-y-4">
      <!-- Initial FAQ pair -->
      <div class="faq-pair space-y-2 rounded-xl border border-gray-200 p-4">
        <input
          type="text"
          placeholder="Question"
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
          data-question
          required
        />
        <textarea
          rows="3"
          placeholder="Answer"
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
          data-answer
          required
        ></textarea>
      </div>
    </div>

    <button
      type="button"
      id="add-faq"
      class="w-full rounded-xl border-2 border-dashed border-gray-300 px-4 py-2 text-sm font-semibold text-gray-600 transition hover:border-[#f56b2a] hover:text-[#f56b2a]"
    >
      + Add Another Question
    </button>

    <button
      type="submit"
      class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
    >
      Generate Schema
    </button>
  </form>

  <div id="faq-output" class="mt-5 hidden">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="font-semibold text-heading">FAQPage JSON-LD</h3>
      <button
        id="faq-copy"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50"
      >
        Copy
      </button>
    </div>
    <textarea
      id="faq-text"
      rows="12"
      readonly
      class="w-full resize-y rounded-xl border-2 border-[#f56b2a]/30 bg-gray-50 p-4 font-mono text-xs leading-5"
    ></textarea>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("faq-form");
    const pairsContainer = document.getElementById("faq-pairs");
    const addBtn = document.getElementById("add-faq");
    const outWrap = document.getElementById("faq-output");
    const outText = document.getElementById("faq-text");
    const copyBtn = document.getElementById("faq-copy");

    addBtn.addEventListener("click", function () {
      const newPair = document.createElement("div");
      newPair.className = "faq-pair space-y-2 rounded-xl border border-gray-200 p-4 relative";
      newPair.innerHTML = `
        <button type="button" class="absolute right-2 top-2 text-gray-400 hover:text-red-500" onclick="this.parentElement.remove()">✕</button>
        <input type="text" placeholder="Question" class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm" data-question required />
        <textarea rows="3" placeholder="Answer" class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm" data-answer required></textarea>
      `;
      pairsContainer.appendChild(newPair);
    });

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const pairs = pairsContainer.querySelectorAll(".faq-pair");
      const faqs = [];

      pairs.forEach((pair) => {
        const q = pair.querySelector("[data-question]").value.trim();
        const a = pair.querySelector("[data-answer]").value.trim();
        if (q && a) {
          faqs.push({
            "@type": "Question",
            name: q,
            acceptedAnswer: {
              "@type": "Answer",
              text: a,
            },
          });
        }
      });

      if (faqs.length === 0) return;

      const schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs,
      };

      outText.value = JSON.stringify(schema, null, 2);
      outWrap.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(outText.value);
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = "Copy"), 900);
      } catch {}
    });
  })();
</script>

hop","Title company","Tow truck service","Toy store","Transmission shop","Travel agency","Tree service","Trucking company","Tutoring service","Upholstery shop","Urgent care center","Urologist","Used car dealer","Vacuum cleaner repair shop","Veterinarian","Video production service","Vietnamese restaurant","Walk-in clinic","Waste management service","Watch repair service","Water damage restoration service","Water heater installation service","Water heater repair service","Waterproofing company","Web design company","Website designer","Wedding photographer","Wedding planner","Wedding venue","Weight loss service","Welder","Well drilling contractor","Wellness center","Window cleaning service","Window installation service","Window tinting service","Wine store","Winery","Yoga studio"];

  function fuzzySearch(query, categories, limit) {
    limit = limit || 12;
    var q = query.toLowerCase().trim();
    if (!q) return [];
    var results = [];
    for (var i = 0; i < categories.length; i++) {
      var cat = categories[i];
      var catLower = cat.toLowerCase();
      if (catLower === q) results.push({ cat: cat, score: 100 });
      else if (catLower.indexOf(q) === 0) results.push({ cat: cat, score: 80 });
      else if (catLower.indexOf(q) > -1) results.push({ cat: cat, score: 40 });
    }
    results.sort(function(a, b) { return b.score - a.score; });
    return results.slice(0, limit).map(function(r) { return r.cat; });
  }

  var form = document.getElementById('gbp-cat-form');
  var input = document.getElementById('gbp-cat-input');
  var resultsEl = document.getElementById('gbp-cat-results');

  function renderResults(categories) {
    if (categories.length === 0) {
      resultsEl.innerHTML = '<div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">No matching categories found.</div>';
      return;
    }
    var html = '<div class="flex items-center justify-between mb-2"><span class="text-xs font-medium text-gray-500">' + categories.length + ' matches</span><button type="button" id="gbp-copy-all" class="text-xs font-semibold text-primary hover:underline">Copy All</button></div><ul class="space-y-1">';
    for (var i = 0; i < categories.length; i++) {
      html += '<li class="group flex items-center justify-between rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm transition hover:border-primary/30 hover:bg-primary/5"><span class="text-heading">' + categories[i] + '</span><button type="button" class="copy-cat text-xs text-primary opacity-0 transition group-hover:opacity-100 hover:underline" data-cat="' + categories[i] + '">Copy</button></li>';
    }
    html += '</ul>';
    resultsEl.innerHTML = html;
    
    var copyBtns = resultsEl.querySelectorAll('.copy-cat');
    for (var j = 0; j < copyBtns.length; j++) {
      copyBtns[j].addEventListener('click', function(e) {
        var btn = e.target;
        navigator.clipboard.writeText(btn.getAttribute('data-cat')).then(function() {
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = 'Copy'; }, 1500);
        });
      });
    }
    
    var copyAllBtn = document.getElementById('gbp-copy-all');
    if (copyAllBtn) {
      copyAllBtn.addEventListener('click', function() {
        navigator.clipboard.writeText(categories.join('\n')).then(function() {
          copyAllBtn.textContent = 'Copied!';
          setTimeout(function() { copyAllBtn.textContent = 'Copy All'; }, 1500);
        });
      });
    }
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    renderResults(fuzzySearch(input.value.trim(), GBP_CATEGORIES));
  });
  
  var debounceTimer;
  input.addEventListener('input', function() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function() {
      var q = input.value.trim();
      if (q.length >= 2) renderResults(fuzzySearch(q, GBP_CATEGORIES));
      else if (q.length === 0) resultsEl.innerHTML = '';
    }, 200);
  });
</script>
---
/**
 * GBP Category Finder - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="gbp-cat-form" class="flex flex-1 flex-col gap-3">
    <input
      id="gbp-cat-input"
      type="text"
      required
      placeholder="Type your business type (e.g., plumber, dentist)"
      class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm text-heading placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40"
      autocomplete="off"
    />
    <button type="submit" class="btn btn-primary mt-auto h-11">Find Categories</button>
  </form>
  <div id="gbp-cat-results" class="mt-4" aria-live="polite"></div>
</div>

<script is:inline>
  // @ts-nocheck

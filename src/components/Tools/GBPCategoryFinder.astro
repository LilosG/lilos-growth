---
/**
 * GBP Primary Category Finder (client-only)
 * - Simple keyword → category suggestions
 * - No unused placeholders; no bare expressions that trip no-unused-expressions
 */
---

<section class="bg-white p-8 rounded-3xl shadow-lg">
  <h2 class="text-xl font-heading font-bold mb-3 text-heading">Google Business Profile Category Finder</h2>
  <p class="text-sm text-body/80 mb-5">
    Type what you do (e.g., “plumber”, “roof repair”). We’ll suggest Google Business Profile categories you can use.
  </p>

  <form id="gbp-cat-form" class="flex flex-col gap-3">
    <input
      id="gbp-cat-keyword"
      type="text"
      required
      placeholder="Service keyword (e.g., plumber)"
      class="w-full px-4 py-2 rounded-xl border border-gray-300"
    />
    <button
      type="submit"
      class="w-full px-5 py-2 rounded-xl bg-[#f56b2a] text-white font-semibold shadow-lg hover:bg-[#c9400a] transition"
    >
      Find Categories
    </button>
  </form>

  <div id="gbp-cat-results" class="mt-5 text-sm"></div>

  <script is:inline>
    // A compact list of common GBP categories for home services.
    // You can expand this list anytime; matching is fuzzy-contains.
    const GBP_CATEGORIES = [
      'Plumber',
      'Plumbing Supply Store',
      'HVAC Contractor',
      'Air Conditioning Repair Service',
      'Heating Contractor',
      'Electrician',
      'Electrical Supply Store',
      'Roofer',
      'Roofing Contractor',
      'Garage Door Supplier',
      'Appliance Repair Service',
      'Water Damage Restoration Service',
      'Carpet Cleaning Service',
      'House Cleaning Service',
      'Landscape Designer',
      'Landscaper',
      'Lawn Care Service',
      'Tree Service',
      'Pool Cleaning Service',
      'Pest Control Service',
      'Exterminator',
      'Painter',
      'Painting',
      'Masonry Contractor',
      'Concrete Contractor',
      'Fence Contractor',
      'Flooring Contractor',
      'Handyman',
      'Locksmith',
      'Window Installation Service',
      'Siding Contractor',
      'Gutter Cleaning Service',
      'Solar Energy Contractor',
      'Septic System Service',
      'Moving Company',
      'Junk Removal',
    ];

    const form = document.getElementById('gbp-cat-form');
    const input = document.getElementById('gbp-cat-keyword');
    const results = document.getElementById('gbp-cat-results');

    function renderList(items) {
      if (!Array.isArray(items) || items.length === 0) {
        results.innerHTML =
          '<div class="rounded-xl border border-gray-200 p-4 bg-gray-50">No matches. Try a broader keyword.</div>';
        return;
      }

      const html = [
        '<div class="rounded-xl border border-gray-200 p-4 bg-gray-50">',
        '<div class="font-semibold mb-2">Suggested categories</div>',
        '<ul class="list-disc pl-5 space-y-1">',
      ];
      for (let i = 0; i < items.length; i++) {
        html.push(`<li>${items[i]}</li>`);
      }
      html.push('</ul></div>');
      results.innerHTML = html.join('');
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      const q = String(input.value || '')
        .trim()
        .toLowerCase();
      if (q.length === 0) {
        results.innerHTML =
          '<div class="rounded-xl border border-red-200 p-4 bg-red-50 text-red-700">Please enter a keyword.</div>';
        return;
      }

      const matches = [];
      for (let i = 0; i < GBP_CATEGORIES.length; i++) {
        const cat = GBP_CATEGORIES[i];
        if (cat.toLowerCase().includes(q)) {
          matches.push(cat);
        }
      }

      // Show up to 12 matches, sorted by length (rough relevance heuristic)
      matches.sort(function (a, b) {
        return a.length - b.length;
      });

      renderList(matches.slice(0, 12));
    });
  </script>
</section>

---
import ReviewLinkGenerator from './ReviewLinkGenerator.astro';
import GBPCategoryFinder from './GBPCategoryFinder.astro';
import LandingPageOutlineGenerator from './LandingPageOutlineGenerator.astro';
---

<section class="max-w-7xl mx-auto px-4 py-16">
  <header class="mb-8 text-center">
    <h2 class="text-4xl font-heading font-extrabold text-[#253242]">Lead-Winning Local SEO Tools</h2>
    <p class="mt-2 text-[#253242]/70">Instant value for visitors, light email gate on exports for you.</p>
  </header>

  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <ReviewLinkGenerator />
    <GBPCategoryFinder />
    <LandingPageOutlineGenerator />
  </div>
</section>

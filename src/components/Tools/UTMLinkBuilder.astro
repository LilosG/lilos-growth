---
/**
 * UTM Link Builder - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="utm-form" class="flex flex-1 flex-col space-y-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Website URL *</label>
      <input
        id="utm-url"
        type="url"
        required
        placeholder="https://example.com/services"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Source *</label>
        <input
          id="utm-source"
          type="text"
          required
          placeholder="google, facebook"
          class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Medium *</label>
        <input
          id="utm-medium"
          type="text"
          required
          placeholder="cpc, email, social"
          class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Campaign Name *</label>
      <input
        id="utm-campaign"
        type="text"
        required
        placeholder="spring_promo"
        class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
      />
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600"
          >Term <span class="text-gray-400">(optional)</span></label
        >
        <input
          id="utm-term"
          type="text"
          placeholder="plumber+denver"
          class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600"
          >Content <span class="text-gray-400">(optional)</span></label
        >
        <input
          id="utm-content"
          type="text"
          placeholder="header_cta"
          class="focus:ring-primary/40 h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2"
        />
      </div>
    </div>
    <button type="submit" class="btn btn-primary mt-auto h-11 w-full">Generate UTM Link</button>
  </form>
  <div id="utm-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-gray-500">Your UTM Link</span>
      <button id="utm-copy" type="button" class="text-xs font-semibold text-primary hover:underline"
        >Copy</button
      >
    </div>
    <input
      id="utm-output"
      type="text"
      readonly
      class="h-11 w-full rounded-lg border border-gray-300 bg-gray-50 px-4 text-sm"
      onclick="this.select()"
    />
  </div>
</div>

<script is:inline>
  /* eslint-disable */
  (function () {
    const form = document.getElementById("utm-form");
    const resultEl = document.getElementById("utm-result");
    const outputEl = document.getElementById("utm-output");
    const copyBtn = document.getElementById("utm-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      try {
        const url = new URL(document.getElementById("utm-url").value.trim());
        url.searchParams.set("utm_source", document.getElementById("utm-source").value.trim());
        url.searchParams.set("utm_medium", document.getElementById("utm-medium").value.trim());
        url.searchParams.set("utm_campaign", document.getElementById("utm-campaign").value.trim());
        const term = document.getElementById("utm-term").value.trim();
        const content = document.getElementById("utm-content").value.trim();
        if (term) url.searchParams.set("utm_term", term);
        if (content) url.searchParams.set("utm_content", content);
        outputEl.value = url.toString();
        resultEl.classList.remove("hidden");
      } catch (e) {
        outputEl.value = "Invalid URL";
        resultEl.classList.remove("hidden");
      }
    });

    copyBtn.addEventListener("click", function () {
      navigator.clipboard.writeText(outputEl.value).then(function () {
        copyBtn.textContent = "Copied!";
        setTimeout(function () {
          copyBtn.textContent = "Copy";
        }, 2000);
      });
    });
  })();
</script>

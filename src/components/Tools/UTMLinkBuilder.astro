---
/**
 * UTM Link Builder - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="utm-form" class="flex flex-1 flex-col space-y-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Website URL *</label>
      <input id="utm-url" type="url" required placeholder="https://example.com/services" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Source *</label>
        <input id="utm-source" type="text" required placeholder="google, facebook" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Medium *</label>
        <input id="utm-medium" type="text" required placeholder="cpc, email, social" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Campaign Name *</label>
      <input id="utm-campaign" type="text" required placeholder="spring_promo" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Term <span class="text-gray-400">(optional)</span></label>
        <input id="utm-term" type="text" placeholder="plumber+denver" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Content <span class="text-gray-400">(optional)</span></label>
        <input id="utm-content" type="text" placeholder="header_cta" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
    </div>
    <button type="submit" class="btn btn-primary mt-auto h-11 w-full">Generate UTM Link</button>
  </form>
  <div id="utm-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-gray-500">Your UTM Link</span>
      <button id="utm-copy" type="button" class="text-xs font-semibold text-primary hover:underline">Copy</button>
    </div>
    <input id="utm-output" type="text" readonly class="h-11 w-full rounded-lg border border-gray-300 bg-gray-50 px-4 text-sm" onclick="this.select()" />
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('utm-form') as HTMLFormElement | null;
    var resultEl = document.getElementById('utm-result') as HTMLElement | null;
    var outputEl = document.getElementById('utm-output') as HTMLInputElement | null;
    var copyBtn = document.getElementById('utm-copy') as HTMLButtonElement | null;

    if (!form || !resultEl || !outputEl || !copyBtn) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      try {
        var urlInputEl = document.getElementById('utm-url') as HTMLInputElement | null;
        var sourceEl = document.getElementById('utm-source') as HTMLInputElement | null;
        var mediumEl = document.getElementById('utm-medium') as HTMLInputElement | null;
        var campaignEl = document.getElementById('utm-campaign') as HTMLInputElement | null;
        var termEl = document.getElementById('utm-term') as HTMLInputElement | null;
        var contentEl = document.getElementById('utm-content') as HTMLInputElement | null;

        if (!urlInputEl || !sourceEl || !mediumEl || !campaignEl || !termEl || !contentEl) return;

        var url = new URL(urlInputEl.value.trim());
        url.searchParams.set('utm_source', sourceEl.value.trim());
        url.searchParams.set('utm_medium', mediumEl.value.trim());
        url.searchParams.set('utm_campaign', campaignEl.value.trim());
        var term = termEl.value.trim();
        var content = contentEl.value.trim();
        if (term) url.searchParams.set('utm_term', term);
        if (content) url.searchParams.set('utm_content', content);
        outputEl!.value = url.toString();
        resultEl!.classList.remove('hidden');
      } catch (e) { outputEl!.value = 'Invalid URL'; resultEl!.classList.remove('hidden'); }
    });

    copyBtn.addEventListener('click', function () {
      if (!outputEl!.value) return;
      navigator.clipboard.writeText(outputEl!.value).then(function () {
        copyBtn!.textContent = 'Copied!';
        setTimeout(function () { copyBtn!.textContent = 'Copy'; }, 2000);
      });
    });
  })();
</script>
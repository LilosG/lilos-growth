---
/**
 * UTM Link Builder
 * Creates trackable URLs for Google Analytics campaigns
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">UTM Link Builder</h2>
  <p class="mb-5 text-sm text-body/80">
    Create trackable campaign URLs for Google Analytics to measure your marketing performance.
  </p>

  <form id="utm-form" class="grid gap-4">
    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Website URL <span class="text-red-500">*</span>
      </label>
      <input
        id="utm-url"
        type="url"
        required
        placeholder="https://example.com/services"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Campaign Source <span class="text-red-500">*</span>
        <span class="text-gray-400">(e.g., google, facebook, newsletter)</span>
      </label>
      <input
        id="utm-source"
        type="text"
        required
        placeholder="google"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Campaign Medium <span class="text-red-500">*</span>
        <span class="text-gray-400">(e.g., cpc, email, social)</span>
      </label>
      <input
        id="utm-medium"
        type="text"
        required
        placeholder="cpc"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Campaign Name <span class="text-gray-400">(optional)</span>
      </label>
      <input
        id="utm-campaign"
        type="text"
        placeholder="spring_sale_2025"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Campaign Term <span class="text-gray-400">(optional, for paid search)</span>
      </label>
      <input
        id="utm-term"
        type="text"
        placeholder="plumber+near+me"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Campaign Content <span class="text-gray-400">(optional, for A/B testing)</span>
      </label>
      <input
        id="utm-content"
        type="text"
        placeholder="banner_ad_v1"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <button
      type="submit"
      class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
    >
      Generate UTM Link
    </button>
  </form>

  <div id="utm-output" class="mt-5 hidden">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="font-semibold text-heading">Your Trackable URL</h3>
      <button
        id="utm-copy"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50"
      >
        Copy
      </button>
    </div>
    <div
      id="utm-result"
      class="break-all rounded-xl border-2 border-[#f56b2a]/30 bg-gray-50 p-4 text-sm"
    ></div>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("utm-form");
    const outWrap = document.getElementById("utm-output");
    const outResult = document.getElementById("utm-result");
    const copyBtn = document.getElementById("utm-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const baseUrl = document.getElementById("utm-url").value.trim();
      const source = document.getElementById("utm-source").value.trim();
      const medium = document.getElementById("utm-medium").value.trim();
      const campaign = document.getElementById("utm-campaign").value.trim();
      const term = document.getElementById("utm-term").value.trim();
      const content = document.getElementById("utm-content").value.trim();

      if (!baseUrl || !source || !medium) return;

      try {
        const url = new URL(baseUrl);
        const params = new URLSearchParams();

        params.set("utm_source", source);
        params.set("utm_medium", medium);
        if (campaign) params.set("utm_campaign", campaign);
        if (term) params.set("utm_term", term);
        if (content) params.set("utm_content", content);

        const finalUrl = url.origin + url.pathname + "?" + params.toString();
        outResult.textContent = finalUrl;
        outWrap.classList.remove("hidden");
      } catch {
        alert("Please enter a valid URL");
      }
    });

    copyBtn.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(outResult.textContent);
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = "Copy"), 900);
      } catch {}
    });
  })();
</script>

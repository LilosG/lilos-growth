---
const title = (Astro.props && Astro.props.title) || '';
const description = (Astro.props && Astro.props.description) || '';
const hasHeader = Boolean(title || description);
---

<article
  class="h-full bg-white rounded-2xl shadow-md border border-gray-200 px-6 pt-6 pb-6 sm:px-7 sm:pt-7 sm:pb-7 flex flex-col"
>
  {
    hasHeader && (
      <header>
        {title && <h3 class="text-lg md:text-xl font-heading font-bold text-heading">{title}</h3>}
        {description && <p class="mt-1 text-sm md:text-base text-body">{description}</p>}
      </header>
    )
  }
  <div class={hasHeader ? 'mt-4' : ''}>
    <slot />
  </div>
</article>

<article
  class="h-full bg-white rounded-2xl shadow-md border border-gray-200 px-6 pt-6 pb-6 sm:px-7 sm:pt-7 sm:pb-7 flex flex-col"
>
  <!-- Optional header area; if unused, it collapses with no space -->
  <header>
    <slot name="header" />
  </header>

  <!-- Body; slight top margin to balance spacing whether header exists or not -->
  <div class="mt-4">
    <slot />
  </div>
</article>

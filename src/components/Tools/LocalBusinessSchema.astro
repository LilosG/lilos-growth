---
/**
 * Local Business Schema Generator - Headless
 */
---

<div class="flex flex-1 flex-col">
  <form id="schema-form" class="flex flex-1 flex-col gap-3">
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Business Name *</label>
      <input id="schema-name" type="text" required placeholder="Acme Plumbing" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Phone *</label>
        <input id="schema-phone" type="tel" required placeholder="+1-555-123-4567" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Website URL *</label>
        <input id="schema-url" type="url" required placeholder="https://example.com" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Street Address *</label>
      <input id="schema-street" type="text" required placeholder="123 Main Street" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">City *</label>
        <input id="schema-city" type="text" required placeholder="Denver" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">State *</label>
        <input id="schema-state" type="text" required placeholder="CO" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">ZIP *</label>
        <input id="schema-zip" type="text" required placeholder="80202" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40" />
      </div>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Business Type</label>
      <select id="schema-type" class="h-11 w-full rounded-lg border border-gray-300 px-4 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40">
        <option value="LocalBusiness">Local Business</option>
        <option value="Plumber">Plumber</option>
        <option value="Electrician">Electrician</option>
        <option value="HVACBusiness">HVAC Business</option>
        <option value="RoofingContractor">Roofing Contractor</option>
        <option value="PestControlCompany">Pest Control</option>
        <option value="LandscapingBusiness">Landscaping</option>
        <option value="CleaningCompany">Cleaning Company</option>
      </select>
    </div>
    <div>
      <label class="mb-1 block text-xs font-medium text-gray-600">Description</label>
      <textarea id="schema-desc" rows="2" placeholder="Brief description of your business..." class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/40"></textarea>
    </div>
    <button type="submit" class="btn btn-primary mt-auto h-11 w-full">Generate Schema</button>
  </form>
  <div id="schema-result" class="mt-4 hidden">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-xs font-medium text-gray-500">JSON-LD Output</span>
      <button id="schema-copy" type="button" class="text-xs font-semibold text-primary hover:underline">Copy</button>
    </div>
    <pre id="schema-output" class="max-h-64 overflow-auto rounded-lg bg-gray-900 p-4 text-xs text-green-400"></pre>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('schema-form') as HTMLFormElement | null;
    var resultEl = document.getElementById('schema-result') as HTMLElement | null;
    var outputEl = document.getElementById('schema-output') as HTMLElement | null;
    var copyBtn = document.getElementById('schema-copy') as HTMLButtonElement | null;

    if (!form || !resultEl || !outputEl || !copyBtn) return;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var typeEl = document.getElementById('schema-type') as HTMLSelectElement | null;
      var nameEl = document.getElementById('schema-name') as HTMLInputElement | null;
      var phoneEl = document.getElementById('schema-phone') as HTMLInputElement | null;
      var urlEl = document.getElementById('schema-url') as HTMLInputElement | null;
      var streetEl = document.getElementById('schema-street') as HTMLInputElement | null;
      var cityEl = document.getElementById('schema-city') as HTMLInputElement | null;
      var stateEl = document.getElementById('schema-state') as HTMLInputElement | null;
      var zipEl = document.getElementById('schema-zip') as HTMLInputElement | null;
      var descEl = document.getElementById('schema-desc') as HTMLTextAreaElement | null;

      if (!typeEl || !nameEl || !phoneEl || !urlEl || !streetEl || !cityEl || !stateEl || !zipEl || !descEl) return;

      var schema: any = {
        '@context': 'https://schema.org',
        '@type': typeEl.value,
        name: nameEl.value.trim(),
        telephone: phoneEl.value.trim(),
        url: urlEl.value.trim(),
        address: {
          '@type': 'PostalAddress',
          streetAddress: streetEl.value.trim(),
          addressLocality: cityEl.value.trim(),
          addressRegion: stateEl.value.trim(),
          postalCode: zipEl.value.trim(),
          addressCountry: 'US'
        }
      };
      var desc = descEl.value.trim();
      if (desc) schema.description = desc;
      outputEl!.textContent = JSON.stringify(schema, null, 2);
      resultEl!.classList.remove('hidden');
    });

    copyBtn.addEventListener('click', function () {
      if (!outputEl!.textContent) return;
      navigator.clipboard.writeText(outputEl!.textContent).then(function () {
        copyBtn!.textContent = 'Copied!';
        setTimeout(function () { copyBtn!.textContent = 'Copy'; }, 2000);
      });
    });
  })();
</script>
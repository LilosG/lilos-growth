---
/**
 * Local Business Schema Generator
 * Generates JSON-LD LocalBusiness schema markup
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">Local Business Schema</h2>
  <p class="mb-5 text-sm text-body/80">
    Generate JSON-LD LocalBusiness schema to help search engines understand your business.
  </p>

  <form id="schema-form" class="grid gap-3 md:grid-cols-2">
    <div class="md:col-span-2">
      <label class="mb-1 block text-xs font-semibold text-gray-600">Business Name *</label>
      <input
        id="schema-name"
        type="text"
        required
        placeholder="Acme Plumbing"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">Phone Number *</label>
      <input
        id="schema-phone"
        type="tel"
        required
        placeholder="+1-555-123-4567"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Website URL <span class="text-gray-400">(optional)</span>
      </label>
      <input
        id="schema-url"
        type="url"
        placeholder="https://example.com"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div class="md:col-span-2">
      <label class="mb-1 block text-xs font-semibold text-gray-600">Street Address *</label>
      <input
        id="schema-street"
        type="text"
        required
        placeholder="123 Main St"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">City *</label>
      <input
        id="schema-city"
        type="text"
        required
        placeholder="Denver"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">State *</label>
      <input
        id="schema-state"
        type="text"
        required
        placeholder="CO"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">ZIP Code *</label>
      <input
        id="schema-zip"
        type="text"
        required
        placeholder="80202"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Price Range <span class="text-gray-400">(optional)</span>
      </label>
      <input
        id="schema-price"
        type="text"
        placeholder="$$"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
    </div>

    <div class="md:col-span-2">
      <button
        type="submit"
        class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
      >
        Generate Schema
      </button>
    </div>
  </form>

  <div id="schema-output" class="mt-5 hidden">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="font-semibold text-heading">LocalBusiness JSON-LD</h3>
      <button
        id="schema-copy"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50"
      >
        Copy
      </button>
    </div>
    <textarea
      id="schema-text"
      rows="14"
      readonly
      class="w-full resize-y rounded-xl border-2 border-[#f56b2a]/30 bg-gray-50 p-4 font-mono text-xs leading-5"
    ></textarea>
    <p class="mt-2 text-xs text-gray-600">
      Add this script to your website's &lt;head&gt; section or before &lt;/body&gt;
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("schema-form");
    const outWrap = document.getElementById("schema-output");
    const outText = document.getElementById("schema-text");
    const copyBtn = document.getElementById("schema-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const name = document.getElementById("schema-name").value.trim();
      const phone = document.getElementById("schema-phone").value.trim();
      const url = document.getElementById("schema-url").value.trim();
      const street = document.getElementById("schema-street").value.trim();
      const city = document.getElementById("schema-city").value.trim();
      const state = document.getElementById("schema-state").value.trim();
      const zip = document.getElementById("schema-zip").value.trim();
      const priceRange = document.getElementById("schema-price").value.trim();

      if (!name || !phone || !street || !city || !state || !zip) return;

      const schema = {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: name,
        telephone: phone,
        address: {
          "@type": "PostalAddress",
          streetAddress: street,
          addressLocality: city,
          addressRegion: state,
          postalCode: zip,
          addressCountry: "US",
        },
      };

      if (url) schema.url = url;
      if (priceRange) schema.priceRange = priceRange;

      const scriptTag = `<script type="application/ld+json">\n${JSON.stringify(schema, null, 2)}\n<\/script>`;
      outText.value = scriptTag;
      outWrap.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(outText.value);
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = "Copy"), 900);
      } catch {}
    });
  })();
</script>

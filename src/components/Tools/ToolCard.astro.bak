---
// src/components/Tools/ToolCard.astro
---

<article class="h-full flex flex-col rounded-2xl border border-gray-200 bg-white px-6 py-6 shadow-md sm:px-7 sm:py-7">
  <!-- Header collapses entirely when slot is unused -->
  <header class="empty:hidden mb-4">
    <slot name="header" />
  </header>

  <div class="flex-1">
    <slot />
  </div>
</article>

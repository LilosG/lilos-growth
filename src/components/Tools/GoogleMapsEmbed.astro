---
/**
 * Google Maps Embed Generator
 * Creates embed code for Google Maps
 */
---

<div class="flex flex-col rounded-3xl bg-white p-8 shadow-lg">
  <h2 class="mb-3 font-heading text-xl font-bold text-heading">Google Maps Embed</h2>
  <p class="mb-5 text-sm text-body/80">
    Generate an embed code to add an interactive Google Map to your website.
  </p>

  <form id="maps-form" class="grid gap-4">
    <div>
      <label class="mb-1 block text-xs font-semibold text-gray-600">
        Address or Place Name <span class="text-red-500">*</span>
      </label>
      <input
        id="maps-address"
        type="text"
        required
        placeholder="123 Main St, Denver, CO 80202"
        class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
      />
      <p class="mt-1 text-xs text-gray-500">
        Enter your business address or search for a landmark
      </p>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="mb-1 block text-xs font-semibold text-gray-600">Width</label>
        <input
          id="maps-width"
          type="text"
          value="600"
          placeholder="600"
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
        />
      </div>
      <div>
        <label class="mb-1 block text-xs font-semibold text-gray-600">Height</label>
        <input
          id="maps-height"
          type="text"
          value="450"
          placeholder="450"
          class="w-full rounded-lg border border-gray-300 px-4 py-2 text-sm"
        />
      </div>
    </div>

    <button
      type="submit"
      class="w-full rounded-xl bg-[#f56b2a] px-5 py-2 font-semibold text-white shadow-lg transition hover:bg-[#c9400a]"
    >
      Generate Embed Code
    </button>
  </form>

  <div id="maps-output" class="mt-5 hidden">
    <div class="mb-2 flex items-center justify-between">
      <h3 class="font-semibold text-heading">Embed Code</h3>
      <button
        id="maps-copy"
        type="button"
        class="rounded-lg border border-gray-300 px-3 py-1 text-sm hover:bg-gray-50"
      >
        Copy
      </button>
    </div>
    <textarea
      id="maps-code"
      rows="5"
      readonly
      class="w-full resize-y rounded-xl border-2 border-[#f56b2a]/30 bg-gray-50 p-4 font-mono text-xs leading-5"
    ></textarea>

    <div class="mt-4">
      <div class="mb-2 text-xs font-semibold text-gray-600">Preview</div>
      <div id="maps-preview" class="overflow-hidden rounded-xl border border-gray-200"></div>
    </div>

    <p class="mt-3 text-xs text-gray-600">
      Paste this code into your website's HTML where you want the map to appear.
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    const form = document.getElementById("maps-form");
    const outWrap = document.getElementById("maps-output");
    const outCode = document.getElementById("maps-code");
    const preview = document.getElementById("maps-preview");
    const copyBtn = document.getElementById("maps-copy");

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const address = document.getElementById("maps-address").value.trim();
      const width = document.getElementById("maps-width").value.trim() || "600";
      const height = document.getElementById("maps-height").value.trim() || "450";

      if (!address) return;

      const encodedAddress = encodeURIComponent(address);
      const embedUrl = `https://www.google.com/maps/embed/v1/place?key=YOUR_API_KEY&q=${encodedAddress}`;

      // Note: For a production tool, you'd want to use the actual Google Maps Embed API
      // For now, we'll use the simpler iframe approach
      const simpleUrl = `https://maps.google.com/maps?q=${encodedAddress}&output=embed`;

      const embedCode = `<iframe
  width="${width}"
  height="${height}"
  style="border:0"
  loading="lazy"
  allowfullscreen
  referrerpolicy="no-referrer-when-downgrade"
  src="${simpleUrl}">
</iframe>`;

      outCode.value = embedCode;
      preview.innerHTML = embedCode;
      outWrap.classList.remove("hidden");
    });

    copyBtn.addEventListener("click", async function () {
      try {
        await navigator.clipboard.writeText(outCode.value);
        copyBtn.textContent = "Copied!";
        setTimeout(() => (copyBtn.textContent = "Copy"), 900);
      } catch {}
    });
  })();
</script>

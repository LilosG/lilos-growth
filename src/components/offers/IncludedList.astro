---
import { Icon } from "astro-icon/components";

export interface Item {
  title: string;
  detail: string;
  icon: string;
}
export interface Props {
  title?: string;
  eyebrow?: string;
  items: Item[];
  id?: string;
}
const { title = "What's included", eyebrow = "What you get", items, id = "included" } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
    <h2
      id={`${id}-heading`}
      class="mt-3 text-center font-heading text-3xl font-bold text-secondary md:text-4xl"
    >
      {title}
    </h2>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="rounded-2xl border border-gray-200 bg-background-cream p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10">
              <Icon name={item.icon} class="h-6 w-6 text-primary" aria-hidden="true" />
            </span>
            <h3 class="mt-4 font-heading text-lg font-bold leading-snug text-secondary">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-body">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

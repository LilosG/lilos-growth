---
import { Icon } from "astro-icon/components";

export interface Props {
  title?: string;
  items: string[];
  id?: string;
}
const { title = "What's included", items, id = "included" } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-3xl px-4">
    <h2
      id={`${id}-heading`}
      class="text-center font-heading text-3xl font-bold text-secondary md:text-4xl"
    >
      {title}
    </h2>
    <ul class="mt-8 space-y-3">
      {
        items.map((item) => (
          <li class="flex items-start gap-3 rounded-xl border border-gray-100 bg-background-cream px-4 py-3">
            <Icon
              name="tabler:circle-check-filled"
              class="mt-0.5 h-6 w-6 shrink-0 text-primary"
              aria-hidden="true"
            />
            <span class="text-base text-heading">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

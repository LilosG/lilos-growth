---
import { Icon } from "astro-icon/components";

export interface Item {
  title: string;
  detail: string;
  icon: string;
}
export interface Props {
  title?: string;
  eyebrow?: string;
  intro: string;
  cta: { text: string; href: string };
  items: Item[];
  id?: string;
}
const { title = "What you get", eyebrow = "What you get", intro, cta, items, id = "included" } =
  Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="bg-white py-16 md:py-20">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-5 lg:gap-16 lg:px-8">
    <div class="lg:col-span-2">
      <div class="lg:sticky lg:top-28">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
        <h2
          id={`${id}-heading`}
          class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-secondary md:text-5xl"
        >
          {title}
        </h2>
        <p class="mt-5 text-base leading-relaxed text-gray-700 md:text-lg">{intro}</p>
        <a
          href={cta.href}
          class="mt-7 inline-flex h-12 items-center justify-center rounded-2xl bg-primary px-7 font-heading text-base font-semibold text-white shadow transition duration-200 hover:-translate-y-0.5 hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          >{cta.text}</a
        >
      </div>
    </div>
    <ul class="grid gap-x-8 gap-y-9 sm:grid-cols-2 lg:col-span-3">
      {
        items.map((item) => (
          <li class="flex gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/15">
              <Icon name={item.icon} class="h-5 w-5 text-primary" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-heading text-lg font-bold leading-snug text-secondary">
                {item.title}
              </h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-gray-700 md:text-base">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
export interface Step {
  title: string;
  desc: string;
}
export interface Props {
  steps: Step[];
  title?: string;
  eyebrow?: string;
}
const { steps, title = "How it works", eyebrow = "Simple process" } = Astro.props;
---

<section aria-labelledby="how-heading" class="bg-secondary py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
    <h2
      id="how-heading"
      class="mt-3 text-center font-heading text-3xl font-extrabold tracking-tight text-white md:text-5xl"
    >
      {title}
    </h2>
    <ol class="relative mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      <div
        class="absolute left-[16.66%] right-[16.66%] top-6 hidden h-px bg-gradient-to-r from-primary/20 via-primary to-primary/20 md:block"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute bottom-6 left-6 top-6 w-px bg-gradient-to-b from-primary to-primary/20 md:hidden"
        aria-hidden="true"
      >
      </div>
      {
        steps.map((step, i) => (
          <li class="relative flex gap-5 md:flex-col md:items-center md:text-center">
            <span
              class="relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary font-heading text-lg font-bold text-white shadow-lg ring-4 ring-secondary"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <h3 class="font-heading text-xl font-bold text-white">
                <span class="sr-only">Step {i + 1}: </span>
                {step.title}
              </h3>
              <p class="mt-2 text-base text-gray-300">{step.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

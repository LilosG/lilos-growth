---
export interface Props {
  steps: string[];
  title?: string;
}
const { steps, title = "How it works" } = Astro.props;
---

<section aria-labelledby="how-heading" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-4xl px-4">
    <h2
      id="how-heading"
      class="text-center font-heading text-3xl font-bold text-secondary md:text-4xl"
    >
      {title}
    </h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="rounded-2xl border border-gray-100 bg-background-cream p-6 text-center">
            <span
              class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary font-heading text-lg font-bold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <p class="mt-3 font-heading text-lg font-semibold text-heading">
              <span class="sr-only">Step {i + 1}: </span>
              {step}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

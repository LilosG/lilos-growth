---
export interface FaqItem {
  q: string;
  a: string;
}
export interface Props {
  items: FaqItem[];
  title?: string;
  /** tel: number in E.164, e.g. +18587222920 */
  phone: string;
}
const { items, title = "Questions, answered", phone } = Astro.props;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: i.a },
  })),
};
---

<section id="faq" aria-labelledby="faq-heading" class="bg-slate-50 py-16 md:py-20">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-3 lg:gap-16 lg:px-8">
    <div class="self-start lg:sticky lg:top-28">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">FAQ</p>
      <h2
        id="faq-heading"
        class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-secondary md:text-5xl"
      >
        {title}
      </h2>
      <p class="mt-4 text-base text-gray-700 md:text-lg">
        Still unsure? <a
          href={`tel:${phone}`}
          class="font-semibold text-primary underline underline-offset-4 hover:text-primary-hover"
          >Text Mike.</a
        >
      </p>
    </div>
    <div class="space-y-3 lg:col-span-2">
      {
        items.map((item, i) => (
          <details
            open={i === 0}
            class="group rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm transition hover:shadow-md"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded font-heading text-lg font-semibold text-heading focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span
                class="text-2xl leading-none text-primary transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-gray-700">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>

---
/**
 * Lead/application form. Posts to the site's existing Formspree endpoint (same as /contact).
 * Without JS it does a normal POST + redirect to /thank-you; with JS it submits in place
 * and shows the success message only after Formspree confirms.
 */
export interface Field {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "url";
  autocomplete?: string;
  required?: boolean;
  placeholder?: string;
  hint?: string;
}
export interface Props {
  id: string;
  title: string;
  intro?: string;
  fields: Field[];
  submitLabel: string;
  successMessage: string;
  /** Sent to Formspree so submissions are identifiable */
  source: string;
}
const { id, title, intro, fields, submitLabel, successMessage, source } = Astro.props;
const FORMSPREE = "https://formspree.io/f/movlbqdk";
const input =
  "block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-base text-heading focus:outline-none focus-visible:border-primary focus-visible:ring-2 focus-visible:ring-primary";
---

<section id={id} aria-labelledby={`${id}-heading`} class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-xl px-4">
    <h2
      id={`${id}-heading`}
      class="text-center font-heading text-3xl font-bold text-secondary md:text-4xl"
    >
      {title}
    </h2>
    {intro && <p class="mt-3 text-center text-body">{intro}</p>}

    <form
      method="POST"
      action={FORMSPREE}
      data-offer-form
      data-source={source}
      class="mt-8 space-y-5 rounded-2xl border border-gray-200 bg-background-cream p-6 shadow-sm"
    >
      <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />
      <input type="hidden" name="_subject" value={`New lead: ${source}`} />
      <input type="hidden" name="source" value={source} />
      <input
        type="text"
        name="_gotcha"
        tabindex="-1"
        autocomplete="off"
        class="hidden"
        aria-hidden="true"
      />

      {
        fields.map((f) => (
          <div>
            <label for={`${id}-${f.name}`} class="mb-1 block text-sm font-semibold text-heading">
              {f.label}
              {!f.required && <span class="font-normal text-muted"> (optional)</span>}
            </label>
            <input
              id={`${id}-${f.name}`}
              name={f.name === "email" ? "_replyto" : f.name}
              type={f.type ?? "text"}
              autocomplete={f.autocomplete}
              placeholder={f.placeholder}
              required={f.required}
              class={input}
            />
            {f.hint && <p class="mt-1 text-xs text-muted">{f.hint}</p>}
          </div>
        ))
      }

      <button
        type="submit"
        class="flex w-full items-center justify-center rounded-xl bg-primary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-60"
      >
        {submitLabel}
      </button>
      <p data-form-error role="alert" class="hidden text-center text-sm font-semibold text-red-700">
        Something went wrong. Please try again or email hello@lilosgrowth.com.
      </p>
    </form>

    <div
      data-form-success
      role="status"
      tabindex="-1"
      class="mt-8 hidden rounded-2xl border-2 border-primary bg-white p-8 text-center font-heading text-xl font-semibold text-heading focus:outline-none"
    >
      {successMessage}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-offer-form]").forEach((form) => {
    const wrap = form.parentElement;
    const success = wrap?.querySelector<HTMLElement>("[data-form-success]");
    const error = form.querySelector<HTMLElement>("[data-form-error]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error?.classList.add("hidden");
      if (button) button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add("hidden");
        success?.classList.remove("hidden");
        success?.focus();
        (window as unknown as { trackEvent?: (n: string, d?: object) => void }).trackEvent?.(
          "offer_lead_submit",
          { source: form.dataset.source }
        );
      } catch {
        error?.classList.remove("hidden");
        if (button) button.disabled = false;
      }
    });
  });
</script>

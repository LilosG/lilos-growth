---
/**
 * Lead/application form. Posts to the site's existing Formspree endpoint (same as /contact).
 * Without JS it does a normal POST + redirect to /thank-you; with JS it submits in place
 * and shows the success message only after Formspree confirms.
 */
export interface Field {
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "url";
  autocomplete?: string;
  required?: boolean;
  placeholder?: string;
  hint?: string;
  /** Render at half width on sm+ screens */
  half?: boolean;
}
export interface Props {
  id: string;
  title: string;
  intro?: string;
  bullets?: string[];
  eyebrow?: string;
  fields: Field[];
  submitLabel: string;
  successMessage: string;
  /** Sent to Formspree so submissions are identifiable */
  source: string;
}
const { id, title, intro, bullets = [], eyebrow = "Get started", fields, submitLabel, successMessage, source } =
  Astro.props;
const FORMSPREE = "https://formspree.io/f/movlbqdk";
const input =
  "block h-12 w-full rounded-xl border border-gray-300 bg-white px-4 text-base text-heading transition focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary";
---

<section id={id} aria-labelledby={`${id}-heading`} class="bg-white py-16 md:py-20">
  <div class="mx-auto grid max-w-7xl items-start gap-12 px-4 sm:px-6 lg:px-8 lg:grid-cols-5 lg:gap-16">
    <div class="lg:col-span-2 lg:pt-4">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
      <h2
        id={`${id}-heading`}
        class="mt-3 font-heading text-3xl font-extrabold tracking-tight text-secondary md:text-5xl"
      >
        {title}
      </h2>
      {intro && <p class="mt-4 text-base text-gray-700 md:text-lg">{intro}</p>}
      {
        bullets.length > 0 && (
          <ul class="mt-8 space-y-4">
            {bullets.map((b) => (
              <li class="flex items-start gap-3 text-heading">
                <svg
                  class="mt-0.5 h-6 w-6 shrink-0 text-primary"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.7 8.3-5.5 5.5a1 1 0 0 1-1.4 0l-2.5-2.5a1 1 0 1 1 1.4-1.4l1.8 1.8 4.8-4.8a1 1 0 0 1 1.4 1.4Z" />
                </svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="lg:col-span-3">
      <form
        method="POST"
        action={FORMSPREE}
        data-offer-form
        data-source={source}
        class="grid gap-5 rounded-3xl border border-slate-200 bg-slate-50 p-6 shadow-sm sm:grid-cols-2 sm:p-8"
      >
        <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />
        <input type="hidden" name="_subject" value={`New lead: ${source}`} />
        <input type="hidden" name="source" value={source} />
        <input
          type="text"
          name="_gotcha"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />

        {
          fields.map((f) => (
            <div class:list={[f.half ? "" : "sm:col-span-2"]}>
              <label for={`${id}-${f.name}`} class="mb-1.5 block text-sm font-semibold text-heading">
                {f.label}
                {!f.required && <span class="font-normal text-muted"> (optional)</span>}
              </label>
              <input
                id={`${id}-${f.name}`}
                name={f.name === "email" ? "_replyto" : f.name}
                type={f.type ?? "text"}
                autocomplete={f.autocomplete}
                placeholder={f.placeholder}
                required={f.required}
                class={input}
              />
              {f.hint && <p class="mt-1 text-xs text-muted">{f.hint}</p>}
            </div>
          ))
        }

        <button
          type="submit"
          class="flex h-14 w-full items-center justify-center rounded-xl bg-primary px-8 font-heading text-lg font-semibold text-white shadow transition hover:-translate-y-0.5 hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-60 sm:col-span-2"
        >
          {submitLabel}
        </button>
        <p
          data-form-error
          role="alert"
          class="hidden text-center text-sm font-semibold text-red-700 sm:col-span-2"
        >
          Something went wrong. Please try again or email hello@lilosgrowth.com.
        </p>
      </form>

      <div
        data-form-success
        role="status"
        tabindex="-1"
        class="hidden rounded-3xl border-2 border-primary bg-white p-6 text-center focus:outline-none sm:p-8"
      >
        <p class="font-heading text-xl font-semibold text-heading">{successMessage}</p>
        <div data-booking class="mt-6 border-t border-slate-200 pt-6">
          <p class="font-heading text-lg font-semibold text-secondary">
            Pick a time to go over it — 15 minutes.
          </p>
          <div data-booking-mount class="mt-4"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Same Calendly inline widget /contact#book uses; loaded only after a confirmed submission.
  const CALENDLY_URL =
    "https://calendly.com/mprickett-bluedoorsp/30min?text_color=1f2d3d&primary_color=f56b2a";
  type CalendlyWindow = Window & {
    Calendly?: { initInlineWidgets?: () => void };
    __calendlyLoaded?: boolean;
  };
  function mountBooking(success?: HTMLElement | null) {
    const mount = success?.querySelector<HTMLElement>("[data-booking-mount]");
    if (!mount || mount.childElementCount) return;
    const w = window as CalendlyWindow;
    if (!document.querySelector('link[href*="assets.calendly.com/assets/external/widget.css"]')) {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://assets.calendly.com/assets/external/widget.css";
      document.head.appendChild(css);
    }
    const widget = document.createElement("div");
    widget.className = "calendly-inline-widget overflow-hidden rounded-2xl border border-gray-100 bg-white";
    widget.dataset.url = CALENDLY_URL;
    widget.style.cssText = "min-width:320px;height:700px;";
    mount.appendChild(widget);
    const init = () => w.Calendly?.initInlineWidgets?.();
    if (w.Calendly) return init();
    const existing = document.querySelector('script[src*="assets.calendly.com/assets/external/widget.js"]');
    if (existing) {
      existing.addEventListener("load", init);
      return;
    }
    const s = document.createElement("script");
    s.src = "https://assets.calendly.com/assets/external/widget.js";
    s.async = true;
    s.onload = init;
    document.head.appendChild(s);
  }

  document.querySelectorAll<HTMLFormElement>("form[data-offer-form]").forEach((form) => {
    const wrap = form.parentElement;
    const success = wrap?.querySelector<HTMLElement>("[data-form-success]");
    const error = form.querySelector<HTMLElement>("[data-form-error]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      error?.classList.add("hidden");
      if (button) button.disabled = true;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.classList.add("hidden");
        success?.classList.remove("hidden");
        success?.focus();
        mountBooking(success);
        (window as unknown as { trackEvent?: (n: string, d?: object) => void }).trackEvent?.(
          "offer_lead_submit",
          { source: form.dataset.source }
        );
      } catch {
        error?.classList.remove("hidden");
        if (button) button.disabled = false;
      }
    });
  });
</script>

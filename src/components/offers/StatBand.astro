---
import { Icon } from "astro-icon/components";

export interface Stat {
  icon: string;
  title: string;
}
export interface Props {
  eyebrow: string;
  stats: Stat[];
}
const { eyebrow, stats } = Astro.props;
---

<section aria-labelledby="proof-heading" class="bg-background-cream py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-primary">{eyebrow}</p>
    <h2 id="proof-heading" class="sr-only">Proof</h2>
    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {
        stats.map((s) => (
          <li class="flex flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
              <Icon name={s.icon} class="h-6 w-6 text-primary" aria-hidden="true" />
            </span>
            <h3 class="mt-5 font-heading text-2xl font-bold text-secondary">{s.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

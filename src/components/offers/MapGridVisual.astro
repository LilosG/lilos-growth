---
/** Illustrative before/after map-rank grids (pure SVG, no images). */
const N = 7;
const gap = 30;
const r = 11;
// Deterministic pseudo-ranks so the output is stable between builds.
const beforeRanks: number[][] = [];
const afterRanks: number[][] = [];
for (let y = 0; y < N; y++) {
  beforeRanks.push([]);
  afterRanks.push([]);
  for (let x = 0; x < N; x++) {
    const d = Math.max(Math.abs(x - 3), Math.abs(y - 3));
    const jitter = (x * 7 + y * 13) % 5;
    beforeRanks[y].push(d === 0 ? 6 + (jitter % 3) : 8 + d * 3 + jitter);
    afterRanks[y].push(d >= 3 ? 3 + (jitter % 2) : d === 2 ? 2 + (jitter % 2) : 1 + (jitter % 2));
  }
}
const beforeColor = (v: number) => (v >= 20 ? "#dc2626" : v >= 8 ? "#f56b2a" : "#f59e0b");
const afterColor = (v: number) => (v <= 3 ? "#16a34a" : "#84cc16");
const label = (v: number) => (v >= 20 ? "20+" : String(v));
const size = (N - 1) * gap + r * 2 + 4;
const grids = [
  { title: "Before", ranks: beforeRanks, color: beforeColor },
  { title: "After 90 days", ranks: afterRanks, color: afterColor },
];
---

<figure class="map-visual rounded-3xl border border-white/15 bg-white/[0.07] p-4 shadow-2xl backdrop-blur sm:p-6">
  <div class="grid grid-cols-2 gap-3 sm:gap-5">
    {
      grids.map((g, gi) => (
        <div>
          <p class="mb-2 text-center text-xs font-bold uppercase tracking-wider text-white sm:text-sm">
            {g.title}
          </p>
          <svg
            viewBox={`0 0 ${size} ${size}`}
            class="h-auto w-full rounded-xl bg-white/90"
            role="img"
            aria-label={`${g.title}: example 7 by 7 map-rank grid`}
          >
            {g.ranks.map((row, y) =>
              row.map((v, x) => (
                <g>
                  <circle
                    cx={r + 2 + x * gap}
                    cy={r + 2 + y * gap}
                    r={r}
                    fill={g.color(v)}
                    class="dot"
                    style={`animation-delay:${(gi * 0.35 + (x + y) * 0.03).toFixed(2)}s`}
                  />
                  <text
                    x={r + 2 + x * gap}
                    y={r + 2 + y * gap + 3.5}
                    text-anchor="middle"
                    font-size={v >= 20 ? 8 : 10}
                    font-weight="700"
                    fill="#fff"
                    font-family="Inter, sans-serif"
                  >
                    {label(v)}
                  </text>
                </g>
              ))
            )}
            <g transform={`translate(${r + 2 + 3 * gap}, ${r + 2 + 3 * gap})`}>
              <path
                d="M0 6 C-12 -6 -12 -22 0 -22 C12 -22 12 -6 0 6 Z"
                fill="#1f2d3d"
                stroke="#fff"
                stroke-width="1.5"
              />
              <circle cy="-13" r="4" fill="#fff" />
            </g>
          </svg>
        </div>
      ))
    }
  </div>
  <figcaption class="mt-4 text-center text-sm text-white/75">Example map-rank grid</figcaption>
</figure>

<style>
  .map-visual {
    animation: fade-up 0.8s ease-out both;
  }
  .dot {
    animation: pop 0.5s ease-out both;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-visual,
    .dot {
      animation: none;
    }
  }
</style>

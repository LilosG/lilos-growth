---
/**
 * Pricing Card Component
 * 
 * Displays pricing tiers with features and CTA buttons.
 * Supports highlighting the most popular option.
 * 
 * @component
 * @example
 * <PricingCard
 *   title="GBP + Local SEO"
 *   subtitle="Steady Map Pack & organic gains"
 *   price="699"
 *   period="mo"
 *   features={[...]}
 *   ctaText="Choose Plan"
 *   ctaHref="/packages"
 *   featured={true}
 * />
 */

import Card from '../core/Card.astro';
import Button from '../core/Button.astro';
import Badge from '../core/Badge.astro';
import { Icon } from 'astro-icon/components';

export interface Props {
  /** Plan title */
  title: string;
  /** Plan subtitle/description (optional) */
  subtitle?: string;
  /** Short description (alternative to subtitle) */
  description?: string;
  /** Monthly price (number only, no $ or /mo) */
  price: string;
  /** Period text (e.g., "mo", "one-time") */
  period?: string;
  /** Badge text to show above title */
  badge?: string;
  /** List of features */
  features: string[];
  /** CTA button text */
  ctaText: string;
  /** CTA button link */
  ctaHref: string;
  /** Whether this is the featured/popular plan */
  featured?: boolean;
  /** Optional footer note */
  footerNote?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  title,
  subtitle,
  description,
  price,
  period = "mo",
  badge,
  features,
  ctaText,
  ctaHref,
  featured = false,
  footerNote,
  class: className = '',
} = Astro.props;

// Remove $ if it exists in the price string
const cleanPrice = price ? price.toString().replace(/^\$/, '').trim() : '';
const displayDescription = subtitle || description;
---

<div class={`relative ${className}`}>
  {featured && (
    <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-10">
      <Badge variant="primary" size="sm" class="shadow-md">
        Most Popular
      </Badge>
    </div>
  )}
  
  <Card 
    variant={featured ? "elevated" : "default"}
    class={`h-full flex flex-col transition-all duration-300 hover:shadow-2xl ${featured ? 'border-2 border-primary shadow-xl' : 'border border-gray-200 hover:border-primary/30'}`}
  >
    {badge && !featured && (
      <div class="mb-3">
        <Badge variant="secondary" size="sm">
          {badge}
        </Badge>
      </div>
    )}
    
    <div class="mb-4">
      <h3 class="font-heading text-lg font-bold text-heading md:text-xl">
        {title}
      </h3>
      {displayDescription && (
        <p class="mt-1 text-sm text-body">
          {displayDescription}
        </p>
      )}
    </div>
    
    <div class="mb-6">
      <div class="flex items-baseline gap-1">
        <span class="font-heading text-2xl font-bold text-primary md:text-3xl">{cleanPrice.startsWith('$') ? cleanPrice : `$${cleanPrice}`}</span>
        <span class="text-sm text-body-light">/{period}</span>
      </div>
    </div>
    
    <ul class="mb-6 flex-grow space-y-2.5">
      {features.map((feature) => (
        <li class="flex items-start gap-2.5 text-sm text-body leading-relaxed">
          <Icon name="tabler:circle-check-filled" class="h-4 w-4 text-primary flex-shrink-0 mt-0.5" />
          <span set:html={feature} />
        </li>
      ))}
    </ul>
    
    {footerNote && (
      <p class="mb-4 text-xs text-body-light italic">
        {footerNote}
      </p>
    )}
    
    <div class="mt-auto border-t border-gray-100 pt-4">
      <Button 
        href={ctaHref}
        variant={featured ? "primary" : "outline"}
        size="md"
        class="w-full"
      >
        {ctaText}
      </Button>
    </div>
  </Card>
</div>

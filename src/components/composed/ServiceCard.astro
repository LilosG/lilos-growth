---
/**
 * Service Card Component
 *
 * Displays a service offering with icon, title, description, and features list.
 * Built on top of the Card component for consistency.
 *
 * @component
 * @example
 * <ServiceCard
 *   icon="tabler:map-pin"
 *   title="Google Business Profile Management"
 *   description="Get seen in Google Maps and local search results..."
 *   features={[
 *     "Complete setup and optimization",
 *     "Consistent photo management",
 *     "Monthly profile audits"
 *   ]}
 * />
 */

import Card from "../core/Card.astro";
import { Icon } from "astro-icon/components";

export interface Props {
  /** Icon name from astro-icon */
  icon: string;
  /** Service title */
  title: string;
  /** Service description */
  description: string;
  /** List of features/benefits */
  features?: string[];
  /** Optional link */
  href?: string;
  /** Additional CSS classes */
  class?: string;
}

const { icon, title, description, features = [], href, class: className = "" } = Astro.props;
---

<Card
  variant="interactive"
  as="article"
  href={href}
  class={`service-card-hover card-lift ${className}`}
>
  <div
    class="service-card-icon mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-primary-50 to-primary-100 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md"
    aria-hidden="true"
  >
    <Icon name={icon} class="h-7 w-7 text-primary" />
  </div>

  <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
    {title}
  </h3>

  <p class="mb-4 text-sm leading-relaxed text-body">
    {description}
  </p>

  {
    features.length > 0 && (
      <ul class="space-y-2 text-sm text-body">
        {features.map((feature) => (
          <li class="flex items-start gap-2">
            <Icon name="tabler:check" class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" />
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    href && (
      <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-primary">
        <span>Learn more</span>
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </div>
    )
  }
</Card>

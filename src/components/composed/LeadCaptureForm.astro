---
/**
 * Lead Capture Form Component
 *
 * Reusable lead generation form with consistent styling and validation.
 * Integrates with Formspree for form submissions.
 *
 * @component
 * @example
 * <LeadCaptureForm
 *   title="Free SEO Website Audit"
 *   submitText="Get My Free Audit"
 *   formspreeId="movlbqdk"
 * />
 */

import Input from "../core/Input.astro";
import Button from "../core/Button.astro";

export interface Props {
  /** Form title */
  title: string;
  /** Submit button text */
  submitText?: string;
  /** Formspree form ID */
  formspreeId: string;
  /** Success redirect URL */
  redirectUrl?: string;
  /** Show company field */
  showCompany?: boolean;
  /** Show website field */
  showWebsite?: boolean;
  /** Trust message below form */
  trustMessage?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  title,
  submitText = "Submit",
  formspreeId,
  redirectUrl = "https://lilosgrowth.com/thank-you",
  showCompany = true,
  showWebsite = true,
  trustMessage = "No spam. We'll reply within 1 business day.",
  class: className = "",
} = Astro.props;

const formAction = `https://formspree.io/f/${formspreeId}`;
---

<div class={`card ${className}`}>
  <h2 class="mb-6 font-heading text-xl font-bold text-heading">
    {title}
  </h2>

  <form method="POST" action={formAction} class="space-y-4">
    <input type="hidden" name="_redirect" value={redirectUrl} />

    <Input
      id="name"
      name="name"
      type="text"
      label="Your Name"
      placeholder="John Smith"
      autocomplete="name"
      required
    />

    <Input
      id="email"
      name="_replyto"
      type="email"
      label="Email Address"
      placeholder="john@example.com"
      autocomplete="email"
      inputmode="email"
      required
    />

    {
      showCompany && (
        <Input
          id="company"
          name="company"
          type="text"
          label="Company Name"
          placeholder="Acme Plumbing"
          autocomplete="organization"
        />
      )
    }

    {
      showWebsite && (
        <Input
          id="website"
          name="website"
          type="url"
          label="Website"
          placeholder="https://example.com"
          autocomplete="url"
          inputmode="url"
          required
        />
      )
    }

    <Button type="submit" variant="primary" size="lg" fullWidth data-evt="cta_lead_form_submit">
      {submitText}
    </Button>
  </form>

  {trustMessage && <p class="mt-4 text-center text-sm text-muted">{trustMessage}</p>}
</div>

---
/**
 * Stat Card Component
 * 
 * Displays a metric or statistic with label and optional note.
 * Used on results page and homepage for showcasing performance.
 * 
 * @component
 * @example
 * <StatCard
 *   label="Avg. Lead Growth"
 *   value="+142%"
 *   note="12-month median across active clients"
 * />
 */

import Card from '../core/Card.astro';

export interface Props {
  /** Metric label */
  label: string;
  /** Metric value */
  value: string;
  /** Optional explanatory note */
  note?: string;
  /** Additional CSS classes */
  class?: string;
}

const {
  label,
  value,
  note,
  class: className = '',
} = Astro.props;
---

<Card variant="elevated" size="sm" class={`text-center ${className}`}>
  <div class="relative">
    <!-- Decorative background element -->
    <div class="absolute -right-4 -top-4 h-20 w-20 rounded-full bg-primary/5 transition-transform group-hover:scale-110" aria-hidden="true"></div>
    
    <div class="relative">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">
        {label}
      </p>
      
      <p class="mt-2 font-heading text-4xl font-bold tracking-tight text-heading">
        {value}
      </p>
      
      {note && (
        <p class="mt-1 text-xs text-muted">
          {note}
        </p>
      )}
    </div>
  </div>
</Card>

---
import Layout from "./Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";
import FloatingCalendlyButton from "~/components/widgets/FloatingCalendlyButton.astro";
import type { MetaData as MetaDataType } from "~/types";
import { isRecord } from "~/utils/type-guards";

export interface Crumb {
  name: string;
  item: string;
}
export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaDataType;
  breadcrumbs?: Crumb[];
  schema?: unknown[];
  noIndex?: boolean;
  showFloatingCalendly?: boolean;
  calendlyUrl?: string; // kept for future use; not used to override FAB target
}

const props = Astro.props as Props;
const {
  title,
  description,
  lang,
  bodyClass,
  metadata,
  breadcrumbs = [],
  schema: schemaExtras = [],
  showFloatingCalendly = true,
} = props;

const noIndex = props.noIndex ?? false;

// Prefer Astro.site when available (respects site config)
const site = Astro.site?.toString() ?? "https://lilosgrowth.com";
const siteUrl = site.endsWith("/") ? site : site + "/";

/**
 * === Global Organization (site-wide, single source of truth) ===
 * Uses your real contact info; update logo URL/dimensions to match your asset.
 */
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#org`,
  name: "Lilos Growth",
  legalName: "Lilos Growth",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: new URL("/logo-lcp-320.webp", siteUrl).toString(),
    width: 320,
    height: 320,
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: "hello@lilosgrowth.com",
      telephone: "+1-858-722-2920",
      areaServed: "US",
      availableLanguage: ["en"],
    },
  ],
};

/**
 * === LocalBusiness (enhanced with full NAP) ===
 * Stable @id lets Google relate entities across your site.
 */
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${siteUrl}#localbiz`,
  name: "Lilos Growth",
  legalName: "Lilos Growth",
  url: siteUrl,
  telephone: "+1-858-722-2920",
  image: `${siteUrl}images/default.svg`, // optional; swap for a better brand image if you have one
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1440 Columbia Street, Suite 909",
    addressLocality: "San Diego",
    addressRegion: "CA",
    addressCountry: "US",
  },
  areaServed: { "@type": "AdministrativeArea", name: "United States" },
  sameAs: [
    // Add real profiles when available, e.g.:
    // "https://www.linkedin.com/company/lilos-growth"
  ],
};

/**
 * === WebSite (lightweight, harmless) ===
 * We omit SearchAction unless you expose an on-site search endpoint.
 */
const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  url: siteUrl,
  name: "Lilos Growth",
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: c.item?.startsWith("http") ? c.item : new URL(c.item || "/", siteUrl).toString(),
        })),
      }
    : null;

/**
 * Ensure we only output one JSON-LD per @type/@id.
 * If no @id is present, we keep the first occurrence of that @type.
 */
function uniqueByTypeId(nodes: unknown[]): Record<string, unknown>[] {
  const seen = new Set<string>();
  return nodes.filter((n): n is Record<string, unknown> => {
    if (!isRecord(n)) return false;
    const typeValue = n["@type"];
    const rawType = Array.isArray(typeValue) ? typeValue.join("|") : String(typeValue ?? "");
    const id = typeof n["@id"] === "string" ? n["@id"] : "";
    const key = `${rawType}#${id}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const schemaNodes = uniqueByTypeId([
  organization,
  localBusiness,
  webSite,
  ...(breadcrumbList ? [breadcrumbList] : []),
  ...schemaExtras,
]);

const effectiveMetadata = {
  ...(metadata ?? {}),
  ...(noIndex ? { robots: { index: false, follow: true } } : {}),
};
---

<Layout {title} {description} {lang} {bodyClass} metadata={effectiveMetadata}>
  <a
    href="#main"
    class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:left-2 focus-visible:top-2 focus-visible:z-[1000] focus-visible:rounded-full focus-visible:bg-white focus-visible:px-4 focus-visible:py-2 focus-visible:text-secondary focus-visible:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
  >
    Skip to content
  </a>

  <Header />

  <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
    <slot />
  </main>

  <Footer />

  {
    schemaNodes.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
    ))
  }

  <script is:inline>
    document.addEventListener("click", (e) => {
      const el = e.target && e.target.closest ? e.target.closest("[data-evt]") : null;
      if (!el) return;
      const evt = el.getAttribute("data-evt");
      // @ts-expect-error gtag optional
      if (!evt || typeof window === "undefined" || typeof window.gtag !== "function") return;
      const label =
        el.href || el.getAttribute("aria-label") || (el.textContent ? el.textContent.trim() : "");
      // @ts-expect-error gtag optional
      window.gtag("event", evt, { event_category: "engagement", event_label: label });
    });
  </script>

  {showFloatingCalendly && <FloatingCalendlyButton href="/contact#book" label="Book a Call" />}

  <style is:global>
    :root {
      --site-anchor-offset: 88px;
    }
    @media (max-width: 1023.98px) {
      :root {
        --site-anchor-offset: 72px;
      }
    }
    @media (max-width: 767.98px) {
      :root {
        --site-anchor-offset: 64px;
      }
    }
    :where(h1[id], h2[id], h3[id], h4[id], section[id], [data-anchor]) {
      scroll-margin-top: var(--site-anchor-offset);
    }
  </style>
</Layout>

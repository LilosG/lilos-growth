---
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Vercel Web Analytics
import VercelAnalytics from '@vercel/analytics/astro';
// Vercel Speed Insights
import SpeedInsights from '@vercel/speed-insights/astro';

// View Transitions (optional)
import { ClientRouter } from 'astro:transitions';

// Floating Calendly Button (kept at natural size)
import FloatingCalendlyButton from '../components/FloatingCalendlyButton.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="h-full 2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <ClientRouter fallback="swap" />
  </head>

  <!-- Sticky footer layout: full-height column -->
  <body
    class="antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip"
  >
    <!-- Page content -->
    <main id="app" class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- Floating Calendly -->
    <FloatingCalendlyButton />

    <!-- Scripts -->
    <BasicScripts />
    <VercelAnalytics />
    <SpeedInsights />

 <!-- Your analytics helper -->
<script is:inline>
  // Plain JS (no TypeScript) so browsers & ESLint are happy
  (function () {
    if (typeof window.trackEvent !== "function") {
      window.trackEvent = function (name, data) {
        try {
          if (window.va && typeof window.va.track === "function") {
            window.va.track(String(name), data || {});
          }
        } catch (e) {
          // no-op
        }
      };
    }
  })();
</script>

  </body>
</html>

---
/**
 * Page wrapper used by most pages.
 * IMPORTANT:
 *  - Do NOT import or render analytics here (owned by Layout.astro).
 *  - Keep Calendly import EXACTLY as requested.
 */
import BaseLayout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import FloatingCalendlyButton from '~/components/widgets/FloatingCalendlyButton.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
}

const { metadata, title, description, lang = 'en', bodyClass = '' } = Astro.props as Props;
---

<BaseLayout {metadata} {title} {description} {lang} {bodyClass}>
  <!-- Optional head passthrough for pages that provide a named head slot -->
  <slot slot="head" name="head" />

  <!-- Site chrome -->
  <Header />

  <main>
    <slot />
  </main>

  <Footer />

  <!-- Calendly floating button (kept exactly as requested) -->
  <FloatingCalendlyButton />
</BaseLayout>

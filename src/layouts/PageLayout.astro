---
/**
 * Page wrapper layout — prints Header, your page <slot />, then Footer.
 * Adds:
 *  - JSON-LD support (LocalBusiness always; optional BreadcrumbList + extra schema[])
 *  - Lightweight GA4 click-event tracking (delegated [data-evt])
 *  - Optional floating Calendly button (lazy + fallback)
 * Keeps your existing Layout.astro in charge of <html> and <head>.
 */

import Layout from './Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import FloatingCalendlyButton from '~/components/widgets/FloatingCalendlyButton.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Crumb {
  name: string;
  item: string; // absolute or relative URL
}

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaDataType;

  // NEW (optional) props for AEO/schema + CTA
  breadcrumbs?: Crumb[];
  schema?: unknown[]; // e.g., FAQPage or Service nodes
  noIndex?: boolean; // respected in Layout.astro if you wire it there
  showFloatingCalendly?: boolean;
  calendlyUrl?: string; // fallback if env let is missing
}

const props = Astro.props as Props;

// Pull only what Layout.astro expects so we don't pass extra props to it.
const { title, description, lang, bodyClass, metadata } = props;

// AEO / Schema props (safe defaults)
const breadcrumbs = props.breadcrumbs ?? [];
const schemaExtras = props.schema ?? [];
const showFloatingCalendly = props.showFloatingCalendly ?? true;
const calendlyUrl = props.calendlyUrl;

// Build site URL for absolute breadcrumb items
const site = Astro.site?.toString() ?? 'https://lilosgrowth.com';

// Minimal LocalBusiness schema (non-PII)
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Lilos Growth',
  url: site,
  areaServed: { '@type': 'AdministrativeArea', name: 'United States' },
};

// Optional BreadcrumbList
const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.name,
          item: c.item?.startsWith('http') ? c.item : new URL(c.item || '/', site).toString(),
        })),
      }
    : null;

// Final schema nodes (OK to render in <body>)
const schemaNodes = [localBusiness, ...(breadcrumbList ? [breadcrumbList] : []), ...schemaExtras];
---

<Layout {title} {description} {lang} {bodyClass} {metadata}>
  <!-- A) Skip link (kept from your version) -->
  <a
    href="#main"
    class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-2 focus-visible:left-2 focus-visible:z-[1000] focus-visible:bg-white focus-visible:text-[#253242] focus-visible:px-4 focus-visible:py-2 focus-visible:rounded-full focus-visible:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]"
  >
    Skip to content
  </a>

  <Header />

  <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
    <slot />
  </main>

  <Footer />

  <!-- JSON-LD (rendered in body is fine for Google) -->
  {schemaNodes.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />)}

  <!-- Delegated GA4 click tracking for elements with data-evt -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      let t = e.target;
      if (!t || !t.closest) return;
      let el = t.closest('[data-evt]');
      if (!el) return;

      let evt = el.getAttribute('data-evt');
      // @ts-expect-error
      if (!evt || typeof window === 'undefined' || typeof window.gtag !== 'function') return;

      let label = el.href || el.getAttribute('aria-label') || (el.textContent ? el.textContent.trim() : '');
      // @ts-expect-error
      window.gtag('event', evt, { event_category: 'engagement', event_label: label });
    });
  </script>

  <!-- Optional floating Calendly button -->
  {
    showFloatingCalendly && (
      <FloatingCalendlyButton
        href={(import.meta.env.PUBLIC_CALENDLY_URL as string) || calendlyUrl || '/contact'}
        label="Book a Call"
      />
    )
  }

  <!-- C) Anchor offset so in-page links aren't hidden beneath sticky header -->
  <style is:global>
    :root {
      /* Base offset used by scroll-margin-top targets */
      --site-anchor-offset: 88px;
    }
    @media (max-width: 1023.98px) {
      :root {
        --site-anchor-offset: 72px;
      }
    }
    @media (max-width: 767.98px) {
      :root {
        --site-anchor-offset: 64px;
      }
    }
    /* Apply to common anchorable elements */
    :where(h1[id], h2[id], h3[id], h4[id], section[id], [data-anchor]) {
      scroll-margin-top: let(--site-anchor-offset);
    }
  </style>
</Layout>

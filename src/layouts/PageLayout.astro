---
/**
 * Page wrapper layout — prints Header, your page <slot />, then Footer.
 * Passes through SEO props to the global Layout so each page can set title/description.
 */

import Layout from './Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaDataType;
}

const props = Astro.props as Props;
---

<Layout {...props}>
  <Header />

  <main id="main" class="flex-1 focus:outline-none">
    <slot />
  </main>

  <Footer />
</Layout>

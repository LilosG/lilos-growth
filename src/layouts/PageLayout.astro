---
import Layout from './Layout.astro';
import SiteHeader from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import FloatingCalendlyButton from '~/components/widgets/FloatingCalendlyButton.astro';
import JsonLdWebSite from '~/components/seo/JsonLdWebSite.astro';
import JsonLdWebPage from '~/components/seo/JsonLdWebPage.astro';
import JsonLdBreadcrumbs from '~/components/seo/JsonLdBreadcrumbs.astro';
import JsonLdLocalBusiness from '~/components/seo/JsonLdLocalBusiness.astro';
import type { MetaData as MetaDataType } from '~/types';

export interface Crumb {
  name: string;
  item: string;
}
export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaDataType;
  breadcrumbs?: Crumb[];
  schema?: unknown[];
  disableLocalBusiness?: boolean;
  searchUrl?: string;
  noIndex?: boolean;
  showFloatingCalendly?: boolean;
}
const props = Astro.props as Props;
const {
  title,
  description,
  lang,
  bodyClass,
  metadata,
  breadcrumbs = [],
  schema: schemaExtras = [],
  disableLocalBusiness = false,
  searchUrl,
  noIndex = false,
  showFloatingCalendly = true,
} = props;

const site = Astro.site?.toString() ?? 'https://lilosgrowth.com';
const abs = (u: string) => (u?.startsWith('http') ? u : new URL(u || '/', site).toString());
const pageUrl = abs(Astro.url.pathname);
const pageTitle = metadata?.title ?? title ?? 'Lilos Growth';
const pageDesc =
  metadata?.description ??
  description ??
  'Get more calls and booked jobs with Local SEO, GBP, and conversion-ready websites.';
---

<Layout {title} {description} {lang} {bodyClass} {metadata}>
  <Fragment slot="head">
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <JsonLdWebSite name="Lilos Growth" url={site} searchUrl={searchUrl} />
    {
      !disableLocalBusiness && (
        <JsonLdLocalBusiness
          name="Lilos Growth"
          url={site}
          email="hello@lilosgrowth.com"
          priceRange="$"
          areaServed="United States"
          subtype="ProfessionalService"
        />
      )
    }
    <JsonLdBreadcrumbs items={breadcrumbs} />
    <JsonLdWebPage
      name={pageTitle}
      description={pageDesc}
      url={pageUrl}
      isPartOfId={`${site}/#website`}
      breadcrumbId={`${site}/#bread`}
    />
    {
      Array.isArray(schemaExtras) &&
        schemaExtras.map((node) => <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />)
    }
    <style is:inline>
      :root {
        --header-h: 88px;
      }
      body {
        padding-top: var(--header-h);
      }
      [id] {
        scroll-margin-top: var(--header-h);
      }
    </style>
  </Fragment>

  <a
    href="#main"
    class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-2 focus-visible:left-2 focus-visible:z-[1000] focus-visible:bg-white focus-visible:text-[#253242] focus-visible:px-4 focus-visible:py-2 focus-visible:rounded-full focus-visible:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]"
  >
    Skip to content
  </a>

  <!-- Header (no props expected) -->
  <SiteHeader />

  <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
    <slot />
  </main>

  <Footer />

  {showFloatingCalendly && <FloatingCalendlyButton href="/contact#book" label="Book a Call" />}

  <script is:inline>
    (function () {
      const docEl = document.documentElement;
      const header = document.querySelector('header.site-header') || document.querySelector('header');
      function setHeaderHeight() {
        if (!header) return;
        const h = Math.ceil(header.getBoundingClientRect().height || 0);
        if (h > 0) docEl.style.setProperty('--header-h', h + 'px');
      }
      setHeaderHeight();
      window.addEventListener('load', setHeaderHeight, { once: true });
      let to;
      window.addEventListener('resize', () => {
        clearTimeout(to);
        to = setTimeout(setHeaderHeight, 100);
      });
      if ('MutationObserver' in window && header) {
        new MutationObserver(setHeaderHeight).observe(header, {
          attributes: true,
          attributeFilter: ['class', 'style'],
        });
      }
    })();
  </script>
</Layout>

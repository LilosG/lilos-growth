---
import Layout from "./Layout.astro";
import Header from "~/components/widgets/Header.astro";
import Footer from "~/components/widgets/Footer.astro";
import FloatingCalendlyButton from "~/components/widgets/FloatingCalendlyButton.astro";
import type { MetaData as MetaDataType } from "~/types";

export interface Crumb {
  name: string;
  item: string;
}
export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaDataType;
  breadcrumbs?: Crumb[];
  schema?: unknown[];
  noIndex?: boolean;
  showFloatingCalendly?: boolean;
  calendlyUrl?: string; // kept for future use; not used to override FAB target
}

const props = Astro.props as Props;
const {
  title,
  description,
  lang,
  bodyClass,
  metadata,
  breadcrumbs = [],
  schema: schemaExtras = [],
  showFloatingCalendly = true,
} = props;

const site = Astro.site?.toString() ?? "https://lilosgrowth.com";

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Lilos Growth",
  url: site,
  areaServed: { "@type": "AdministrativeArea", name: "United States" },
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: c.item?.startsWith("http") ? c.item : new URL(c.item || "/", site).toString(),
        })),
      }
    : null;

/**
 * Ensure we only output one JSON-LD per @type/@id.
 * If no @id is present, we keep the first occurrence of that @type.
 * This prevents duplicate BreadcrumbList/LocalBusiness when pages also inject schema.
 */
function uniqueByTypeId(nodes: any[]): any[] {
  const seen = new Set<string>();
  return nodes.filter((n) => {
    if (!n || typeof n !== "object") return false;
    const rawType = Array.isArray(n["@type"]) ? n["@type"].join("|") : String(n["@type"] ?? "");
    const id = typeof n["@id"] === "string" ? n["@id"] : "";
    const key = `${rawType}#${id}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}

const schemaNodes = uniqueByTypeId([
  localBusiness,
  ...(breadcrumbList ? [breadcrumbList] : []),
  ...schemaExtras,
]);
---

<Layout {title} {description} {lang} {bodyClass} {metadata}>
  <a
    href="#main"
    class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:left-2 focus-visible:top-2 focus-visible:z-[1000] focus-visible:rounded-full focus-visible:bg-white focus-visible:px-4 focus-visible:py-2 focus-visible:text-[#253242] focus-visible:shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f56b2a] focus-visible:ring-offset-2"
  >
    Skip to content
  </a>

  <Header />

  <main id="main" class="flex-1 focus:outline-none" tabindex="-1">
    <slot />
  </main>

  <Footer />

  {
    schemaNodes.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} is:inline />
    ))
  }

  <script is:inline>
    document.addEventListener("click", (e) => {
      const el = e.target && e.target.closest ? e.target.closest("[data-evt]") : null;
      if (!el) return;
      const evt = el.getAttribute("data-evt");
      // @ts-expect-error gtag optional
      if (!evt || typeof window === "undefined" || typeof window.gtag !== "function") return;
      const label =
        el.href || el.getAttribute("aria-label") || (el.textContent ? el.textContent.trim() : "");
      // @ts-expect-error gtag optional
      window.gtag("event", evt, { event_category: "engagement", event_label: label });
    });
  </script>

  {showFloatingCalendly && <FloatingCalendlyButton href="/contact#book" label="Book a Call" />}

  <style is:global>
    :root {
      --site-anchor-offset: 88px;
    }
    @media (max-width: 1023.98px) {
      :root {
        --site-anchor-offset: 72px;
      }
    }
    @media (max-width: 767.98px) {
      :root {
        --site-anchor-offset: 64px;
      }
    }
    :where(h1[id], h2[id], h3[id], h4[id], section[id], [data-anchor]) {
      scroll-margin-top: var(--site-anchor-offset);
    }
  </style>
</Layout>

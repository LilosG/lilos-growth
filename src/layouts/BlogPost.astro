---
import Layout from "~/layouts/PageLayout.astro";
import { breadcrumbJsonLd, blogPostingJsonLd, websiteSearchActionJsonLd } from "../lib/seo";
type Faq = { q: string; a: string };
const { frontmatter } = Astro.props as { frontmatter: any };
const url = new URL(Astro.url.pathname, origin).toString();
const imageUrl = typeof frontmatter.image === "string" ? frontmatter.image : frontmatter.image?.src;
const crumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: frontmatter.title, url },
];
---

<Layout title={frontmatter.title} description={frontmatter.description}>
  <script is:inline type="application/ld+json" set:html={breadcrumbJsonLd(crumbs)} />
  <script
    is:inline
    type="application/ld+json"
    set:html={blogPostingJsonLd({
      title: frontmatter.title,
      description: frontmatter.description,
      url,
      image: imageUrl,
      author: frontmatter.author,
      datePublished: frontmatter.datePublished,
      dateModified: frontmatter.dateModified,
    })}
  />
  <script is:inline type="application/ld+json" set:html={websiteSearchActionJsonLd()} />

  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-10 md:py-12">
      <h1 class="text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl">
        {frontmatter.title}
      </h1>
      <p class="mt-3 text-base text-slate-600">{frontmatter.description}</p>

      {
        imageUrl && (
          <figure class="mt-8">
            <img
              src={imageUrl}
              alt={
                typeof frontmatter.image === "string"
                  ? frontmatter.title
                  : frontmatter.image?.alt || frontmatter.title
              }
              loading="lazy"
              class="w-full rounded-3xl"
            />
          </figure>
        )
      }

      <article
        class="prose mt-8 max-w-none md:prose-lg prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-slate-900 prose-p:leading-relaxed prose-p:text-slate-700 prose-a:text-[#f56b2a] prose-a:no-underline hover:prose-a:text-[#f34e00] prose-strong:text-slate-900 prose-ol:my-3 prose-ul:my-3 prose-li:my-1 prose-img:rounded-3xl prose-hr:my-10"
      >
        <slot />
      </article>

      {
        Array.isArray(frontmatter.faq) && frontmatter.faq.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-semibold text-slate-900">FAQ</h2>
            <div class="mt-4 space-y-4">
              {frontmatter.faq.map((f: Faq) => (
                <details class="rounded-3xl border-2 border-[#f56b2a]/10 bg-[#fff7f0] p-4">
                  <summary class="font-medium">{f.q}</summary>
                  <div class="mt-2 text-slate-700">{f.a}</div>
                </details>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>
</Layout>

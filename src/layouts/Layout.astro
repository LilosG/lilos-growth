---
/**
 * Site page layout — loads Tailwind, meta components, analytics, and global scripts.
 * Pages pass title/description/metadata; SEO is centralized via <Metadata />.
 */

import "~/styles/tokens.css";
import "~/assets/styles/tailwind.css";
import "~/styles/animations.css";

import CommonMeta from "~/components/common/CommonMeta.astro";
import ApplyColorMode from "~/components/common/ApplyColorMode.astro";
import Metadata from "~/components/common/Metadata.astro";
import SiteVerification from "~/components/common/SiteVerification.astro";
import BasicScripts from "~/components/common/BasicScripts.astro";

import GoogleAnalytics from "~/components/common/GoogleAnalytics.astro";

// Use the official Vercel Analytics package; alias to avoid any name conflicts.
import VercelAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import CookieBanner from "~/components/CookieBanner.astro";

import type { MetaData as MetaDataType } from "~/types";

/** Page meta input */
type MetaInput = Partial<MetaDataType> & {
  title?: string;
  description?: string;
};

export interface Props {
  title?: string;
  description?: string;
  ignoreTitleTemplate?: boolean;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaInput;
}

const {
  title,
  description,
  ignoreTitleTemplate,
  lang = "en",
  bodyClass = "",
  metadata = {},
} = Astro.props as Props;

/** Conservative fallback titles when a page doesn't provide one */
const pathname = Astro.url.pathname;
let fallbackTitle: string | undefined;
if (!title) {
  if (pathname === "/" || pathname === "/index") {
    fallbackTitle = "Local SEO & Websites for Home Service Pros";
  } else if (pathname.startsWith("/additional-services")) {
    fallbackTitle = "Additional Services for Home Service Pros";
  }
}
const effectiveTitle = title ?? fallbackTitle;

/** Narrow, safe global surface: only expose trackEvent */
declare global {
  interface Window {
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
  }
}
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />

    <ApplyColorMode />

    <!-- Centralized SEO -->
    <Metadata
      {...metadata}
      title={effectiveTitle}
      description={description}
      ignoreTitleTemplate={ignoreTitleTemplate}
    />

    <SiteVerification />

    <!-- GA4 loader (uses PUBLIC_GOOGLE_MEASUREMENT_ID) -->
    <GoogleAnalytics />

    <!-- Allow pages to push extra head assets (e.g., Calendly CSS/preconnect) -->
    <slot name="head" />

    <!-- Preconnect to CDN for faster CSS loading -->
    <link rel="preconnect" href="https://lilosgrowth.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- System Fonts for fastest LCP - no external font blocking -->
    <!-- Note: Vercel Analytics and SpeedInsights load asynchronously -->
    <link rel="dns-prefetch" href="https://analytics.ahrefs.com" />
    <link rel="preconnect" href="https://vitals.vercel-insights.com" crossorigin />

    <!-- Ahrefs Analytics (consent-gated, deferred) -->
    <script is:inline>
      (() => {
        const consentKey = "lg_cookie_consent";
        const load = () => {
          if (window.__ahrefsLoaded) return;

          const loadScript = () => {
            const s = document.createElement("script");
            s.src = "https://analytics.ahrefs.com/analytics.js";
            s.async = true;
            s.setAttribute("data-key", "HMqVx+wg6FRKBgVerbziWw");
            document.head.appendChild(s);
            window.__ahrefsLoaded = true;
          };

          // Defer until browser is idle
          if ("requestIdleCallback" in window) {
            requestIdleCallback(loadScript, { timeout: 3000 });
          } else {
            setTimeout(loadScript, 3000);
          }
        };

        try {
          if (localStorage.getItem(consentKey) === "accepted") load();
        } catch {}

        window.addEventListener("lg-consent-accepted", load);
      })();
    </script>
  </head>

  <body
    class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}
  >
    <div class="flex flex-1 flex-col">
      <slot />
    </div>

    <!-- Site-wide small helpers -->
    <BasicScripts />

    <!-- Analytics (Vercel) + Performance -->
    <VercelAnalytics />
    <SpeedInsights />

    <!-- Event bridge: window.trackEvent -> Vercel (va) & GA4 (gtag) if available -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          const va = /** @type {any} */ (window).va;
          if (typeof va === "function") va("event", { name: String(name), data });
        } catch {}

        try {
          // @ts-expect-error: gtag exists only if GA loaded
          window.gtag?.("event", String(name), data);
        } catch {}
      };
    </script>
    <CookieBanner />

    <!-- Animation System Initialization -->
    <script>
      import { initAllAnimations, enableSmoothScroll } from "~/utils/animations";

      // Initialize animations when page loads
      initAllAnimations();
      enableSmoothScroll();
    </script>

    <!-- Service Worker Registration -->
    <script is:inline>
      // Register service worker for offline support and caching
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js")
            .then((registration) => {
              console.log("[SW] Registered:", registration.scope);

              // Check for updates on page load
              registration.update();

              // Listen for new service worker
              registration.addEventListener("updatefound", () => {
                const newWorker = registration.installing;
                newWorker.addEventListener("statechange", () => {
                  if (newWorker.state === "installed" && navigator.serviceWorker.controller) {
                    // New service worker available, prompt user to reload
                    if (confirm("New version available! Reload to update?")) {
                      newWorker.postMessage({ type: "SKIP_WAITING" });
                      window.location.reload();
                    }
                  }
                });
              });
            })
            .catch((error) => {
              console.error("[SW] Registration failed:", error);
            });

          // Reload when new service worker takes control
          navigator.serviceWorker.addEventListener("controllerchange", () => {
            window.location.reload();
          });
        });
      }
    </script>
  </body>
</html>

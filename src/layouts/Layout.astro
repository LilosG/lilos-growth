---
/**
 * Global site layout — loads Tailwind, meta components, and site-wide scripts.
 * Includes Vercel Analytics + Speed Insights using their official Astro adapters.
 */

import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro'; // keep if you use GTM/GA/etc.
import BasicScripts from '~/components/common/BasicScripts.astro';

// Vercel Web Analytics & Speed Insights (official)
import VercelAnalytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import type { MetaData as MetaDataType } from '~/types';

declare global {
  interface Window {
    /** Helper for custom events that forwards to Vercel Analytics when available */
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
  }
}

export interface Props {
  /** Optional per-page SEO title override */
  title?: string;
  /** Optional per-page meta description override */
  description?: string;
  /** Document language */
  lang?: string;
  /** Extra classes to append to <body> */
  bodyClass?: string;
  /** Your existing metadata object used by <Metadata /> */
  metadata?: MetaDataType;
}

const {
  title,
  description,
  lang = 'en',
  bodyClass = '',
  metadata = {},
} = Astro.props as Props;
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
  </head>

  <!-- Sticky-footer safe: full-height flex column on the BODY -->
  <body class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}>
    <!-- Page content -->
    <div class="flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Site scripts -->
    <BasicScripts />

    <!-- Vercel analytics (do not duplicate elsewhere) -->
    <VercelAnalytics />
    <SpeedInsights />

    <!-- Small helper to send custom events to Vercel Analytics -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          if (typeof window.va === 'function') {
            window.va('event', { name: String(name), data });
          }
        } catch {}
      };
    </script>
  </body>
</html>

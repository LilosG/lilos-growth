---
// src/layouts/Layout.astro
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Vercel Web Analytics
import VercelAnalytics from '@vercel/analytics/astro';
// Vercel Speed Insights
import SpeedInsights from '@vercel/speed-insights/astro';

// View Transitions (optional)
import { ClientRouter } from 'astro:transitions';

// Floating Calendly Button (kept full size, outside the scaler)
import FloatingCalendlyButton from '../components/FloatingCalendlyButton.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="h-full 2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <ClientRouter fallback="swap" />
  </head>

  <!-- Sticky-footer safe: full-height flex column on the BODY -->
  <body
    class="antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip"
  >
    <!-- Scaled page canvas: scales ALL page content (header, hero, cards, footer) without affecting layout height -->
    <div class="flex-1 flex flex-col">
      <div
        class="w-full origin-top will-change-transform
               md:scale-[.90] xl:scale-[.87] 2xl:scale-[.85]"
        style="transform-origin: top center;"
      >
        <slot />
      </div>
    </div>

    <!-- Floating Calendly stays native size -->
    <FloatingCalendlyButton />

    <BasicScripts />
    <VercelAnalytics />
    <SpeedInsights />

    <script is:inline>
      // Safe helper for analytics; swallow non-critical errors to avoid breaking UX.
      window.trackEvent = (name, data) => {
        try {
          const va = window.va;
          if (va && typeof va.track === 'function') {
            va.track(String(name), data || {});
          }
        } catch (e) {
          // Intentionally ignore analytics errors; keep a statement to satisfy ESLint.
          void e;
        }
      };
    </script>
  </body>
</html>

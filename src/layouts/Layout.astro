---
/**
 * Global site layout — loads Tailwind, meta components, and site-wide scripts.
 * Web Analytics (Vercel) is injected by the @astrojs/vercel adapter (see astro.config.*).
 * Speed Insights is added here via the Astro component.
 */

import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

import SpeedInsights from '@vercel/speed-insights/astro';

import type { MetaData as MetaDataType } from '~/types';

declare global {
  interface Window {
    /** Helper for custom events that forwards to Vercel Web Analytics when available */
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
    va?: (type: string, payload: Record<string, unknown>) => void;
  }
}

/** Allow pages to pass minimal meta (no `any`). */
type MetaInput = Partial<MetaDataType> & {
  title?: string;
  description?: string;
};

export interface Props {
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaInput;
}

const { title, description, lang = 'en', bodyClass = '', metadata = {} } = Astro.props as Props;
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <!-- Centralized SEO: AstroLib component emits <title>, description, canonical, OG/Twitter, robots, etc. -->
    <Metadata {...metadata} title={title} description={description} />
    <SiteVerification />
    <Analytics />
  </head>

  <!-- Sticky-footer safe: full-height flex column on the BODY -->
  <body
    class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}
  >
    <!-- Page content -->
    <div class="flex-1 flex flex-col">
      <slot />
    </div>

    <!-- Site scripts -->
    <BasicScripts />

    <!-- Speed Insights -->
    <SpeedInsights />

    <!-- Small helper to send custom events to Vercel Web Analytics (no-op if not enabled) -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          if (typeof window.va === 'function') {
            window.va('event', { name: String(name), data });
          }
        } catch {}
      };
    </script>
  </body>
</html>

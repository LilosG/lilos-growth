---
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

import VercelAnalytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import { ClientRouter } from 'astro:transitions';

import FloatingCalendlyButton from '../components/FloatingCalendlyButton.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
---

<!doctype html>
<html lang="en" dir="ltr" class="h-full 2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <ClientRouter fallback="swap" />

    <style is:global>
      /* 
       * SCALE + HEIGHT COMPENSATION
       * We set a single --scale var by breakpoint, and make the scaled area tall
       * enough so that (min-height * scale) >= 100dvh. That kills the footer gap.
       */
      :root { --scale: 1; }
      @media (min-width: 768px)   { :root { --scale: 0.90; } }  /* md */
      @media (min-width: 1280px)  { :root { --scale: 0.87; } }  /* xl */
      @media (min-width: 1536px)  { :root { --scale: 0.85; } }  /* 2xl */

      /* Safety: ensure the very last block inside the page content can't add trailing space */
      main#page > :is(section, div):last-child,
      body > :is(section, div):last-child {
        margin-bottom: 0 !important;
        padding-bottom: 0 !important;
      }

      /* Optional: if a background band ever shows, make the body default white. 
         Comment this out if you want the site-wide bg color instead. */
      /* body { background: #fff; } */
    </style>
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-[100dvh] flex flex-col overflow-x-clip">
    <!-- Scaled page canvas -->
    <div class="flex-1 flex flex-col">
      <div
        id="scaled-canvas"
        class="w-full will-change-transform"
        style="
          transform-origin: top center;
          transform: scale(var(--scale));
          min-height: calc(100dvh / var(--scale));
        "
      >
        <slot />
      </div>
    </div>

    <!-- Floating Calendly stays native size -->
    <FloatingCalendlyButton />

    <BasicScripts />
    <VercelAnalytics />
    <SpeedInsights />

    <script is:inline>
      window.trackEvent = (name, data) => {
        try { if (window.va && typeof window.va.track === 'function') window.va.track(String(name), data || {}); }
        catch {}
      };
    </script>
  </body>
</html>

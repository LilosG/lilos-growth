---
// src/layouts/Layout.astro
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

// Vercel Web Analytics (SINGLE owner here) — default import for your versions
import VercelAnalytics from '@vercel/analytics/astro';
// Vercel Speed Insights — default import for your versions
import SpeedInsights from '@vercel/speed-insights/astro';

// View Transitions (optional)
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

// Only declare our helper; do NOT redeclare window.va (the package already does)
declare global {
  interface Window {
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
  }
}

export interface Props {
  /** Optional per-page SEO title override */
  title?: string;
  /** Optional per-page meta description override */
  description?: string;
  /** Document language */
  lang?: string;
  /** Extra classes to append to <body> */
  bodyClass?: string;
  /** Your existing metadata object used by <Metadata /> */
  metadata?: MetaDataType;
}

const { title, description, lang = 'en', bodyClass = '', metadata = {} } = Astro.props as Props;
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full 2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <ClientRouter fallback="swap" />

    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
  </head>

  <!-- Sticky-footer safe: full-height flex column on the BODY -->
  <body
    class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}
  >
    <!-- Scaled page canvas: scales ALL page content (header, hero, cards, footer) without affecting layout height -->
    <div class="flex-1 flex flex-col">
      <div
        class="w-full origin-top will-change-transform
               md:scale-[.90] xl:scale-[.87] 2xl:scale-[.85]"
        style="transform-origin: top center;"
      >
        <slot />
      </div>
    </div>

    <BasicScripts />
    <VercelAnalytics />
    <SpeedInsights />

    <!-- Inline helper using the correct event API. No npm imports here. -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          if (typeof window.va === 'function') {
            window.va('event', { name: String(name), data });
          }
        } catch {}
      };
    </script>
  </body>
</html>

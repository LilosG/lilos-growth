---
/**
 * Site page layout — loads Tailwind, meta components, and site-wide scripts.
 * Keeps your original look & feel. Safe Analytics + SpeedInsights included.
 */

import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import type { MetaData as MetaDataType } from '~/types';

type MetaInput = Partial<MetaDataType> & { title?: string; description?: string };

export interface Props {
  title?: string;
  description?: string;
  ignoreTitleTemplate?: boolean;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaInput;
}

const { title, description, ignoreTitleTemplate, lang = 'en', bodyClass = '', metadata = {} } = Astro.props as Props;

/** Keep your previous fallback title logic minimal/safe */
const pathname = Astro.url.pathname;
let fallbackTitle: string | undefined;
if (!title) {
  if (pathname === '/' || pathname === '/index') fallbackTitle = 'Local SEO & Websites for Home Service Pros';
  else if (pathname.startsWith('/additional-services')) fallbackTitle = 'Additional Services for Home Service Pros';
}
const effectiveTitle = title ?? fallbackTitle;
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />

    <!-- Centralized SEO -->
    <Metadata
      {...metadata}
      title={effectiveTitle}
      description={description}
      ignoreTitleTemplate={ignoreTitleTemplate}
    />

    <!-- Allow pages to inject head extras (Calendly CSS, preconnects, etc.) -->
    <slot name="head" />

    <SiteVerification />

    <!-- Emits /_vercel/insights/script.js; no visual output -->
    <Analytics />
  </head>

  <body
    class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}
  >
    <div class="flex-1 flex flex-col">
      <slot />
    </div>

    <BasicScripts />
    <SpeedInsights />

    <!-- Custom event helper (uses window.va provided by Vercel) -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          if (typeof window.va === 'function') {
            window.va('event', { name: String(name), data });
          }
        } catch {}
      };
    </script>
  </body>
</html>

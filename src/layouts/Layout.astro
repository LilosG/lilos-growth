---
/**
 * Site page layout — loads Tailwind, meta components, analytics, and global scripts.
 * Pages pass title/description/metadata; SEO is centralized via <Metadata />.
 */

import "~/assets/styles/tailwind.css";

import CommonMeta from "~/components/common/CommonMeta.astro";
import CustomStyles from "~/components/CustomStyles.astro";
import ApplyColorMode from "~/components/common/ApplyColorMode.astro";
import Metadata from "~/components/common/Metadata.astro";
import SiteVerification from "~/components/common/SiteVerification.astro";
import BasicScripts from "~/components/common/BasicScripts.astro";

import GoogleAnalytics from "~/components/common/GoogleAnalytics.astro";

// Use the official Vercel Analytics package; alias to avoid any name conflicts.
import VercelAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import CookieBanner from "~/components/CookieBanner.astro";

import type { MetaData as MetaDataType } from "~/types";

/** Page meta input */
type MetaInput = Partial<MetaDataType> & {
  title?: string;
  description?: string;
};

export interface Props {
  title?: string;
  description?: string;
  ignoreTitleTemplate?: boolean;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaInput;
}

const {
  title,
  description,
  ignoreTitleTemplate,
  lang = "en",
  bodyClass = "",
  metadata = {},
} = Astro.props as Props;

/** Conservative fallback titles when a page doesn't provide one */
const pathname = Astro.url.pathname;
let fallbackTitle: string | undefined;
if (!title) {
  if (pathname === "/" || pathname === "/index") {
    fallbackTitle = "Local SEO & Websites for Home Service Pros";
  } else if (pathname.startsWith("/additional-services")) {
    fallbackTitle = "Additional Services for Home Service Pros";
  }
}
const effectiveTitle = title ?? fallbackTitle;

/** Narrow, safe global surface: only expose trackEvent */
declare global {
  interface Window {
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
  }
}
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />

    <CustomStyles />
    <ApplyColorMode />

    <!-- Centralized SEO -->
    <Metadata
      {...metadata}
      title={effectiveTitle}
      description={description}
      ignoreTitleTemplate={ignoreTitleTemplate}
    />

    <SiteVerification />

    <!-- GA4 loader (uses PUBLIC_GOOGLE_MEASUREMENT_ID) -->
    <GoogleAnalytics />

    <!-- Allow pages to push extra head assets (e.g., Calendly CSS/preconnect) -->
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  
  <!-- AHREFS_ANALYTICS -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="HMqVx+wg6FRKBgVerbziWw" async></script>
</head>

  <body
    class={`antialiased text-default bg-page tracking-tight min-h-screen min-h-[100dvh] flex flex-col overflow-x-clip ${bodyClass}`}
  >
    <div class="flex flex-1 flex-col">
      <slot />
    </div>

    <!-- Site-wide small helpers -->
    <BasicScripts />

    <!-- Analytics (Vercel) + Performance -->
    <VercelAnalytics />
    <SpeedInsights />

    <!-- Event bridge: window.trackEvent -> Vercel (va) & GA4 (gtag) if available -->
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          const va = /** @type {any} */ (window).va;
          if (typeof va === "function") va("event", { name: String(name), data });
        } catch {}

        try {
          // @ts-expect-error: gtag exists only if GA loaded
          window.gtag?.("event", String(name), data);
        } catch {}
      };
    </script>
    <CookieBanner />
  </body>
</html>

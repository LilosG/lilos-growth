---
/**
 * Site page layout — loads Tailwind, meta components, analytics, and global scripts.
 * Pages pass title/description/metadata; SEO is centralized via <Metadata />.
 */
import '~/assets/styles/tailwind.css';
import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import GoogleAnalytics from '~/components/common/GoogleAnalytics.astro';
import VercelAnalytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { MetaData as MetaDataType } from '~/types';

type MetaInput = Partial<MetaDataType> & { title?: string; description?: string; };

export interface Props {
  title?: string;
  description?: string;
  ignoreTitleTemplate?: boolean;
  lang?: string;
  bodyClass?: string;
  metadata?: MetaInput;
}

const { title, description, ignoreTitleTemplate, lang = 'en', bodyClass = '', metadata = {} } = Astro.props as Props;
const canonical = new URL(Astro.url.pathname, Astro.site?.toString() ?? 'https://lilosgrowth.com').toString();

/** Conservative fallback titles when a page doesn't provide one */
const pathname = Astro.url.pathname;
let fallbackTitle: string | undefined;
if (!title) {
  if (pathname === '/' || pathname === '/index') {
    fallbackTitle = 'Local SEO & Websites for Home Service Pros';
  } else if (pathname.startsWith('/additional-services')) {
    fallbackTitle = 'Additional Services for Home Service Pros';
  }
}
const effectiveTitle = title ?? fallbackTitle;

/** Narrow, safe global surface: only expose trackEvent */
declare global {
  interface Window {
    trackEvent?: (name: string, data?: Record<string, unknown>) => void;
  }
}
---

<!doctype html>
<html lang={lang} dir="ltr" class="h-full">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <link rel="canonical" href={canonical} />
    <ApplyColorMode />
    <Metadata
      title={typeof metadata !== 'undefined' && metadata?.title ? metadata.title : typeof effectiveTitle !== 'undefined' ? effectiveTitle : 'Lilos Growth'}
      description={typeof metadata !== 'undefined' && metadata?.description ? metadata.description : typeof description !== 'undefined' ? description : 'Get more calls and booked jobs with Local SEO, Google Business Profile, and conversion-ready websites.'}
      ogTitle={typeof metadata !== 'undefined' && metadata?.title ? metadata.title : typeof title !== 'undefined' ? title : 'Lilos Growth'}
      ogDescription={typeof metadata !== 'undefined' && metadata?.description ? metadata.description : typeof description !== 'undefined' ? description : 'Get more calls and booked jobs with Local SEO, Google Business Profile, and conversion-ready websites.'}
      twitterTitle={typeof metadata !== 'undefined' && metadata?.title ? metadata.title : typeof title !== 'undefined' ? title : 'Lilos Growth'}
      twitterDescription={typeof metadata !== 'undefined' && metadata?.description ? metadata.description : typeof description !== 'undefined' ? description : 'Get more calls and booked jobs with Local SEO, Google Business Profile, and conversion-ready websites.'}
    />
    <SiteVerification />
    <GoogleAnalytics />
    <VercelAnalytics />
    <SpeedInsights />
  </head>
  <body class={`flex min-h-screen flex-col antialiased ${bodyClass ?? ''}`}>
    <slot />
    <BasicScripts />
    <script is:inline>
      window.trackEvent = (name, data = {}) => {
        try {
          const va = /** @type {any} */ (window).va;
          if (typeof va === 'function') va('event', { name: String(name), data });
        } catch {}
        try { window.gtag?.('event', String(name), data); } catch {}
      };
    </script>
  </body>
</html>

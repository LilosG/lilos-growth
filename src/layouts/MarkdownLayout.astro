---
import Layout from "~/layouts/Layout.astro";
import type { MetaData as MetaDataType } from "~/types";

export interface Props {
  frontmatter?: Record<string, unknown>;
  metadata?: MetaDataType;
  title?: string;
  description?: string;
  lang?: string;
  bodyClass?: string;
}

const {
  frontmatter = {},
  metadata: inputMetadata,
  title,
  description,
  lang = "en",
  bodyClass = "",
} = Astro.props as Props;

// Build a safe title (string | undefined)
const metaTitle =
  typeof title === "string"
    ? title
    : typeof inputMetadata?.title === "string"
      ? (inputMetadata.title as string)
      : typeof frontmatter?.title === "string"
        ? (frontmatter.title as string)
        : undefined;

const metadata: MetaDataType = {
  ...(inputMetadata ?? {}),
  title: metaTitle,
};

// Helper to read a string safely from frontmatter
const fmTitle = typeof frontmatter?.title === "string" ? (frontmatter.title as string) : undefined;
---

<Layout metadata={metadata} {title} {description} {lang} {bodyClass}>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    {
      fmTitle && (
        <h1 class="leading-tighter font-heading text-4xl font-bold tracking-tighter md:text-5xl">
          {fmTitle}
        </h1>
      )
    }

    <div
      class="prose-md prose prose-lg mx-auto max-w-4xl dark:prose-invert prose-headings:font-heading dark:prose-headings:text-slate-300"
    >
      <slot />
    </div>
  </section>
</Layout>

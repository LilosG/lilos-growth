/* Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500;700&display=swap');

/* Tailwind layers */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* ---------- Base (site-wide defaults) ---------- */
body {
  @apply font-body text-body bg-white;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  @apply font-heading text-heading;
}

/* ---------- Small utility helpers that rely on AW CSS vars ---------- */
@layer utilities {
  .bg-page {
    background-color: var(--aw-color-bg-page);
  }
  .bg-dark {
    background-color: var(--aw-color-bg-page-dark);
  }
  .bg-light {
    background-color: var(--aw-color-bg-page);
  }
  .text-page {
    color: var(--aw-color-text-page);
  }
  .text-muted {
    color: var(--aw-color-text-muted);
  }
}

/* ---------- Reusable components ---------- */
@layer components {
  /* Consistent focus styling */
  .focus-ring {
    @apply focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a];
  }

  .btn {
    @apply inline-flex items-center justify-center rounded-full border border-gray-400 bg-transparent
           text-base font-medium leading-snug text-page text-center transition
           py-3.5 px-6 md:px-8
           ease-in duration-200
           hover:bg-gray-100 hover:border-gray-600
           dark:text-slate-300 dark:border-slate-500 dark:hover:bg-slate-800 dark:hover:border-slate-800
           cursor-pointer;
    @apply focus-ring;
  }

  .btn-primary {
    @apply btn font-semibold bg-primary text-white border-primary
           hover:bg-secondary hover:border-secondary hover:text-white
           dark:text-white dark:bg-primary dark:border-primary dark:hover:border-secondary dark:hover:bg-secondary;
  }

  .btn-secondary {
    @apply btn;
  }

  .btn-tertiary {
    @apply btn border-none shadow-none text-muted hover:text-gray-900
           dark:text-gray-400 dark:hover:text-white;
  }

  /* Optional: outline variant */
  .btn-outline-primary {
    @apply btn bg-white text-primary border border-primary hover:bg-primary hover:text-white;
  }
}

/* ---------- Header (shrink-on-scroll) ---------- */
/* Your markup adds .site-header and toggles .is-shrunk; style the wrapper inside header */
header.site-header-legacy.is-shrunk > div:first-child {
  @apply bg-page md:bg-white/90 md:backdrop-blur-md;
  box-shadow: 0 0.375rem 1.5rem 0 rgb(140 152 164 / 13%);
}
.dark header.site-header-legacy.is-shrunk > div:first-child,
header.site-header-legacy.is-shrunk.dark > div:first-child {
  @apply bg-page md:bg-[#030621e6] border-b border-gray-500/20;
  box-shadow: none;
}
/* If you later want the bar to compress vertically, uncomment:
header.site-header.is-shrunk .header-bar { @apply py-2; }
*/

/* ---------- Mobile menu & dropdown helpers (safe to keep) ---------- */
#header.expanded nav {
  position: fixed;
  top: 70px;
  left: 0;
  right: 0;
  bottom: 70px !important;
  padding: 0 5px;
}

.dropdown:focus .dropdown-menu,
.dropdown:focus-within .dropdown-menu,
.dropdown:hover .dropdown-menu {
  display: block;
}

/* Icon stroke helpers */
[astro-icon].icon-light > * {
  stroke-width: 1.2;
}
[astro-icon].icon-bold > * {
  stroke-width: 2.4;
}

/* Burger animation used by older header variant; harmless to keep */
[data-aw-toggle-menu] path {
  @apply transition;
}
[data-aw-toggle-menu].expanded g > path:first-child {
  @apply -rotate-45 translate-y-[15px] translate-x-[-3px];
}
[data-aw-toggle-menu].expanded g > path:last-child {
  @apply rotate-45 translate-y-[-8px] translate-x-[14px];
}

/* Spacing fix for legacy dropdown blocks */
.dd *:first-child {
  margin-top: 0;
}

/* ---------- CTA mapping (by data-evt) ---------- */
@layer components {
  /* Any instrumented CTA becomes a branded primary button */
  [data-evt^='cta_'] {
    @apply btn btn-primary;
  }
  /* Opt-in secondary (outline) when data-cta="secondary" */
  [data-evt^='cta_'][data-cta='secondary'] {
    @apply btn btn-outline-primary;
  }
}
/* ==== Header override (force readable scrolled state) ==== */
header.site-header .header-backplate {
  background: var(--hdr-bg) !important;
  border-bottom: 1px solid var(--hdr-border) !important;
  box-shadow: var(--hdr-shadow) !important;
}
header.site-header.is-shrunk .header-backplate {
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}
header.site-header.is-shrunk .nav-link {
  color: #1f2d3d !important;
}
header.site-header:not(.is-shrunk) .nav-link {
  color: rgba(255, 255, 255, 0.95) !important;
}
/* ==== /Header override ==== */

/* enforce nav-link colors */
header.site-header.is-shrunk .nav-link {
  color: #1f2d3d !important;
}
header.site-header:not(.is-shrunk) .nav-link {
  color: rgba(255, 255, 255, 0.95) !important;
}
/* ==== FINAL OVERRIDE: force readable scrolled header ==== */
header.site-header.is-shrunk .header-backplate {
  background: #ffffff !important;
  border-bottom: 1px solid rgba(2, 6, 23, 0.08) !important;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08) !important;
}
header.site-header.is-shrunk .nav-link {
  color: #1f2d3d !important;
}
/* ==== /FINAL OVERRIDE ==== */
/* ==== Logo readability on dark overlay (top-of-page only) ==== */
header.site-header:not(.is-shrunk) .logo--color {
  mix-blend-mode: screen; /* turns dark SVG nearly white over dark bg */
  opacity: 0.95; /* slight softening to avoid harsh edges */
}
/* ==== /Logo readability ==== */
/* -- Top-of-page color logo treatment (no white asset) -- */
header.site-header:not(.is-shrunk) .logo--color{
  mix-blend-mode: screen;
  filter: brightness(1.25) contrast(1.08);
  opacity: .98;
}
/* ------------------------------------------------------ */

---
import Layout from '~/layouts/PageLayout.astro';
---

<Layout>
  <!-- HERO SECTION -->
  <section class="bg-[#253242] min-h-[680px] flex items-center pt-10 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
    <div class="relative z-10 max-w-6xl mx-auto w-full flex flex-col md:flex-row md:items-center gap-14 px-4">
      <!-- Left Column: Logo, Headline, CTA -->
      <div class="flex-1">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-10 w-44" />
        <h1
          class="text-5xl md:text-7xl font-heading text-white font-extrabold mb-2 leading-tight text-left tracking-tight"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span class="block text-2xl md:text-4xl font-semibold mt-3 mb-2 text-[#f56b2a] tracking-wider uppercase">
            For Home Service Businesses
          </span>
        </h1>
        <div class="h-2 w-32 bg-[#f56b2a] rounded-full mb-8"></div>
        <p class="text-xl md:text-2xl text-white/80 mb-10 max-w-lg font-medium">
          Get more calls, book more jobs, and gain peace of mind—without tech overwhelm. Lilos Growth delivers
          actionable marketing for local service pros.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#contact"
            class="inline-flex items-center px-10 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-xl shadow transition"
          >
            Get More Calls Today
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <a
            href="#services"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
          >
            See Our Services
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
        </div>
      </div>
      <!-- Right Column: Lead Form -->
      <div class="flex-1 max-w-md mx-auto md:mx-0 bg-white p-10 rounded-3xl shadow-xl border border-gray-100">
        <h2 class="text-2xl font-heading text-heading font-bold mb-5 text-left">
          Free SEO Website Audit for Home Service Pros!
        </h2>
        <form class="flex flex-col gap-5" data-netlify="true">
          <input
            type="text"
            name="name"
            placeholder="Your Name"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary"
            required
          />
          <input
            type="email"
            name="email"
            placeholder="Email Address"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary"
            required
          />
          <input
            type="text"
            name="company"
            placeholder="Company Name"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base"
          />
          <input
            type="text"
            name="website"
            placeholder="Website"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base"
            required
          />
          <button
            type="submit"
            class="mt-2 px-8 py-4 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#f34e00] transition"
          >
            Get My Free Audit
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="py-14 bg-cream border-t border-gray-100" id="who-we-help">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-7">Who We Help</h2>
      <h3 class="text-lg font-semibold text-heading mb-2">Home Service Businesses We Work With:</h3>
      <div class="flex flex-wrap gap-4 justify-center mb-3">
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Plumbers</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">HVAC</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Electricians</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Roofers</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Cleaning</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Pest Control</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Landscaping</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Other Trades</span>
      </div>
    </div>
  </section>

  <!-- FULLY MANAGED LOCAL SEO SECTION -->
  <section class="py-24 bg-cream border-t border-gray-100" id="included-services">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
        Fully Managed Local SEO for Home Service Businesses
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Complete, end-to-end SEO management that puts your business at the top of local search results.<br />
        We handle everything so you can focus on what you do best.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-10">
        <!-- Card 1 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Google Business Profile Management</h3>
          <p class="text-body mb-4">
            Get seen in Google Maps and local search results with a fully optimized, always up-to-date profile.
          </p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>Complete setup and full optimization for your main services and service areas</li>
            <li>Consistent photo, update, and post management</li>
            <li>Monthly profile audits to stay ahead of algorithm changes</li>
          </ul>
        </article>
        <!-- Card 2 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Local Citation Building</h3>
          <p class="text-body mb-4">
            Build trust and local authority with accurate, consistent listings everywhere your customers search.
          </p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>Business info (NAP) cleanup and accuracy across 50+ directories</li>
            <li>Submissions to top industry and local sites</li>
            <li>Ongoing updates and audit checks for accuracy</li>
          </ul>
        </article>
        <!-- Card 3 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.828 10.172a4 4 0 010 5.656l-3.536 3.536a4 4 0 01-5.656-5.656l1.414-1.414"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.172 13.828a4 4 0 010-5.656l3.536-3.536a4 4 0 015.656 5.656l-1.414 1.414"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Local Link Building</h3>
          <p class="text-body mb-4">
            Boost your rankings and authority with strategic local backlinks that make a difference.
          </p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>Outreach to local sites, blogs, and organizations</li>
            <li>Earning placements on trusted, relevant domains</li>
            <li>Community-based link strategies for long-term growth</li>
          </ul>
        </article>
        <!-- Card 4 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <rect x="5" y="4" width="14" height="16" rx="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9h8M8 13h6"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Content & On-Page SEO</h3>
          <p class="text-body mb-4">
            Turn searchers into customers with content and site improvements that drive results.
          </p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>SEO-focused service area and location pages</li>
            <li>Blog content that answers real customer questions</li>
            <li>On-page optimization: keywords, meta tags, internal links</li>
          </ul>
        </article>
        <!-- Card 5 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <rect x="3" y="6" width="18" height="12" rx="2"></rect>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h8"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Website Build & Optimization</h3>
          <p class="text-body mb-4">
            Modern websites built for speed, trust, and more leads—ready for Google’s latest standards.
          </p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>Fast, mobile-first, and conversion-focused design</li>
            <li>Technical SEO built in: site speed, structure, schema, Core Web Vitals</li>
            <li>Easy updates and built-in tracking for your growth</li>
          </ul>
        </article>
        <!-- Card 6 -->
        <article
          class="bg-white rounded-2xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-10 h-10 text-[#f56b2a]"
            >
              <polygon points="12,2 15,10 24,10 17,15 19,23 12,18 5,23 7,15 0,10 9,10"></polygon>
            </svg>
          </div>
          <h3 class="text-2xl font-semibold mb-2 text-heading">Review Management</h3>
          <p class="text-body mb-4">Stand out from competitors and build trust with a proven review strategy.</p>
          <ul class="text-body list-disc list-inside space-y-1">
            <li>Request and automate new review invites</li>
            <li>Monitor, respond, and manage all reviews in one place</li>
            <li>Guidance for building a five-star reputation</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-20 bg-white border-t border-gray-100" id="why">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
        Why Choose Lilos Growth for Your Home Service Business?
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="flex flex-col items-center bg-bluelight rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Specialists in Home Services</h3>
          <p class="text-body text-center">We know the industry inside and out—no generic marketing here.</p>
        </div>
        <!-- Card 2 -->
        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Big Agency Fluff</h3>
          <p class="text-body text-center">
            Direct, personal attention from a dedicated strategist. No “account managers” or runarounds.
          </p>
        </div>
        <!-- Card 3 -->
        <div class="flex flex-col items-center bg-bluelight rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Results You Can See</h3>
          <p class="text-body text-center">
            Local rankings, calls, and jobs—measurable improvements, not vanity metrics.
          </p>
        </div>
        <!-- Card 4 -->
        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Easy, Honest, & Human</h3>
          <p class="text-body text-center">Clear reporting, no confusing jargon, and a process that makes sense.</p>
        </div>
        <!-- Card 5 (New) -->
        <div class="flex flex-col items-center bg-bluelight rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Long-Term Contract</h3>
          <p class="text-body text-center">
            Stay as long as we’re delivering real results. We work to earn your business every month—no setup fees, no
            hidden terms.
          </p>
        </div>
        <!-- Card 6 (New) -->
        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Built by Home Service Owners</h3>
          <p class="text-body text-center">
            Lilos Growth was created by former home service business owners who know what works—and what doesn’t—when
            marketing for local trades. We get it because we’ve lived it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCAL SEO PROCESS SECTION -->
  <section class="py-20 bg-cream border-t border-gray-100" id="process">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
        Our Proven 4-Step Local SEO System
        <span class="block mx-auto mt-2 h-1 w-16 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center max-w-2xl mx-auto font-medium">
        Here's exactly how we get your business ranking higher and bringing in more local calls—no guesswork, just
        results.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <div
          class="flex flex-col items-center bg-white rounded-2xl shadow-md border border-gray-100 p-8 h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-xl"
        >
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[#f56b2a]/10 mb-4">
            <span class="text-2xl font-bold text-[#f56b2a]">1</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-heading mb-2 text-center">Keyword & Market Research</h3>
          <p class="text-body text-base text-center">
            We start with data—uncovering what your local customers actually search for. Every strategy is built on real
            search volume and opportunity, not guesses.
          </p>
        </div>
        <!-- Step 2 -->
        <div
          class="flex flex-col items-center bg-white rounded-2xl shadow-md border border-gray-100 p-8 h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-xl"
        >
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[#f56b2a]/10 mb-4">
            <span class="text-2xl font-bold text-[#f56b2a]">2</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-heading mb-2 text-center">Profile & Website Optimization</h3>
          <p class="text-body text-base text-center">
            We fully optimize your Google Business Profile and website—fixing technical issues, adding your best
            services, and making it easy for customers to find and contact you.
          </p>
        </div>
        <!-- Step 3 -->
        <div
          class="flex flex-col items-center bg-white rounded-2xl shadow-md border border-gray-100 p-8 h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-xl"
        >
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[#f56b2a]/10 mb-4">
            <span class="text-2xl font-bold text-[#f56b2a]">3</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-heading mb-2 text-center">Content & Authority Building</h3>
          <p class="text-body text-base text-center">
            We publish location-focused pages and helpful blog content, then build high-quality links that increase your
            authority, visibility, and trust with Google.
          </p>
        </div>
        <!-- Step 4 -->
        <div
          class="flex flex-col items-center bg-white rounded-2xl shadow-md border border-gray-100 p-8 h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-xl"
        >
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-[#f56b2a]/10 mb-4">
            <span class="text-2xl font-bold text-[#f56b2a]">4</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-heading mb-2 text-center">Ongoing Management & Results</h3>
          <p class="text-body text-base text-center">
            We track your progress, report wins, and keep optimizing—new content, smart updates, and regular strategy
            tweaks. You get clear results and more calls, month after month.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE PACKAGES SECTION - UNIFIED STYLE WITH ADD-ON CHECKBOX -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
        Service Packages for Home Service Companies
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Choose the package that fits your goals. No contracts. Real results.
      </p>
      <div class="flex flex-col md:flex-row gap-10 items-stretch justify-center">
        <!-- GBP Card -->
        <div
          class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto"
        >
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">Google Business Profile Services</h3>
          <div class="text-base font-semibold mb-1 text-center">Basic: Profile Management</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Maintaining Your Google Presence
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $199<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>Basic GBP setup</li>
            <li>Monthly listing maintenance</li>
            <li>Photo uploads</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">$299/mo</span>
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Full GBP setup & optimization</li>
                  <li>Monthly listing management</li>
                  <li>Review & reputation guidance</li>
                  <li>Posts, photos, updates</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
            >
              Get Started
            </a>
          </div>
        </div>
        <!-- SEO Card -->
        <div
          class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto relative"
        >
          <div
            class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10"
          >
            Most Popular
          </div>
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center mt-3">Organic &amp; Local SEO</h3>
          <div class="text-base font-semibold mb-1 text-center">Regular: Local SEO Essentials</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Steady, Consistent Growth
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $499<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">

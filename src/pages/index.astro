---
/**
 * Homepage - Refactored with Design System
 *
 * This is the refactored version using proper design tokens,
 * reusable components, and best practices for Astro + Tailwind.
 */
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/core/Button.astro";
import Badge from "~/components/core/Badge.astro";
import Section from "~/components/core/Section.astro";
import ServiceCard from "~/components/composed/ServiceCard.astro";
import ProcessStep from "~/components/composed/ProcessStep.astro";
import StatCard from "~/components/composed/StatCard.astro";
import LeadCaptureForm from "~/components/composed/LeadCaptureForm.astro";
import GuaranteeBadge from "~/components/composed/GuaranteeBadge.astro";
import PricingCard from "~/components/composed/PricingCard.astro";
import TestimonialBand from "~/components/results/TestimonialBand.astro";
import TrustBand from "~/components/composed/TrustBand.astro";
import { homeTestimonials, trustLogos } from "~/data/proof";

export const title = "Local SEO + GBP Management for Home Service Pros";
export const description =

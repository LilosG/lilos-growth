---
// src/pages/index.astro
import Layout from "~/layouts/PageLayout.astro";
import PricingSection from "~/components/sections/PricingSection.astro";

export const title = "Local SEO & Websites for Home Service Pros";
export const description =
  "Get more calls and booked jobs with Local SEO, Google Business Profile management, and conversion-ready websites—built for plumbers, HVAC, pest control, and other service pros.";

// Pass page-specific SEO to the global <Metadata /> via Layout
export const metadata = {
  title,
  description,
  ignoreTitleTemplate: true,
};

---

<Layout title={title} description={description} metadata={metadata}>
  <fragment slot="head">
    <!-- Preload LCP image - WebP primary, PNG fallback -->
    <link
      rel="preload"
      as="image"
      href="/logo-lcp-160.webp"
      type="image/webp"
      fetchpriority="high"
    />
  </fragment>

  <!-- HERO SECTION -->
  <section
    class="relative flex min-h-[680px] items-center overflow-hidden bg-secondary pb-20 pt-10"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 md:flex-row md:items-center"
    >
      <!-- Left Column: Logo, Headline, CTA -->
      <div class="flex-1">
        <picture>
          <source srcset="/logo-lcp-160.webp 1x, /logo-lcp-320.webp 2x" type="image/webp" />
          <img
            src="/logo-lcp-160.webp"
            alt="Lilos Growth Logo"
            class="logo--halo mb-10 w-40"
            width="160"
            height="160"
            fetchpriority="high"
            loading="eager"
          />
        </picture>
        <h1
          class="mb-2 text-left font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span
            class="mb-2 mt-3 block text-xl font-semibold uppercase tracking-wider text-primary md:text-3xl"
          >
            For Home Service Businesses
          </span>
        </h1>
        <div class="mb-8 h-1.5 w-28 rounded-full bg-primary"></div>
        <p class="mb-9 max-w-lg text-lg font-medium text-white/80 md:text-xl">
          Get more calls, book more jobs, guaranteed!
          <span
            class="mb-2 mt-3 block text-xl font-semibold uppercase tracking-wider text-primary md:text-3xl"
          ></span>
          If qualified calls or forms don’t grow within 90 days, we refund months 2–3
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center rounded-2xl bg-primary px-8 py-3.5 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
            aria-label="Get Started — open contact form"
          >
            Get More Calls Today
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Lead Form -->
      <div
        id="contact"
        class="mx-auto max-w-md flex-1 rounded-3xl border border-gray-100 bg-white p-10 shadow-xl md:mx-0"
      >
        <h2 class="mb-4 text-left font-heading text-xl font-bold text-heading">
          Free SEO Website Audit for Home Service Pros!
        </h2>

        <!-- Formspree lead capture -->
        <form method="POST" action="https://formspree.io/f/movlbqdk" class="gap-4.5 flex flex-col">
          <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />

          <div>
            <label for="name" class="sr-only">Your Name</label>
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Your Name"
              autocomplete="name"
              class="focus:ring-primary/30 w-full rounded-lg border border-border-base bg-white px-4 py-3.5 text-base text-heading placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
              required
            />
          </div>

          <div>
            <label for="email" class="sr-only">Email Address</label>
            <input
              id="email"
              type="email"
              name="_replyto"
              placeholder="Email Address"
              autocomplete="email"
              class="focus:ring-primary/30 w-full rounded-lg border border-border-base bg-white px-4 py-3.5 text-base text-heading placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
              required
            />
          </div>

          <div>
            <label for="company" class="sr-only">Company Name</label>
            <input
              id="company"
              type="text"
              name="company"
              placeholder="Company Name"
              autocomplete="organization"
              class="focus:ring-primary/30 w-full rounded-lg border border-border-base bg-white px-4 py-3.5 text-base text-heading placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
            />
          </div>

          <div>
            <label for="website" class="sr-only">Website</label>
            <input
              id="website"
              type="url"
              name="website"
              placeholder="Website"
              inputmode="url"
              autocomplete="url"
              class="focus:ring-primary/30 w-full rounded-lg border border-border-base bg-white px-4 py-3.5 text-base text-heading placeholder:text-muted focus:border-primary focus:outline-none focus:ring-2"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-1.5 rounded-xl bg-primary px-7 py-3.5 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-dark"
            data-evt="cta_hero_free_audit"
          >
            Get My Free Audit
          </button>
        </form>

        <!-- Trust micro-copy -->
        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="border-t border-gray-100 bg-white py-14" id="who-we-help">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-6 font-heading text-2xl font-bold md:text-3xl">Who We Help</h2>
      <h3 class="mb-2 text-base font-semibold text-heading">
        Home Service Businesses We Work With:
      </h3>
      <div class="mb-2.5 flex flex-wrap justify-center gap-3.5">
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold">Plumbers</span>
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold">HVAC</span>
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold"
          >Electricians</span
        >
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold">Roofers</span>
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold">Cleaning</span>
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold"
          >Pest Control</span
        >
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold">Landscaping</span
        >
        <span class="bg-bluelight rounded-xl px-5 py-2 font-heading font-semibold"
          >Other Trades</span
        >
      </div>
    </div>
  </section>

  <!-- FULLY MANAGED LOCAL SEO SECTION -->
  <section class="bg-cream border-t border-gray-100 py-24" id="included-services">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3.5 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Fully Managed Local SEO for Home Service Businesses
      </h2>
      <p class="mb-12 text-center text-lg font-medium text-body">
        Complete, end-to-end SEO management that puts your business at the top of local search
        results.<br />
        We handle everything so you can focus on what you do best.
      </p>

      <div class="grid grid-cols-1 gap-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="h-8 w-8 text-primary"
            >
              <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"
              ></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">
            Google Business Profile Management
          </h3>
          <p class="mb-3.5 text-[15px] text-body">
            Get seen in Google Maps and local search results with a fully optimized, always
            up-to-date profile.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Complete setup and full optimization for your main services and service areas</li>
            <li>Consistent photo, update, and post management</li>
            <li>Monthly profile audits to stay ahead of algorithm changes</li>
          </ul>
        </article>

        <!-- Card 2 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="h-8 w-8 text-primary"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">Local Citation Building</h3>
          <p class="mb-3.5 text-[15px] text-body">
            Build trust and local authority with accurate, consistent listings everywhere your
            customers search.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Business info (NAP) cleanup and accuracy across core directories</li>
            <li>Submissions to top industry and local sites</li>
            <li>Ongoing updates and audit checks for accuracy</li>
          </ul>
        </article>

        <!-- Card 3 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-8 w-8 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 2l2.5 5.5L20 10l-5.5 2.5L12 18l-2.5-5.5L4 10l5.5-2.5L12 2z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">AI Search Optimization (AEO)</h3>
          <p class="mb-3.5 text-[15px] text-body">
            Make pages quotable in AI Overviews and assistants. We structure content and schema so
            AI can find, understand, and cite your business.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Entity-rich copy + long-tail Q&amp;A blocks</li>
            <li>Schema: LocalBusiness, Service, FAQ, HowTo</li>
            <li>Answer-block rewrites for zero-click visibility</li>
            <li>GBP Q&amp;A + review prompts aligned to AEO</li>
          </ul>
        </article>

        <!-- Card 4 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 5h16M4 12h10M4 19h16"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">Content & On-Page SEO</h3>
          <p class="mb-3.5 text-[15px] text-body">
            Turn pages into top-ranking assets with intent-matched content and technical on-page
            fixes.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Service & location pages that convert</li>
            <li>Title/meta, headings, internal links</li>
            <li>Core Web Vitals-friendly content patterns</li>
          </ul>
        </article>

        <!-- Card 5 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="M7 8h10M7 12h6M7 16h10"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">Website Build & Optimization</h3>
          <p class="mb-3.5 text-[15px] text-body">
            Modern, fast, mobile-ready pages that load quickly and turn visitors into leads.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Speed, security & technical SEO</li>
            <li>Conversion-ready layouts & CRO tweaks</li>
            <li>Tracked forms & analytics setup</li>
          </ul>
        </article>

        <!-- Card 6 -->
        <article
          class="border-primary/10 shadow-primary/10 hover:shadow-primary/20 flex h-full flex-col items-start rounded-3xl border-2 bg-white p-8 shadow-xl transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-primary"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 17l-5 3 1.9-5.9L4 9h6l2-6 2 6h6l-4.9 5.1 L17 20z"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-xl font-semibold text-heading">Review Management</h3>
          <p class="mb-3.5 text-[15px] text-body">
            Drive more 5-star reviews and showcase social proof everywhere customers look.
          </p>
          <ul class="list-inside list-disc space-y-1.5 text-[15px] text-body">
            <li>Automated review requests & responses</li>
            <li>GBP, Google & niche platform coverage</li>
            <li>On-site review widgets & trust signals</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-white py-24">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Why Choose Lilos Growth for Your Home Service Business?
      </h2>
      <span class="mx-auto mt-2 block h-1 w-12 rounded bg-primary"></span>

      <div class="mt-11 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-3xl border border-gray-100 bg-white p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">Specialized in Home Services</h3>
          <p class="text-[15px] text-body">
            We exclusively serve trades and home service pros—no generic strategies here.
          </p>
        </article>

        <article class="bg-cream rounded-3xl border border-gray-100 p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">No Big Agency Fluff</h3>
          <p class="text-[15px] text-body">
            Direct communication with local SEO experts. No layers of account managers.
          </p>
        </article>

        <article class="rounded-3xl border border-gray-100 bg-white p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">Proven Local Results</h3>
          <p class="text-[15px] text-body">
            Map Pack rankings, reviews, and calls—delivered across multiple service markets.
          </p>
        </article>

        <article class="bg-cream rounded-3xl border border-gray-100 p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">Easy, Honest Pricing</h3>
          <p class="text-[15px] text-body">
            Clear, simple pricing and packages designed for service companies.
          </p>
        </article>

        <article class="rounded-3xl border border-gray-100 bg-white p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">Strategy &amp; Execution</h3>
          <p class="text-[15px] text-body">
            We build the roadmap and implement it—no cookie-cutter templates here.
          </p>
        </article>

        <article class="bg-cream rounded-3xl border border-gray-100 p-8 shadow-md">
          <h3 class="mb-2 font-heading text-base font-semibold">Built by Service Owners</h3>
          <p class="text-[15px] text-body">
            We’ve run service businesses ourselves, so we know what actually works.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- PROVEN PROCESS -->
  <section class="bg-cream border-t border-gray-100 py-24">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Our Proven 4-Step Local SEO System
      </h2>
      <span class="mx-auto mt-2 block h-1 w-12 rounded bg-primary"></span>
      <p class="mb-12 mt-6 text-center text-lg font-medium text-body">
        Here’s exactly how we get your business ranking higher and bringing in more local calls<br
          class="hidden md:block"
        />
        —no guesswork, just results.
      </p>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        <!-- Step 1 -->
        <article class="rounded-3xl border border-gray-200 bg-white p-8 text-center shadow">
          <div
            class="border-primary/20 mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full border bg-[#fff7f0] font-bold text-primary"
          >
            1
          </div>
          <h3 class="mb-2 text-base font-semibold">Keyword &amp; Market Research</h3>
          <p class="text-[15px] text-body">
            We analyze your market, competitors, and customer search patterns to build a data-driven
            plan.
          </p>
        </article>

        <!-- Step 2 -->
        <article class="rounded-3xl border border-gray-200 bg-white p-8 text-center shadow">
          <div
            class="border-primary/20 mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full border bg-[#fff7f0] font-bold text-primary"
          >
            2
          </div>
          <h3 class="mb-2 text-base font-semibold">Profile &amp; Website Optimization</h3>
          <p class="text-[15px] text-body">
            We fully optimize your GBP and website so they work together to dominate local search
            results.
          </p>
        </article>

        <!-- Step 3 -->
        <article class="rounded-3xl border border-gray-200 bg-white p-8 text-center shadow">
          <div
            class="border-primary/20 mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full border bg-[#fff7f0] font-bold text-primary"
          >
            3
          </div>
          <h3 class="mb-2 text-base font-semibold">Content &amp; Authority Building</h3>
          <p class="text-[15px] text-body">
            We publish service/location pages and blog content, then earn high-quality links that
            grow authority.
          </p>
        </article>

        <!-- Step 4 -->
        <article class="rounded-3xl border border-gray-200 bg-white p-8 text-center shadow">
          <div
            class="border-primary/20 mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full border bg-[#fff7f0] font-bold text-primary"
          >
            4
          </div>
          <h3 class="mb-2 text-base font-semibold">Ongoing Management &amp; Results</h3>
          <p class="text-[15px] text-body">
            We track performance, report wins, and keep optimizing—new content, smart updates,
            strategy tweaks.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE PACKAGES -->
  --- ---

  <PricingSection />

  <!-- Wavy Divider -->
  <div class="-mb-1 w-full overflow-hidden leading-none">
    <svg viewBox="0 0 1440 60" class="block h-10 w-full text-white" aria-hidden="true">
      <path fill="currentColor" d="M0,32L1440,0V60H0Z"></path>
    </svg>
  </div>

  <!-- PROOF METRICS BAND -->
  <section aria-label="Key results" class="border-t border-gray-100 bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <p class="mb-8 text-center text-sm font-semibold uppercase tracking-widest text-body">Verified client results — Wheyland Electric</p>
      <ul class="grid grid-cols-1 gap-6 text-center sm:grid-cols-3 md:gap-8">
        <li class="rounded-2xl border border-gray-200 bg-white/60 p-6">
          <div class="font-heading text-4xl font-bold tracking-tight text-primary">+900%</div>
          <p class="mt-1 text-sm text-gray-600">Keyword growth in 30 days after launch</p>
        </li>
        <li class="rounded-2xl border border-gray-200 bg-white/60 p-6">
          <div class="font-heading text-4xl font-bold tracking-tight text-primary">3×</div>
          <p class="mt-1 text-sm text-gray-600">GBP calls — month one post-launch</p>
        </li>
        <li class="rounded-2xl border border-gray-200 bg-white/60 p-6">
          <div class="font-heading text-4xl font-bold tracking-tight text-primary">+350%</div>
          <p class="mt-1 text-sm text-gray-600">Web leads in first 3 weeks</p>
        </li>
      </ul>
      <p class="mt-6 text-center text-sm text-body">
        <a href="/results" class="font-semibold text-primary underline underline-offset-2 hover:text-primary-dark">See the full case study →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-20" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2
        class="relative mb-7 text-center font-heading text-2xl font-bold text-heading md:text-3xl"
      >
        Frequently Asked Questions About Home Service Marketing
        <span class="mx-auto mt-2 block h-1 w-12 rounded bg-primary"></span>
      </h2>
      <div class="space-y-6">
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-base font-semibold text-heading">
            How quickly will I see results from local SEO?
          </h3>
          <p class="text-[15px] text-body">
            Most home service companies start seeing more calls, leads, and improved rankings within
            30–60 days—sometimes faster. Your results can depend on your market and competition, but
            we focus on quick wins from day one.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-base font-semibold text-heading">
            Are there any setup fees?

---
// src/pages/index.astro
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Local SEO & Websites for Home Service Pros | Lilos Growth';
export const description =
  'Get more calls and booked jobs with Local SEO, Google Business Profile management, and conversion-ready websites—built for plumbers, HVAC, pest control, and other service pros.';

// Pass page-specific SEO to the global <Metadata /> via Layout
export const metadata = {
  title,
  description,
  ignoreTitleTemplate: true,
};
---

<Layout title={title} description={description} metadata={metadata}>
  <!-- HERO SECTION -->
  <section class="bg-[#253242] min-h-[680px] flex items-center pt-10 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto w-full flex flex-col md:flex-row md:items-center gap-14 px-4">
      <!-- Left Column: Logo, Headline, CTA -->
      <div class="flex-1">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-10 w-40" fetchpriority="high" />
        <h1
          class="text-4xl md:text-6xl font-heading text-white font-extrabold mb-2 leading-tight text-left tracking-tight"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span class="block text-xl md:text-3xl font-semibold mt-3 mb-2 text-[#f56b2a] tracking-wider uppercase">
            For Home Service Businesses
          </span>
        </h1>
        <div class="h-1.5 w-28 bg-[#f56b2a] rounded-full mb-8"></div>
        <p class="text-lg md:text-xl text-white/80 mb-9 max-w-lg font-medium">
          Get more calls, book more jobs, and gain peace of mind—without tech overwhelm. Lilos Growth delivers
          actionable marketing for local service pros.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center px-8 py-3.5 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
            aria-label="Get Started — open contact form"
          >
            Get More Calls Today
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="#packages"
            class="hidden md:inline-flex items-center px-6 py-3 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-base shadow transition"
            data-evt="cta_hero_see_services"
          >
            See Our Services
            <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Lead Form -->
      <div
        id="contact"
        class="flex-1 max-w-md mx-auto md:mx-0 bg-white p-10 rounded-3xl shadow-xl border border-gray-100"
      >
        <h2 class="text-xl font-heading text-heading font-bold mb-4 text-left">
          Free SEO Website Audit for Home Service Pros!
        </h2>

        <!-- Netlify-friendly form: name, POST, hidden form-name, honeypot -->
        <form
          name="seo-audit"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="flex flex-col gap-4.5"
          action="/thank-you"
        >
          <input type="hidden" name="form-name" value="seo-audit" />
          <p class="hidden">
            <label>
              Don’t fill this out if you’re human:
              <input name="bot-field" />
            </label>
          </p>

          <div>
            <label for="name" class="sr-only">Your Name</label>
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Your Name"
              autocomplete="name"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="email" class="sr-only">Email Address</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="Email Address"
              autocomplete="email"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="company" class="sr-only">Company Name</label>
            <input
              id="company"
              type="text"
              name="company"
              placeholder="Company Name"
              autocomplete="organization"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
            />
          </div>

          <div>
            <label for="website" class="sr-only">Website</label>
            <input
              id="website"
              type="url"
              name="website"
              placeholder="Website"
              inputmode="url"
              autocomplete="url"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-1.5 px-7 py-3.5 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#f34e00] transition"
            data-evt="cta_hero_free_audit"
          >
            Get My Free Audit
          </button>
        </form>

        <!-- Trust micro-copy -->
        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="py-14 bg-white border-t border-gray-100" id="who-we-help">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold mb-6">Who We Help</h2>
      <h3 class="text-base font-semibold text-heading mb-2">Home Service Businesses We Work With:</h3>
      <div class="flex flex-wrap gap-3.5 justify-center mb-2.5">
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Plumbers</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">HVAC</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Electricians</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Roofers</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Cleaning</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Pest Control</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Landscaping</span>
        <span class="px-5 py-2 rounded-xl bg-bluelight font-heading font-semibold">Other Trades</span>
      </div>
    </div>
  </section>

  <!-- FULLY MANAGED LOCAL SEO SECTION -->
  <section class="py-24 bg-cream border-t border-gray-100" id="included-services">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-3.5 text-center">
        Fully Managed Local SEO for Home Service Businesses
      </h2>
      <p class="text-lg text-body mb-12 text-center font-medium">
        Complete, end-to-end SEO management that puts your business at the top of local search results.<br />
        We handle everything so you can focus on what you do best.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-10">
        <!-- Card 1 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-8 h-8 text-[#f56b2a]"
            >
              <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">Google Business Profile Management</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Get seen in Google Maps and local search results with a fully optimized, always up-to-date profile.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Complete setup and full optimization for your main services and service areas</li>
            <li>Consistent photo, update, and post management</li>
            <li>Monthly profile audits to stay ahead of algorithm changes</li>
          </ul>
        </article>

        <!-- Card 2 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="w-8 h-8 text-[#f56b2a]"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"></path>
              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">Local Citation Building</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Build trust and local authority with accurate, consistent listings everywhere your customers search.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Business info (NAP) cleanup and accuracy across core directories</li>
            <li>Submissions to top industry and local sites</li>
            <li>Ongoing updates and audit checks for accuracy</li>
          </ul>
        </article>

        <!-- Card 3 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-8 h-8 text-[#f56b2a]"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 2l2.5 5.5L20 10l-5.5 2.5L12 18l-2.5-5.5L4 10l5.5-2.5L12 2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">AI Search Optimization (AEO)</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Make pages quotable in AI Overviews and assistants. We structure content and schema so AI can find,
            understand, and cite your business.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Entity-rich copy + long-tail Q&amp;A blocks</li>
            <li>Schema: LocalBusiness, Service, FAQ, HowTo</li>
            <li>Answer-block rewrites for zero-click visibility</li>
            <li>GBP Q&amp;A + review prompts aligned to AEO</li>
          </ul>
        </article>

        <!-- Card 4 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 5h16M4 12h10M4 19h16"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">Content & On-Page SEO</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Turn pages into top-ranking assets with intent-matched content and technical on-page fixes.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Service & location pages that convert</li>
            <li>Title/meta, headings, internal links</li>
            <li>Core Web Vitals-friendly content patterns</li>
          </ul>
        </article>

        <!-- Card 5 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="16" rx="2"></rect>
              <path d="M7 8h10M7 12h6M7 16h10"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">Website Build & Optimization</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Modern, fast, mobile-ready pages that load quickly and turn visitors into leads.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Speed, security & technical SEO</li>
            <li>Conversion-ready layouts & CRO tweaks</li>
            <li>Tracked forms & analytics setup</li>
          </ul>
        </article>

        <!-- Card 6 -->
        <article
          class="bg-white rounded-3xl border-2 border-[#f56b2a]/10 shadow-xl shadow-[#f56b2a]/10 p-8 flex flex-col items-start h-full transition-transform duration-200 hover:-translate-y-2 hover:shadow-2xl hover:shadow-[#f56b2a]/20"
        >
          <div class="mb-4" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-8 h-8 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 17l-5 3 1.9-5.9L4 9h6l2-6 2 6h6l-4.9 5.1 L17 20z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2 text-heading">Review Management</h3>
          <p class="text-body mb-3.5 text-[15px]">
            Drive more 5-star reviews and showcase social proof everywhere customers look.
          </p>
          <ul class="text-body list-disc list-inside space-y-1.5 text-[15px]">
            <li>Automated review requests & responses</li>
            <li>GBP, Google & niche platform coverage</li>
            <li>On-site review widgets & trust signals</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-24 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold text-center">
        Why Choose Lilos Growth for Your Home Service Business?
      </h2>
      <span class="block mx-auto mt-2 h-1 w-12 bg-[#f56b2a] rounded"></span>

      <div class="mt-11 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <article class="bg-white rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">Specialized in Home Services</h3>
          <p class="text-body text-[15px]">
            We exclusively serve trades and home service pros—no generic strategies here.
          </p>
        </article>

        <article class="bg-cream rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">No Big Agency Fluff</h3>
          <p class="text-body text-[15px]">
            Direct communication with local SEO experts. No layers of account managers.
          </p>
        </article>

        <article class="bg-white rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">Proven Local Results</h3>
          <p class="text-body text-[15px]">
            Map Pack rankings, reviews, and calls—delivered across multiple service markets.
          </p>
        </article>

        <article class="bg-cream rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">Easy, Honest Pricing</h3>
          <p class="text-body text-[15px]">Clear, simple pricing and packages designed for service companies.</p>
        </article>

        <article class="bg-white rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">Strategy &amp; Execution</h3>
          <p class="text-body text-[15px]">We build the roadmap and implement it—no cookie-cutter templates here.</p>
        </article>

        <article class="bg-cream rounded-3xl p-8 shadow-md border border-gray-100">
          <h3 class="font-heading text-base font-semibold mb-2">Built by Service Owners</h3>
          <p class="text-body text-[15px]">We’ve run service businesses ourselves, so we know what actually works.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PROVEN PROCESS -->
  <section class="py-24 bg-cream border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold text-center">
        Our Proven 4-Step Local SEO System
      </h2>
      <span class="block mx-auto mt-2 h-1 w-12 bg-[#f56b2a] rounded"></span>
      <p class="text-lg text-body mt-6 mb-12 text-center font-medium">
        Here’s exactly how we get your business ranking higher and bringing in more local calls<br
          class="hidden md:block"
        />
        —no guesswork, just results.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Step 1 -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow p-8 text-center">
          <div
            class="mx-auto mb-4 flex items-center justify-center w-10 h-10 rounded-full bg-[#fff7f0] text-[#f56b2a] font-bold border border-[#f56b2a]/20"
          >
            1
          </div>
          <h3 class="text-base font-semibold mb-2">Keyword &amp; Market Research</h3>
          <p class="text-body text-[15px]">
            We analyze your market, competitors, and customer search patterns to build a data-driven plan.
          </p>
        </article>

        <!-- Step 2 -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow p-8 text-center">
          <div
            class="mx-auto mb-4 flex items-center justify-center w-10 h-10 rounded-full bg-[#fff7f0] text-[#f56b2a] font-bold border border-[#f56b2a]/20"
          >
            2
          </div>
          <h3 class="text-base font-semibold mb-2">Profile &amp; Website Optimization</h3>
          <p class="text-body text-[15px]">
            We fully optimize your GBP and website so they work together to dominate local search results.
          </p>
        </article>

        <!-- Step 3 -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow p-8 text-center">
          <div
            class="mx-auto mb-4 flex items-center justify-center w-10 h-10 rounded-full bg-[#fff7f0] text-[#f56b2a] font-bold border border-[#f56b2a]/20"
          >
            3
          </div>
          <h3 class="text-base font-semibold mb-2">Content &amp; Authority Building</h3>
          <p class="text-body text-[15px]">
            We publish service/location pages and blog content, then earn high-quality links that grow authority.
          </p>
        </article>

        <!-- Step 4 -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow p-8 text-center">
          <div
            class="mx-auto mb-4 flex items-center justify-center w-10 h-10 rounded-full bg-[#fff7f0] text-[#f56b2a] font-bold border border-[#f56b2a]/20"
          >
            4
          </div>
          <h3 class="text-base font-semibold mb-2">Ongoing Management &amp; Results</h3>
          <p class="text-body text-[15px]">
            We track performance, report wins, and keep optimizing—new content, smart updates, strategy tweaks.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- SERVICE PACKAGES -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-3.5 text-center relative">
        Service Packages for Home Service Companies
        <span class="block mx-auto mt-2 h-1 w-12 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-lg text-body mb-11 text-center font-medium">
        Choose the package that fits your goals. No contracts. Real results.
      </p>

      <!-- Equal-height cards with anchored CTAs and a nested "Upgrade" panel (Option A) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 items-stretch auto-rows-fr">
        <!-- GBP -->
        <article class="h-full bg-white rounded-3xl shadow-md border border-gray-200 p-8 flex flex-col relative">
          <header class="text-center">
            <h3 class="text-lg font-heading font-bold text-heading">Google Business Profile</h3>
            <div class="text-xs font-semibold mt-1">Base: Profile Management</div>
            <span class="inline-block text-[11px] bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold">
              Best for: Maintaining Your Google Presence
            </span>
            <div class="text-2xl font-bold text-[#f56b2a] mt-4">
              $199<span class="text-sm font-normal text-gray-500">/mo</span>
            </div>
          </header>

          <ul class="text-body text-[15px] space-y-2 list-disc pl-5 mt-4.5">
            <li>Complete setup or audit with category &amp; keyword targeting</li>
            <li>Ongoing profile optimization &amp; listing updates</li>
            <li>Review generation + reply support</li>
            <li>EXIF-optimized photos (proper sizing, filenames &amp; alt text)</li>
            <li>Monthly performance snapshot</li>
          </ul>

          <!-- Upgrade panel (nested, same-family) -->
          <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mt-4 md:min-h-48 lg:min-h-[220px]">
            <div class="font-semibold text-[#f56b2a] mb-1">
              Upgrade: <span class="font-bold">Growth — $399/mo</span>
            </div>
            <ul class="text-body text-[15px] space-y-2 list-disc pl-5">
              <li>Everything in Starter, plus done-for-you review replies</li>
              <li>Geo-grid heatmap tracking &amp; competitor insights</li>
              <li>Citation build/cleanup on <span class="font-semibold">200+ directories</span> (core + industry)</li>
              <li>Call tracking number &amp; conversion dashboard</li>

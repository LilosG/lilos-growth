      let selectedPlan = 999;

      function selectPlan(btn: HTMLButtonElement) {
        document.querySelectorAll(".roi-plan-btn").forEach(function (b) {
          b.className =
            "roi-plan-btn rounded-xl border py-3 text-xs font-bold transition border-border-base bg-white text-muted hover:border-primary hover:text-primary";
        });
        btn.className =
          "roi-plan-btn rounded-xl border py-3 text-xs font-bold transition border-primary bg-primary text-white shadow";
        selectedPlan = parseInt(btn.dataset.val ?? "999", 10);
        calcROI();
      }

      function calcROI() {
        const job =
          parseFloat(
            (document.getElementById("avg-job") as HTMLInputElement | null)?.value ?? ""
          ) || 500;
        const close =
          parseFloat(
            (document.getElementById("close-rate") as HTMLInputElement | null)?.value ?? ""
          ) || 40;
        const leads =
          parseFloat(
            (document.getElementById("monthly-leads") as HTMLInputElement | null)?.value ?? ""
          ) || 15;
        const cost = selectedPlan;
        const jobs = Math.round(leads * (close / 100));
        const revenue = jobs * job;
        const net = revenue - cost;
        const roi = cost > 0 ? Math.round((net / cost) * 100) : 0;
        const year1 = revenue * 12;
        const payback = revenue > 0 ? Math.ceil((cost / revenue) * 10) / 10 : 0;
        const paybackStr = payback <= 1 ? "< 1 mo" : payback.toFixed(1) + " mo";

        document.getElementById("roi-pct")!.textContent = roi + "%";
        document.getElementById("roi-leads")!.textContent = jobs.toString();
        document.getElementById("roi-revenue")!.textContent = "$" + revenue.toLocaleString();
        document.getElementById("roi-net")!.textContent =
          (net >= 0 ? "$" : "-$") + Math.abs(net).toLocaleString();
        document.getElementById("roi-payback")!.textContent = paybackStr;
        document.getElementById("roi-year1")!.textContent = "$" + year1.toLocaleString();
        document.getElementById("roi-investment")!.textContent =
          "Investment: $" + cost.toLocaleString() + "/mo · No contracts · Cancel anytime";
      }

      (
        window as Window &
          typeof globalThis & { selectPlan: typeof selectPlan; calcROI: typeof calcROI }
      ).selectPlan = selectPlan;
      (
        window as Window &
          typeof globalThis & { selectPlan: typeof selectPlan; calcROI: typeof calcROI }
      ).calcROI = calcROI;
      document.addEventListener("DOMContentLoaded", calcROI);
    })();
  </script>


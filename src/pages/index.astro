---
import Layout from "~/layouts/PageLayout.astro";
import { clientStats, caseStudies, packages } from "~/data/packages";

export const metadata = {
  title: "Local SEO, GBP Management & Website Design | Lilos Growth",
  description:
    "Lilos Growth helps local businesses rank higher, get more calls, and grow through local SEO, Google Business Profile management, and websites built to rank. North County San Diego and beyond. Month-to-month, no contracts.",
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-white pb-24 pt-20">
    <div
      class="pointer-events-none absolute inset-0"
      style="background:radial-gradient(ellipse 80% 60% at 50% -10%,rgba(245,107,42,0.07) 0%,transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-6 text-center">
      <div
        class="border-primary/25 bg-primary/8 mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-1.5"
      >
        <span class="h-2 w-2 rounded-full bg-primary"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-primary"
          >Local SEO · GBP Management · Website Design</span
        >
      </div>
      <h1
        class="mx-auto mb-6 max-w-4xl font-heading text-6xl font-extrabold leading-[1.06] tracking-tight text-heading md:text-7xl"
      >
        Rank Higher.<br />Get More Calls.<br /><span class="text-primary">Grow Your Business.</span>
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-xl leading-relaxed text-body">
        We build the local search presence that turns Google into your best salesperson. Written
        strategy first, full execution every month, real reporting on real metrics. No contracts. No
        fluff.
      </p>
      <div class="mb-10 flex flex-wrap justify-center gap-4">
        <a
          href="/contact#book"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-10 py-4 font-heading text-lg font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.4)] transition hover:bg-primary-dark"
        >
          Get Your Free GBP Audit →
        </a>
        <a
          href="/packages"
          class="border-heading/20 inline-flex items-center gap-2 rounded-full border-2 px-10 py-4 font-heading text-lg font-bold text-heading transition hover:border-primary hover:text-primary"
        >
          See Packages
        </a>
      </div>
      <div class="flex flex-wrap justify-center gap-8 text-sm font-medium text-muted">
        <span class="flex items-center gap-2"
          ><svg
            class="h-4 w-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"
            ></path></svg
          >No contracts — cancel anytime</span
        >
        <span class="flex items-center gap-2"
          ><svg
            class="h-4 w-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"
            ></path></svg
          >Written strategy before we start</span
        >
        <span class="flex items-center gap-2"
          ><svg
            class="h-4 w-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"
            ></path></svg
          >Free audit delivered in 48 hours</span
        >
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <section class="border-y border-border-subtle bg-background-subtle py-6">
    <div class="mx-auto max-w-5xl px-6">
      <p class="mb-5 text-center text-xs font-bold uppercase tracking-widest text-muted">
        Trusted by local businesses across San Diego and beyond
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {
          [
            { name: "Wheyland Electric", type: "Electrical" },
            { name: "Tamarack Restoration", type: "Restoration" },
            { name: "Kelari Party Rentals", type: "Events" },
            { name: "Carlsbad Fix It", type: "Home Services" },
            { name: "Grind & Prosper", type: "Restaurant Group" },
            { name: "Frontera Wheels", type: "Auto" },
          ].map((c) => (
            <div class="flex flex-col items-center gap-0.5">
              <span class="font-heading text-sm font-bold text-heading opacity-60">{c.name}</span>
              <span class="text-[10px] font-semibold uppercase tracking-widest text-muted opacity-50">
                {c.type}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          clientStats.map((s) => (
            <div class="rounded-2xl border border-border-subtle bg-background-subtle p-8 text-center shadow-sm">
              <div class="font-heading text-5xl font-extrabold text-primary">{s.stat}</div>
              <div class="mt-2 font-heading text-base font-bold text-heading">{s.label}</div>
              <div class="mt-1 text-sm text-muted">{s.sub}</div>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-center text-xs text-muted">
        All stats sourced from Semrush. Verified client data.
      </p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="border-y border-border-subtle bg-background-subtle py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">How it works</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">
          How We Get You to #1
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-muted">
          Our proven process transforms your local search presence — no black box, no guesswork.
        </p>
      </div>
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
        <div class="space-y-8">
          {
            [
              {
                n: "1",
                title: "Free GBP Audit",
                body: "We score your Google Business Profile against 40 ranking signals and benchmark your top 3 competitors. Written PDF delivered in 48 hours. No pitch — just findings.",
              },
              {
                n: "2",
                title: "Written Strategy First",
                body: "Before any work starts you get a detailed strategy document — keyword gaps, site architecture, GBP roadmap, citation issues, 90-day priority list.",
              },
              {
                n: "3",
                title: "Full Execution",
                body: "GBP managed every month, content published, pages built, citations corrected, backlinks earned. We handle everything.",
              },
              {
                n: "4",
                title: "Monthly Reporting",
                body: "Rankings, GBP calls, direction requests, organic traffic, keyword growth — every month. Real metrics, no vanity numbers.",
              },
            ].map((step) => (
              <div class="flex items-start gap-5">
                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-primary font-heading text-lg font-extrabold text-white shadow-[0_4px_16px_rgba(245,107,42,0.35)]">
                  {step.n}
                </div>
                <div>
                  <h3 class="mb-1 font-heading text-lg font-bold text-heading">{step.title}</h3>
                  <p class="text-sm leading-relaxed text-muted">{step.body}</p>
                </div>
              </div>
            ))
          }
        </div>
        <div
          class="relative overflow-hidden rounded-2xl border border-border-subtle bg-white shadow-lg"
        >
          <div class="flex items-center gap-2 bg-[#1a73e8] px-4 py-3">
            <div class="flex gap-1.5">
              <div class="h-3 w-3 rounded-full bg-white/30"></div><div
                class="h-3 w-3 rounded-full bg-white/30"
              >
              </div><div class="h-3 w-3 rounded-full bg-white/30"></div>
            </div>
            <div class="flex-1 rounded bg-white/20 px-3 py-1 text-xs font-medium text-white/80">
              google.com/maps · electrician carlsbad ca
            </div>
          </div>
          <div class="p-5">
            <div class="mb-3 text-xs font-bold uppercase tracking-wider text-muted">
              Google Map Pack — Carlsbad, CA
            </div>
            <div class="mb-4 space-y-2">
              {
                [
                  {
                    rank: "#1",
                    name: "Wheyland Electric",
                    stars: "4.9",
                    reviews: "47",
                    tag: "OUR CLIENT",
                    highlight: true,
                  },
                  {
                    rank: "#2",
                    name: "SD Electric Pro",
                    stars: "4.6",
                    reviews: "23",
                    tag: "",
                    highlight: false,
                  },
                  {
                    rank: "#3",
                    name: "Pacific Electrical",
                    stars: "4.4",
                    reviews: "18",
                    tag: "",
                    highlight: false,
                  },
                ].map((r) => (
                  <div
                    class={`flex items-center justify-between rounded-xl px-4 py-3 ${r.highlight ? "bg-primary/8 border-primary/25 border" : "border border-border-subtle bg-background-subtle"}`}
                  >
                    <div class="flex items-center gap-3">
                      <span
                        class={`font-heading text-sm font-extrabold ${r.highlight ? "text-primary" : "text-muted"}`}
                      >
                        {r.rank}
                      </span>
                      <div>
                        <div
                          class={`font-heading text-sm font-bold ${r.highlight ? "text-heading" : "text-body"}`}
                        >
                          {r.name}
                        </div>
                        <div class="flex items-center gap-1 text-xs text-muted">
                          <svg class="h-3 w-3 text-warning" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                          {r.stars} · {r.reviews} reviews
                        </div>
                      </div>
                    </div>
                    {r.tag && (
                      <span class="rounded-full bg-primary px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
                        {r.tag}
                      </span>
                    )}
                  </div>
                ))
              }
            </div>
            <div class="border-t border-border-subtle pt-4">
              <div class="grid grid-cols-3 gap-3 text-center">
                <div class="rounded-lg bg-background-subtle p-2">
                  <div class="font-heading text-lg font-extrabold text-primary">22</div>
                  <div class="text-[10px] text-muted">Top 3 Keywords</div>
                </div>
                <div class="rounded-lg bg-background-subtle p-2">
                  <div class="font-heading text-lg font-extrabold text-primary">613%</div>
                  <div class="text-[10px] text-muted">Keyword Growth</div>
                </div>
                <div class="rounded-lg bg-background-subtle p-2">
                  <div class="font-heading text-lg font-extrabold text-primary">90d</div>
                  <div class="text-[10px] text-muted">Timeframe</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPLETE LOCAL SEO SOLUTION -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <div
          class="border-primary/20 bg-primary/5 mb-4 inline-flex items-center gap-2 rounded-full border px-4 py-1.5"
        >
          <svg
            class="h-4 w-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
          >
          <span class="text-xs font-bold uppercase tracking-widest text-primary"
            >Everything Included</span
          >
        </div>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">
          Complete Local SEO Solution
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-muted">
          Every service your local search presence needs — GBP, SEO, content, citations, backlinks,
          reputation, and AI visibility. All under one strategy.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          [
            {
              bg: "bg-orange-50",
              icon_color: "text-primary",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>`,
              title: "Google Business Profile",
              body: "Full setup, optimization, and monthly management. Posts, photos, review responses, Q&A, and performance reporting — done for you every month.",
              href: "/packages#gbp",
            },
            {
              bg: "bg-blue-50",
              icon_color: "text-blue-600",
              icon: `<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>`,
              title: "Local SEO & Content",
              body: "5–15 local content assets per month — service pages, city pages, FAQs, listicles. On-page fixes, technical SEO, schema, and citations continuously built.",
              href: "/packages#seo",
            },
            {
              bg: "bg-purple-50",
              icon_color: "text-purple-600",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>`,
              title: "Local Citation Building",
              body: "Consistent NAP across 100+ directories. Ongoing citation builds and cleanup so every listing sends the right signals to Google.",
              href: "/packages#seo",
            },
            {
              bg: "bg-teal-50",
              icon_color: "text-teal-600",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>`,
              title: "Reputation Management",
              body: "Every review responded to. Proactive review request guidance and templates. Monitoring across Google, Yelp, and industry directories.",
              href: "/packages#gbp",
            },
            {
              bg: "bg-pink-50",
              icon_color: "text-pink-600",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l6 0"/>`,
              title: "Local Link Building",
              body: "2–6 local backlinks per month depending on plan — associations, sponsorships, local press, partner pages. Real links that move rankings.",
              href: "/packages#seo",
            },
            {
              bg: "bg-indigo-50",
              icon_color: "text-indigo-600",
              icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>`,
              title: "AI Search Visibility",
              body: "Google AI Overviews, ChatGPT Search, and Perplexity now surface local businesses. We track your AI visibility and build the schema and content that gets you cited.",
              href: "/packages#seo",
            },
          ].map((s) => (
            <article class="hover:border-primary/30 flex flex-col rounded-2xl border border-border-subtle bg-white p-7 shadow-sm transition hover:shadow-md">
              <div class={`mb-4 flex h-11 w-11 items-center justify-center rounded-xl ${s.bg}`}>
                <svg
                  class={`h-5 w-5 ${s.icon_color}`}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  viewBox="0 0 24 24"
                  set:html={s.icon}
                />
              </div>
              <h3 class="mb-2 font-heading text-base font-bold text-heading">{s.title}</h3>
              <p class="flex-1 text-sm leading-relaxed text-muted">{s.body}</p>
            </article>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <a
          href="/packages"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-3.5 font-heading text-base font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.35)] transition hover:bg-primary-dark"
        >
          See All Services & Pricing →
        </a>
      </div>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="border-y border-border-subtle bg-background-subtle py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <div
          class="border-primary/20 bg-primary/5 mb-4 inline-flex items-center gap-2 rounded-full border px-4 py-1.5"
        >
          <svg
            class="h-4 w-4 text-primary"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
            ></path></svg
          >
          <span class="text-xs font-bold uppercase tracking-widest text-primary"
            >Proven Results</span
          >
        </div>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">
          Real Rankings. Real Results. Real Revenue.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-muted">
          Every stat sourced directly from Semrush — no projections, no estimates.
        </p>
      </div>
      <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          caseStudies.map((cs) => (
            <article class="overflow-hidden rounded-2xl border border-border-subtle bg-white shadow-md transition duration-200 hover:-translate-y-0.5 hover:shadow-xl">
              <div class="relative overflow-hidden bg-secondary" style="height:180px;">
                <img
                  src={cs.screenshot}
                  alt={`${cs.client} website screenshot`}
                  class="absolute inset-0 h-full w-full object-cover object-top opacity-75"
                  loading="lazy"
                />
                <div
                  class="absolute inset-0"
                  style="background:linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0.05) 100%);"
                />
                <div class="absolute inset-0 flex flex-col justify-between p-5">
                  <div class="flex items-start justify-end">
                    <span class="flex-shrink-0 rounded-full bg-primary px-2.5 py-1 text-xs font-extrabold text-white shadow">
                      #1
                    </span>
                  </div>
                  <div>
                    <div class="mb-0.5 text-[10px] font-bold uppercase tracking-widest text-white/60">
                      {cs.type}
                    </div>
                    <h3 class="font-heading text-base font-extrabold leading-tight text-white">
                      {cs.client}
                    </h3>
                  </div>
                </div>
              </div>
              <div class="px-5 py-5">
                <div class="mb-4 grid grid-cols-3 gap-3">
                  {cs.stats.map((st) => (
                    <div class="text-center">
                      <div class="font-heading text-xl font-extrabold text-primary">{st.value}</div>
                      <div class="text-[10px] font-semibold leading-tight text-heading">
                        {st.label}
                      </div>
                      <div class="text-[10px] text-muted">{st.sub}</div>
                    </div>
                  ))}
                </div>
                <div class="flex items-center justify-between border-t border-border-subtle pt-4">
                  <span class="text-xs text-muted">Timeframe: {cs.timeframe}</span>
                  <a
                    href={cs.href}
                    class="text-xs font-bold text-primary transition hover:text-primary-dark"
                  >
                    View case study →
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="text-center">
        <a
          href="/contact#book"
          class="inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 font-heading text-base font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.35)] transition hover:bg-primary-dark"
        >
          Get Your Free GBP Audit →
        </a>
      </div>
    </div>
  </section>

  <!-- GBP OPTIMIZATION SPOTLIGHT -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">
            Google Business Profile
          </p>
          <h2 class="mb-5 font-heading text-4xl font-extrabold text-heading">
            Your #1 local ranking factor — actively managed every month.
          </h2>
          <p class="mb-6 text-base leading-relaxed text-body">
            90% of customers choose businesses from the Google Map Pack. Most profiles are
            half-built and underoptimized. We fix that and keep it working — posts, photos, review
            responses, Q&A, and monthly performance reporting.
          </p>
          <div class="mb-8 grid grid-cols-2 gap-4">
            {
              [
                { val: "12", label: "Posts per month" },
                { val: "3×", label: "More customer actions" },
                { val: "100%", label: "Reviews responded to" },
                { val: "48hr", label: "Audit delivery" },
              ].map((m) => (
                <div class="rounded-xl border border-border-subtle bg-background-subtle p-4 text-center">
                  <div class="font-heading text-2xl font-extrabold text-primary">{m.val}</div>
                  <div class="mt-0.5 text-xs text-muted">{m.label}</div>
                </div>
              ))
            }
          </div>
          <a
            href="/packages#gbp"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 font-heading text-base font-bold text-white shadow transition hover:bg-primary-dark"
          >
            See GBP Plans →
          </a>
        </div>
        <div class="rounded-2xl border border-border-subtle bg-white p-6 shadow-lg">
          <div class="mb-4 flex items-center justify-between">
            <span class="text-sm font-bold text-heading">Google Business Profile</span>
            <span class="rounded-full bg-primary px-3 py-1 text-xs font-bold text-white"
              >OPTIMIZED</span
            >
          </div>
          <div
            class="mb-5 flex items-start gap-4 rounded-xl border border-border-subtle bg-background-subtle p-4"

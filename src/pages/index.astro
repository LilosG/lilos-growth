    ],
  },
  {
    icon: "tabler:device-desktop",
    title: "Website Build & Optimization",
    description: "Modern, fast, mobile-ready pages that load quickly and turn visitors into leads.",
    features: [
      "Speed, security & technical SEO",
      "Conversion-ready layouts & CRO tweaks",
      "Tracked forms & analytics setup",
    ],
  },
  {
    icon: "tabler:star",
    title: "Review Management",
    description: "Drive more 5-star reviews and showcase social proof everywhere customers look.",
    features: [
      "Automated review requests & responses",
      "GBP, Google & niche platform coverage",
      "On-site review widgets & trust signals",
    ],
  },
];

// Process steps data
const processSteps = [
  {
    number: 1,
    title: "Keyword & Market Research",
    description:
      "We analyze your market, competitors, and customer search patterns to build a data-driven plan.",
  },
  {
    number: 2,
    title: "Profile & Website Optimization",
    description:
      "We fully optimize your GBP and website so they work together to dominate local search results.",
  },
  {
    number: 3,
    title: "Content & Authority Building",
    description:
      "We publish service/location pages and blog content, then earn high-quality links that grow authority.",
  },
  {
    number: 4,
    title: "Ongoing Management & Results",
    description:
      "We track performance, report wins, and keep optimizing—new content, smart updates, strategy tweaks.",
  },
];

// Why choose us features
const whyChooseUs = [
  {
    title: "Specialized in Home Services",
    description: "We exclusively serve trades and home service pros—no generic strategies here.",
  },
  {
    title: "No Big Agency Fluff",
    description: "Direct communication with local SEO experts. No layers of account managers.",
  },
  {
    title: "Proven Local Results",
    description: "Map Pack rankings, reviews, and calls—delivered across multiple service markets.",
  },
  {
    title: "Easy, Honest Pricing",
    description: "Clear, simple pricing and packages designed for service companies.",
  },
  {
    title: "Strategy & Execution",
    description: "We build the roadmap and implement it—no cookie-cutter templates here.",
  },
  {
    title: "Built by Service Owners",
    description: "We've run service businesses ourselves, so we know what actually works.",
  },
];

// Stats data
const stats = [
  { label: "Avg. GBP calls in 90 days", value: "+42%" },
  { label: "Avg. CPC after 60 days", value: "-28%" },
  { label: "Lead-to-close (quarterly)", value: "+19%" },
];

// Industries served
const industries = [
  "Plumbers",
  "HVAC",
  "Electricians",
  "Roofers",
  "Cleaning",
  "Pest Control",
  "Landscaping",
  "Other Trades",
];

// Pricing data
const mainPricingPlans = [
  {
    title: "GBP",
    subtitle: "Consistent Google Business Profile presence",
    price: "299",
    ctaText: "Get Started",
    ctaHref: "/packages",
    features: [
      "<strong>Profile optimization & upkeep</strong> (N/A fields, services, products, hours)",
      "<strong>Categories tuned</strong> for intent & relevance",
      "<strong>Weekly posts</strong> (offers, FAQs, highlights) — no rollovers",
      "<strong>Fresh photos</strong> with EXIF/alt optimized for geo & keywords",
      "<strong>Review replies</strong> + simple request prompts",
      "<strong>Monthly performance report</strong> with next steps",
    ],
  },
  {
    title: "GBP + Local SEO",
    subtitle: "Steady Map Pack & organic gains",
    price: "699",
    ctaText: "Choose Plan",
    ctaHref: "/packages",
    featured: true,
    features: [
      "<strong>Everything in GBP</strong>, plus:",
      "<strong>On-site fixes</strong> (titles, metas, H1-H2, internal links, basic schema)",
      "<strong>3–5 optimized pages</strong> per month (service or location)",
      "<strong>Citation creation/cleanup</strong> & core listings",
      "<strong>Local rank tracking</strong> + quarterly competitor snapshot",
      "<strong>Monthly report</strong> + 30-min strategy call",
    ],
    footerNote: "Workload scales with site size & baseline quality; no rollovers.",
  },
  {
    title: "GBP + Local SEO Growth",
    subtitle: "Faster traction via volume",
    price: "1,199",
    ctaText: "Schedule a Call",
    ctaHref: "/contact",
    features: [
      "<strong>Everything in GBP + Local SEO</strong>, plus:",
      "<strong>2+ services optimized</strong> per month (pages & posts)",
      "<strong>2–4 local backlinks</strong> per month (associations, partners, mentions)",
      "<strong>Ongoing citations</strong> at scale & crawl priority",
      "<strong>Expanded content volume</strong> (pages/blogs as needed)",
      "<strong>Monthly report</strong> + 45-min strategy call",
    ],
    footerNote:
      "Content/link budgets are capped to maintain quality; unused work does not roll over.",
  },
];

const addOnPlans = [
  {
    title: "Website-as-a-Service",
    subtitle: "Modern, conversion-ready site + support",
    price: "199",
    ctaText: "See WaaS Details",
    ctaHref: "/services/web-design",
    features: [
      "<strong>Mobile-first site</strong> with SEO baked in",
      "<strong>Secure hosting & monitoring</strong>",
      "<strong>Unlimited minor edits</strong> via support tickets",
      "<strong>Analytics & lead tracking</strong> set up",
      "<strong>Month-to-month support</strong> — no long contracts",
    ],
  },
  {
    title: "Local SEO — Essentials",
    subtitle: "Single-location growth plan",
    price: "599",
    ctaText: "Start Local SEO",
    ctaHref: "/packages",
    features: [
      "<strong>Site & on-page optimization</strong> (titles, metas, H1-H2, CWV, schema)",
      "<strong>Keyword research & tracking</strong> with quarterly priorities",
      "<strong>Service/location content</strong> & internal-linking scaffold",
      "<strong>Citation cleanup</strong> & foundational listings",
      "<strong>Monthly report</strong> + action checklist",
    ],
  },
  {
    title: "Local SEO — Growth",
    subtitle: "Higher-volume monthly execution",
    price: "999",
    ctaText: "Choose Growth",
    ctaHref: "/packages",
    features: [
      "<strong>Everything in Essentials</strong>, plus:",
      "<strong>More pages & optimizations</strong> each month",
      "<strong>Expanded citations & link acquisition</strong>",
      "<strong>Quarterly competitor review</strong> & heatmap snapshot",
      "<strong>Monthly report</strong> + strategy call",
    ],
  },
];

// FAQ data
const faqs = [
  {
    question: "How quickly will I see results from local SEO?",
    answer:
      "Most home service companies start seeing more calls, leads, and improved rankings within 30–60 days—sometimes faster. Your results can depend on your market and competition, but we focus on quick wins from day one.",
  },
  {
    question: "Are there any setup fees?",
    answer:
      "Some services—like website development or complete SEO overhauls—may require a one-time setup fee. We'll always be transparent about costs before starting, so you know exactly what to expect. Most of our ongoing marketing services are billed month-to-month with no long-term contracts.",
  },
  {
    question: "Do I need to understand SEO or websites to get results?",
    answer:
      "Not at all! You run your business, we handle all the marketing and website details. We keep things simple and communicate in plain English—no tech jargon.",
  },
  {
    question: "Can you help if I already have a website or GBP listing?",
    answer:
      "Absolutely. We can improve your existing website and Google Business Profile, or help with a full redesign and re-optimization if you want a fresh start.",
  },
  {
    question: "Will I have a dedicated point of contact?",
    answer:
      "Yes! You'll always work directly with a home service marketing strategist—no call centers, account manager runarounds, or agency handoffs.",
  },
  {
    question: "Can you work with my existing website?",
    answer:
      "In most cases, yes! We specialize in WordPress, Webflow, and Duda, but can work with most major platforms. If your current site is built with Wix, Squarespace, Weebly, or a similar basic builder, we'll recommend what's best for long-term SEO—whether that means optimizing your existing site or building you a new one that gets better results.",
  },
];
---

<Layout title={title} description={description} metadata={metadata}>
  <!-- HERO SECTION -->
  <section class="relative flex min-h-[680px] items-center overflow-hidden bg-secondary">
    <!-- Gradient background -->
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-12 px-4 py-16 md:flex-row md:items-center md:gap-16"
    >
      <!-- Left Column: Logo, Headline, CTA -->
      <div class="flex-1 space-y-6">
        <img
          src="/Lilos_Growth_Logo_Corrected.svg"
          alt="Lilos Growth Logo"
          class="logo--halo w-40"
          fetchpriority="high"
        />

        <div class="space-y-4">
          <h1 class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl">
            Local SEO + GBP Management
          </h1>

          <p
            class="font-heading text-lg font-semibold uppercase tracking-wider text-primary md:text-2xl"
          >
            Premium Websites Included
          </p>

          <div class="h-1.5 w-28 rounded-full bg-primary"></div>
        </div>

        <div class="space-y-4">
          <p class="max-w-lg text-base font-medium text-white/90 md:text-lg">
            Lilos Growth helps home service businesses win more calls with GBP optimization, local
            SEO, and websites built to convert.
          </p>
          <GuaranteeBadge variant="badge" class="border-primary-light bg-white/10 text-white" />
        </div>

        <div class="flex flex-wrap gap-3">
          <Button
            variant="primary"
            size="lg"
            href="/contact#book"
            data-evt="cta_hero_book_call"
          >
            Book a Call
          </Button>

          <Button
            variant="outline"
            size="lg"
            href="#pricing"
            class="hidden md:inline-flex"
            data-evt="cta_hero_view_pricing"
          >
            View Pricing
          </Button>
        </div>
      </div>

      <!-- Right Column: Lead Form -->
      <div class="mx-auto max-w-md flex-1 md:mx-0">
        <LeadCaptureForm
          title="Free SEO Website Audit for Home Service Pros!"
          submitText="Get My Free Audit"
          formspreeId="movlbqdk"
          class="shadow-2xl"
        />
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <Section
    id="who-we-help"
    padding="sm"
    class="border-t border-border-subtle bg-surface-base"
    containerClass="max-w-5xl text-center"
  >
      <h2 class="mb-6 font-heading text-xl font-bold md:text-2xl">Who We Help</h2>

      <h3 class="mb-4 text-base font-semibold text-heading">
        Home Service Businesses We Work With:
      </h3>

      <div class="flex flex-wrap justify-center gap-3">
        {
          industries.map((industry) => (
            <Badge variant="info" class="px-5 py-2 text-sm">
              {industry}
            </Badge>
          ))
        }
      </div>
  </Section>

  <!-- TRUST BAR -->
  <Section padding="sm" class="border-t border-border-subtle bg-white" containerClass="max-w-6xl">
    <TrustBand heading="Trusted by home service teams nationwide" logos={trustLogos} />
  </Section>

  <!-- FULLY MANAGED LOCAL SEO SECTION -->
  <Section
    id="included-services"
    class="border-t border-border-subtle bg-background-cream"
    containerClass="max-w-6xl"
  >
      <div class="mb-12 text-center">
        <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
          Fully Managed Local SEO for Home Service Businesses
        </h2>
        <p class="mx-auto max-w-3xl text-base text-body">
          Complete, end-to-end SEO management that puts your business at the top of local search
          results. We handle everything so you can focus on what you do best.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <div data-stagger-item>
              <ServiceCard {...service} />
            </div>
          ))
        }
      </div>
  </Section>

  <!-- WHY CHOOSE US -->
  <Section class="border-t border-border-subtle bg-surface-base" containerClass="max-w-6xl">
      <h2 class="mb-12 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        Why Choose Lilos Growth for Your Home Service Business?
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          whyChooseUs.map((feature, index) => (
            <article
              class={`card ${index % 2 === 0 ? "bg-surface-base" : "bg-background-cream"}`}
              data-stagger-item
            >
              <h3 class="mb-2 font-heading text-lg font-semibold text-heading">{feature.title}</h3>
              <p class="text-sm leading-relaxed text-body">{feature.description}</p>
            </article>
          ))
        }
      </div>
  </Section>

  <!-- OUR PROCESS -->
  <Section class="border-t border-border-subtle bg-background-cream" containerClass="max-w-6xl">
      <div class="mb-12 text-center">
        <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
          Our Proven 4-Step Local SEO System
        </h2>
        <p class="mx-auto max-w-3xl text-base text-body">
          Here's exactly how we get your business ranking higher and bringing in more local calls—no
          guesswork, just results.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step) => (
            <div data-stagger-item>
              <ProcessStep {...step} />
            </div>
          ))
        }
      </div>
  </Section>

  <!-- STATS SECTION -->
  <Section
    aria-label="Key results"
    class="border-t border-border-subtle bg-surface-base"
    containerClass="max-w-6xl"
  >
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <div data-stagger-item>
              <StatCard label={stat.label} value={stat.value} />
            </div>
          ))
        }
      </div>
  </Section>

  <!-- TESTIMONIALS -->
  <Section class="border-t border-border-subtle bg-background-cream" containerClass="max-w-6xl">
    <div class="mb-10 text-center">
      <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">
        Results that turn into booked jobs
      </h2>
      <p class="mt-3 text-base text-body">
        Premium websites, GBP management, and local SEO working together—without the agency fluff.
      </p>
    </div>
    <TestimonialBand items={homeTestimonials} />
  </Section>

  <!-- MAIN PRICING SECTION -->
  <Section id="pricing" class="bg-white" containerClass="max-w-7xl">
      <div class="mb-12 text-center">
        <h2 class="mb-3 font-heading text-2xl font-bold text-heading md:text-3xl">
          Local SEO Plans & Pricing
        </h2>
        <p class="text-base text-body">
          Month-to-month. No setup fees. Transparent deliverables. <strong>No rollovers.</strong>
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          mainPricingPlans.map((plan) => (
            <div data-stagger-item class="h-full">
              <PricingCard {...plan} />
            </div>
          ))
        }
      </div>
  </Section>

  <!-- ADD-ON PRICING SECTION -->
  <Section class="bg-surface-base" containerClass="max-w-7xl">
      <div class="mb-12 text-center">
        <h2 class="mb-3 font-heading text-2xl font-bold text-heading md:text-3xl">
          Add-On & One-Time Options
        </h2>
        <p class="text-base text-body">Bundle with any plan or purchase separately.</p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {
          addOnPlans.map((plan) => (
            <div data-stagger-item class="h-full">
              <PricingCard {...plan} />
            </div>
          ))
        }
      </div>
  </Section>

  <!-- FAQ SECTION -->
  <Section id="faq" class="bg-surface-base" containerClass="max-w-4xl">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Frequently Asked Questions About Home Service Marketing
      </h2>

      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <details class="group card" data-stagger-item>
              <summary class="flex cursor-pointer items-center justify-between font-semibold text-heading">
                {faq.question}
                <span class="ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-background-subtle text-muted transition-colors group-open:bg-primary group-open:text-white">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </span>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-body">{faq.answer}</p>
            </details>
          ))
        }
      </div>
  </Section>

  <!-- FINAL CTA -->
  <Section
    class="border-t border-border-subtle bg-background-cream"
    containerClass="max-w-3xl text-center"
  >
      <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
        Ready to Grow Your Home Service Business?
      </h2>
      <p class="mb-8 text-base text-body">
        Get a free SEO audit and see how we can help you dominate local search.
      </p>
      <Button variant="primary" size="lg" href="/contact#book" data-evt="cta_footer_get_started">
        Get Your Free Audit
      </Button>
  </Section>
</Layout>

<style>
  /* Smooth accordion animation */
  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary svg {
    transform: rotate(180deg);
  }

  details summary svg {
    transition: transform 0.2s ease;
  }
</style>

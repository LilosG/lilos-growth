---
import Layout from '~/layouts/PageLayout.astro';

export const title = "About Lilos Growth | Built by Home Service Owners";
export const description = "Lilos Growth is a marketing agency founded by home service business owners. We know the industry firsthand and deliver proven SEO, websites, and GBP management that drive real growth.";
---

<html lang="en">
  <head>
    <title>About Us | Lilos Growth</title>
    <meta
      name="description"
      content="Lilos Growth is a digital marketing agency founded by home service business owners, built for real results—no fluff, just honest, effective marketing for local pros."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- HERO/INTRO SECTION -->
    <section class="bg-[#253242] min-h-[380px] flex items-center pt-14 pb-16 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 max-w-4xl mx-auto w-full px-4 text-center flex flex-col items-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-4 leading-tight tracking-tight">
          About Lilos Growth
        </h1>
        <div class="h-1 w-16 bg-[#f56b2a] rounded-full mx-auto mb-4"></div>
        <p class="text-xl text-white/90 font-medium max-w-2xl mx-auto">
          We built the agency <span class="text-[#f56b2a] font-bold">we always wanted to hire</span> as home service business
          owners.
        </p>
      </div>
    </section>

    <!-- OUR STORY/WHY SECTION -->
    <section class="py-16 bg-white border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-6 text-heading">From the Client Side to Your Side</h2>
        <p class="text-lg text-body mb-6">
          Lilos Growth was founded by a team who's been in your shoes. Before digital marketing, we owned and ran
          successful home service businesses in pest control and general contracting.
        </p>
        <p class="text-lg text-body mb-6">
          Like many local business owners, we spent thousands on marketing agencies who overpromised and underdelivered.
          We were tired of fluffy reports, confusing jargon, and paying for "busy work" instead of booked jobs. So we
          built Lilos Growth to do things differently.
        </p>
        <p class="text-lg text-body mb-4">
          Our agency is designed for <span class="font-semibold text-heading">real results</span> — not vanity metrics. We
          focus on what actually moves the needle: more calls, more jobs, and measurable growth.
        </p>
        <div class="flex justify-center mt-8">
          <span class="inline-block px-7 py-3 bg-[#f56b2a] text-white rounded-xl font-heading font-semibold shadow">
            No Fluff. No Contracts. Just Results.
          </span>
        </div>
      </div>
    </section>

    <!-- VALUES / DIFFERENCE SECTION -->
    <section class="py-16 bg-cream border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-8 text-heading text-center">
          Why Home Service Pros Choose Lilos Growth
        </h2>
        <div class="grid md:grid-cols-2 gap-10">
          <div class="bg-white rounded-2xl shadow p-8">
            <h3 class="font-heading text-xl font-bold mb-2 text-[#f56b2a]">We've Been on Your Side</h3>
            <p>
              We know the difference between what sounds good on paper and what actually gets the phone ringing. Every
              strategy is built from first-hand experience.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-8">
            <h3 class="font-heading text-xl font-bold mb-2 text-[#f56b2a]">Straightforward & Human</h3>
            <p>
              No agency jargon, no "black box" tactics. You get honest answers, transparent pricing, and clear reporting
              — always.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-8">
            <h3 class="font-heading text-xl font-bold mb-2 text-[#f56b2a]">100% Service, 0% BS</h3>
            <p>
              We only recommend what we'd do for our own business. No lock-in contracts, no wasted budget, no agency
              runaround. If it doesn't help you grow, we don't do it.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-8">
            <h3 class="font-heading text-xl font-bold mb-2 text-[#f56b2a]">Built for Local Service Companies</h3>
            <p>
              We specialize in marketing for home service pros — plumbers, HVAC, pest control, cleaning, trades, and
              more. No cookie-cutter plans, ever.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA TO CONTACT / STRATEGY CALL -->
    <section class="py-16 bg-white border-t border-gray-100 text-center">
      <div class="max-w-2xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4 text-heading">Curious if We're the Right Fit?</h2>
        <p class="text-lg text-body mb-8">
          Book a free strategy call or send us a message. We'll review your business and show exactly how we can help
          you grow — no obligations, ever.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
        >
          Book Free Strategy Call
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </section>
  </Layout>


</html>

---
import Layout from "~/layouts/PageLayout.astro";

export const title = "About Lilos Growth | Built by Home Service Owners";
export const description =
  "Lilos Growth is a marketing agency founded by home service business owners. We deliver proven Local SEO, websites, and Google Business Profile management that drive real, measurable growth.";
---

<Layout title={title} description={description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] items-center overflow-hidden bg-secondary pb-20 pt-16"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light">
    </div>
    <div class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center px-4 text-center">
      <img
        src="/Lilos_Growth_Logo_Corrected.svg"
        alt="Lilos Growth Logo"
        class="mx-auto mb-6 w-36 logo--halo"
      />
      <h1
        class="font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        About Lilos Growth
      </h1>
      <span class="mt-3 max-w-2xl text-lg text-white/90 md:text-xl">
        We built the agency <span class="font-bold text-primary">we always wanted to hire</span> as
        home service business owners.
      </span>

      <!-- trust badge -->
      <div class="mt-6 flex items-center gap-2">
        <svg
          class="h-5 w-5 text-[#f6b100]"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path
            d="M10 15l-5.878 3.09L5.854 12 1 7.91l6.066-.49L10 2l2.934 5.42L19 7.91 14.146 12l1.732 6.09z"
          ></path>
        </svg>
        <span class="font-semibold text-white/90">5-Star Rated by Local Businesses</span>
      </div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
        From the Client Side to Your Side
      </h2>an class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>
      <p class="mt-6 text-lg text-body">
        Lilos Growth was founded by a team who’s been in your shoes. Before marketing, we owned and
        ran successful home service businesses in pest control and general contracting.
      </p>
      <p class="mt-4 text-lg text-body">
        Like many local owners, we spent thousands on agencies that overpromised and underdelivered.
        We were tired of fluffy reports, confusing jargon, and paying for “busy work” instead of
        booked jobs. So we built Lilos Growth to do things differently.
      </p>
      <p class="mt-4 text-lg text-body">
        Our agency is designed for <span class="font-semibold text-heading">real results</span>—not
        vanity metrics. We focus on what moves the needle: <span class="font-semibold"
          >more calls, more jobs, more reviews</span
        >, and measurable growth you can see every month.
      </p>

      <div class="mt-8">
        <span
          class="inline-block rounded-xl bg-primary px-6 py-3 font-heading font-semibold text-white shadow"
        >
          No Fluff. No Contracts. Just Results.
        </span>
      </div>
    </div>
  </section>

  <!-- QUICK CREDIBILITY STATS -->
  <section class="border-t border-gray-100 bg-cream py-14">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid grid-cols-2 gap-6 text-center md:grid-cols-4">
        <div class="rounded-2xl border border-primary/10 bg-white p-6 shadow">
          <div class="text-3xl font-extrabold text-heading">10+ yrs</div>
          <div class="mt-1 text-body">in local services & marketing</div>
        </div>
        <div class="rounded-2xl border border-primary/10 bg-white p-6 shadow">
          <div class="text-3xl font-extrabold text-heading">30+</div>
          <div class="mt-1 text-body">trades & niches served</div>
        </div>
        <div class="rounded-2xl border border-primary/10 bg-white p-6 shadow">
          <div class="text-3xl font-extrabold text-heading">100%</div>
          <div class="mt-1 text-body">month-to-month plans</div>
        </div>
        <div class="rounded-2xl border border-primary/10 bg-white p-6 shadow">
          <div class="text-3xl font-extrabold text-heading">48 hrs</div>
          <div class="mt-1 text-body">avg. response time</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-white py-24">
    <div class="mx-auto max-w-6xl px-4"      <h2 class="mb-10 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        Why Home Service Pros Choose Lilos Growth
      </h2>span class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3">
        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M3 12l6 6l12-12"></path>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            We’ve Been in the Field
          </h3>
          <p class="text-center text-body">
            We know what gets phones ringing because we’ve done it for our own companies.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            Straightforward & Human
          </h3>
          <p class="text-center text-body">
            Plain English, transparent pricing, clear reporting—always.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12l5 5L20 7"></path>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            Results You Can See
          </h3>
          <p class="text-center text-body">
            Local rankings, calls, leads, and booked jobs—tracked and reported.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M12 8v4l3 3"></path>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            No Long-Term Contracts
          </h3>
          <p class="text-center text-body">Month-to-month. We earn your business with results.</p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M4 7l8 8l8-8"></path>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            Specialists in Home Services
          </h3>
          <p class="text-center text-body">
            Plumbing, HVAC, pest, cleaning, lawn, electrical, roofing, and more.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-primary/10 bg-bluelight p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
            <svg
              class="h-7 w-7 text-primary"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle cx="9" cy="10" r="1"></circle><circle cx="15" cy="10" r="1"></circle>
              <path d="M8 15s1.5-2 4-2 4 2 4 2"></path>
            </svg>
          </span>
          <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">
            Easy, Honest, & Human
          </h3>
          <p class="text-center text-body">A dedicated strategist. No call centers or handoffs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <section class="border-t border-gray-100 bg-cream py-24">
    <div class="mx-auto max-w-6xl px-4">      <h2 class="mb-8 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        A Simple, Proven Approach
      </h2>pan class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>
      <p class="mb-12 text-center text-lg text-body">
        No black boxes. Here’s how we help local service companies grow.
      </p>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
        {
          [
            [
              "Discovery & Goals",
              "We learn your market, services, and capacity—so growth fits your crew and schedule.",
            ],
            [
              "Fix & Foundation",
              "We repair technical issues and optimize your website + Google Business Profile.",
            ],
            [
              "Content & Authority",
              "We publish service/location pages & blogs and build high-quality local links.",
            ],
            [
              "Measure & Improve",
              "Transparent reporting, review growth, and ongoing optimization each month.",
            ],
          ].map(([label, copy], i) => (
            <div class="flex flex-col items-center rounded-2xl border-2 border-primary/10 bg-white p-8 shadow-xl">
              <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-2xl font-extrabold text-primary">
                {i + 1}
              </div>
              <h3 class="mb-2 text-center font-heading text-lg font-bold text-heading">{label}</h3>
              <p class="text-center text-body">{copy}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MINI TESTIMONIAL -->
  <section class="border-t border-gray-100 bg-white py-12">
    <div class="mx-auto max-w-3xl px-4">
      <div class="mx-auto rounded-2xl bg-cream p-8 text-center shadow">
        <p class="mb-2 text-lg font-medium">
          “After 60 days we went from the bottom of Google Maps to the top 3. The phones ring every
          week now.”
        </p>
        <div class="flex items-center justify-center gap-2 text-sm text-body/70">
          <span>— John T., Plumbing Business Owner</span>
        </div>
      </div>
    </div>
  </section>

  <!-- LIGHT FAQ -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">      <h2 class="mb-6 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Common Questions
      </h2>pan class="mx-auto mt-2 block h-1 w-12 rounded bg-primary"></span>
      </h2>
      <div class="grid gap-6">
        <div class="rounded-2xl border border-gray-100 bg-bluelight p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Do you work with my trade or niche?
          </h3>
          <p class="text-body">
            Almost certainly. We focus on local services—plumbing, HVAC, pest, cleaning, lawn,
            electrical, roofing, restoration, and more. If you book jobs in a service area, we can
            help.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Are there contracts or setup fees?
          </h3>
          <p class="text-body">
            No long-term contracts. Most services are month-to-month with transparent pricing. If a
            one-time setup is needed (e.g., a full site build), we’ll outline it clearly before
            starting.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Will I have a dedicated point of contact?
          </h3>
          <p class="text-body">
            Yes—every client works directly with a home-service strategist. No call centers or
            endless handoffs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="border-t border-gray-100 bg-bluelight py-20">
    <div class="mx-auto max-w-3xl px-4 text-center">      <h2 class="mb-3 font-heading text-2xl font-bold text-heading md:text-3xl">
        Curious if We're the Right Fit?
      </h2>pan class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>
      <p class="mb-8 text-lg text-body">
        Book a free strategy call. We’ll review your market, show opportunities, and map a plan—no
        pressure.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-2xl bg-primary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#c9400a]"
        >
          Book Free Strategy Call
          <svg
            class="ml-2 h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="/#packages"
          class="inline-flex items-center justify-center rounded-2xl bg-secondary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary-hover"
        >
          View Services & Pricing
        </a>
      </div>
    </div>
  </section>
</Layout>

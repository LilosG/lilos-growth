---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>SEO & Digital Marketing Services for Home Service Businesses | Lilos Growth</title>
    <meta
      name="description"
      content="Get more calls and booked jobs with proven Google Business Profile optimization, Local SEO, and web design for home service businesses. Transparent pricing and real results."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- HERO SECTION -->
    <section
      class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-14 pb-16 relative overflow-hidden"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-6 px-4 mx-auto text-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
          Local SEO & Digital Marketing
        </h1>
        <span class="block text-xl md:text-2xl font-semibold mt-2 mb-2 text-[#f56b2a] tracking-wider uppercase">
          Services For Home Service Businesses
        </span>
        <p class="text-lg md:text-xl text-white/80 mb-7 max-w-2xl font-medium">
          Get more calls and booked jobs with services tailored for plumbers, HVAC, cleaning, pest control, landscaping,
          and other local trades. No contracts, no fluff—just results.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="#core-services"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
          >
            Explore Services <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <a
            href="#packages"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
          >
            See Packages <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <!-- WHO WE HELP -->
    <section class="py-12 bg-cream border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5">Who We Help</h2>
        <p class="text-lg text-body mb-6">
          We work with all types of local home service companies. If you book jobs in your city or town, our services
          are for you:
        </p>
        <div class="flex flex-wrap gap-3 justify-center mb-2">
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Plumbers</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">HVAC</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Electricians</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Roofers</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Cleaning</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Pest Control</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Landscaping</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Painters</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Other Trades</span>
        </div>
        <p class="text-sm text-body/70 mt-3">
          Not sure if we can help your niche? <a href="#contact" class="text-primary underline">Ask us today</a>—chances
          are, we’ve worked with your industry!
        </p>
      </div>
    </section>

    <!-- CORE SERVICES -->
    <section id="core-services" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-10 text-center">
          Our Core Services
          <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-10">
          <!-- Service 1 -->
          <div class="bg-bluelight rounded-2xl shadow p-8 flex flex-col">
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a]">Google Business Profile Optimization</h3>
            <p class="mb-4">
              Rank higher in the Google Map Pack and get more calls with full profile optimization, posting, and review
              management built for home service businesses.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Claim, optimize, and manage your GBP listing</li>
              <li>Ongoing reviews & photo updates</li>
              <li>Monthly reporting & progress tracking</li>
            </ul>
            <a href="/services/google-business-profile" class="text-primary underline mt-auto font-semibold"
              >Learn more</a
            >
          </div>
          <!-- Service 2 -->
          <div class="bg-bluelight rounded-2xl shadow p-8 flex flex-col">
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a]">Local SEO & Content</h3>
            <p class="mb-4">
              Own your service area with expert local SEO, weekly blogs, location/service pages, and high-intent
              keywords—plus full technical optimization for Google and AI search.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Weekly content & blog posting</li>
              <li>Service/location pages for your city</li>
              <li>Citation building & cleanup</li>
            </ul>
            <a href="/services/local-seo-content" class="text-primary underline mt-auto font-semibold">Learn more</a>
          </div>
          <!-- Service 3 -->
          <div class="bg-bluelight rounded-2xl shadow p-8 flex flex-col">
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a]">Website Design & Conversion</h3>
            <p class="mb-4">
              Modern, mobile-friendly websites and landing pages that build trust and convert visitors into booked jobs.
              Easy editing and support included.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Lightning-fast, secure hosting</li>
              <li>Conversion-focused landing pages</li>
              <li>Lead capture, reviews, and calls built in</li>
            </ul>
            <a href="/services/web-design" class="text-primary underline mt-auto font-semibold">Learn more</a>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US + TESTIMONIAL -->
    <section class="py-20 bg-cream border-t border-gray-100" id="why">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
          Why Home Service Pros Trust Lilos Growth
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-12">
          <!-- Value 1 -->
          <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M5 12l5 5L20 7"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Built for Home Services</h3>
            <p class="text-body text-center">No one-size-fits-all plans—our expertise is home service marketing.</p>
          </div>
          <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Agency Runaround</h3>
            <p class="text-body text-center">
              You always work with a strategist. No account managers or call center handoffs.
            </p>
          </div>
          <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M3 12l2-2l4 4l8-8l2 2"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Local Results</h3>
            <p class="text-body text-center">
              You’ll see measurable calls, map pack moves, and booked jobs—not vanity metrics.
            </p>
          </div>
          <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="10"></circle><path d="M8 15s1.5-2 4-2 4 2 4 2"></path><circle
                  cx="9"
                  cy="10"
                  r="1"></circle><circle cx="15" cy="10" r="1"></circle></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Easy & Honest</h3>
            <p class="text-body text-center">Clear reporting, honest answers, and results you can see.</p>
          </div>
        </div>
        <!-- Testimonial Row -->
        <div class="bg-white rounded-2xl shadow p-8 text-center max-w-2xl mx-auto">
          <p class="text-lg font-medium mb-2">
            “We went from zero calls to being in the top 3 of the map pack for every service—Lilos Growth is the real
            deal!”
          </p>
          <div class="flex items-center justify-center gap-2 text-sm text-body/70">
            <span>— Emily R., HVAC Company Owner</span>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="py-20 bg-white border-t border-gray-100" id="process">
      <div class="relative z-10 max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
          How It Works
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div class="flex flex-col items-center">
            <div class="w-14 h-14 mb-5 flex items-center justify-center rounded-full bg-[#f56b2a]/10">
              <span class="text-2xl font-bold text-[#f56b2a]">1</span>
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Book a Free Strategy Call</h3>
            <p class="text-body text-center">
              We’ll learn about your market, services, and goals—no jargon, no pressure.
            </p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-14 h-14 mb-5 flex items-center justify-center rounded-full bg-[#f56b2a]/10">
              <span class="text-2xl font-bold text-[#f56b2a]">2</span>
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Custom Local Growth Plan</h3>
            <p class="text-body text-center">
              Get a step-by-step plan for ranking, traffic, and more calls—plus quick wins right away.
            </p>
          </div>
          <div class="flex flex-col items-center">
            <div class="w-14 h-14 mb-5 flex items-center justify-center rounded-full bg-[#f56b2a]/10">
              <span class="text-2xl font-bold text-[#f56b2a]">3</span>
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Watch Results Grow</h3>
            <p class="text-body text-center">
              We handle the heavy lifting. You get clear updates and can focus on your customers.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE PACKAGES SECTION -->
    <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
          Service Packages
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-xl text-body mb-14 text-center font-medium">
          Simple, transparent pricing for home service businesses. No contracts. Real results.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Package 1 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 flex flex-col p-8 items-center">
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-2 font-semibold"
              >Best for: Map Pack Rankings</span
            >
            <h3 class="text-xl font-heading text-heading font-bold mb-2 text-center">
              Google Business Profile Optimization
            </h3>
            <div class="text-4xl font-bold text-primary mb-4">
              $399<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-8 space-y-2 text-left">
              <li>✓ Full GBP setup & optimization</li>
              <li>✓ Monthly listing management</li>
              <li>✓ Review & reputation guidance</li>
              <li>✓ Posts, photos, and updates</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition"
            >
              Get Started
            </a>
          </div>
          <!-- Package 2 -->
          <div class="bg-white rounded-2xl shadow-lg border-2 border-primary flex flex-col p-8 items-center relative">
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-bold px-4 py-1 rounded-2xl shadow"
            >
              Most Popular
            </div>
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-2 font-semibold"
              >Best for: Leads & Growth</span
            >
            <h3 class="text-xl font-heading text-heading font-bold mb-2 text-center">Organic & Local SEO</h3>
            <div class="text-4xl font-bold text-primary mb-4">
              $699<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-8 space-y-2 text-left">
              <li>✓ Local keyword strategy</li>
              <li>✓ On-page SEO & site health</li>
              <li>✓ Google Map ranking</li>
              <li>✓ Content & citation building</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition"
            >
              Get Started
            </a>
          </div>
          <!-- Package 3 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 flex flex-col p-8 items-center">
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-2 font-semibold"
              >Best for: Conversion-Ready Websites</span
            >
            <h3 class="text-xl font-heading text-heading font-bold mb-2 text-center">Website Design & Development</h3>
            <div class="text-4xl font-bold text-primary mb-4">
              $199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-8 space-y-2 text-left">
              <li>✓ Mobile-friendly design</li>
              <li>✓ Fast, secure hosting</li>
              <li>✓ Conversion-focused pages</li>
              <li>✓ Easy editing & support</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition"
            >
              Get Started
            </a>
          </div>
        </div>
        <p class="text-base text-center text-body mt-10">
          <span class="font-bold">Not sure which is right for you?</span>
          <a href="#contact" class="text-primary underline">Book a free strategy call</a> for a custom recommendation.
        </p>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-20 bg-white border-t border-gray-100" id="faq">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center relative">
          Frequently Asked Questions
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="space-y-6">
          <!-- Industry/Niche FAQ -->
          <div class="bg-bluelight rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Do you work with my industry or niche?</h3>
            <p class="text-body text-base">
              If you’re a local service business—even if not listed above—there’s a 99% chance we can help. Just <a
                href="#contact"
                class="text-primary underline">reach out here</a
              > and ask!
            </p>
          </div>
          <!-- FAQ 1 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              How quickly will I see results from local SEO?
            </h3>
            <p class="text-body text-base">
              Most home service companies start seeing more calls, leads, and improved rankings within 30-60
              days—sometimes faster. We focus on quick wins from day one, and keep you in the loop with transparent
              updates.
            </p>
          </div>
          <!-- FAQ 2 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Is there a contract or setup fee?</h3>
            <p class="text-body text-base">
              No contracts or setup fees—everything is month-to-month. Stay only as long as you’re happy with your
              results.
            </p>
          </div>
          <!-- FAQ 3 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              Do I need to understand SEO or websites to get results?
            </h3>
            <p class="text-body text-base">
              Not at all! You run your business, we handle all the digital marketing. We keep things simple, speak your
              language, and never use tech jargon.
            </p>
          </div>
          <!-- FAQ 4 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              Can you help if I already have a website or GBP listing?
            </h3>
            <p class="text-body text-base">
              Absolutely. We improve, optimize, and fix existing sites and profiles—or create new ones if you want a
              fresh start.
            </p>
          </div>
          <!-- FAQ 5 -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              Will I have a dedicated point of contact?
            </h3>
            <p class="text-body text-base">
              Yes! You always work directly with a home service marketing strategist—no call centers, no agency
              handoffs.
            </p>
          </div>
        </div>
      </div>
    </section>
  </Layout>


</html>

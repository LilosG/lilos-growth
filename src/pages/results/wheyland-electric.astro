---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Wheyland Electric Case Study — 9x Website Leads, 10x Keywords | Lilos Growth";
export const description =
  "Wheyland Electric was averaging 3-4 web form leads and 2-3 click-to-call leads per month after 10 years with a legacy agency. Five months after our rebuild: ~35 form leads/mo, ~28 click-to-call leads/mo, organic traffic up 909%, keywords ranked up 1,430%.";

const metadata = { title, description };

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "https://lilosgrowth.com/results/wheyland-electric#article",
  headline: "Wheyland Electric: 9x Website Leads and 909% More Organic Traffic",
  description:
    "How Lilos Growth rebuilt Wheyland Electric's website, ran local SEO, and managed Google Business Profile — verified via Semrush, GA4, and Google Business Profile Performance data across the first five months.",
  author: { "@type": "Organization", name: "Lilos Growth", url: "https://lilosgrowth.com" },
  publisher: { "@id": "https://lilosgrowth.com/#org" },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": "https://lilosgrowth.com/results/wheyland-electric",
  },
};

const stats = [
  {
    value: "+909%",
    label: "Organic traffic",
    sub: "43 → 434 sessions · Semrush",
    tag: "Local SEO",
  },
  {
    value: "+1,430%",
    label: "Keywords ranked",
    sub: "20 → 306 keywords · Semrush",
    tag: "Local SEO",
  },
  { value: "~9×", label: "Website form leads", sub: "3-4/mo → ~35/mo · GA4", tag: "Leads" },
  { value: "~10×", label: "Click-to-call leads", sub: "2-3/mo → ~28/mo · GA4", tag: "Leads" },
  { value: "+224%", label: "GBP profile views", sub: "2,104 views, YoY · GBP", tag: "GBP" },
  { value: "~6×", label: "GBP calls, sustained", sub: "~2/mo → ~12/mo · GBP", tag: "GBP" },
];

const keywords = [
  { kw: "electrician carlsbad ca", pos: "#2" },
  { kw: "electrical panels carlsbad", pos: "#2" },
  { kw: "electrician rancho santa fe", pos: "#2" },
  { kw: "electrician carlsbad", pos: "#3" },
  { kw: "industrial electrician carlsbad", pos: "#3" },
  { kw: "commercial electrician carlsbad", pos: "#7" },
  { kw: "electricians in encinitas ca", pos: "#7" },
  { kw: "residential electrician carlsbad", pos: "#9" },
  { kw: "oceanside electrician", pos: "#12" },
  { kw: "commercial electrician oceanside", pos: "#12" },
];

const services = ["EV", "Panel", "Service", "Lighting", "Fan", "Spa", "Outlet"];
const cities = [
  "Carlsbad",
  "Del Mar",
  "Encinitas",
  "Oceanside",
  "Rancho Santa Fe",
  "San Marcos",
  "Vista",
  "Solana Beach",
];
---

<Layout
  title={title}
  description={description}
  metadata={metadata}
  schema={[articleSchema]}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Results", item: "https://lilosgrowth.com/results" },
    { name: "Wheyland Electric", item: "https://lilosgrowth.com/results/wheyland-electric" },
  ]}
>
  <!-- HERO -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div class="relative z-10 mx-auto max-w-4xl px-4">
      <div class="mb-4 flex flex-wrap gap-2">
        <span class="bg-primary/20 rounded-full px-3 py-1 text-xs font-semibold text-primary"
          >Case Study</span
        >
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/80"
          >Electrician · Carlsbad, CA</span
        >
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/80"
          >Website Build + Local SEO + GBP</span
        >
      </div>
      <h1 class="mb-4 font-heading text-3xl font-extrabold leading-tight text-white md:text-5xl">
        Wheyland Electric:<br class="hidden md:block" />9x website leads,<br
          class="hidden md:block"
        />909% more traffic
      </h1>
      <p class="max-w-2xl text-base font-medium text-white/85 md:text-lg">
        A 10-year-old site managed by a legacy agency. Virtually no organic footprint. We rebuilt
        from the ground up in late February 2026 — and five months later the growth held, across
        organic traffic, Google Business Profile, and every lead channel we track.
      </p>
    </div>
  </section>

  <!-- STATS BAND -->
  <section class="border-b border-gray-100 bg-white py-12">
    <div class="mx-auto max-w-5xl px-4">
      <p class="mb-6 text-center text-xs font-semibold uppercase tracking-widest text-body">
        Verified results — 5 months post-launch (Feb 28 – Jul 28, 2026)
      </p>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        {
          stats.map((s) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-sm">
              <span class="bg-primary/10 mb-2 inline-block rounded-full px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary">
                {s.tag}
              </span>
              <div class="font-heading text-3xl font-extrabold text-primary md:text-4xl">
                {s.value}
              </div>
              <div class="mt-1 text-sm font-semibold text-heading">{s.label}</div>
              <div class="mt-0.5 text-xs text-body">{s.sub}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SITUATION -->
  <section class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-body">The situation</p>
      <h2 class="mb-6 font-heading text-2xl font-bold text-heading md:text-3xl">
        10 years. Same agency. A handful of leads a month.
      </h2>
      <div class="space-y-4 text-[15px] leading-relaxed text-body">
        <p>
          Wheyland Electric is a licensed residential and commercial electrician serving North
          County San Diego — Carlsbad, Encinitas, Oceanside, Vista, Del Mar, Rancho Santa Fe, San
          Marcos, and Solana Beach. Their services include EV charger installation, electrical panel
          upgrades, service calls, recessed lighting, ceiling fans, spa and jacuzzi electrical, and
          outlet and GFCI repairs.
        </p>
        <p>
          Their site had been managed by the same agency for a decade. It had minimal organic
          visibility, virtually no local keyword coverage, and was generating 3-4 website form leads
          and 2-3 click-to-call leads per month. GBP calls averaged around 2 per month.
        </p>
        <p>
          They came to Lilos Growth in February 2026 looking for a full rebuild and a real local SEO
          strategy.
        </p>
      </div>

      <div class="bg-cream my-8 border-l-4 border-primary py-5 pl-6 pr-4">
        <p class="font-heading text-base font-semibold leading-relaxed text-heading md:text-lg">
          "The previous agency had them at 3-4 web form leads and 2-3 click-to-call leads per month.
          The new site launched in late February 2026 and generated 18 form submissions in its first
          3 weeks — and five months later, form leads are averaging ~35/mo and click-to-call is
          averaging ~28/mo."
        </p>
        <p class="mt-2 text-sm text-body">
          — Verified via Google Analytics 4 event tracking (click_to_call, form_submit) and Google
          Business Profile Performance data
        </p>
      </div>
    </div>
  </section>

  <!-- BEFORE VS AFTER -->
  <section class="bg-cream border-t border-gray-100 py-20">
    <div class="mx-auto max-w-3xl px-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-body">Before vs. after</p>
      <h2 class="mb-8 font-heading text-2xl font-bold text-heading md:text-3xl">
        The numbers speak for themselves.
      </h2>
      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="grid grid-cols-2">
          <div class="border-r border-gray-100 p-6">
            <div class="mb-4 text-xs font-semibold uppercase tracking-widest text-red-500">
              Before — pre-Feb 2026
            </div>
            {
              [
                ["Website form leads/mo", "3-4"],
                ["Click-to-call leads/mo", "2-3"],
                ["GBP calls/mo", "~2"],
                ["Organic traffic", "43"],
                ["Keywords ranked", "20"],
                ["Top-3 keywords", "1"],
              ].map(([metric, value]) => (
                <div class="flex items-baseline justify-between border-b border-gray-50 py-2 last:border-0">
                  <span class="text-sm text-body">{metric}</span>
                  <span class="font-heading text-sm font-bold text-red-500">{value}</span>
                </div>
              ))
            }
          </div>
          <div class="p-6">
            <div class="mb-4 text-xs font-semibold uppercase tracking-widest text-green-600">
              After — 5 months (Jul 2026)
            </div>
            {
              [
                ["Website form leads/mo", "~35"],
                ["Click-to-call leads/mo", "~28"],
                ["GBP calls/mo", "~12 sustained*"],
                ["Organic traffic", "434"],
                ["Keywords ranked", "306"],
                ["Top-3 keywords", "29"],
              ].map(([metric, value]) => (
                <div class="flex items-baseline justify-between border-b border-gray-50 py-2 last:border-0">
                  <span class="text-sm text-body">{metric}</span>
                  <span class="font-heading text-sm font-bold text-green-600">{value}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <p class="mt-3 text-xs text-body">
        * GBP calls spiked to 21 in the first month post-launch, then settled to a sustained ~12/mo
        average over the following 4 months (60 total, Feb-Jun 2026).
      </p>
    </div>
  </section>

  <!-- KEYWORD RANKINGS -->
  <section class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-3xl px-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-body">Keyword rankings</p>
      <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
        From 20 keywords to 306 — 29 in the top 3.
      </h2>
      <p class="mb-8 text-[15px] text-body">
        Full breakdown, Semrush, Feb 28 → Jul 28, 2026: 29 keywords in the top 3 (up from 1), 38 in
        positions 4-10, 63 in 11-20, 97 in 21-50, and 58 in 51-100. The list below is an early
        keyword snapshot from the first month post-launch.
      </p>
      <div class="space-y-2">
        {
          keywords.map((k) => (
            <div class="flex items-center justify-between rounded-xl border border-gray-100 bg-white px-4 py-3 shadow-sm">
              <span class="text-sm text-body">{k.kw}</span>
              <span
                class={`rounded-full px-3 py-1 text-xs font-bold ${parseInt(k.pos.replace("#", "")) <= 3 ? "bg-green-100 text-green-700" : parseInt(k.pos.replace("#", "")) <= 10 ? "bg-blue-100 text-blue-700" : "bg-orange-100 text-orange-700"}`}
              >
                {k.pos}
              </span>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-xs text-body">
        Early snapshot source: Ahrefs position tracker, March 2026. Aggregate totals above: Semrush,
        July 2026.
      </p>
    </div>
  </section>

  <!-- WHAT WE BUILT -->
  <section class="bg-cream border-t border-gray-100 py-20">
    <div class="mx-auto max-w-4xl px-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-body">What we built</p>
      <h2 class="mb-4 font-heading text-2xl font-bold text-heading md:text-3xl">
        107 pages. 8 cities. 64 money pages. Launched in under 2 weeks.
      </h2>
      <p class="mb-10 text-[15px] text-body">
        Built on Astro and Tailwind CSS. Every page purpose-built for organic search — structured
        around the services Wheyland offers and the cities they serve.
      </p>

      <div class="mb-10 grid grid-cols-2 gap-4 md:grid-cols-4">
        {
          [
            { num: "107", label: "Total pages indexed" },
            { num: "64", label: "City × service money pages" },
            { num: "13", label: "Blog posts at launch" },
            { num: "8", label: "Service area cities" },
          ].map((s) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-sm">
              <div class="font-heading text-3xl font-extrabold text-primary">{s.num}</div>
              <div class="mt-1 text-xs text-body">{s.label}</div>
            </div>
          ))
        }
      </div>

      <h3 class="mb-4 font-heading text-base font-semibold text-heading">City × service matrix</h3>
      <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full text-xs">
          <thead>
            <tr class="border-b border-gray-100 bg-gray-50">
              <th class="px-4 py-3 text-left font-semibold text-heading">City</th>
              {
                services.map((s) => (
                  <th class="px-3 py-3 text-center font-semibold text-heading">{s}</th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              cities.map((city, i) => (
                <tr class={i % 2 === 0 ? "bg-white" : "bg-gray-50/50"}>
                  <td class="px-4 py-2.5 font-medium text-heading">{city}</td>
                  {services.map(() => (
                    <td class="px-3 py-2.5 text-center text-green-600">✓</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- HOW WE DID IT -->
  <section class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-4xl px-4">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-body">The method</p>
      <h2 class="mb-10 font-heading text-2xl font-bold text-heading md:text-3xl">
        The system behind the results.
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          [
            {
              n: "01",
              title: "Full site rebuild",
              desc: "Astro + Tailwind. Static-first, sub-second load times, Core Web Vitals optimized from day one.",
            },
            {
              n: "02",
              title: "City × service architecture",
              desc: "Every service, every city — 64 dedicated pages targeting the exact queries buyers use when searching for an electrician in their area.",
            },
            {
              n: "03",
              title: "Schema & entity markup",
              desc: "LocalBusiness, Service, FAQ, and HowTo schema across all pages — structured for Google and AI search.",
            },
            {
              n: "04",
              title: "GBP optimization",
              desc: "Categories, services, EXIF-optimized photos, weekly posts, and review management from launch day.",
            },
            {
              n: "05",
              title: "GA4 + conversion tracking",
              desc: "Form submissions, click-to-call, and GBP actions all tracked and attributed from day one.",
            },
            {
              n: "06",
              title: "Targeted blog content",
              desc: "13 posts at launch targeting in-market EV charger and panel upgrade searches across North County.",
            },
          ].map((item) => (
            <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
              <div class="text-primary/30 mb-3 font-heading text-2xl font-bold">{item.n}</div>
              <h3 class="mb-2 font-heading text-base font-semibold text-heading">{item.title}</h3>
              <p class="text-sm text-body">{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-secondary to-secondary-dark py-16">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="mb-3 font-heading text-2xl font-extrabold text-white md:text-3xl">
        You run a trades business in your market.
      </h2>
      <p class="mb-8 text-base text-white/85">
        We've done this for an electrician in North County San Diego. We know the system. Book a
        free 15-minute audit and we'll show you exactly what's holding your site back.
      </p>
      <a
        href="/contact#book"
        data-evt="cta_case_study_wheyland"
        class="inline-flex items-center rounded-full bg-primary px-8 py-3.5 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-dark"
      >
        Get a free site audit
        <svg
          class="ml-2 h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          viewBox="0 0 24 24"
          aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
        >
      </a>
    </div>
  </section>
</Layout>

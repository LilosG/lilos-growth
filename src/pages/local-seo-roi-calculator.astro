---
import PageLayout from "~/layouts/PageLayout.astro";
import LocalSEOROICalculator from "~/components/tools/LocalSEOROICalculator.astro";

const title = "Local SEO ROI Calculator for Home Service Businesses | Lilos Growth";
const description =
  "Find out what a top Google Maps ranking is worth to your business. Enter your trade, city, average job value, and current lead volume to see your projected ROI from local SEO.";

const metadata = { title, description };

const toolSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Local SEO ROI Calculator",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description:
    "Free ROI calculator for home service businesses to estimate the revenue impact of ranking in the Google Map Pack.",
  provider: { "@id": "https://lilosgrowth.com/#org" },
  url: "https://lilosgrowth.com/local-seo-roi-calculator",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<PageLayout
  title={title}
  description={description}
  metadata={metadata}
  schema={[toolSchema]}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Tools", item: "https://lilosgrowth.com/local-seo-tools" },
    { name: "ROI Calculator", item: "https://lilosgrowth.com/local-seo-roi-calculator" },
  ]}
>
  <!-- HERO -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-12 pt-12"
  >
    <div class="relative z-10 mx-auto max-w-3xl px-4 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">Free Tool</p>
      <h1 class="mb-4 font-heading text-3xl font-extrabold leading-tight text-white md:text-4xl">
        Local SEO ROI Calculator
      </h1>
      <p class="mx-auto max-w-xl text-base font-medium text-white/85">
        See what a top Google Maps ranking is actually worth to your business. Enter your trade,
        city, and numbers — get a realistic revenue projection in seconds.
      </p>
    </div>
  </section>

  <!-- CALCULATOR -->
  <div class="bg-cream py-12">
    <LocalSEOROICalculator />
  </div>

  <!-- BOTTOM CTA -->
  <section class="border-t border-gray-100 bg-white py-14">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">
        Want us to run this for your actual market?
      </h2>
      <p class="mb-6 text-base text-body">
        Book a free 15-minute audit. We'll pull real GSC and GBP data for your business and show you
        exactly where the gaps are.
      </p>
      <a
        href="/contact#book"
        data-evt="cta_roi_calc_bottom"
        class="inline-flex items-center rounded-full bg-primary px-8 py-3.5 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-dark"
      >
        Book a Free Audit
        <svg
          class="ml-2 h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          viewBox="0 0 24 24"
          aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
        >
      </a>
      <p class="mt-4 text-sm text-body">
        Or explore our <a
          href="/local-seo-tools"
          class="font-semibold text-primary underline underline-offset-2 hover:text-primary-dark"
          >other free SEO tools →</a
        >
      </p>
    </div>
  </section>
</PageLayout>

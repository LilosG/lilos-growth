---
// FILE: src/pages/packages.astro
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Plans & Pricing | Websites, Local SEO & GBP | Lilos Growth';
export const description =
  'Transparent, no-contract pricing for Google Business Profile management, Local SEO, websites, and Website-as-a-Service. Built for home-service pros, month-to-month, no surprises.';
---

<Layout title={title} description={description}>
  <!-- HERO (unchanged style) -->
  <section class="bg-[#253242] min-h-[340px] flex items-center justify-center pt-14 pb-14 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl mx-auto w-full px-4 text-center">
      <h1 class="font-heading text-white text-5xl md:text-6xl font-extrabold mb-4 drop-shadow">Plans & Pricing</h1>
      <p class="font-body text-xl text-white/90 mb-3 font-medium">
        Month-to-month. No setup fees. Built for home-service pros.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="#packages"
          class="inline-flex items-center px-8 py-3 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
          data-track
          data-track-event="view_packages">View Packages</a
        >
        <a
          href="#faq"
          class="inline-flex items-center px-8 py-3 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
          data-track
          data-track-event="view_faq">Frequently Asked Questions</a
        >
      </div>
    </div>
  </section>

  <!-- TRUST STRIP (unchanged sections) -->
  <section class="bg-[#f7fafd] py-16 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-5">How Our Process Works</h2>
      <p class="font-body text-lg text-body mb-12 max-w-2xl mx-auto">
        Straightforward onboarding, clear deliverables, and transparent reporting.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="bg-white rounded-2xl shadow p-6">
          <h3 class="font-heading text-heading font-bold text-lg mb-2">Free Consultation</h3>
          <p class="font-body text-body text-base">Tailored audit + growth plan—no obligation.</p>
        </div>
        <div class="bg-white rounded-2xl shadow p-6">
          <h3 class="font-heading text-heading font-bold text-lg mb-2">Custom Plan</h3>
          <p class="font-body text-body text-base">Pick a package or we’ll tailor one for goals & budget.</p>
        </div>
        <div class="bg-white rounded-2xl shadow p-6">
          <h3 class="font-heading text-heading font-bold text-lg mb-2">Launch & Optimize</h3>
          <p class="font-body text-body text-base">We implement, improve, and report—end to end.</p>
        </div>
        <div class="bg-white rounded-2xl shadow p-6">
          <h3 class="font-heading text-heading font-bold text-lg mb-2">Grow & Report</h3>
          <p class="font-body text-body text-base">Monthly reports + check-ins to keep momentum.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="bg-white py-10 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-heading text-heading text-2xl md:text-3xl font-extrabold mb-6">Who We Help</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Plumbers</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >HVAC</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Electricians</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Roofers</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Pest Control</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Landscaping</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Cleaning</span
        >
        <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
          >Other Pros</span
        >
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="bg-[#f7fafd] py-16 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-10">Why Choose Lilos Growth?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-4">
        <div class="bg-white rounded-2xl p-10 shadow border border-gray-100">
          <h3 class="font-heading text-heading font-bold text-xl mb-3">Home-Service Specialists</h3>
          <p class="font-body text-body text-base">Niche focus = faster wins and clearer playbooks.</p>
        </div>
        <div class="bg-white rounded-2xl p-10 shadow border border-gray-100">
          <h3 class="font-heading text-heading font-bold text-xl mb-3">Month-to-Month</h3>
          <p class="font-body text-body text-base">No contracts. Stay only if we’re delivering.</p>
        </div>
        <div class="bg-white rounded-2xl p-10 shadow border border-gray-100">
          <h3 class="font-heading text-heading font-bold text-xl mb-3">Done-for-You</h3>
          <p class="font-body text-body text-base">We handle updates, optimizations, reviews & reporting.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section id="packages" class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 space-y-16">
      <!-- GBP (Google Business Profile) -->
      <div>
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-3 text-center">
          Google Business Profile (GBP)
        </h2>
        <p class="font-body text-lg text-body mb-8 text-center max-w-3xl mx-auto">
          Comprehensive management to win the Map Pack and convert more calls.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <!-- Starter -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
              >Best for getting established</span
            >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Starter</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li>Full GBP setup/optimization + category & services alignment</li>
              <li>
                Posts: <strong>6/mo</strong> &nbsp;•&nbsp; Photos: <strong>6/mo</strong> (EXIF-optimized names, alt text)
              </li>
              <li>Review replies <strong>up to 30/mo</strong>; Q&amp;A weekly</li>
              <li>Services/Products refresh <strong>quarterly</strong></li>
              <li>Citation cleanup <strong>quarterly</strong>; monthly performance report</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Get Started</a
            >
          </div>
          <!-- Growth -->
          <div
            class="bg-white rounded-2xl shadow-xl border-2 border-primary flex flex-col p-8 relative hover:shadow-2xl transition"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
            >
              Most Popular
            </div>
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
              >Includes everything in Starter</span
            >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Growth</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $399<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li>Posts: <strong>~3/week</strong> &nbsp;•&nbsp; Fresh photos ongoing (EXIF-optimized)</li>
              <li>Review replies: <strong>no cap</strong> + proactive requests</li>
              <li>Services/Products refresh <strong>monthly</strong></li>
              <li>Ongoing citation management (top platforms + corrections)</li>
              <li>Quarterly heatmap & competitor snapshot; monthly report + 30-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Get Started</a
            >
          </div>
        </div>
      </div>

      <!-- Local SEO -->
      <div>
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-3 text-center">
          Local SEO (Single Location)
        </h2>
        <p class="font-body text-lg text-body mb-8 text-center max-w-3xl mx-auto">
          On-page, technical, citations, and local authority building—built for service areas.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Essentials -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Essentials</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $499<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li><strong>Up to 5 pages</strong> + <strong>5 blog posts</strong> per month (≈750–1,000 words)</li>
              <li>On-page & technical fixes batched monthly (titles, metas, H1/H2, internal links, schema basics)</li>
              <li>Citations: 10–20 initial, then 5–10/mo</li>
              <li>Monthly report + 30-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Get Started</a
            >
          </div>

          <!-- Growth -->
          <div
            class="bg-white rounded-2xl shadow-xl border-2 border-primary flex flex-col p-8 relative hover:shadow-2xl transition"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
            >
              Best Value
            </div>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Growth</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $799<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li><strong>Up to 10 pages</strong> + <strong>10 blog posts</strong> per month</li>
              <li>2–4 local backlinks/mo (assoc/partner/sponsor/guest)</li>
              <li>Core Web Vitals, schema & crawl prioritization</li>
              <li>Ongoing citations; quarterly heatmap & competitor review</li>
              <li>Monthly report + 45-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Get Started</a
            >
          </div>

          <!-- Pro -->
          <div
            class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Pro</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $1,199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li><strong>Up to 20 pages</strong> + <strong>10 blog posts</strong> per month</li>
              <li>4–6 local backlinks/mo; conversion testing on top pages</li>
              <li>Bi-weekly check-ins</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Request Pro</a
            >
          </div>
        </div>
      </div>

      <!-- Websites (One-time builds) -->
      <div>
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-3 text-center">
          Websites (One-Time Builds)
        </h2>
        <p class="font-body text-lg text-body mb-8 text-center max-w-3xl mx-auto">
          Own your site outright. Launch quickly with conversion-ready pages.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
          <!-- Launch Lite -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Launch Lite</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $499<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li>≈ <strong>10 pages</strong>: Home, 3 services, About/Contact, + core supporting pages</li>
              <li>Form + click-to-call; basic schema</li>
              <li><strong>3–5 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Start Website</a
            >
          </div>

          <!-- Starter -->
          <div
            class="bg-white rounded-2xl shadow-xl border-2 border-primary flex flex-col p-8 relative hover:shadow-2xl transition"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
            >
              Popular
            </div>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Starter</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $750<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li><strong>15 pages</strong>: Home + 9 service/city pages + supporting pages</li>
              <li>Titles/metas/H1–H2; internal link scaffold; stock library</li>
              <li><strong>5–7 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Start Website</a
            >
          </div>

          <!-- Standard -->
          <div
            class="bg-white rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Standard</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $1,500<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li>≈ <strong>25 pages</strong></li>
              <li>Enhanced schema (LocalBusiness + Services)</li>
              <li>Conversion blocks (badges, FAQs, reviews)</li>
              <li><strong>10–14 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"
              >Start Website</a
            >
          </div>
        </div>

        <p class="text-sm text-body/80 mt-4 max-w-3xl mx-auto text-center">
          Global website notes: client supplies branding/services/service areas/5–10 reviews; premium stock billed at
          cost; hosting not included (WaS covers hosting/updates).
        </p>
      </div>

      <!-- Website-as-a-Service (WaS) -->
      <div>
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-3 text-center">
          Website-as-a-Service (WaS)
        </h2>
        <p class="font-body text-lg text-body mb-8 text-center max-w-3xl mx-auto">
          Subscription website with hosting, updates, and ongoing support.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <!-- WaS Base -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 hover:shadow-2xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Base</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $250<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-8">
              <li><strong>Up to 5 minor updates/mo</strong></li>
              <li>≤ 1 new page/mo</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"

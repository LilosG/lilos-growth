      <!-- Add-ons & Surcharges -->
      <div>
        <h2 class="mb-4 text-center font-heading text-2xl font-extrabold text-heading md:text-3xl">
          Add-ons & Surcharges
        </h2>
        <div class="mx-auto max-w-4xl rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <ul class="list-inside list-disc space-y-2 font-body text-base text-body">

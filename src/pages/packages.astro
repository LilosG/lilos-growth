---
import Layout from '~/layouts/Layout.astro';

export const title = 'Plans & Pricing | Websites, Local SEO & GBP | Lilos Growth';
export const description =
  'Choose a transparent, no-contract package for websites, Local SEO, and Google Business Profile optimization. Affordable monthly pricing designed for home service businesses.';
---

<Layout title={title} description={description}>
  <main class="font-body text-body bg-white">
    <!-- HERO -->
    <section class="bg-[#253242] min-h-[340px] flex items-center justify-center pt-14 pb-14 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl mx-auto w-full px-4 text-center">
        <h1 class="font-heading text-white text-5xl md:text-6xl font-extrabold mb-4 drop-shadow">Plans and Pricing</h1>
        <p class="font-body text-xl text-white/90 mb-3 font-medium">
          Transparent, bundled marketing for home service businesses.<br class="hidden md:block" />
          Month-to-month. No hidden fees. Real results.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a
            href="#packages"
            class="inline-flex items-center px-8 py-3 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
          >
            View Packages
          </a>
          <a
            href="#faq"
            class="inline-flex items-center px-8 py-3 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
          >
            Frequently Asked Questions
          </a>
        </div>
      </div>
    </section>

    <!-- HOW OUR PROCESS WORKS -->
    <section class="bg-[#f7fafd] py-16 border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-5">How Our Process Works</h2>
        <p class="font-body text-lg text-body mb-12 max-w-2xl mx-auto">
          Get real results with a process built for busy home service pros. No contracts. No surprises. Just clarity and
          growth.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="bg-white rounded-2xl shadow p-6 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-lg mb-2">Free Consultation</h3>
            <p class="font-body text-body text-base">
              Get a tailored audit and growth plan—no obligation, just actionable insights.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-6 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-lg mb-2">Custom Plan</h3>
            <p class="font-body text-body text-base">
              Pick your ideal package or have us customize a plan for your needs and goals.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-6 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-lg mb-2">Launch & Optimize</h3>
            <p class="font-body text-body text-base">
              We handle setup, improvements, and ongoing updates. You get transparency and growth.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow p-6 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-lg mb-2">Grow & Report</h3>
            <p class="font-body text-body text-base">
              Get clear reports, more leads, and ongoing support from a real local team.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHO WE HELP -->
    <section class="bg-white py-10 border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="font-heading text-heading text-2xl md:text-3xl font-extrabold mb-6">Who We Help</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Plumbers</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >HVAC</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Electricians</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Roofers</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Pest Control</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Landscaping</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Cleaning</span
          >
          <span class="bg-bluelight px-5 py-2 rounded-full text-heading font-heading font-medium text-base shadow"
            >Other Pros</span
          >
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US (matches home page) -->
    <section class="bg-[#f7fafd] py-16 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-10">Why Choose Lilos Growth?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-4">
          <div class="bg-white rounded-2xl p-10 shadow border border-gray-100 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-xl mb-3">Home Service Experts</h3>
            <p class="font-body text-body text-base">
              We only work with service pros—so we know your market and how to get real results.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-10 shadow border border-gray-100 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-xl mb-3">No Contracts. No Setup Fees.</h3>
            <p class="font-body text-body text-base">
              Month-to-month billing, transparent pricing, and full ownership—always.
            </p>
          </div>
          <div class="bg-white rounded-2xl p-10 shadow border border-gray-100 flex flex-col items-center">
            <h3 class="font-heading text-heading font-bold text-xl mb-3">100% Done For You</h3>
            <p class="font-body text-body text-base">
              We handle everything—setup, optimizations, reviews, reporting, and strategy updates.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE PACKAGES -->
    <section id="packages" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-5 text-center">
          Service Packages for Home Service Companies
        </h2>
        <p class="font-body text-lg text-body mb-10 text-center max-w-2xl mx-auto">
          Choose the package that fits your goals. Month-to-month. No contracts. No setup fees. Real results.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">
          <!-- Website as a Service -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 items-start hover:shadow-2xl transition"
          >
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
            >
              Get Online Fast
            </span>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Website as a Service</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-2">
              $750<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="font-body mb-4 text-body">
              Great for service businesses who want a modern, mobile-ready website—fast.
            </p>
            <ul class="font-body text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Responsive, modern web design</li>
              <li>Content & image development</li>
              <li>Unlimited edits & easy updates</li>
              <li>Month-to-month support</li>
              <li>Secure hosting & fast launch</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>
          <!-- GBP/Maps Only -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 items-start hover:shadow-2xl transition"
          >
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
            >
              Maps Pack Rankings
            </span>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Google Business Profile Package</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-2">
              $499<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="font-body mb-4 text-body">
              Perfect for local businesses focused on Google Maps rankings and reviews.
            </p>
            <ul class="font-body text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Full GBP setup & optimization</li>
              <li>Ongoing monthly management</li>
              <li>Reviews, posts & photos</li>
              <li>Reputation guidance</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>
          <!-- SEO Only -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border border-gray-100 flex flex-col p-8 items-start hover:shadow-2xl transition"
          >
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
            >
              Grow Organic Leads
            </span>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Local SEO Package</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-2">
              $499<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="font-body mb-4 text-body">
              Great for those who want to dominate organic search in their service area.
            </p>
            <ul class="font-body text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Local keyword research & tracking</li>
              <li>On-page SEO & content</li>
              <li>Citation building/cleanup</li>
              <li>Google Map ranking</li>
              <li>Weekly blog/content posting</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>
        </div>
        <!-- Bundles (highlighted) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <!-- SEO + GBP BUNDLE -->
          <div
            class="bg-white rounded-2xl shadow-2xl border-2 border-primary flex flex-col p-10 items-start relative hover:shadow-3xl transition"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
            >
              Best Value
            </div>
            <span
              class="block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
            >
              SEO & Maps Pack Bundle
            </span>
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">Local SEO + GBP Bundle</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-2">
              $799<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="font-body mb-4 text-body">
              Serious about growth? Bundle local SEO & Google Maps management for best results.
            </p>
            <ul class="font-body text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Everything from GBP & Local SEO</li>
              <li>Double the posts, more reviews</li>
              <li>Advanced Map Pack & ranking tactics</li>
              <li>Monthly strategy/report call</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>
          <!-- ALL-IN BUNDLE -->
          <div
            class="bg-primary rounded-2xl shadow-2xl border-2 border-primary flex flex-col p-10 items-start relative hover:shadow-3xl transition"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-white text-primary text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
            >
              All-In-One Bundle
            </div>
            <span
              class="block text-xs bg-white/20 text-white px-3 py-1 rounded-full mb-3 font-heading font-semibold uppercase tracking-wide"
            >
              Website + SEO + GBP
            </span>
            <h3 class="font-heading text-white text-2xl font-bold mb-2">Website + Local SEO + GBP</h3>
            <div class="text-4xl font-heading text-white font-bold mb-2">
              $1299<span class="text-lg font-normal text-white/70">/mo</span>
            </div>
            <p class="font-body mb-4 text-white/90">
              Everything you need: a modern site, organic rankings, and top-3 map pack placement—done for you.
            </p>
            <ul class="font-body text-white/90 text-base mb-8 space-y-1 list-disc list-inside">
              <li>Modern site build or redesign</li>
              <li>All Local SEO & GBP services</li>
              <li>Full site hosting & editing</li>
              <li>Premium support, strategy & analytics</li>
              <li>Everything above, bundled for less</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-white text-primary font-heading font-semibold text-lg shadow hover:bg-bluelight transition w-full text-center"
            >
              Get Started
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPARE PACKAGES TABLE (MATCHED WIDTH & STYLE) -->
    <section class="bg-[#f7fafd] py-16 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="font-heading text-heading text-2xl md:text-3xl font-extrabold mb-8 text-center">Compare Packages</h2>
        <div class="overflow-x-auto rounded-2xl bg-white shadow border border-gray-100">
          <table class="min-w-full text-left">
            <thead>
              <tr class="bg-bluelight text-heading text-base">
                <th class="py-4 px-6 font-heading font-bold">Features</th>
                <th class="py-4 px-6 font-heading font-bold text-center">Website</th>
                <th class="py-4 px-6 font-heading font-bold text-center">GBP</th>
                <th class="py-4 px-6 font-heading font-bold text-center">SEO</th>
                <th class="py-4 px-6 font-heading font-bold text-center">Bundle</th>
                <th class="py-4 px-6 font-heading font-bold text-center">All-In-One</th>
              </tr>
            </thead>
            <tbody class="text-body text-base font-body">
              <tr class="border-t">
                <td class="py-3 px-6">Modern Website Build</td>
                <td class="text-center">Yes</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">GBP Optimization & Mgmt</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Local Keyword Research</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">On-Page SEO</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Weekly Content Posting</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Citation Building/Cleanup</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Reputation Guidance</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Monthly Strategy Call</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">-</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
              <tr class="border-t">
                <td class="py-3 px-6">Premium Support</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
                <td class="text-center">Yes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="py-16 bg-white border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="font-heading text-heading text-2xl md:text-3xl font-extrabold mb-8">What Our Clients Say</h2>
        <div class="flex flex-col md:flex-row gap-8 justify-center items-stretch">
          <div class="bg-bluelight rounded-2xl shadow p-8 flex-1 flex flex-col items-center">
            <div class="text-3xl text-primary mb-3 font-heading">★★★★★</div>
            <p class="text-lg text-heading mb-3 font-heading font-semibold">
              "We booked more calls in 2 months than all last year. The Lilos Growth team knows home services and got us
              results."
            </p>
            <span class="text-body text-base font-body">– Mike S., HVAC Company</span>
          </div>
          <div class="bg-bluelight rounded-2xl shadow p-8 flex-1 flex flex-col items-center">
            <div class="text-3xl text-primary mb-3 font-heading">★★★★★</div>
            <p class="text-lg text-heading mb-3 font-heading font-semibold">
              "The website and Google Maps ranking paid for itself fast. Their process was seamless and easy."
            </p>
            <span class="text-body text-base font-body">– Sarah K., Plumbing Contractor</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20 bg-[#f7fafd] border-t border-gray-100" id="faq">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-8 text-center relative">
          Frequently Asked Questions
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="space-y-8">
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
            <h3 class="font-heading text-heading text-xl font-bold mb-2">Do I have to sign a long-term contract?</h3>
            <p class="font-body text-body text-lg">
              Never. All plans are month-to-month. Stay only as long as you love the results!
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
            <h3 class="font-heading text-heading text-xl font-bold mb-2">Can I upgrade, downgrade, or cancel?</h3>
            <p class="font-body text-body text-lg">
              Yes—switch packages any time, and cancel with no penalty. We're here to make your growth easy.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
            <h3 class="font-heading text-heading text-xl font-bold mb-2">Do you offer custom packages?</h3>
            <p class="font-body text-body text-lg">
              Absolutely. If you need something different, <a href="#contact" class="text-primary underline"
                >contact us</a
              > and we’ll build a solution for your business.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-8">
            <h3 class="font-heading text-heading text-xl font-bold mb-2">
              What’s included in the “Website as a Service” package?
            </h3>
            <p class="font-body text-body text-lg">
              Everything to get online: fast, modern site, ongoing edits, secure hosting, and top-notch support.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="py-12 bg-primary">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 class="font-heading text-white text-3xl font-extrabold mb-4">Ready to Grow? Get a Free Consultation.</h2>
        <p class="font-body text-white/80 text-lg mb-7">
          Book your free website & SEO audit—no hard sell, just actionable insights.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-white hover:bg-bluelight text-primary font-heading font-semibold text-lg shadow transition"
        >
          Book My Free Audit
        </a>
      </div>
    </section>
  </main>
</Layout>

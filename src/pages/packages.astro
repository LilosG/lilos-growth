          </div>
          <!-- WaS Plus -->
          <div
            class="relative flex flex-col rounded-2xl border-2 border-primary bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 rounded-2xl bg-primary px-4 py-1 font-heading text-xs font-bold text-white shadow"
            >
              Growing Teams
            </div>
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Plus</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $750<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li><strong>Up to 15 updates/mo</strong></li>
              <li>≤ 3 new pages/mo; quarterly CRO refresh</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Get WaS</a
            >
          </div>
        </div>
      </div>

      <!-- Bundles -->
      <div>
        <h2 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
          Bundles
        </h2>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
          <div
            class="hover:shadow-3xl flex flex-col rounded-2xl border-2 border-primary bg-white p-8 shadow-2xl transition"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">GBP + SEO Essentials</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $699<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-6 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>Everything in GBP Starter + Local SEO Essentials</li>
              <li>Unified reporting + strategy</li>
            </ul>
            <a
              href="#contact"
              class="rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"

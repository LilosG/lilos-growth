        </article>

        <!-- Authority -->
        <article class="relative flex flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-sm">
          <h3 class="font-heading text-xl font-bold text-heading">Authority</h3>
          <div class="mt-2 flex items-baseline gap-1">

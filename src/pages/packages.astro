---
import Layout from '~/layouts/PageLayout.astro';
import { packages, gbpOneTime, gbpRecurring, seoOneTime, seoTiers, websiteBuilds, websiteAsAService, audits, addOns } from '~/data/packages';

const metadata = {
  title: 'Pricing & Packages | Local SEO, GBP & Website Design | Lilos Growth',
  description: 'Clear, transparent pricing for local SEO, Google Business Profile management, and website design. Three package tiers, standalone GBP, website builds, and audits. Month-to-month, no contracts.',
};

const faqs = [
  { q: 'Why is the first month more expensive?', a: 'Month one includes significantly more work — full audit, written strategy document, GBP optimization, technical SEO foundation, schema installation, and citation cleanup. Every client gets a complete strategy document before execution begins. The setup fee reflects that work honestly. Ongoing months are the retainer rate.' },
  { q: 'Can I start with just GBP and add SEO later?', a: 'Yes — and that\'s how most clients start. GBP management at $249/mo is the lowest-barrier entry. Once you\'re seeing results, usually within 60 days, adding an SEO retainer is a natural next step. The GBP work feeds directly into the SEO strategy.' },
  { q: 'What\'s the difference between the free GBP audit and the Local Search Audit?', a: 'The free audit covers your Google Business Profile only — scored, benchmarked, findings delivered. The Local Search Audit ($499) covers your entire digital footprint: GBP, technical SEO, keyword landscape, competitive position, schema, citations, AI visibility, and a full 90-day action plan. The $499 is credited in full toward any retainer.' },
  { q: 'Do the website builds include SEO?', a: 'Yes. Every build includes on-page SEO, schema, GA4, GSC, and the service × city page architecture built to rank. Ongoing monthly content, citations, and backlinks are the retainer. The site is the foundation — the retainer is what makes it compound.' },
  { q: 'What does "local content assets" mean?', a: 'Service pages, city pages, service × city pages, FAQs, listicles, location blog posts — whatever type of content moves the needle in your market that month. Purpose-built local search assets targeting real keywords with real search volume. Not generic blog posts.' },
  { q: 'Is there a minimum commitment?', a: 'No minimum. Month-to-month on everything. We ask for 30 days notice to offboard cleanly — no penalty, no contract, no lock-in.' },
];
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-white pt-20 pb-20">
    <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse 80% 60% at 50% -10%,rgba(245,107,42,0.06) 0%,transparent 70%);" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-primary">Pricing</p>
      <h1 class="mb-5 font-heading text-5xl font-extrabold leading-tight text-heading md:text-6xl">Clear pricing. Real work.<br /><span class="text-primary">No surprises.</span></h1>
      <p class="mx-auto max-w-xl text-lg text-muted">Three pillars — Google Business Profile, Local SEO, and Website Design. Each stands alone or stacks into a complete local search strategy. Every retainer is month-to-month. Written strategy included with every engagement.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm font-medium text-muted">
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>No contracts — cancel anytime</span>
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Written strategy with every engagement</span>
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Real reporting on real metrics every month</span>
      </div>
    </div>
  </section>

  <!-- BUNDLED PACKAGES -->
  <section class="bg-background-subtle py-24 border-y border-border-subtle" id="packages">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Most clients start here</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Bundled Packages — GBP + Local SEO</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-muted">GBP management and local SEO working together under one strategy. One report, one point of contact, one direction. Add a website build at any time — it's a separate one-time fee, the retainer stays the same.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {packages.map(pkg => (
          <article class={`relative flex flex-col rounded-2xl border p-8 transition ${pkg.featured ? 'border-primary bg-secondary shadow-2xl' : 'border-border-subtle bg-white shadow-sm hover:border-primary/30 hover:shadow-md'}`}>
            {pkg.featured && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-primary px-5 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow">{pkg.badge}</span>
              </div>
            )}
            <p class={`mb-1 text-xs font-bold uppercase tracking-widest ${pkg.featured ? 'text-primary' : 'text-muted'}`}>{pkg.tagline}</p>
            <h3 class={`font-heading text-2xl font-extrabold ${pkg.featured ? 'text-white' : 'text-heading'}`}>{pkg.name}</h3>
            <div class="mt-3 flex items-baseline gap-1">
              <span class={`font-heading text-5xl font-extrabold ${pkg.featured ? 'text-white' : 'text-primary'}`}>${pkg.price}</span>
              <span class={`text-sm ${pkg.featured ? 'text-white/50' : 'text-body'}`}>/mo</span>
            </div>
            <p class={`mt-1 text-xs ${pkg.featured ? 'text-white/40' : 'text-muted'}`}>Setup month: ${pkg.setupPrice}</p>
            <div class={`my-5 h-px ${pkg.featured ? 'bg-white/10' : 'bg-border-subtle'}`}></div>
            <ul class="flex-1 space-y-2.5 text-sm mb-8">
              {pkg.inclusions.map(inc => (
                <li class={`flex items-start gap-2 ${pkg.featured ? 'text-white/75' : 'text-body'}`}>
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {inc}
                </li>
              ))}
            </ul>
            <a href="/contact#book" class={`block rounded-xl px-6 py-3.5 text-center text-sm font-bold transition ${pkg.featured ? 'bg-primary text-white shadow hover:bg-primary-dark' : 'border-2 border-primary text-primary hover:bg-primary hover:text-white'}`}>Get Started</a>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-muted">Want to add a website? Site build is a one-time fee added to any package. Your retainer rate stays the same. <a href="#website" class="font-semibold text-primary underline underline-offset-2 hover:text-primary-dark">See website pricing below →</a></p>
    </div>
  </section>

  <!-- GBP STANDALONE -->
  <section class="bg-white py-24" id="gbp">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Google Business Profile</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">The entry point. Most clients start here.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-muted">A fully optimized, actively managed GBP generates calls without ad spend. It's the highest-ROI local search asset for most local businesses — and most profiles are leaving more than half their potential on the table.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <article class="flex flex-col rounded-2xl border border-border-subtle bg-white p-8 shadow-sm">
          <div class="mb-1 inline-flex items-center gap-2">
            <span class="rounded-full border border-border-base px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-muted">One-time</span>
          </div>
          <h3 class="mt-3 font-heading text-2xl font-extrabold text-heading">{gbpOneTime.name}</h3>
          <div class="mt-2 flex items-baseline gap-1">
            <span class="font-heading text-5xl font-extrabold text-primary">${gbpOneTime.price}</span>
            <span class="text-sm text-body">one-time</span>
          </div>
          <p class="mt-1 text-xs text-muted">Delivery: {gbpOneTime.delivery}</p>
          <div class="my-5 h-px bg-border-subtle"></div>
          <p class="mb-5 text-sm leading-relaxed text-body">{gbpOneTime.description}</p>
          <ul class="flex-1 space-y-2.5 text-sm mb-6">
            {gbpOneTime.inclusions.map(inc => (
              <li class="flex items-start gap-2 text-body">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                {inc}
              </li>
            ))}
          </ul>
          {gbpOneTime.note && <p class="mb-6 rounded-xl bg-primary/5 border border-primary/20 px-4 py-3 text-xs text-primary font-medium">{gbpOneTime.note}</p>}
          <a href="/contact#book" class="block rounded-xl border-2 border-primary px-6 py-3.5 text-center text-sm font-bold text-primary transition hover:bg-primary hover:text-white">Get Started</a>
        </article>
        <article class="flex flex-col rounded-2xl border border-primary bg-secondary p-8 shadow-xl">
          <div class="mb-1 inline-flex items-center gap-2">
            <span class="rounded-full border border-white/20 px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-white/60">Ongoing management</span>
          </div>
          <h3 class="mt-3 font-heading text-2xl font-extrabold text-white">{gbpRecurring.name}</h3>
          <div class="mt-2 flex items-baseline gap-1">
            <span class="font-heading text-5xl font-extrabold text-white">${gbpRecurring.price}</span>
            <span class="text-sm text-white/50">/mo</span>
          </div>
          <p class="mt-1 text-xs text-white/40">{gbpRecurring.description}</p>
          <div class="my-5 h-px bg-white/10"></div>
          <ul class="flex-1 space-y-2.5 text-sm mb-8">
            {gbpRecurring.inclusions.map(inc => (
              <li class="flex items-start gap-2 text-white/75">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                {inc}
              </li>
            ))}
          </ul>
          <a href="/contact#book" class="block rounded-xl bg-primary px-6 py-3.5 text-center text-sm font-bold text-white shadow transition hover:bg-primary-dark">Get Started</a>
        </article>
      </div>
    </div>
  </section>

  <!-- SEO STANDALONE -->
  <section class="bg-background-subtle py-24 border-y border-border-subtle" id="seo">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Local SEO</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Build the asset that compounds month over month.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-muted">On-page, technical, citations, content, and local authority — built to rank in your market and grow continuously. On retainer, your site adds 10–20 new optimized pages per month, expanding your local footprint automatically.</p>
      </div>

      <!-- SEO One-Time -->
      <div class="mb-10 overflow-hidden rounded-2xl border border-border-subtle bg-white shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="p-8 md:border-r md:border-border-subtle">
            <span class="rounded-full border border-border-base px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-muted">One-time</span>
            <h3 class="mt-4 font-heading text-2xl font-extrabold text-heading">{seoOneTime.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="font-heading text-5xl font-extrabold text-primary">${seoOneTime.price}</span>
              <span class="text-sm text-body">one-time</span>
            </div>
            <p class="mt-1 text-xs text-muted">Delivery: {seoOneTime.delivery}</p>
            {seoOneTime.note && <p class="mt-4 rounded-xl bg-primary/5 border border-primary/20 px-4 py-3 text-xs text-primary font-medium">{seoOneTime.note}</p>}
            <a href="/contact#book" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-primary px-7 py-3.5 font-heading text-base font-bold text-white shadow transition hover:bg-primary-dark">Get Started →</a>
          </div>
          <div class="bg-background-subtle p-8">
            <p class="mb-4 text-xs font-bold uppercase tracking-widest text-muted">What's included</p>
            <ul class="space-y-2.5 text-sm">
              {seoOneTime.inclusions.map(inc => (
                <li class="flex items-start gap-2 text-body">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {inc}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- SEO Retainer Tiers -->
      <div class="mb-6 rounded-xl bg-primary/5 border border-primary/20 px-5 py-4 text-sm text-body">
        <strong class="text-heading">Every retainer includes:</strong> written strategy document and full foundation audit in the setup month. GBP management is not included in standalone SEO tiers — add it for $249/mo or choose a bundled package above.
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {seoTiers.map(tier => (
          <article class={`relative flex flex-col rounded-2xl border p-8 transition ${tier.featured ? 'border-primary bg-white shadow-xl ring-2 ring-primary/20' : 'border-border-subtle bg-white shadow-sm hover:border-primary/30 hover:shadow-md'}`}>
            {tier.featured && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-primary px-5 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow">Most Popular</span>
              </div>
            )}
            <h3 class="font-heading text-xl font-extrabold text-heading">{tier.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="font-heading text-4xl font-extrabold text-primary">${tier.price}</span>
              <span class="text-sm text-body">/mo</span>
            </div>
            <p class="mt-1 mb-5 text-xs text-muted">Setup month: ${tier.setupPrice}</p>
            <div class="h-px mb-5 bg-border-subtle"></div>
            <ul class="flex-1 space-y-2.5 text-sm mb-8">
              {tier.inclusions.map(inc => (
                <li class="flex items-start gap-2 text-body">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {inc}
                </li>
              ))}
            </ul>
            <a href="/contact#book" class={`block rounded-xl px-6 py-3.5 text-center text-sm font-bold transition ${tier.featured ? 'bg-primary text-white shadow hover:bg-primary-dark' : 'border-2 border-primary text-primary hover:bg-primary hover:text-white'}`}>Get Started</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WEBSITE BUILDS -->
  <section class="bg-white py-24" id="website">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Website Design & Build</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Built to rank from day one.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-muted">Every site built on Astro + Tailwind + Vercel — fast, schema-first, and structured around the service × city page architecture that dominates local search. Not a template. Not a page builder.</p>
      </div>
      <div class="mb-6 overflow-hidden rounded-xl border border-border-subtle bg-background-subtle px-6 py-4">
        <p class="text-sm text-body"><strong class="text-heading">Standard inclusions across all builds:</strong> LocalBusiness + Services schema, GA4, Google Search Console, click-to-call, contact form with reCAPTCHA, and full on-page SEO. Client provides logo, brand colors, service list, service areas, and 5–10 reviews.</p>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3 mb-12">
        {websiteBuilds.map(build => (
          <article class={`relative flex flex-col rounded-2xl border p-8 transition ${build.featured ? 'border-primary bg-white shadow-xl ring-2 ring-primary/20' : 'border-border-subtle bg-white shadow-sm hover:border-primary/30 hover:shadow-md'}`}>
            {build.featured && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-primary px-5 py-1.5 text-xs font-bold uppercase tracking-wider text-white shadow">Most Popular</span>
              </div>
            )}
            <h3 class="font-heading text-2xl font-extrabold text-heading">{build.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="font-heading text-5xl font-extrabold text-primary">${build.price}</span>
              <span class="text-sm text-body">one-time</span>
            </div>
            <div class="mt-2 flex gap-3">
              <span class="rounded-full bg-background-subtle border border-border-subtle px-2.5 py-0.5 text-xs font-semibold text-muted">{build.pages}</span>
              <span class="rounded-full bg-background-subtle border border-border-subtle px-2.5 py-0.5 text-xs font-semibold text-muted">{build.timeline}</span>
            </div>
            <div class="my-5 h-px bg-border-subtle"></div>
            <p class="mb-2 text-sm text-body">{build.description}</p>
            <p class="mb-5 text-xs text-muted italic">{build.bestFor}</p>
            <ul class="flex-1 space-y-2.5 text-sm mb-8">
              {build.inclusions.map(inc => (
                <li class="flex items-start gap-2 text-body">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {inc}
                </li>
              ))}
            </ul>
            <a href="/contact#book" class={`block rounded-xl px-6 py-3.5 text-center text-sm font-bold transition ${build.featured ? 'bg-primary text-white shadow hover:bg-primary-dark' : 'border-2 border-primary text-primary hover:bg-primary hover:text-white'}`}>Start Your Build</a>
          </article>
        ))}
      </div>

      <!-- WaS -->
      <div class="rounded-2xl border border-border-subtle bg-background-subtle p-8">
        <div class="mb-6">
          <p class="mb-1 text-xs font-bold uppercase tracking-widest text-primary">Website as a Service</p>
          <h3 class="font-heading text-2xl font-extrabold text-heading">Don't want to own or maintain the site?</h3>
          <p class="mt-2 text-base text-muted">We handle hosting, updates, and ongoing additions. A high-performance local site without managing any of it.</p>
        </div>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
          {websiteAsAService.map(was => (
            <div class="rounded-xl border border-border-subtle bg-white p-6 shadow-sm">
              <h4 class="font-heading text-lg font-bold text-heading">{was.name}</h4>
              <div class="mt-1 flex items-baseline gap-1">
                <span class="font-heading text-3xl font-extrabold text-primary">${was.price}</span>
                <span class="text-sm text-body">/mo</span>
              </div>
              <div class="my-4 h-px bg-border-subtle"></div>
              <ul class="space-y-2 text-sm">
                {was.inclusions.map(inc => (
                  <li class="flex items-start gap-2 text-body">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    {inc}
                  </li>
                ))}
              </ul>
              <a href="/contact#book" class="mt-6 block rounded-xl border-2 border-primary px-5 py-2.5 text-center text-sm font-bold text-primary transition hover:bg-primary hover:text-white">Get Started</a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AUDITS -->
  <section class="bg-background-subtle py-24 border-y border-border-subtle" id="audits">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Start with a real look at where you stand</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Every engagement starts with an audit.</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {audits.map(audit => (
          <article class={`flex flex-col rounded-2xl border p-8 shadow-sm transition ${audit.price === 0 ? 'border-primary/30 bg-white' : 'border-border-subtle bg-white hover:border-primary/30 hover:shadow-md'}`}>
            <div class="mb-3 flex items-start justify-between">
              <span class={`rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider ${audit.price === 0 ? 'bg-primary text-white' : 'border border-border-base text-muted'}`}>{audit.price === 0 ? 'Free' : 'Paid'}</span>
            </div>
            <h3 class="font-heading text-2xl font-extrabold text-heading">{audit.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              {audit.price === 0
                ? <span class="font-heading text-4xl font-extrabold text-primary">Free</span>
                : <><span class="font-heading text-4xl font-extrabold text-primary">${audit.price}</span><span class="text-sm text-body">one-time</span></>
              }
            </div>
            {audit.delivery && <p class="mt-1 text-xs text-muted">Delivery: {audit.delivery}</p>}
            <div class="my-5 h-px bg-border-subtle"></div>
            <p class="mb-5 text-sm leading-relaxed text-body">{audit.description}</p>
            <ul class="flex-1 space-y-2.5 text-sm mb-6">
              {audit.inclusions.map(inc => (
                <li class="flex items-start gap-2 text-body">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {inc}
                </li>
              ))}
            </ul>
            {audit.note && <p class="mb-6 rounded-xl bg-primary/5 border border-primary/20 px-4 py-3 text-xs text-primary font-medium">{audit.note}</p>}
            <a href="/contact#book" class={`block rounded-xl px-6 py-3.5 text-center text-sm font-bold transition ${audit.price === 0 ? 'bg-primary text-white shadow hover:bg-primary-dark' : 'border-2 border-primary text-primary hover:bg-primary hover:text-white'}`}>
              {audit.price === 0 ? 'Request Your Free Audit →' : 'Get Started'}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AI VISIBILITY -->
  <section class="bg-secondary py-24" id="ai-visibility">
    <div class="mx-auto max-w-5xl px-6">

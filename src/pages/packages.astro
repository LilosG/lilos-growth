---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Pricing | Local SEO & Website Plans for Home Service Businesses";
export const description =
  "Simple, transparent pricing for home service businesses. Three monthly retainers covering GBP management, Local SEO, and content — plus a one-time site build. Month-to-month, no contracts.";

const metadata = { title, description };

const faqs = [
  { q: "Do I have to sign a long-term contract?", a: "Never. All plans are month-to-month. Stay because it's working." },
  { q: "Can I upgrade, downgrade, or cancel?", a: "Yes — switch plans or cancel anytime with no penalty." },
  { q: "What's included in GBP management across all plans?", a: "Every retainer includes full Google Business Profile management: weekly posts, EXIF-optimized photos, review replies, Q&A monitoring, category and services alignment, and monthly reporting." },
  { q: "Do you offer custom packages?", a: "Yes. If your situation doesn't fit a standard tier, reach out and we'll scope something specific to your goals and market." },
  { q: "Is the site build a separate purchase?", a: "Yes. The $1,200 site build is a one-time project. It can be paired with any retainer or purchased standalone. A $199/mo maintenance plan is available if you want hosting, updates, and support ongoing." },
  { q: "How quickly will I see results?", a: "Most clients see measurable gains — more GBP calls, improved rankings, more form submissions — within 30 to 60 days. We prioritize quick wins from day one." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const retainers = [
  {
    name: "Foundation",
    price: "$599",
    desc: "The right starting point. GBP fully managed plus steady on-page SEO progress each month.",
    features: [
      "Full GBP management — posts, photos, reviews, Q&A",
      "On-page fixes — titles, metas, H1s, internal links, schema",
      "Up to 5 pages/mo — service or location pages",
      "Citation cleanup and core directory listings",
      "Monthly performance report",
    ],
    cta: "Get Started",
    evt: "cta_pricing_foundation",
    featured: false,
  },
  {
    name: "Growth",
    price: "$999",
    desc: "Higher content volume, backlinks, and AEO schema — built for businesses ready to compete aggressively in local search.",
    features: [
      "Everything in Foundation",
      "Up to 5 pages/mo + 2 blog posts",
      "2–3 local backlinks/mo",
      "AI search visibility — AEO schema, FAQ/HowTo, entity optimization",
      "Quarterly competitor snapshot + heatmap",
      "Monthly report + 45-min strategy call",
    ],
    cta: "Get Started",
    evt: "cta_pricing_growth",
    featured: true,
  },
  {
    name: "Authority",
    price: "$1,499",
    desc: "Maximum output for businesses that want to dominate their market. High content volume, aggressive link acquisition, and priority access.",
    features: [
      "Everything in Growth",
      "Up to 10 pages/mo + 4 blog posts",
      "4–6 local backlinks/mo",
      "Quarterly AI Visibility Audit included",
      "Bi-weekly check-ins + priority turnaround",
    ],
    cta: "Get Started",
    evt: "cta_pricing_authority",
    featured: false,
  },
];
---

<Layout title={title} description={description} metadata={metadata} schema={[faqSchema]}
  breadcrumbs={[{ name: "Home", item: "https://lilosgrowth.com/" }, { name: "Pricing", item: "https://lilosgrowth.com/packages" }]}>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-secondary pb-24 pt-20" aria-label="Pricing hero">
    <div class="pointer-events-none absolute right-0 top-0 h-[500px] w-[500px] translate-x-1/3 -translate-y-1/4 rounded-full opacity-[0.10]" style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-primary">Pricing</p>
      <h1 class="mb-5 font-heading text-5xl font-extrabold leading-tight text-white md:text-6xl">Simple, Honest Plans</h1>
      <p class="mx-auto max-w-xl text-lg font-medium text-white/65">Month-to-month. No setup fees. No contracts. Built for home service businesses that want real results.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-6 text-sm text-white/40">
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>GBP management included in every plan</span>
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Cancel anytime</span>
        <span class="flex items-center gap-2"><svg class="h-4 w-4 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>Results in 30–60 days</span>
      </div>
    </div>
  </section>

  <!-- MONTHLY RETAINERS -->
  <section id="plans" class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Monthly Retainers</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Pick your growth level</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-muted">All plans include GBP management. Pick the level of SEO and content execution that fits your goals.</p>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {retainers.map((plan) => (
          <article class:list={[
            "relative flex flex-col rounded-2xl p-8 transition duration-200",
            plan.featured
              ? "border-2 border-primary bg-white shadow-2xl shadow-primary/10"
              : "border border-border-subtle bg-white shadow-sm hover:border-primary/30 hover:shadow-md"
          ]}>
            {plan.featured && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                <span class="rounded-full bg-primary px-4 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-lg">Most Popular</span>
              </div>
            )}
            <h3 class="font-heading text-xl font-bold text-heading">{plan.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class="font-heading text-4xl font-extrabold text-primary">{plan.price}</span>
              <span class="text-sm text-body">/mo</span>
            </div>
            <p class="mt-3 text-sm text-body">{plan.desc}</p>
            <div class="my-5 h-px bg-border-subtle"></div>
            <ul class="flex-1 space-y-2.5 text-sm text-body">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="/contact#book"
              data-evt={plan.evt}
              class:list={[
                "mt-8 block rounded-xl px-6 py-3 text-center text-sm font-semibold transition",
                plan.featured
                  ? "bg-primary text-white shadow hover:bg-primary-dark"
                  : "border-2 border-primary text-primary hover:bg-primary hover:text-white"
              ]}
            >
              {plan.cta}
            </a>
          </article>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-body">Not sure which plan fits? <a href="/contact#book" class="font-semibold text-primary underline underline-offset-2 hover:text-primary-dark">Book a free 15-minute audit</a> and we'll recommend the right starting point.</p>
    </div>
  </section>

  <!-- WEBSITE BUILD -->
  <section class="bg-background-cream py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">One-Time Project</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">Website Build</h2>
        <p class="mx-auto mt-4 max-w-xl text-base text-muted">Own your site outright. Pair with any retainer or purchase standalone.</p>
      </div>
      <div class="overflow-hidden rounded-3xl border border-border-subtle bg-white shadow-lg">
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="p-10 md:border-r md:border-border-subtle">
            <div class="flex items-baseline gap-2">
              <span class="font-heading text-5xl font-extrabold text-primary">$1,200</span>
              <span class="text-sm text-body">one-time</span>
            </div>
            <p class="mt-3 text-sm text-body">Full site built on Astro and Tailwind CSS — the same stack powering our client sites. Fast, static, SEO-native, and structured to rank from day one.</p>
            <div class="my-5 h-px bg-border-subtle"></div>
            <ul class="space-y-2.5 text-sm text-body">
              {[
                "15–20 pages — home, services, city pages, blog, contact",
                "City × service money page matrix",
                "Schema markup, GA4, click-to-call, form tracking",
                "Core Web Vitals optimized — sub-second load times",
                "7–10 business day delivery",
              ].map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href="/contact#book" data-evt="cta_pricing_build" class="mt-8 inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-3.5 font-heading text-base font-bold text-white shadow-lg transition hover:bg-primary-dark">
              Start Your Build
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"/></svg>
            </a>
          </div>
          <div class="bg-background-cream p-10">
            <h3 class="mb-1 font-heading text-lg font-bold text-heading">Add Maintenance</h3>
            <div class="flex items-baseline gap-2">
              <span class="font-heading text-3xl font-extrabold text-primary">$199</span>
              <span class="text-sm text-body">/mo</span>
            </div>
            <p class="mt-3 text-sm text-body">Keep your site fast, secure, and up to date without lifting a finger.</p>
            <ul class="mt-5 space-y-2.5 text-sm text-body">
              {[
                "Hosting, security monitoring, and uptime",
                "Up to 5 minor edits/mo via support ticket",
                "Analytics and lead tracking maintained",
                "Month-to-month — no long-term commitment",
              ].map((f) => (
                <li class="flex items-start gap-2">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-5xl px-6">
      <p class="mb-3 text-center text-xs font-bold uppercase tracking-widest text-primary">Verified client results</p>
      <h2 class="mb-12 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">What we delivered in 30 days</h2>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="rounded-2xl bg-secondary p-8 text-center">
          <div class="font-heading text-6xl font-extrabold tracking-tight text-primary">+900%</div>
          <p class="mt-3 text-sm font-bold text-white">Keyword growth</p>
          <p class="mt-1 text-xs text-white/50">5 &rarr; 50 ranked keywords in 30 days</p>
        </div>
        <div class="rounded-2xl bg-primary p-8 text-center">
          <div class="font-heading text-6xl font-extrabold tracking-tight text-white">3&times;</div>
          <p class="mt-3 text-sm font-bold text-white">GBP calls</p>
          <p class="mt-1 text-xs text-white/70">7 &rarr; 21 calls — first month post-launch</p>
        </div>
        <div class="rounded-2xl bg-secondary p-8 text-center">
          <div class="font-heading text-6xl font-extrabold tracking-tight text-primary">+350%</div>
          <p class="mt-3 text-sm font-bold text-white">Web leads</p>
          <p class="mt-1 text-xs text-white/50">3/mo avg &rarr; 18 leads in 3 weeks</p>
        </div>
      </div>
      <p class="mt-8 text-center text-sm">
        <a href="/results/wheyland-electric" class="font-semibold text-primary underline underline-offset-4 hover:text-primary-dark">See the full Wheyland Electric case study &rarr;</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-background-cream py-24" id="faq">
    <div class="mx-auto max-w-3xl px-6">
      <p class="mb-3 text-center text-xs font-bold uppercase tracking-widest text-primary">FAQ</p>
      <h2 class="mb-12 text-center font-heading text-4xl font-extrabold text-heading md:text-5xl">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-border-base bg-white shadow-sm transition hover:border-primary/30">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-heading text-base font-bold text-heading">
              {faq.q}
              <svg class="h-5 w-5 flex-shrink-0 text-primary transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-6 text-base leading-relaxed text-body">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="relative overflow-hidden bg-secondary py-32" aria-label="Final CTA">
    <div class="pointer-events-none absolute right-0 top-0 h-[500px] w-[500px] translate-x-1/3 -translate-y-1/4 rounded-full opacity-[0.10]" style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <h2 class="mb-6 font-heading text-5xl font-extrabold leading-tight text-white md:text-6xl">Not sure where<br /><span class="text-primary">to start?</span></h2>
      <p class="mb-10 text-xl font-medium text-white/70">Book a free 15-minute audit. We'll review your GBP and site, identify the biggest gaps, and recommend the right plan — no pitch, just findings.</p>
      <a href="/contact#book" data-evt="cta_pricing_final" class="inline-flex items-center gap-2.5 rounded-full bg-primary px-12 py-5 font-heading text-xl font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.45)] transition hover:bg-primary-dark">
        Book My Free Audit
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"/></svg>
      </a>
    </div>
  </section>

</Layout>

  <!-- FAQ -->
  <section class="border-t border-gray-100 bg-background-cream py-16" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Frequently Asked Questions
      </h2>
      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <Card variant="elevated">
              <h3 class="mb-2 font-heading text-base font-bold text-heading md:text-lg">

---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Pricing | Local SEO & Website Plans for Home Service Businesses";
export const description =
  "Simple, transparent pricing for home service businesses. Three monthly retainers covering GBP management, Local SEO, and content — plus a one-time site build. Month-to-month, no contracts.";

const metadata = { title, description };

const faqs = [
  {
    question: "Do I have to sign a long-term contract?",
    answer: "Never. All plans are month-to-month. Stay because it's working.",
  },
  {
    question: "Can I upgrade, downgrade, or cancel?",
    answer: "Yes — switch plans or cancel anytime with no penalty.",
  },
  {
    question: "What's included in GBP management across all plans?",
    answer: "Every retainer includes full Google Business Profile management: weekly posts, EXIF-optimized photos, review replies, Q&A monitoring, category and services alignment, and monthly reporting.",
  },
  {
    question: "Do you offer custom packages?",
    answer: "Yes. If your situation doesn't fit a standard tier, reach out and we'll scope something specific to your goals and market.",
  },
  {
    question: "Is the site build a separate purchase?",
    answer: "Yes. The $1,200 site build is a one-time project. It can be paired with any retainer or purchased standalone. A $199/mo maintenance plan is available if you want hosting, updates, and support ongoing.",
  },
  {
    question: "How quickly will I see results?",
    answer: "Most clients see measurable gains — more GBP calls, improved rankings, more form submissions — within 30 to 60 days. We prioritize quick wins from day one.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  metadata={metadata}
  schema={[faqSchema]}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Pricing", item: "https://lilosgrowth.com/packages" },
  ]}
>
  <!-- HERO -->
  <section class="relative flex min-h-[300px] items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-12 pt-12">
    <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">Pricing</p>
      <h1 class="mb-4 font-heading text-3xl font-extrabold text-white md:text-5xl">
        Simple, Honest Plans
      </h1>
      <p class="mx-auto max-w-xl text-base font-medium text-white/85 md:text-lg">
        Month-to-month. No setup fees. No contracts. Built for home service businesses that want real results.
      </p>
    </div>
  </section>

  <!-- RETAINER PLANS -->
  <section id="plans" class="border-t border-gray-100 bg-white py-20">

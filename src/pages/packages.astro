---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>Plans & Pricing | Lilos Growth Digital Marketing Packages</title>
    <meta
      name="description"
      content="Transparent, bundled marketing packages for home service businesses. Choose from GBP, SEO, Web Design, or bundle for more value. No contracts. Real results."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- PAGE HERO -->
    <section class="bg-[#253242] min-h-[340px] flex items-center justify-center pt-10 pb-10 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl mx-auto w-full px-4 text-center">
        <h1 class="text-5xl md:text-6xl font-heading text-white font-extrabold mb-4">Plans and Pricing</h1>
        <p class="text-xl text-white/80 mb-2 font-medium">
          Transparent, flexible marketing for home service pros.<br class="hidden md:block" /> Choose the plan that matches
          your goals.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a
            href="#packages"
            class="inline-flex items-center px-8 py-3 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
          >
            View Packages
          </a>
          <a
            href="#faq"
            class="inline-flex items-center px-8 py-3 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
          >
            Frequently Asked Questions
          </a>
        </div>
      </div>
    </section>

    <!-- PACKAGES GRID -->
    <section id="packages" class="py-24 bg-bluelight border-t border-gray-100 shadow-xl">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
          Entry-Level & Bundled Packages
          <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-xl text-body mb-14 text-center font-medium max-w-2xl mx-auto">
          Choose from essential services or bundled packages for the best value. No contracts. No setup fees. Just
          results.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">
          <!-- Website as a Service -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 flex flex-col p-8 items-start">
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-3 font-semibold"
              >Get Online Fast</span
            >
            <h3 class="text-2xl font-heading text-heading font-bold mb-2">Website as a Service</h3>
            <div class="text-4xl font-bold text-primary mb-2">
              $199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="mb-4 text-body">For the business that just wants a great looking website and support.</p>
            <ul class="text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Responsive, modern web design</li>
              <li>Content & image development</li>
              <li>Unlimited edits & easy updates</li>
              <li>Month-to-month support</li>
              <li>Secure hosting & fast launch</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>

          <!-- GBP/Maps Only -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 flex flex-col p-8 items-start">
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-3 font-semibold"
              >Maps Pack Rankings</span
            >
            <h3 class="text-2xl font-heading text-heading font-bold mb-2">Google Business Profile Package</h3>
            <div class="text-4xl font-bold text-primary mb-2">
              $399<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="mb-4 text-body">For the business focused on ranking in Google Maps.</p>
            <ul class="text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Full GBP setup & optimization</li>
              <li>Ongoing monthly management</li>
              <li>Reviews, posts & photos</li>
              <li>Reputation guidance</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>

          <!-- SEO Only -->
          <div class="bg-white rounded-2xl shadow border border-gray-100 flex flex-col p-8 items-start">
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-3 font-semibold"
              >Grow Organic Leads</span
            >
            <h3 class="text-2xl font-heading text-heading font-bold mb-2">Local SEO Package</h3>
            <div class="text-4xl font-bold text-primary mb-2">
              $699<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="mb-4 text-body">For the business that wants higher rankings and organic leads.</p>
            <ul class="text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Local keyword research & tracking</li>
              <li>On-page SEO & content</li>
              <li>Citation building/cleanup</li>
              <li>Google Map ranking</li>
              <li>Weekly blog/content posting</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>
        </div>

        <!-- BUNDLES (highlighted) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <!-- SEO + GBP BUNDLE -->
          <div class="bg-white rounded-2xl shadow-lg border-2 border-primary flex flex-col p-10 items-start relative">
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-bold px-4 py-1 rounded-2xl shadow"
            >
              Best Value
            </div>
            <span class="block text-sm bg-[#f56b2a]/10 text-[#f56b2a] px-4 py-1 rounded-full mb-3 font-semibold"
              >SEO & Maps Pack Bundle</span
            >
            <h3 class="text-2xl font-heading text-heading font-bold mb-2">Local SEO + GBP Bundle</h3>
            <div class="text-4xl font-bold text-primary mb-2">
              $999<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <p class="mb-4 text-body">The perfect package for service businesses ready for serious growth.</p>
            <ul class="text-body text-base mb-8 space-y-1 list-disc list-inside">
              <li>Everything from GBP & Local SEO</li>
              <li>Double the posts, more reviews</li>
              <li>Advanced Map Pack & ranking tactics</li>
              <li>Monthly strategy/report call</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition w-full text-center"
            >
              Get Started
            </a>
          </div>

          <!-- ALL-IN BUNDLE -->
          <div class="bg-primary rounded-2xl shadow-lg border-2 border-primary flex flex-col p-10 items-start relative">
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 bg-white text-primary text-xs font-bold px-4 py-1 rounded-2xl shadow"
            >
              All-In-One Bundle
            </div>
            <span class="block text-sm bg-white/20 text-white px-4 py-1 rounded-full mb-3 font-semibold"
              >Website + SEO + GBP</span
            >
            <h3 class="text-2xl font-heading text-white font-bold mb-2">Website + Local SEO + GBP</h3>
            <div class="text-4xl font-bold text-white mb-2">
              $1499<span class="text-lg font-normal text-white/70">/mo</span>
            </div>
            <p class="mb-4 text-white/90">
              Everything you need: a modern site, organic rankings, and top-3 map pack placement—done for you.
            </p>
            <ul class="text-white/90 text-base mb-8 space-y-1 list-disc list-inside">
              <li>Modern site build or redesign</li>
              <li>All Local SEO & GBP services</li>
              <li>Full site hosting & editing</li>
              <li>Premium support, strategy & analytics</li>
              <li>Everything above, bundled for less</li>
            </ul>
            <a
              href="#contact"
              class="mt-auto px-6 py-3 rounded-xl bg-white text-primary font-heading font-semibold text-lg shadow hover:bg-bluelight transition w-full text-center"
            >
              Get Started
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section class="py-20 bg-white border-t border-gray-100" id="faq">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center relative">
          Frequently Asked Questions
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="space-y-6">
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              Do I have to sign a long-term contract?
            </h3>
            <p class="text-body text-base">
              Never. All plans are month-to-month. Stay only as long as you love the results!
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Can I upgrade, downgrade, or cancel?</h3>
            <p class="text-body text-base">
              Yes—switch packages any time, and cancel with no penalty. We're here to make your growth easy.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Do you offer custom packages?</h3>
            <p class="text-body text-base">
              Absolutely. If you need something different, <a href="#contact" class="text-primary underline"
                >contact us</a
              > and we’ll build a solution for your business.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
            <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
              What’s included in the “Website as a Service” package?
            </h3>
            <p class="text-body text-base">
              Everything to get online: fast, modern site, ongoing edits, secure hosting, and top-notch support.
            </p>
          </div>
        </div>
      </div>
    </section>
  </Layout>


</html>

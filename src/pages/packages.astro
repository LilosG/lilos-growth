          </div>
        </div>
      </div>

      <!-- Bundles -->
      <div>
        <h2 class="font-heading text-heading text-3xl md:text-4xl font-extrabold mb-3 text-center">Bundles</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <div
            class="bg-white rounded-2xl shadow-2xl border-2 border-primary flex flex-col p-8 hover:shadow-3xl transition"
          >
            <h3 class="font-heading text-heading text-2xl font-bold mb-2">GBP + SEO Essentials</h3>
            <div class="text-4xl font-heading text-primary font-bold mb-4">
              $699<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="font-body text-body text-base space-y-2 list-disc list-inside mb-6">
              <li>Everything in GBP Starter + Local SEO Essentials</li>
              <li>Unified reporting + strategy</li>
            </ul>
            <a
              href="#contact"
              class="px-6 py-3 rounded-xl bg-primary text-white font-heading font-semibold text-lg shadow hover:bg-secondary transition text-center"

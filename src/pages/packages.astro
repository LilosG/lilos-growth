---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Marketing Packages for Home Service Businesses | Lilos Growth';
export const description =
  'Transparent monthly plans for Local SEO, Google Business Profile management, and Website-as-a-Service. No contracts — real results.';

// Breadcrumbs + OfferCatalog schema mapped to visible pricing
const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Packages', item: '/packages' },
];

const offerCatalog = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Service Packages',
  itemListElement: [
    {
      '@type': 'Offer',
      price: 199,
      priceCurrency: 'USD',
      url: 'https://lilosgrowth.com/services/google-business-profile-optimization',
      availability: 'https://schema.org/InStock',
      itemOffered: { '@type': 'Service', name: 'Google Business Profile — Base: Profile Management' },
    },
    {
      '@type': 'Offer',
      price: 499,
      priceCurrency: 'USD',
      url: 'https://lilosgrowth.com/services/local-seo',
      availability: 'https://schema.org/InStock',
      itemOffered: { '@type': 'Service', name: 'Local SEO — Base: Growth Essentials' },
    },
    {
      '@type': 'Offer',
      price: 250,
      priceCurrency: 'USD',
      url: 'https://lilosgrowth.com/services/web-design',
      availability: 'https://schema.org/InStock',
      itemOffered: { '@type': 'Service', name: 'Website as a Service — Base: Website Essentials' },
    },
    {
      '@type': 'Offer',
      price: 799,
      priceCurrency: 'USD',
      url: 'https://lilosgrowth.com/services/local-seo',
      availability: 'https://schema.org/InStock',
      itemOffered: { '@type': 'Service', name: 'Local SEO + GBP Management — Base: Complete Local Presence' },
    },
  ],
};
---

<Layout {title} {description} breadcrumbs={breadcrumbs} schema={[offerCatalog]}>
  <!-- Your original Packages page content goes here (unchanged UI). -->
  <!-- If you already have this file’s markup, keep it. The only addition is breadcrumbs + schema via props above. -->
  <slot />
</Layout>

---
// FILE: src/pages/packages.astro
import Layout from "~/layouts/PageLayout.astro";

export const title = "Plans & Pricing | Websites, Local SEO & GBP";
export const description =
  "Transparent, no-contract pricing for Google Business Profile management, Local SEO, websites, and Website-as-a-Service. Built for home-service pros, month-to-month, no surprises.";
---

<Layout title={title} description={description}>
  <!-- HERO (unchanged style) -->
  <section
    class="relative flex min-h-[340px] items-center justify-center overflow-hidden bg-secondary pb-14 pt-14"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light">
    </div>
    <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
      <h1 class="mb-4 font-heading text-5xl font-extrabold text-white drop-shadow md:text-6xl">
        Plans & Pricing
      </h1>
      <p class="mb-3 font-body text-xl font-medium text-white/90">
        Month-to-month. No setup fees. Built for home-service pros.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="#packages"
          class="inline-flex items-center rounded-2xl bg-primary px-8 py-3 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
          data-track
          data-track-event="view_packages">View Packages</a
        >
        <a
          href="#faq"
          class="inline-flex items-center rounded-2xl bg-secondary px-8 py-3 font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary-hover"
          data-track
          data-track-event="view_faq">Frequently Asked Questions</a
        >
      </div>
    </div>
  </section>

  <!-- TRUST STRIP (unchanged sections) -->
  <section class="border-t border-gray-100 bg-[#f7fafd] py-16">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-5 font-heading text-3xl font-extrabold text-heading md:text-4xl">
        How Our Process Works
      </h2>
      <p class="mx-auto mb-12 max-w-2xl font-body text-lg text-body">
        Straightforward onboarding, clear deliverables, and transparent reporting.
      </p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
        <div class="rounded-2xl bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-bold text-heading">Free Consultation</h3>
          <p class="font-body text-base text-body">Tailored audit + growth plan—no obligation.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-bold text-heading">Custom Plan</h3>
          <p class="font-body text-base text-body">
            Pick a package or we’ll tailor one for goals & budget.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-bold text-heading">Launch & Optimize</h3>
          <p class="font-body text-base text-body">We implement, improve, and report—end to end.</p>
        </div>
        <div class="rounded-2xl bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-bold text-heading">Grow & Report</h3>
          <p class="font-body text-base text-body">Monthly reports + check-ins to keep momentum.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="border-t border-gray-100 bg-white py-10">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h2 class="mb-6 font-heading text-2xl font-extrabold text-heading md:text-3xl">
        Who We Help
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Plumbers</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >HVAC</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Electricians</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Roofers</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Pest Control</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Landscaping</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Cleaning</span
        >
        <span
          class="rounded-full bg-bluelight px-5 py-2 font-heading text-base font-medium text-heading shadow"
          >Other Pros</span
        >
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-[#f7fafd] py-16">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <h2 class="mb-10 font-heading text-3xl font-extrabold text-heading md:text-4xl">
        Why Choose Lilos Growth?
      </h2>
      <div class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-100 bg-white p-10 shadow">
          <h3 class="mb-3 font-heading text-xl font-bold text-heading">Home-Service Specialists</h3>
          <p class="font-body text-base text-body">
            Niche focus = faster wins and clearer playbooks.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-10 shadow">
          <h3 class="mb-3 font-heading text-xl font-bold text-heading">Month-to-Month</h3>
          <p class="font-body text-base text-body">No contracts. Stay only if we’re delivering.</p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-10 shadow">
          <h3 class="mb-3 font-heading text-xl font-bold text-heading">Done-for-You</h3>
          <p class="font-body text-base text-body">
            We handle updates, optimizations, reviews & reporting.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section id="packages" class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-7xl space-y-16 px-4">
      <!-- GBP (Google Business Profile) -->
      <div>
        <h2 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
          Google Business Profile (GBP)
        </h2>
        <p class="mx-auto mb-8 max-w-3xl text-center font-body text-lg text-body">
          Comprehensive management to win the Map Pack and convert more calls.
        </p>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
          <!-- Starter -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-bluelight p-8 shadow-xl transition hover:shadow-2xl"
          >
            <span
              class="mb-3 block rounded-full bg-primary/10 px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-primary"
              >Best for getting established</span
            >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Starter</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>Full GBP setup/optimization + category & services alignment</li>
              <li>
                Posts: <strong>6/mo</strong> &nbsp;•&nbsp; Photos: <strong>6/mo</strong> (EXIF-optimized
                names, alt text)
              </li>
              <li>Review replies <strong>up to 30/mo</strong>; Q&amp;A weekly</li>
              <li>Services/Products refresh <strong>quarterly</strong></li>
              <li>Citation cleanup <strong>quarterly</strong>; monthly performance report</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Get Started</a
            >
          </div>
          <!-- Growth -->
          <div
            class="relative flex flex-col rounded-2xl border-2 border-primary bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 rounded-2xl bg-primary px-4 py-1 font-heading text-xs font-bold text-white shadow"
            >
              Most Popular
            </div>
            <span
              class="mb-3 block rounded-full bg-primary/10 px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-primary"
              >Includes everything in Starter</span
            >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Growth</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $399<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>
                Posts: <strong>~3/week</strong> &nbsp;•&nbsp; Fresh photos ongoing (EXIF-optimized)
              </li>
              <li>Review replies: <strong>no cap</strong> + proactive requests</li>
              <li>Services/Products refresh <strong>monthly</strong></li>
              <li>Ongoing citation management (top platforms + corrections)</li>
              <li>Quarterly heatmap & competitor snapshot; monthly report + 30-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Get Started</a
            >
          </div>
        </div>
      </div>

      <!-- Local SEO -->
      <div>
        <h2 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
          Local SEO (Single Location)
        </h2>
        <p class="mx-auto mb-8 max-w-3xl text-center font-body text-lg text-body">
          On-page, technical, citations, and local authority building—built for service areas.
        </p>

        <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
          <!-- Essentials -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-bluelight p-8 shadow-xl transition hover:shadow-2xl"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Essentials</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $499<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>
                <strong>Up to 5 pages</strong> + <strong>5 blog posts</strong> per month (≈750–1,000
                words)
              </li>
              <li>
                On-page & technical fixes batched monthly (titles, metas, H1/H2, internal links,
                schema basics)
              </li>
              <li>Citations: 10–20 initial, then 5–10/mo</li>
              <li>Monthly report + 30-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Get Started</a
            >
          </div>

          <!-- Growth -->
          <div
            class="relative flex flex-col rounded-2xl border-2 border-primary bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 rounded-2xl bg-primary px-4 py-1 font-heading text-xs font-bold text-white shadow"
            >
              Best Value
            </div>
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Growth</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $799<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li><strong>Up to 10 pages</strong> + <strong>10 blog posts</strong> per month</li>
              <li>2–4 local backlinks/mo (assoc/partner/sponsor/guest)</li>
              <li>Core Web Vitals, schema & crawl prioritization</li>
              <li>Ongoing citations; quarterly heatmap & competitor review</li>
              <li>Monthly report + 45-min call</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Get Started</a
            >
          </div>

          <!-- Pro -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Pro</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $1,199<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li><strong>Up to 20 pages</strong> + <strong>10 blog posts</strong> per month</li>
              <li>4–6 local backlinks/mo; conversion testing on top pages</li>
              <li>Bi-weekly check-ins</li>
              <li><em>No rollovers.</em></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Request Pro</a
            >
          </div>
        </div>
      </div>

      <!-- Websites (One-time builds) -->
      <div>
        <h2 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
          Websites (One-Time Builds)
        </h2>
        <p class="mx-auto mb-8 max-w-3xl text-center font-body text-lg text-body">
          Own your site outright. Launch quickly with conversion-ready pages.
        </p>

        <div class="grid grid-cols-1 gap-10 md:grid-cols-3">
          <!-- Launch Lite -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-bluelight p-8 shadow-xl transition hover:shadow-2xl"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Launch Lite</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $499<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>
                ≈ <strong>10 pages</strong>: Home, 3 services, About/Contact, + core supporting
                pages
              </li>
              <li>Form + click-to-call; basic schema</li>
              <li><strong>3–5 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Start Website</a
            >
          </div>

          <!-- Starter -->
          <div
            class="relative flex flex-col rounded-2xl border-2 border-primary bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <div
              class="absolute -top-5 left-1/2 -translate-x-1/2 rounded-2xl bg-primary px-4 py-1 font-heading text-xs font-bold text-white shadow"
            >
              Popular
            </div>
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Starter</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $750<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li><strong>15 pages</strong>: Home + 9 service/city pages + supporting pages</li>
              <li>Titles/metas/H1–H2; internal link scaffold; stock library</li>
              <li><strong>5–7 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Start Website</a
            >
          </div>

          <!-- Standard -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-white p-8 shadow-xl transition hover:shadow-2xl"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Standard</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $1,500<span class="text-lg font-normal text-gray-500"> one-time</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li>≈ <strong>25 pages</strong></li>
              <li>Enhanced schema (LocalBusiness + Services)</li>
              <li>Conversion blocks (badges, FAQs, reviews)</li>
              <li><strong>10–14 business-day launch</strong></li>
            </ul>
            <a
              href="#contact"
              class="mt-auto rounded-xl bg-primary px-6 py-3 text-center font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary"
              >Start Website</a
            >
          </div>
        </div>

        <p class="mx-auto mt-4 max-w-3xl text-center text-sm text-body/80">
          Global website notes: client supplies branding/services/service areas/5–10 reviews;
          premium stock billed at cost; hosting not included (WaS covers hosting/updates).
        </p>
      </div>

      <!-- Website-as-a-Service (WaS) -->
      <div>
        <h2 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
          Website-as-a-Service (WaS)
        </h2>
        <p class="mx-auto mb-8 max-w-3xl text-center font-body text-lg text-body">
          Subscription website with hosting, updates, and ongoing support.
        </p>
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
          <!-- WaS Base -->
          <div
            class="flex flex-col rounded-2xl border border-gray-100 bg-bluelight p-8 shadow-xl transition hover:shadow-2xl"
          >
            <h3 class="mb-2 font-heading text-2xl font-bold text-heading">Base</h3>
            <div class="mb-4 font-heading text-4xl font-bold text-primary">
              $250<span class="text-lg font-normal text-gray-500">/mo</span>
            </div>
            <ul class="mb-8 list-inside list-disc space-y-2 font-body text-base text-body">
              <li><strong>Up to 5 minor updates/mo</strong></li>
              <li>≤ 1 new page/mo</li>
            </ul>

---
import Layout from "~/layouts/PageLayout.astro";
import IncludePackagesPrimary from "~/components/includes/IncludePackagesPrimary.astro";
import IncludePackagesSecondary from "~/components/includes/IncludePackagesSecondary.astro";

export const title = "Plans Preview";
export const description = "Reusing homepage pricing/service cards exactly as-is on another page.";
export const metadata = { title, description };
---

<Layout title={title} description={description} metadata={metadata}>
  <section class="py-8">
    <div class="mx-auto max-w-4xl px-4">
      <h1 class="text-3xl font-bold text-heading">Plans Preview</h1>
      <p class="mt-2 text-body">These are the exact homepage sections reused with zero changes.</p>
    </div>
  </section>

  <!-- Primary plans (GBP, GBP + Local SEO, GBP + Local SEO Growth) -->
  <IncludePackagesPrimary />

  <!-- Add-On & One-Time Options -->
  <IncludePackagesSecondary />
</Layout>

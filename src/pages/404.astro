---
import Layout from "~/layouts/PageLayout.astro";
import { getHomePermalink, getPermalink } from "~/utils/permalinks";

const title = `Page Not Found`;
---

<Layout metadata={{ title }} noIndex={true}>
  <section class="flex min-h-[60vh] items-center bg-slate-50 py-20">
    <div class="container mx-auto px-5">
      <div class="mx-auto max-w-lg text-center">
        <p class="text-8xl font-bold text-primary">404</p>
        <h1 class="mt-4 text-3xl font-bold text-heading md:text-4xl">Page not found</h1>
        <p class="mb-8 mt-4 text-lg text-body">
          Don't worry — here are some useful pages to get you back on track.
        </p>

        <div class="mb-8 flex flex-wrap justify-center gap-3">
          <a
            href={getPermalink("/services/local-seo")}
            class="inline-flex items-center rounded-full border border-primary bg-white px-5 py-2.5 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
          >
            Local SEO Services
          </a>
          <a
            href={getPermalink("/services/google-business-profile-optimization")}
            class="inline-flex items-center rounded-full border border-primary bg-white px-5 py-2.5 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
          >
            GBP Optimization
          </a>
          <a
            href={getPermalink("/services/web-design")}
            class="inline-flex items-center rounded-full border border-primary bg-white px-5 py-2.5 text-sm font-semibold text-primary transition hover:bg-primary hover:text-white"
          >
            Website Design
          </a>
        </div>

        <div class="flex flex-wrap justify-center gap-3">
          <a
            href={getPermalink("/contact#book")}
            class="inline-flex items-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow transition hover:bg-primary-dark"
          >
            Book a Free Call
          </a>
          <a
            href={getHomePermalink()}
            class="inline-flex items-center rounded-full border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-heading transition hover:border-primary hover:text-primary"
          >
            Back to Homepage
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

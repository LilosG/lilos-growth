---
import PageLayout from "~/layouts/PageLayout.astro";
import OfferHero from "~/components/offers/OfferHero.astro";
import DeviceMockup from "~/components/offers/DeviceMockup.astro";
import IncludedList from "~/components/offers/IncludedList.astro";
import OfferPricing from "~/components/offers/OfferPricing.astro";
import HowItWorks from "~/components/offers/HowItWorks.astro";
import OfferLeadForm from "~/components/offers/OfferLeadForm.astro";
import OfferFAQ from "~/components/offers/OfferFAQ.astro";
import StickyMobileCTA from "~/components/offers/StickyMobileCTA.astro";
import { website as offer } from "~/data/offers";

const title = "Free Website Program for Home-Service Pros";
const description =
  "We build your website free, with a page for every service and every town you serve. Keep it ranking for $499/mo, rate locked. Apply in 2 minutes.";

const sites = [
  {
    name: "Tamarack Restoration",
    city: "Carlsbad, CA",
    desktop: "/images/landers/tamarack-desktop.webp",
    mobile: "/images/landers/tamarack-mobile.webp",
  },
  {
    name: "Carlsbad Fix It",
    city: "Carlsbad, CA",
    desktop: "/images/landers/carlsbadfixit-desktop.webp",
    mobile: "/images/landers/carlsbadfixit-mobile.webp",
  },
];

const included = [
  { icon: "tabler:world", title: offer.includes[0], detail: "Every service and every town you serve gets its own page." },
  { icon: "tabler:code", title: offer.includes[1], detail: "Structured data that helps Google understand your business." },
  { icon: "tabler:sparkles", title: offer.includes[2], detail: "Built so AI assistants and search engines can read and cite you." },
  { icon: "tabler:phone-check", title: offer.includes[3], detail: "Know which calls and form fills your site is producing." },
  { icon: "tabler:map-pin", title: offer.includes[4], detail: "Profile optimization, weekly posts, review replies and map-rank reports." },
  { icon: "tabler:trending-up", title: offer.includes[5], detail: "Ongoing work every month to keep your pages ranking." },
];

const faqs = [
  {
    q: "Is the website really free?",
    a: "Yes. The build is free with the monthly or prepaid plan.",
  },
  {
    q: "Who owns the site?",
    a: "You do once your term is complete. Monthly clients who leave early keep it for $1,000.",
  },
  {
    q: "How long does it take?",
    a: "4–6 weeks. 14 days on prepaid plans.",
  },
  {
    q: "Do you lock my rate?",
    a: "Yes. Your rate is locked for as long as you stay.",
  },
];
---

<PageLayout
  {title}
  {description}
  noIndex
  minimal
  minimalCta={{ text: "Apply now", href: "#apply" }}
>
  <OfferHero
    eyebrow="Free website program · North County"
    titleBefore="Apply for a "
    highlight="free website"
    subhead="For home-service businesses in North County. We build it free — a page for every service and every town you serve. You keep it ranking for $499/mo, locked."
    priceChip="$499/mo · rate locked"
    primary={{ text: "See plans", href: "#pricing" }}
    secondary={{ text: "Apply in 2 minutes", href: "#apply" }}
    trust={[
      { icon: "tabler:users", text: "17 active clients" },
      { icon: "tabler:map-pin", text: "Based in Carlsbad" },
      { icon: "tabler:shield-check", text: "Day-90 guarantee" },
    ]}
  >
    <DeviceMockup
      desktopSrc={sites[0].desktop}
      mobileSrc={sites[0].mobile}
      alt={`${sites[0].name} website`}
      eager
    >
      <span class="absolute -left-2 top-6 hidden sm:block rounded-xl bg-white px-3 py-2 text-xs font-bold text-secondary shadow-xl sm:-left-6 sm:text-sm">A page for every service</span>
      <span class="absolute -left-2 bottom-16 hidden sm:block rounded-xl bg-primary px-3 py-2 text-xs font-bold text-white shadow-xl sm:-left-6 sm:text-sm">A page for every town</span>
    </DeviceMockup>
  </OfferHero>

  <section aria-labelledby="sites-heading" class="bg-background-cream py-20 md:py-28">
    <div class="mx-auto max-w-6xl px-4">
      <p class="text-center text-xs font-bold uppercase tracking-[0.18em] text-primary">Our work</p>
      <h2 id="sites-heading" class="mt-3 text-center font-heading text-3xl font-bold text-secondary md:text-4xl">
        Sites we've built for local home-service businesses
      </h2>
      <ul class="mt-14 grid gap-14 md:grid-cols-2 md:gap-10">
        {sites.map((site) => (
          <li>
            <DeviceMockup desktopSrc={site.desktop} mobileSrc={site.mobile} alt={`${site.name} website`} />
            <p class="mt-4 text-center font-heading text-xl font-bold text-secondary">{site.name}</p>
            <p class="text-center text-sm text-body">{site.city}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <IncludedList title="What you get" items={included} />

  <OfferPricing {offer} />

  <HowItWorks
    steps={[
      { title: "Apply", desc: "Two minutes, no payment yet." },
      { title: "We design your homepage preview", desc: "You see it before you decide anything." },
      { title: "Approve and launch", desc: "A page for every service and every town you serve." },
    ]}
  />

  <OfferLeadForm
    id="apply"
    title="Apply for your free website"
    eyebrow="Apply"
    bullets={["Two minutes, no payment yet", "You see your homepage preview before you decide anything", "A page for every service and every town you serve"]}
    intro="Two minutes. We'll send your homepage preview and a time to talk."
    source="free-website: application"
    submitLabel="Submit my application"
    successMessage="Application received — we'll send your homepage preview and a time to talk."
    fields={[
      {
        name: "trade",
        label: "Your trade",
        placeholder: "Plumbing, HVAC, roofing…",
        required: true,
        half: true,
      },
      {
        name: "cities_served",
        label: "Cities served",
        placeholder: "Carlsbad, Oceanside, Vista…",
        required: true,
        half: true,
      },
      {
        name: "current_website",
        label: "Current website",
        type: "url",
        autocomplete: "url",
        placeholder: "https://",
      },
      { name: "name", label: "Your name", autocomplete: "name", required: true, half: true },
      { name: "email", label: "Email", type: "email", autocomplete: "email", required: true },
      { name: "mobile", label: "Mobile", type: "tel", autocomplete: "tel", required: true, half: true },
    ]}
  />

  <OfferFAQ items={faqs} />

  <section aria-labelledby="final-cta-heading" class="bg-secondary-dark py-20 text-center md:py-28">
    <div class="mx-auto max-w-2xl px-4">
      <h2 id="final-cta-heading" class="font-heading text-3xl font-bold text-white">
        Get a free website that ranks
      </h2>
      <p class="mt-2 text-white/90">$499/mo, locked. Or prepay 6 months and get 1 month free.</p>
      <a
        href="#pricing"
        class="mt-6 inline-flex h-12 items-center justify-center rounded-2xl bg-primary px-7 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
        >See plans</a
      >
    </div>
  </section>

  <StickyMobileCTA label="See plans" detail="$499/mo" />
</PageLayout>

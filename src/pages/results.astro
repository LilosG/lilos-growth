---
/**
 * Results Page - Enhanced with service filtering and visual hierarchy
 */
import PageLayout from "~/layouts/PageLayout.astro";
import CaseStudyCard from "~/components/results/CaseStudyCard.astro";
import ResultsCTABand from "~/components/results/ResultsCTABand.astro";

import { resultsStats, resultsCaseStudies, resultsFaqs, serviceTypeLabels } from "~/data/results";
import type { ServiceType } from "~/data/results";

const featuredStudy = resultsCaseStudies.find((s) => s.featured);
const otherStudies = resultsCaseStudies.filter((s) => !s.featured);

// GBP Performance Data
const gbpResults = [
  {
    client: "Blue Door Pest Control",
    metric: "Direction Requests",
    value: "194",
    growth: "+19.0%",
    period: "Sep 2025 – Dec 2025",
    image: "/images/results/blue-door-gbp.png",
  },
  {
    client: "Carlsbad Fix It",
    metric: "Business Profile Interactions",
    value: "38",
    growth: "Upward Trend",
    period: "Sep 2025 – Dec 2025",
    image: "/images/results/carlsbad-fixit-gbp.png",
  },
];
---

<PageLayout
  title="Client Results & Case Studies | Lilos Growth"
  description="Real results for home service businesses: more calls, better rankings, faster websites. See how we help pest control, HVAC, restoration, and other local businesses grow."
>
  {/* HERO */}
  <section class="relative overflow-hidden bg-secondary">
    <div class="absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">Proven Results</p>
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">
          More calls. Better rankings.<br class="hidden sm:block" />
          <span class="text-primary">Real growth.</span>
        </h1>
        <p class="mt-4 text-lg text-white/80 md:text-xl">
          We help home service businesses dominate local search with fast websites, optimized Google
          Business Profiles, and local SEO that actually drives calls.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white">
            Website Design
          </span>
          <span class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white">
            GBP Optimization
          </span>
          <span class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-white">
            Local SEO
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* STATS */}
  <section class="border-b border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        {
          resultsStats.map((stat) => (
            <div class="group relative overflow-hidden rounded-2xl border border-gray-100 bg-gradient-to-br from-white to-gray-50 p-6 shadow-sm transition-shadow hover:shadow-md">
              <div class="bg-primary/5 absolute -right-4 -top-4 h-24 w-24 rounded-full transition-transform group-hover:scale-110" />
              <div class="relative">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                  {stat.label}
                </p>
                <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">
                  {stat.value}
                </p>
                {stat.note && <p class="mt-1 text-xs text-gray-500">{stat.note}</p>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* FEATURED CASE STUDY */}
  {
    featuredStudy && (
      <section class="bg-cream border-b border-gray-100 py-16 md:py-20">
        <div class="mx-auto max-w-6xl px-4">
          <div class="mb-8 flex items-center gap-3">
            <span class="rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
              Featured
            </span>
            <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">
              Client Spotlight
            </h2>
          </div>

          <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl">
            <div class="grid gap-0 lg:grid-cols-2">
              {/* Screenshot Side */}
              <div class="relative bg-gray-100">
                {featuredStudy.screenshot && (
                  <div class="aspect-[4/3] overflow-hidden lg:absolute lg:inset-0 lg:aspect-auto">
                    <img
                      src={featuredStudy.screenshot.src}
                      alt={featuredStudy.screenshot.alt || featuredStudy.client}
                      class="h-full w-full object-cover object-top"
                      loading="eager"
                    />
                  </div>
                )}
                {featuredStudy.websiteUrl && (
                  <a
                    href={featuredStudy.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute bottom-4 left-4 inline-flex items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-heading shadow-lg backdrop-blur transition hover:bg-white"
                  >
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                    View Live Site
                  </a>
                )}
              </div>

              {/* Content Side */}
              <div class="flex flex-col justify-center p-8 lg:p-10">
                <div class="flex items-center gap-3">
                  {featuredStudy.image?.src && (
                    <img
                      src={featuredStudy.image.src}
                      alt={featuredStudy.image.alt || featuredStudy.client}
                      class="h-10 w-auto object-contain"
                    />
                  )}
                </div>

                <h3 class="mt-4 font-heading text-2xl font-bold text-heading md:text-3xl">
                  {featuredStudy.title}
                </h3>

                <p class="mt-1 text-sm text-gray-500">
                  {featuredStudy.city} · {featuredStudy.sectorTag}
                </p>

                {/* Service Badges */}
                <div class="mt-4 flex flex-wrap gap-2">
                  {featuredStudy.serviceTypes.map((type: ServiceType) => (
                    <span
                      class:list={[
                        "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold",
                        type === "website" && "bg-blue-100 text-blue-700",
                        type === "gbp" && "bg-green-100 text-green-700",
                        type === "local-seo" && "bg-purple-100 text-purple-700",
                      ]}
                    >
                      {type === "website" && (
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          />
                        </svg>
                      )}
                      {type === "gbp" && (
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                      )}
                      {type === "local-seo" && (
                        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                          />
                        </svg>
                      )}
                      {serviceTypeLabels[type]}
                    </span>
                  ))}
                </div>

                <p class="mt-4 text-body">{featuredStudy.blurb}</p>

                {/* KPIs */}
                <div class="mt-6 grid grid-cols-3 gap-4">
                  {featuredStudy.kpis.slice(0, 3).map((kpi) => (
                    <div class="text-center">
                      <p class="font-heading text-2xl font-bold text-primary md:text-3xl">
                        {kpi.value}
                      </p>
                      <p class="mt-1 text-xs uppercase tracking-wider text-gray-500">{kpi.label}</p>
                    </div>
                  ))}
                </div>

                <div class="mt-8">
                  <a href={featuredStudy.ctaHref || "/contact"} class="btn btn-primary">
                    {featuredStudy.ctaText || "Learn More"}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* GBP PERFORMANCE SECTION */}
  <section class="border-b border-gray-200 bg-gray-50 py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-12 text-center">
        <span
          class="bg-primary/10 mb-4 inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold text-primary"
        >
          GBP Management
        </span>
        <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">
          Google Business Profile Performance
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-gray-600">
          Real-time performance data from profiles we manage. We focus on the metrics that matter:
          direction requests, calls, and direct customer interactions.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {
          gbpResults.map((result) => (
            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg">
              <div class="border-b border-gray-200 bg-gray-50 p-6">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="font-heading text-lg font-bold text-heading">{result.client}</h3>
                    <p class="text-sm text-gray-500">{result.period}</p>
                  </div>
                  <div class="text-right">
                    <div class="text-2xl font-bold text-primary">{result.value}</div>
                    <div class="text-xs font-semibold uppercase tracking-wider text-green-600">
                      {result.growth}
                    </div>
                  </div>
                </div>
                <p class="mt-2 text-sm font-medium text-gray-700">{result.metric}</p>
              </div>
              <div class="relative aspect-[16/9] bg-gray-100">
                <img
                  src={result.image}
                  alt={`${result.client} GBP Performance`}
                  class="h-full w-full object-cover object-top"
                  loading="eager"
                  decoding="async"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ALL CASE STUDIES -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mb-10 text-center">
        <h2 class="font-heading text-3xl font-bold text-heading md:text-4xl">More Client Wins</h2>
        <p class="mx-auto mt-3 max-w-2xl text-lg text-body">
          From pest control to restoration to handyman services—we help home service businesses
          across industries dominate their local markets.
        </p>
      </div>

      {/* Filter Tabs */}
      <div
        class="mb-8 flex flex-wrap justify-center gap-2"
        role="tablist"
        aria-label="Filter by service type"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-filter="all"
          class="filter-tab rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white transition-colors"
        >
          All Results
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter="website"
          class="filter-tab rounded-full bg-gray-100 px-5 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-200"
        >
          Websites
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter="gbp"
          class="filter-tab rounded-full bg-gray-100 px-5 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-200"
        >
          GBP Optimization
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter="local-seo"
          class="filter-tab rounded-full bg-gray-100 px-5 py-2 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-200"
        >
          Local SEO
        </button>
      </div>

      {/* Case Study Grid */}
      <div id="results-grid" class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {otherStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </section>

  {/* FAQ */}
  <section class="bg-cream border-t border-gray-100 py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Common Questions
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-center text-body">
        Answers about working together, timelines, and what to expect.
      </p>

      <div class="mt-10 space-y-4">
        {
          resultsFaqs.map((faq) => (
            <details class="group rounded-2xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 [&::-webkit-details-marker]:hidden">
                <h3 class="pr-4 font-heading text-base font-semibold text-heading">{faq.q}</h3>
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-100 text-gray-500 transition-colors group-open:bg-primary group-open:text-white">
                  <svg
                    class="h-4 w-4 transition-transform group-open:rotate-45"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v12M6 12h12"
                    />
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-4 text-body">{faq.a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* CTA */}
  <ResultsCTABand />
</PageLayout>

<script>
  // Filter functionality
  const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
  const cards = document.querySelectorAll<HTMLElement>("#results-grid > article");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const filter = tab.dataset.filter ?? "all";

      // Update tab states
      tabs.forEach((t) => {
        t.classList.remove("bg-primary", "text-white");
        t.classList.add("bg-gray-100", "text-gray-700");
        t.setAttribute("aria-selected", "false");
      });
      tab.classList.remove("bg-gray-100", "text-gray-700");
      tab.classList.add("bg-primary", "text-white");
      tab.setAttribute("aria-selected", "true");

      // Filter cards
      cards.forEach((card) => {
        const services = card.getAttribute("data-services") || "";
        if (filter === "all" || services.includes(filter)) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>

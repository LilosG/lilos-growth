---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { getSlug, getDate, formatDate, allowDrafts, type BlogEntry } from "../../lib/blog";

// Build static paths using your canonical slug logic
export async function getStaticPaths() {
  const posts: BlogEntry[] = await getCollection("blog");
  return posts.filter((p) => !p.data.draft).map((p) => ({ params: { slug: getSlug(p) } }));
}

const slug = String(Astro.params.slug ?? "");

// Find the post by the same slug logic used above
const posts: BlogEntry[] = await getCollection("blog");
const entry = posts.find((p) => getSlug(p) === slug);
if (!entry) throw new Error(`Post not found for slug: ${slug}`);
if (entry.data.draft && !allowDrafts()) {
  throw new Error(`Draft post not available: ${slug}`);
}

const { Content } = await entry.render();

// Meta
const title = entry.data.title ?? "Untitled";
const description = entry.data.description ?? "";
const date = getDate(entry);
const category = entry.data.category;
const image = typeof entry.data.image === "string" ? entry.data.image : entry.data.image?.src;
const imageAlt =
  typeof entry.data.imageAlt === "string" && entry.data.imageAlt.trim()
    ? entry.data.imageAlt
    : typeof entry.data.image === "object" &&
        entry.data.image &&
        typeof entry.data.image.alt === "string" &&
        entry.data.image.alt.trim()
      ? entry.data.image.alt
      : title;

const tags: string[] = entry.data.tags ?? [];
const faqs: { question: string; answer: string }[] = entry.data.faqs ?? entry.data.faq ?? [];
const CATEGORY_MONEY_PAGES: Record<string, { label: string; href: string }[]> = {
  "Local SEO": [
    { label: "Local SEO Services", href: "/services/local-seo" },
    { label: "Google Business Profile", href: "/services/google-business-profile-optimization" },
  ],
  "Google Business Profile": [
    { label: "GBP Optimization Service", href: "/services/google-business-profile-optimization" },
    { label: "Local SEO Services", href: "/services/local-seo" },
  ],
  Websites: [
    { label: "Website Design for Contractors", href: "/services/web-design" },
    { label: "Local SEO Services", href: "/services/local-seo" },
  ],
  SEO: [
    { label: "Local SEO Services", href: "/services/local-seo" },
    { label: "Website Design", href: "/services/web-design" },
  ],
  Content: [
    { label: "Local SEO Services", href: "/services/local-seo" },
    { label: "GBP Optimization Service", href: "/services/google-business-profile-optimization" },
  ],
  Workflows: [
    { label: "Local SEO Services", href: "/services/local-seo" },
    { label: "GBP Optimization Service", href: "/services/google-business-profile-optimization" },
  ],
};
const moneyPages = (category && CATEGORY_MONEY_PAGES[category]) ?? [
  { label: "Local SEO for Home Service Businesses", href: "/services/local-seo" },
  {
    label: "Google Business Profile Optimization",
    href: "/services/google-business-profile-optimization",
  },
];
const relatedPosts = posts
  .filter((p) => getSlug(p) !== slug && !p.data.draft)
  .map((p) => {
    const pTags: string[] = p.data.tags ?? [];
    const overlap = pTags.filter((t: string) => tags.includes(t)).length;
    return { post: p, overlap };
  })
  .sort(
    (a, b) =>
      b.overlap - a.overlap || (getDate(b.post)?.getTime() ?? 0) - (getDate(a.post)?.getTime() ?? 0)
  )
  .slice(0, 3)
  .map(({ post }) => post);
---

<Layout
  title={title}
  description={description}
  metadata={{
    title,
    description,
    openGraph: image
      ? {
          images: [
            { url: new URL(image, "https://lilosgrowth.com").href, width: 1200, height: 630 },
          ],
        }
      : undefined,
  }}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Blog", item: "https://lilosgrowth.com/blog" },
    { name: title, item: `https://lilosgrowth.com/blog/${slug}` },
  ]}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          headline: title,
          description,
          datePublished: date?.toISOString(),
          dateModified: date?.toISOString(),
          image: image ? new URL(image, "https://lilosgrowth.com").href : undefined,
          author: { "@type": "Organization", name: "Lilos Growth", url: "https://lilosgrowth.com" },
          publisher: {
            "@type": "Organization",
            name: "Lilos Growth",
            url: "https://lilosgrowth.com",
          },
          mainEntityOfPage: {
            "@type": "WebPage",
            "@id": `https://lilosgrowth.com/blog/${slug}`,
          },
        },
        ...(faqs.length > 0
          ? [
              {
                "@type": "FAQPage",
                mainEntity: faqs.map((f) => ({
                  "@type": "Question",
                  name: f.question,
                  acceptedAnswer: { "@type": "Answer", text: f.answer },
                })),
              },
            ]
          : []),
      ],
    })}
  />
  <!-- HERO: hard, reliable contrast; no overlays; immune to inherited opacity -->
  <section class="relative isolate bg-secondary pb-14 pt-10 text-white">
    <div class="container">
      <a href="/blog" class="inline-block text-sm opacity-90 hover:opacity-100">← Back to Blog</a>

      <div class="mt-4">
        <h1
          class="text-4xl font-extrabold leading-tight tracking-tight !text-white !opacity-100 drop-shadow-sm md:text-5xl"
        >
          {title}
        </h1>
        <div class="mt-4 flex items-center gap-3 text-sm">
          {
            category && (
              <span class="rounded-full border border-white/25 bg-white/10 px-2 py-1 !text-white">
                {category}
              </span>
            )
          }
          {date && <time class="!text-white/90">{formatDate(date)}</time>}
        </div>
      </div>
    </div>
  </section>

  <!-- READING AREA: light page bg + white card for maximum legibility -->
  <section class="bg-slate-50 py-12">
    <div class="container">
      <div
        class="mx-auto max-w-3xl rounded-3xl border border-gray-100 bg-white p-6 shadow-xl md:p-10"
      >
        {
          image && (
            <img
              src={image}
              alt={imageAlt}
              class="mb-8 rounded-2xl shadow"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="800"
              height="450"
            />
          )
        }

        <!-- Tailwind Typography, branded colors, comfortable sizes -->
        <div
          class="prose prose-slate max-w-none lg:prose-lg prose-headings:text-heading prose-p:text-[#4a4a4a] prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-blockquote:rounded-xl prose-blockquote:border-[#ffd8c5] prose-blockquote:bg-[#fff4ee] prose-blockquote:px-5 prose-blockquote:py-3 prose-blockquote:text-[#55301f] prose-strong:text-heading prose-hr:border-gray-200"
        >
          <Content />
        </div>

        <!-- Mid-article CTA -->
        <div class="not-prose border-primary/20 mt-8 rounded-2xl border bg-[#fff4ee] px-6 py-5">
          <p class="text-sm font-semibold text-heading">Ready to rank higher and get more calls?</p>
          <p class="mt-1 text-sm text-body">
            We build Local SEO systems for home service businesses — no contracts, transparent
            reporting.
          </p>
          <a
            href="/contact#book"
            class="mt-3 inline-flex items-center rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white shadow transition hover:bg-primary-dark"
            data-evt="cta_blog_mid_article"
          >
            Book a Free Audit →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- POPULAR SERVICE PAGES -->
  <section class="border-t border-gray-100 bg-white py-10">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-body/60 mb-2 text-xs font-semibold uppercase tracking-wide">
          Local SEO Services
        </p>
        <h2 class="mb-6 text-xl font-bold text-heading">Popular Service Pages</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {
            moneyPages.map((page: { label: string; href: string }) => (
              <a
                href={page.href}
                class="border-primary/20 inline-flex items-center rounded-full border bg-white px-4 py-2 text-sm font-semibold text-heading transition-colors hover:border-primary hover:text-primary"
              >
                {page.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED ARTICLES -->
  {
    relatedPosts.length === 0 ? null : (
      <section class="border-t border-gray-100 bg-slate-50 py-12">
        <div class="container">
          <div class="mx-auto max-w-5xl">
            <h2 class="mb-6 text-2xl font-bold text-heading">Related Articles</h2>
            <div class="grid gap-6 md:grid-cols-3">
              {relatedPosts.map((p) => {
                return (
                  <a
                    href={`/blog/${getSlug(p)}`}
                    class="border-primary/10 block overflow-hidden rounded-3xl border-2 bg-white p-6 shadow-xl transition-transform hover:-translate-y-1"
                  >
                    <div class="mb-1 text-xs text-body">{p.data.category}</div>
                    <h3 class="mb-2 text-base font-semibold leading-snug text-heading">
                      {p.data.title}
                    </h3>
                    <p class="line-clamp-2 text-sm text-body">{p.data.description}</p>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- GLOBAL BLOG CTA: consistent next steps on every post -->
  <section class="bg-secondary py-10 text-white">
    <div class="container">
      <div
        class="mx-auto max-w-4xl rounded-3xl border border-white/10 bg-white/5 px-6 py-8 shadow-xl md:px-10"
      >
        <h2 class="text-2xl font-extrabold tracking-tight md:text-3xl">
          Ready to turn this into real leads?
        </h2>
        <p class="mt-3 text-sm text-white/80 md:text-base">
          Put these playbooks into action with a Local SEO plan tailored for your home service
          business.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="/services/local-seo"
            class="inline-flex items-center rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white shadow transition hover:bg-primary-dark"
            data-evt="cta_blog_local_seo"
          >
            Explore Local SEO Services
          </a>
          <a
            href="/contact#book"
            class="inline-flex items-center rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white/90 hover:bg-white/10"
            data-evt="cta_blog_book_call"
          >
            Book a Call
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

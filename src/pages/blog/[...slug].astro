---
import PageLayout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';

/** Remap old { params: { blog } } → new { params: { slug } } */
export async function getStaticPaths() {
  const entries = await getStaticPathsBlogPost();
  return entries.map((e) => ({
    ...e,
    params: { slug: e.params.blog },
    props: e.props,
  }));
}
export const robots = blogPostRobots;

// Derive fields without using `any`
const props = Astro.props as Record<string, unknown>;
const post = props['post'] as Record<string, unknown> | undefined;

function asString(v: unknown): string | undefined {
  return typeof v === 'string' ? v : undefined;
}

const baseTitle = asString(post?.['title']) ?? 'Post';
const fullTitle = `${baseTitle} | Lilos Growth`;
const description = asString(post?.['description']) ?? asString(post?.['excerpt']) ?? '';

// Match your Crumb type exactly
const breadcrumbs: { name: string; item: string }[] = [
  { name: 'Home', item: '/' },
  { name: 'Blog', item: '/blog' },
];
---

<PageLayout title={fullTitle} {description} {breadcrumbs}>
  {/* The runtime object from utils/blog matches SinglePost expectations; TS can't see its exact shape here. */}
  {/* @ts-expect-error - SinglePost expects a stricter Post; runtime shape is provided by utils/blog. */}
  <SinglePost post={post} url={Astro.url.pathname} />
</PageLayout>

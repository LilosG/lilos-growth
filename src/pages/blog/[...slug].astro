---
import type { CollectionEntry } from "astro:content";
import { getEntry, getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";

/** Build-time paths for all blog entries */
export async function getStaticPaths() {
  const entries = (await getCollection("blog")) as CollectionEntry<"blog">[];
  return entries.map((e) => ({
    // NOTE: This is a REST route ([...slug]), so params.slug MUST be a string, not an array.
    params: { slug: e.slug },
    props: { entrySlug: e.slug },
  }));
}

const { entrySlug } = Astro.props as { entrySlug: string };

/** Load the entry selected by getStaticPaths */
const entry = await getEntry("blog", entrySlug);
if (!entry) {
  return Astro.redirect("/blog");
}

const { Content } = await entry.render();

/** Normalize dates to ISO strings for JSON-LD */
const toISO = (v: unknown) => {
  if (!v) return undefined;
  if (typeof v === "string") return new Date(v).toISOString();
  try { return (v as Date).toISOString?.(); } catch { return undefined; }
};

const datePublishedISO = toISO(entry.data.date);
const dateModifiedISO = toISO(entry.data.updated ?? entry.data.date);

/** Stable absolute URL for mainEntityOfPage (no trailing slash) */
const siteBase = Astro.site ? Astro.site.toString() : "https://lilosgrowth.com";
const canonicalUrl = new URL(`/blog/${entry.slug}`, siteBase).toString();

/** Resolve hero image URL if provided */
let imageUrl: string | undefined;
const hero = (entry.data as any).hero;
if (typeof hero === "string") imageUrl = hero;
else if (hero?.src) imageUrl = hero.src;

/** Compose the BlogPosting graph (exactly one block emitted below) */
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description || entry.data.excerpt,
  datePublished: datePublishedISO,
  dateModified: dateModifiedISO,
  author: { "@type": "Person", name: entry.data.author },
  mainEntityOfPage: canonicalUrl,
  ...(imageUrl ? { image: [imageUrl] } : {}),
  ...(((entry.data as any).schemaOverrides ?? {}) as Record<string, unknown>),
};
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose mx-auto px-4 md:px-0">
    <Content />
  </article>

  <!-- One BlogPosting JSON-LD only -->
  <script type="application/ld+json" is:inline>
  <astro-head>
    <script type="application/ld+json">{JSON.stringify(articleLd)}</script>
  </astro-head>
  </script>
</PageLayout>

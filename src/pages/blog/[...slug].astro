---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p: CollectionEntry<'blog'>) => !p.data.draft);
  return posts.map((entry: CollectionEntry<'blog'>) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Post = CollectionEntry<'blog'>;
const { entry } = Astro.props as { entry: Post };

const { Content } = await entry.render();

const { title, excerpt, date, updated, author, cover, alt, tags = [], category } = entry.data;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = `${site}/blog/${entry.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: excerpt ?? undefined,
  datePublished: date ? new Date(date).toISOString() : undefined,
  dateModified: updated ? new Date(updated).toISOString() : undefined,
  author: author ? { '@type': 'Person', name: author } : undefined,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url || `/blog/${entry.slug}` },
  image: cover ? (String(cover).startsWith('http') ? String(cover) : `${site}${cover}`) : undefined,
};
---

<PageLayout
  title={title}
  description={excerpt ?? ''}
  canonical={url || `/blog/${entry.slug}`}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: String(title), item: `/blog/${entry.slug}` },
  ]}
  schema={[]}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <header class="pt-12 sm:pt-16 lg:pt-20">
      <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{title}</h1>
      <div class="mt-3 text-sm text-gray-500">
        {date && <time datetime={new Date(date).toISOString()}>{new Date(date).toLocaleDateString()}</time>}
        {
          updated && (
            <>
              {' · Updated '}
              <time datetime={new Date(updated).toISOString()}>{new Date(updated).toLocaleDateString()}</time>
            </>
          )
        }
        {
          author && (
            <>
              {' · '}
              {author}
            </>
          )
        }
      </div>
    </header>

    {
      cover && (
        <div class="mt-6 overflow-hidden rounded-2xl">
          <img src={String(cover)} alt={String(alt ?? title)} loading="eager" class="h-auto w-full object-cover" />
        </div>
      )
    }

    <div class="prose prose-gray mt-8 max-w-none">
      <Content />
    </div>

    {
      (Array.isArray(tags) && tags.length > 0) || category ? (
        <footer class="mt-10 flex flex-wrap gap-2 text-sm text-gray-600">
          {category && (
            <a href={`/blog/${category}`} class="underline">
              #{String(category)}
            </a>
          )}
          {Array.isArray(tags) &&
            tags.map((t) => (
              <a href={`/blog/tag/${String(t)}`} class="underline">
                #{String(t)}
              </a>
            ))}
        </footer>
      ) : null
    }
  </article>
</PageLayout>

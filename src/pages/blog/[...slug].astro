---
import PageLayout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';

/** Remap old { params: { blog } } → new { params: { slug } } */
export async function getStaticPaths() {
  const entries = await getStaticPathsBlogPost();
  return entries.map((e) => ({
    ...e,
    params: { slug: e.params.blog },
    props: e.props,
  }));
}
export const robots = blogPostRobots;

const { post } = Astro.props;
const title = post?.frontmatter?.title ? `${post.frontmatter.title} | Lilos Growth` : 'Post | Lilos Growth';
const description = post?.frontmatter?.description || post?.frontmatter?.excerpt || '';
---

<PageLayout
  {title}
  {description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <SinglePost post={post} />
  {post?.relatedPosts && <RelatedPosts posts={post.relatedPosts} />}
</PageLayout>

---
import PageLayout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import { getStaticPathsBlogPost, blogPostRobots } from '~/utils/blog';

/** Remap old { params: { blog } } → new { params: { slug } } */
export async function getStaticPaths() {
  const entries = await getStaticPathsBlogPost();
  return entries.map((e) => ({
    ...e,
    params: { slug: e.params.blog },
    props: e.props,
  }));
}
export const robots = blogPostRobots;

const { post } = Astro.props as any;
const title = post?.title ? `${post.title} | Lilos Growth` : 'Post | Lilos Growth';
const description = post?.description || post?.excerpt || '';
---

<PageLayout
  {title}
  {description}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
  ]}
>
  <SinglePost post={post} url={Astro.url.pathname} />
</PageLayout>

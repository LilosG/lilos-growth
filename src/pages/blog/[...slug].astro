---
import PageLayout from "~/layouts/PageLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(
    (p: CollectionEntry<"blog">) => !p.data?.draft,
  );
  return posts.map((p: CollectionEntry<"blog">) => ({
    params: { slug: p.slug },
    props: { slug: p.slug },
  }));
}

const { slug } = Astro.props as { slug: string };

// Load the post entry
const entry = (await getCollection("blog")).find(
  (p: CollectionEntry<"blog">) => p.slug === slug,
) as CollectionEntry<"blog"> | undefined;

if (!entry) {
  throw new Error(`Post not found for slug: ${slug}`);
}

type BlogFrontmatter = {
  title: string;
  excerpt?: string;
  description?: string;
  author?: string;
  date: string | Date;
  updated?: string | Date;
  cover?: string;
  alt?: string;
  tags?: string[];
  categories?: string[];
  canonical?: string;
};

const d = entry.data as BlogFrontmatter;

const publishedISO = new Date(d.date).toISOString();
const updatedISO = d.updated ? new Date(d.updated).toISOString() : undefined;
const canonical = d.canonical ? d.canonical : `/blog/${entry.slug}`;

// Exactly one BlogPosting JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.excerpt || d.description || "",
  datePublished: publishedISO,
  ...(updatedISO ? { dateModified: updatedISO } : {}),
  ...(d.author ? { author: { "@type": "Person", name: d.author } } : {}),
  mainEntityOfPage: canonical,
  ...(d.cover ? { image: [d.cover] } : {}),
};
---

<PageLayout
  title={d.title}
  description={d.excerpt || d.description || ""}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Blog", item: "/blog" },
    { name: d.title, item: `/blog/${entry.slug}` },
  ]}
  schema={[]}
  noIndex={false}
>
  <!-- COVER -->
  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <header class="mb-6">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">{d.title}</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
          {d.author && <span>By {d.author} · </span>}
          <time datetime={new Date(d.date).toISOString()}>
            {new Date(d.date).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })}
          </time>
          {d.updated && (
            <span>
              {" "}(Updated{" "}
              <time datetime={new Date(d.updated).toISOString()}>
                {new Date(d.updated).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })}
              </time>
              )
            </span>
          )}
        </p>
      </header>

      {d.cover ? (
        <figure class="mb-8 overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 dark:border-gray-800">
          <img
            src={d.cover}
            alt={d.alt ?? d.title}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            class="h-auto w-full"
          />
        </figure>
      ) : null}

      <!-- Markdown body -->
      <article class="prose prose-slate max-w-none dark:prose-invert">
        <entry.Content />
      </article>
    </div>
  </section>

  <!-- Single BlogPosting JSON-LD -->
  <script type="application/ld+json" is:inline>
    {jsonLd}
  </script>

  <astro-head>
    <link rel="canonical" href={canonical} />
  </astro-head>
</PageLayout>

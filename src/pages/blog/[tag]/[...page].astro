---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const PAGE_SIZE = 12 as const;

export async function getStaticPaths() {
  // Use a LOCAL constant so bundling/tree-shake can’t drop it at build time.
  const PAGE_SIZE_LOCAL = 12 as const;

  // Load non-draft posts from the blog collection
  const posts = (await getCollection('blog')).filter((p: CollectionEntry<'blog'>) => !p.data?.draft);

  // Group posts by tag (lowercased)
  const byTag = new Map<string, CollectionEntry<'blog'>[]>();
  for (const p of posts) {
    const tags: string[] = Array.isArray(p.data.tags) ? (p.data.tags as string[]) : [];
    for (const t of tags) {
      const k = t.toLowerCase();
      if (!byTag.has(k)) byTag.set(k, []);
      byTag.get(k)!.push(p);
    }
  }

  // Build paths
  const paths: Array<{
    params: { tag: string; page: string };
    props: { tag: string; page: number; totalPages: number };
  }> = [];

  for (const [tag, items] of byTag.entries()) {
    const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE_LOCAL));
    for (let i = 1; i <= totalPages; i++) {
      paths.push({
        params: { tag, page: String(i) },
        props: { tag, page: i, totalPages },
      });
    }
  }

  return paths;
}

const { tag, page, totalPages } = Astro.props as {
  tag: string;
  page: number;
  totalPages: number;
};

// Page slice for this tag
const all = (await getCollection('blog'))
  .filter((p: CollectionEntry<'blog'>) => !p.data?.draft)
  .filter((p: CollectionEntry<'blog'>) =>
    Array.isArray(p.data.tags) ? (p.data.tags as string[]).map((s) => s.toLowerCase()).includes(tag) : false
  )
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

const start = (page - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const posts = all.slice(start, end);

const title = `Blog — #${tag} (Page ${page})`;
const canonical = `/blog/${encodeURIComponent(tag)}/${page}`;
---

<PageLayout
  title={title}
  description={`Posts tagged #${tag}`}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: `#${tag}`, item: `/blog/${tag}` },
    { name: `Page ${page}`, item: `/blog/${tag}/${page}` },
  ]}
  schema={[]}
  noIndex={false}
>
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      {
        posts.length === 0 ? (
          <p class="text-sm text-gray-600">No posts yet.</p>
        ) : (
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {posts.map((p: CollectionEntry<'blog'>) => (
              <li>
                <a class="block rounded-2xl border border-gray-200 p-5 hover:bg-gray-50" href={`/blog/${p.slug}`}>
                  <h2 class="text-lg font-semibold">{String(p.data.title)}</h2>
                  {p.data.excerpt && <p class="mt-2 text-sm text-gray-600">{String(p.data.excerpt)}</p>}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <nav class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination">
        {
          page > 1 && (
            <a
              href={`/blog/${tag}/${page - 1}`}
              class="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm"
            >
              Prev
            </a>
          )
        }
        <span class="px-3 py-2 rounded-lg bg-gray-900 text-white text-sm">{page}</span>
        {
          page < totalPages && (
            <a
              href={`/blog/${tag}/${page + 1}`}
              class="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm"
            >
              Next
            </a>
          )
        }
      </nav>
    </div>
  </section>

  <astro-head>
    <link rel="canonical" href={canonical} />
  </astro-head>
</PageLayout>

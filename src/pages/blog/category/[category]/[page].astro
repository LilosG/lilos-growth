---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import type { PaginateFunction, Page } from "astro";
import BlogCard from "../../../../components/BlogCard.astro";
import { getSlug, toListing, byCategory, type BlogEntry } from "../../../../lib/blog";
import Card from "~/components/ui/Card.astro";
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const pageSize = 12;
  const posts: BlogEntry[] = await getCollection("blog");
  const published = toListing(posts);
  const cats = new Set<string>();
  for (const p of published) {
    const c = (p.data as Record<string, unknown>).category;
    if (typeof c === "string" && c) cats.add(c);
  }

  return Array.from(cats).flatMap((cat) =>
    paginate(published.filter(byCategory(cat)), {
      params: { category: cat },
      pageSize,
      props: { cat },
    })
  );
}

type PageProps = {
  page: Page<BlogEntry>;
  cat: string;
};

const { page, cat } = Astro.props as PageProps;

const title = `Category: ${cat}`;
const description = `Articles filed under ${cat}.`;
---

<Layout title={title} description={description} metadata={{ title, description }} noIndex={true}>
  <!-- HERO (same structure as homepage) -->
  <section
    class="relative flex min-h-[680px] items-center overflow-hidden bg-secondary pb-20 pt-10"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 md:flex-row md:items-center"
    >
      <!-- Left -->
      <div class="flex-1">
        <img src="/logo-lcp-320.webp" alt="Lilos Growth Logo" class="logo--halo mb-10 w-40" />
        <h1
          class="mb-2 font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
        >
          Category: <span class="text-primary">{cat}</span>
        </h1>
        <div class="mb-8 h-1.5 w-28 rounded-full bg-primary"></div>
        <p class="mb-9 max-w-lg text-lg font-medium text-white/80 md:text-xl">
          Curated posts in the {cat} category—strategy, playbooks, and examples tailored for home-service
          companies.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="/packages"
            class="inline-flex items-center rounded-2xl bg-primary px-8 py-3.5 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
          >
            Get More Calls Today
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center rounded-2xl bg-secondary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-secondary-hover"
          >
            Book a Call
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: lead form -->
      <Card id="contact" class="mx-auto max-w-md flex-1 !p-10 shadow-xl md:mx-0">
        <h2 class="mb-4 text-left font-heading text-xl font-bold text-heading">
          Free SEO Website Audit for Home Service Pros!
        </h2>
        <form method="POST" action="https://formspree.io/f/movlbqdk" class="gap-4.5 flex flex-col">
          <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />

          <Input id="name" name="name" label="Your Name" required />
          <Input id="email" name="_replyto" label="Email Address" type="email" required />
          <Input id="company" name="company" label="Company Name" />
          <Input id="website" name="website" label="Website" type="url" required />

          <Button type="submit" variant="primary" size="md" class="mt-1.5">
            Get My Free Audit
          </Button>
        </form>
        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </Card>
    </div>
  </section>

  <!-- LIST -->
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      {
        page.data.length === 0 ? (
          <p class="text-gray-600">No posts found in this category.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {page.data.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      {
        page.lastPage > 1 && (
          <nav class="mt-10 flex items-center justify-center gap-3">
            <a
              href={
                page.currentPage > 2
                  ? `/blog/category/${encodeURIComponent(cat)}/${page.currentPage - 1}`
                  : `/blog/category/${encodeURIComponent(cat)}`
              }
              class="btn-outline-primary btn btn-sm disabled:opacity-40"
              aria-disabled={page.currentPage === 1}
            >
              Prev
            </a>
            <span class="text-sm">
              Page {page.currentPage} of {page.lastPage}
            </span>
            <a
              href={`/blog/category/${encodeURIComponent(cat)}/${Math.min(page.lastPage, page.currentPage + 1)}`}
              class="btn-outline-primary btn btn-sm disabled:opacity-40"
              aria-disabled={page.currentPage === page.lastPage}
            >
              Next
            </a>
          </nav>
        )
      }
    </div>
  </section>
</Layout>

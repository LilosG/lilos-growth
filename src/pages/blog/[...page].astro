---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import type { PaginateFunction, Page } from "astro";
import BlogCard from "../../components/BlogCard.astro";
import { toListing, getSlug, type BlogEntry } from "../../lib/blog";
import Card from "~/components/ui/Card.astro";
import Input from "~/components/ui/Input.astro";
import Button from "~/components/ui/Button.astro";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const pageSize = 12; // match index.astro
  const entries: BlogEntry[] = await getCollection("blog");
  const ordered = toListing(entries); // newest first, drafts hidden unless LOCAL_DRAFTS=1
  const uniq = Array.from(new Map(ordered.map((p) => [p.slug, p])).values());
  return paginate(uniq, { pageSize });
}

type PageProps = {
  page: Page<BlogEntry>;
};
const { page } = Astro.props as PageProps;

const pageTitle = "Blog";
const pageDescription =
  "Latest articles on Local SEO, Google Business Profile, websites, and growth.";

const allEntries: BlogEntry[] = await getCollection("blog");
const allOrdered = toListing(allEntries);
const categories = Array.from(new Set(allOrdered.map((entry) => entry.data.category))).sort();
const tags = Array.from(
  new Set(
    allOrdered
      .flatMap((entry) => entry.data.tags ?? [])
      .filter((tag) => tag && tag.trim().length > 0)
  )
).sort((a, b) => a.localeCompare(b));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  metadata={{ title: pageTitle, description: pageDescription }}
  noIndex={page.currentPage > 1}
>
  <!-- HERO SECTION (identical to index.astro) -->
  <section
    class="relative flex min-h-[680px] items-center overflow-hidden bg-secondary pb-20 pt-10"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"
    >
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 md:flex-row md:items-center"
    >
      <div class="flex-1">
        <img
          src="/logo-lcp-320.webp"
          alt="Lilos Growth Logo"
          class="logo--halo mb-10 w-40"
          fetchpriority="high"
        />
        <h1
          class="mb-2 text-left font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span
            class="mb-2 mt-3 block text-xl font-semibold uppercase tracking-wider text-primary md:text-3xl"
          >
            For Home Service Businesses
          </span>
        </h1>
        <div class="mb-8 h-1.5 w-28 rounded-full bg-primary"></div>
        <p class="mb-9 max-w-lg text-lg font-medium text-white/80 md:text-xl">
          Get more calls, book more jobs, and gain peace of mind—without tech overwhelm. Lilos
          Growth delivers actionable marketing for local service pros.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center rounded-2xl bg-primary px-8 py-3.5 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
            aria-label="Get Started — open contact form"
          >
            Get More Calls Today
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="/packages"
            class="hidden items-center rounded-2xl bg-secondary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-secondary-hover md:inline-flex"
            data-evt="cta_hero_see_services"
          >
            See Our Services
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <Card id="contact" class="mx-auto max-w-md flex-1 !p-10 shadow-xl md:mx-0">
        <h2 class="mb-4 text-left font-heading text-xl font-bold text-heading">
          Free SEO Website Audit for Home Service Pros!
        </h2>

        <form method="POST" action="https://formspree.io/f/movlbqdk" class="gap-4.5 flex flex-col">
          <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />

          <Input id="name" name="name" label="Your Name" autocomplete="name" required />
          <Input
            id="email"
            name="_replyto"
            label="Email Address"
            type="email"
            autocomplete="email"
            required
          />
          <Input id="company" name="company" label="Company Name" autocomplete="organization" />
          <Input
            id="website"
            name="website"
            label="Website"
            type="url"
            inputmode="url"
            autocomplete="url"
            required
          />

          <Button
            type="submit"
            variant="primary"
            size="md"
            class="mt-1.5"
            data-evt="cta_hero_free_audit"
          >
            Get My Free Audit
          </Button>
        </form>

        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </Card>
    </div>
  </section>

  <!-- BLOG LIST (identical to index.astro, but fed by page.data) -->
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      {
        page.data.length === 0 ? (
          <p class="text-gray-600">No posts published yet.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {page.data.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      <!-- Pager: identical look, links without trailing slash -->
      <nav class="mt-10 flex items-center justify-center gap-3">
        <a
          href={page.currentPage > 2
            ? `/blog/${page.currentPage - 1}`
            : page.currentPage > 1
              ? `/blog`
              : "#"}
          class="btn-outline-primary btn btn-sm disabled:opacity-40"
          aria-disabled={page.currentPage === 1}
        >
          Prev
        </a>
        <span class="text-sm">
          Page {page.currentPage} of {page.lastPage}
        </span>
        <a
          href={page.currentPage < page.lastPage ? `/blog/${page.currentPage + 1}` : "#"}
          class="btn-outline-primary btn btn-sm disabled:opacity-40"
          aria-disabled={page.currentPage === page.lastPage}
        >
          Next
        </a>
      </nav>
    </div>
  </section>

  <section class="border-t border-gray-100 bg-gray-50 py-10">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-2">
      <div>
        <h2 class="mb-3 text-lg font-bold text-heading">Browse Categories</h2>
        <ul class="flex flex-wrap gap-2">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/blog/category/${encodeURIComponent(category)}`}
                  class="inline-flex rounded-full border border-gray-300 bg-white px-3 py-1 text-sm text-body transition hover:border-primary hover:text-primary"
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-lg font-bold text-heading">Browse Tags</h2>
        <ul class="flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li>
                <a
                  href={`/blog/tag/${encodeURIComponent(tag)}`}
                  class="inline-flex rounded-full border border-gray-300 bg-white px-3 py-1 text-sm text-body transition hover:border-primary hover:text-primary"
                >
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

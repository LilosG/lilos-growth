---
import PageLayout from '~/layouts/PageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

/** Pagination settings (used at render-time below) */
const PAGE_SIZE = 12 as const;

/** Build paginated paths for /blog/2, /blog/3, ... (page 1 is /blog) */
export async function getStaticPaths() {
  // Local constant to avoid any tree-shake weirdness
  const PAGE_SIZE_LOCAL = 12 as const;

  const all = (await getCollection('blog'))
    .filter((p: CollectionEntry<'blog'>) => !p.data?.draft)
    .sort(
      (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
        new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
    );

  const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE_LOCAL));

  // IMPORTANT: [...page] expects an array param; generate /blog/2..N
  const paths: Array<{ params: { page: string[] }; props: { page: number; totalPages: number } }> = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({ params: { page: [String(i)] }, props: { page: i, totalPages } });
  }
  return paths;
}

/** Props from getStaticPaths */
const { page, totalPages } = Astro.props as { page: number; totalPages: number };

/** Compute entries for this page */
const allEntries = (await getCollection('blog'))
  .filter((p: CollectionEntry<'blog'>) => !p.data?.draft)
  .sort(
    (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

const start = (page - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;

type BlogFrontmatter = {
  title: string;
  excerpt?: string;
  author?: string;
  date: string | Date;
  cover?: string;
  alt?: string;
};

const posts: Array<{ slug: string; data: BlogFrontmatter }> = allEntries
  .slice(start, end)
  .map((p: CollectionEntry<'blog'>) => ({ slug: p.slug, data: p.data as BlogFrontmatter }));

const pageTitle = `Insights & Playbooks — Page ${page}`;
const pageDescription =
  'Practical guides on Astro, Tailwind, and Local SEO for home-service brands—focused on rankings, speed, and conversions.';
const canonical = `/blog/${page}`;
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={[
    { name: 'Home', item: '/' },
    { name: 'Blog', item: '/blog' },
    { name: `Page ${page}`, item: `/blog/${page}` },
  ]}
  schema={[]}
  noIndex={false}
>
  <!-- HERO -->
  <section class="bg-slate-800 min-h-72 flex flex-col items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-800 to-slate-700 pointer-events-none"></div>
    <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-3 px-4 mx-auto text-center">
      <h1 class="text-3xl md:text-4xl font-heading text-white font-extrabold leading-tight tracking-tight">
        Insights &amp; Playbooks
      </h1>
      <p class="text-base md:text-lg text-white/80 max-w-2xl">Local SEO • AEO • Astro/Astrowind</p>
      <p class="text-base md:text-lg text-white/80 max-w-2xl">
        Practical guides for home-service brands—focused on rankings, speed, and conversions.
      </p>
    </div>
  </section>

  <!-- GRID -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {
          posts.map((p: { slug: string; data: BlogFrontmatter }) => {
            const d = p.data;
            const href = `/blog/${p.slug}`;
            return (
              <article class="rounded-2xl border border-gray-200 shadow-sm overflow-hidden bg-white flex flex-col">
                <a href={href} class="block">
                  <div class="relative w-full">
                    <div class="h-44 w-full bg-gray-100" />
                    {d.cover && (
                      <img
                        src={String(d.cover)}
                        alt={String(d.alt ?? d.title)}
                        class="absolute inset-0 h-full w-full object-cover"
                        loading="lazy"
                        decoding="async"
                        width="1600"
                        height="900"
                      />
                    )}
                  </div>
                </a>
                <div class="p-5 flex flex-col gap-3 flex-1">
                  <p class="text-xs text-gray-500">
                    {d.author && <span>By {String(d.author)} · </span>}
                    <time datetime={new Date(d.date).toISOString()}>
                      {new Date(d.date).toLocaleDateString(undefined, {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </p>
                  <h2 class="text-lg font-semibold leading-snug">
                    <a href={href} class="hover:underline">
                      {String(d.title)}
                    </a>
                  </h2>
                  {d.excerpt && <p class="text-sm text-gray-600 line-clamp-3">{String(d.excerpt)}</p>}
                  <div class="mt-auto pt-2">
                    <a
                      href={href}
                      class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 hover:underline"
                    >
                      Read more
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6l6 6-6 6" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>

      <!-- PAGINATION -->
      <nav class="mt-10 flex items-center justify-center gap-2" aria-label="Pagination">
        {
          page > 2 && (
            <a href="/blog/2" class="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm">
              2
            </a>
          )
        }
        {
          page > 1 ? (
            <a
              href={page === 2 ? '/blog' : `/blog/${page - 1}`}
              class="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm"
            >
              Prev
            </a>
          ) : null
        }
        <span class="px-3 py-2 rounded-lg bg-gray-900 text-white text-sm">{page}</span>
        {
          page < totalPages && (
            <a href={`/blog/${page + 1}`} class="px-3 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm">
              Next
            </a>
          )
        }
      </nav>
    </div>
  </section>

  <!-- Canonical is handled here so we don't touch layout internals -->
  <head>
    <link rel="canonical" href={canonical} />
  </head>
</PageLayout>

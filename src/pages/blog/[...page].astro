---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

type BlogEntry = CollectionEntry<'blog'>;
const PAGE_SIZE = 9;

// Load posts (exclude drafts) and sort by updated || date (desc).
const allPosts = (await getCollection('blog', (entry: BlogEntry) => !entry.data.draft)) as BlogEntry[];
allPosts.sort((a: BlogEntry, b: BlogEntry) => {
  const ad = new Date(a.data.updated ?? a.data.date).getTime();
  const bd = new Date(b.data.updated ?? b.data.date).getTime();
  return bd - ad;
});

const raw = (Astro.params.page ?? '1').toString();
const firstSeg = raw.split('/')[0] ?? '1';
const currentPage = Math.max(1, Number(firstSeg));

const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
if (currentPage > totalPages) {
  const dest = totalPages === 1 ? '/blog' : `/blog/${totalPages}`;
  return Astro.redirect(dest, 302);
}

const start = (currentPage - 1) * PAGE_SIZE;
const end = start + PAGE_SIZE;
const pageSlice = allPosts.slice(start, end);

const linkForPost = (slug: string) => `/blog/${slug}`;
const pageHref = (n: number) => (n === 1 ? '/blog' : `/blog/${n}`);
const pageTitle = `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`;
const pageDescription = 'Tactical guides for home-service brands—Astro, Tailwind, Local SEO & AEO.';
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<PageLayout title={pageTitle} description={pageDescription}>
  <astro-head>
    <link rel="canonical" href={currentPage === 1 ? '/blog' : `/blog/${currentPage}`} />
    <meta name="robots" content="index,follow" />
  </astro-head>

  <!-- HERO — same as index -->
  <section class="relative overflow-hidden bg-[#1f2d3d]">
    <div class="absolute inset-0 bg-gradient-to-br from-[#1f2d3d] to-[#2b3e55]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto flex min-h-[420px] max-w-3xl flex-col items-center justify-center text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-white md:text-5xl">Insights & Playbooks</h1>
        <span class="mt-3 inline-block text-sm font-semibold uppercase tracking-wider text-[#f56b2a]">
          Local SEO • AEO • Astro/AstroWind
        </span>
        <p class="mt-4 max-w-2xl text-base text-white/80 md:text-lg">
          Practical guides for home-service brands—focused on rankings, speed, and conversions.
        </p>
      </div>
    </div>
  </section>

  <!-- CONTENT -->
  <main class="relative bg-white">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-10 sm:px-6 lg:px-8 md:pt-14">
      {
        pageSlice.length === 0 ? (
          <div class="py-20 text-center text-gray-500">No posts on this page.</div>
        ) : (
          <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {pageSlice.map((post: BlogEntry) => {
              const d = post.data;
              const when = new Date(d.updated ?? d.date);
              const displayDate = formatDate(when.toISOString());

              const coverObj = (d as any).cover;
              const coverSrc =
                typeof coverObj === 'object' && coverObj?.src
                  ? coverObj.src
                  : typeof coverObj === 'string'
                    ? coverObj
                    : undefined;
              const coverW = typeof coverObj === 'object' && coverObj?.width ? Number(coverObj.width) : undefined;
              const coverH = typeof coverObj === 'object' && coverObj?.height ? Number(coverObj.height) : undefined;
              const alt = (d as any).alt ?? (d as any).coverAlt ?? d.title ?? 'Blog cover';

              const href = linkForPost(post.slug);

              return (
                <li class="group flex flex-col rounded-2xl border border-black/5 bg-white/70 shadow-sm ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-md">
                  <a href={href} class="block focus:outline-none" aria-label={d.title}>
                    {coverSrc ? (
                      <div class="overflow-hidden rounded-t-2xl bg-gray-100">
                        <img
                          src={coverSrc}
                          width={coverW}
                          height={coverH}
                          alt={alt}
                          loading="lazy"
                          decoding="async"
                          class="h-auto w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                          style={!(coverW && coverH) ? 'aspect-ratio: 16/9;' : undefined}
                        />
                      </div>
                    ) : (
                      <div class="rounded-t-2xl bg-gray-100" style="aspect-ratio: 16/9;" aria-hidden="true" />
                    )}
                  </a>

                  <div class="flex flex-1 flex-col p-5">
                    <div class="mb-2 text-sm text-gray-500">
                      {d.author ? <span>By {d.author}</span> : null}
                      <span class="mx-1" aria-hidden="true">
                        •
                      </span>
                      <time datetime={when.toISOString()}>{displayDate}</time>
                    </div>

                    <h2 class="text-lg font-semibold text-gray-900">
                      <a href={href} class="hover:underline focus:outline-none">
                        {d.title}
                      </a>
                    </h2>

                    {(d as any).excerpt || (d as any).description ? (
                      <p class="mt-2 line-clamp-3 text-sm text-gray-600">
                        {((d as any).excerpt ?? (d as any).description) as string}
                      </p>
                    ) : null}

                    {Array.isArray((d as any).tags) && (d as any).tags.length ? (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {(d as any).tags.slice(0, 3).map((t: string) => (
                          <span class="rounded-full border border-gray-200 px-2 py-1 text-xs text-gray-700">{t}</span>
                        ))}
                      </div>
                    ) : null}

                    <div class="mt-auto pt-5">
                      <a
                        href={href}
                        class="inline-flex items-center text-sm font-medium text-gray-900 underline-offset-4 hover:underline"
                      >
                        Read more
                        <svg class="ml-1 h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path
                            fill-rule="evenodd"
                            d="M10.293 3.293a1 1 0 011.414 0l5 5a1 1 0 01.083 1.32l-.083.094-5 5a1 1 0 01-1.497-1.32l.083-.094L13.585 10H4a1 1 0 01-.117-1.993L4 8h9.585l-3.292-3.293a1 1 0 01-.083-1.32l.083-.094z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        )
      }

      {
        totalPages > 1 ? (
          <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
            <a
              href={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
              aria-disabled={currentPage === 1}
              class={`rounded-lg border px-3 py-2 text-sm ${
                currentPage === 1
                  ? 'cursor-not-allowed border-gray-200 text-gray-300'
                  : 'border-gray-300 text-gray-700 hover:bg-gray-50'
              }`}
              rel="prev"
            >
              Previous
            </a>
            <ul class="flex items-center gap-1">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
                <li>
                  <a
                    href={pageHref(n)}
                    aria-current={n === currentPage ? 'page' : undefined}
                    class={`rounded-lg px-3 py-2 text-sm ${
                      n === currentPage ? 'bg-gray-900 text-white' : 'text-gray-700 hover:bg-gray-100'
                    }`}
                  >
                    {n}
                  </a>
                </li>
              ))}
            </ul>
            <a
              href={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
              aria-disabled={currentPage === totalPages}
              class={`rounded-lg border px-3 py-2 text-sm ${
                currentPage === totalPages
                  ? 'cursor-not-allowed border-gray-200 text-gray-300'
                  : 'border-gray-300 text-gray-700 hover:bg-gray-50'
              }`}
              rel="next"
            >
              Next
            </a>
          </nav>
        ) : null
      }
    </div>
  </main>
</PageLayout>

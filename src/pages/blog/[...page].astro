---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { toListing, getSlug, type BlogEntry } from "../../lib/blog";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const pageSize = 12; // match index.astro
  const entries: BlogEntry[] = await getCollection("blog");
  const ordered = toListing(entries); // newest first, drafts hidden unless LOCAL_DRAFTS=1
  const uniq = Array.from(new Map(ordered.map((p) => [p.slug, p])).values());
  return paginate(uniq, { pageSize });
}

type PageProps = {
  page: {
    data: BlogEntry[];
    current: number;
    last: number;
  };
};
const { page } = Astro.props as PageProps;

const pageTitle = "Blog";
const pageDescription =
  "Latest articles on Local SEO, Google Business Profile, websites, and growth.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  metadata={{ title: pageTitle, description: pageDescription }}
>
  <!-- HERO SECTION (identical to index.astro) -->
  <section
    class="relative flex min-h-[680px] items-center overflow-hidden bg-[#253242] pb-20 pt-10"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]">
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 md:flex-row md:items-center"
    >
      <div class="flex-1">
        <img
          src="/Lilos_Growth_Logo_Corrected.svg"
          alt="Lilos Growth Logo"
          class="mb-10 w-40"
          fetchpriority="high"
        />
        <h1
          class="mb-2 text-left font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-6xl"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span
            class="mb-2 mt-3 block text-xl font-semibold uppercase tracking-wider text-[#f56b2a] md:text-3xl"
          >
            For Home Service Businesses
          </span>
        </h1>
        <div class="mb-8 h-1.5 w-28 rounded-full bg-[#f56b2a]"></div>
        <p class="mb-9 max-w-lg text-lg font-medium text-white/80 md:text-xl">
          Get more calls, book more jobs, and gain peace of mind—without tech overwhelm. Lilos
          Growth delivers actionable marketing for local service pros.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-8 py-3.5 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#f34e00]"
            aria-label="Get Started — open contact form"
          >
            Get More Calls Today
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="/packages"
            class="hidden items-center rounded-2xl bg-secondary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#27394b] md:inline-flex"
            data-evt="cta_hero_see_services"
          >
            See Our Services
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <div
        id="contact"
        class="mx-auto max-w-md flex-1 rounded-3xl border border-gray-100 bg-white p-10 shadow-xl md:mx-0"
      >
        <h2 class="mb-4 text-left font-heading text-xl font-bold text-heading">
          Free SEO Website Audit for Home Service Pros!
        </h2>

        <form
          name="seo-audit"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="gap-4.5 flex flex-col"
          action="/thank-you"
        >
          <input type="hidden" name="form-name" value="seo-audit" />
          <p class="hidden">
            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="name" class="sr-only">Your Name</label>
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Your Name"
              autocomplete="name"
              class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="email" class="sr-only">Email Address</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="Email Address"
              autocomplete="email"
              class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="company" class="sr-only">Company Name</label>
            <input
              id="company"
              type="text"
              name="company"
              placeholder="Company Name"
              autocomplete="organization"
              class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
            />
          </div>

          <div>
            <label for="website" class="sr-only">Website</label>
            <input
              id="website"
              type="url"
              name="website"
              placeholder="Website"
              inputmode="url"
              autocomplete="url"
              class="w-full rounded-lg border border-gray-300 px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-1.5 rounded-xl bg-[#f56b2a] px-7 py-3.5 font-heading text-base font-semibold text-white shadow transition hover:bg-[#f34e00]"
            data-evt="cta_hero_free_audit"
          >
            Get My Free Audit
          </button>
        </form>

        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </div>
    </div>
  </section>

  <!-- BLOG LIST (identical to index.astro, but fed by page.data) -->
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      {
        page.data.length === 0 ? (
          <p class="text-gray-600">No posts published yet.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {page.data.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      <!-- Pager: identical look, links without trailing slash -->
      <nav class="mt-10 flex items-center justify-center gap-3">
        <a
          href={page.current > 2 ? `/blog/${page.current - 1}` : page.current > 1 ? `/blog` : "#"}
          class="btn btn-sm btn-outline-primary disabled:opacity-40"
          aria-disabled={page.current === 1}
        >
          Prev
        </a>
        <span class="text-sm">Page {page.current} of {page.last}</span>
        <a
          href={page.current < page.last ? `/blog/${page.current + 1}` : "#"}
          class="btn btn-sm btn-outline-primary disabled:opacity-40"
          aria-disabled={page.current === page.last}
        >
          Next
        </a>
      </nav>
    </div>
  </section>
</Layout>

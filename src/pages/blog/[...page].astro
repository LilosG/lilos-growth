---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import { toListing, getSlug, type BlogEntry } from '../../lib/blog';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const pageSize = 12; // match index.astro
  const entries: BlogEntry[] = await getCollection('blog');
  const ordered = toListing(entries); // newest first, drafts hidden unless LOCAL_DRAFTS=1
  const uniq = Array.from(new Map(ordered.map((p) => [p.slug, p])).values());
  return paginate(uniq, { pageSize });
}

type PageProps = {
  page: {
    data: BlogEntry[];
    current: number;
    last: number;
  };
};
const { page } = Astro.props as PageProps;

const pageTitle = 'Blog | Lilos Growth';
const pageDescription = 'Latest articles on Local SEO, Google Business Profile, websites, and growth.';
---

<Layout title={pageTitle} description={pageDescription} metadata={{ title: pageTitle, description: pageDescription }}>
  <!-- HERO SECTION (identical to index.astro) -->
  <section class="bg-[#253242] min-h-[680px] flex items-center pt-10 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>

    <div class="relative z-10 max-w-6xl mx-auto w-full flex flex-col md:flex-row md:items-center gap-14 px-4">
      <div class="flex-1">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-10 w-40" fetchpriority="high" />
        <h1
          class="text-4xl md:text-6xl font-heading text-white font-extrabold mb-2 leading-tight text-left tracking-tight"
        >
          Local SEO & Digital Marketing<br class="hidden md:block" />
          <span class="block text-xl md:text-3xl font-semibold mt-3 mb-2 text-[#f56b2a] tracking-wider uppercase">
            For Home Service Businesses
          </span>
        </h1>
        <div class="h-1.5 w-28 bg-[#f56b2a] rounded-full mb-8"></div>
        <p class="text-lg md:text-xl text-white/80 mb-9 max-w-lg font-medium">
          Get more calls, book more jobs, and gain peace of mind—without tech overwhelm. Lilos Growth delivers
          actionable marketing for local service pros.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="#contact"
            class="inline-flex items-center px-8 py-3.5 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
            aria-label="Get Started — open contact form"
          >
            Get More Calls Today
            <svg
              class="ml-2 w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="/packages"
            class="hidden md:inline-flex items-center px-6 py-3 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-base shadow transition"
            data-evt="cta_hero_see_services"
          >
            See Our Services
            <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <div
        id="contact"
        class="flex-1 max-w-md mx-auto md:mx-0 bg-white p-10 rounded-3xl shadow-xl border border-gray-100"
      >
        <h2 class="text-xl font-heading text-heading font-bold mb-4 text-left">
          Free SEO Website Audit for Home Service Pros!
        </h2>

        <form
          name="seo-audit"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="flex flex-col gap-4.5"
          action="/thank-you"
        >
          <input type="hidden" name="form-name" value="seo-audit" />
          <p class="hidden">
            <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
          </p>

          <div>
            <label for="name" class="sr-only">Your Name</label>
            <input
              id="name"
              type="text"
              name="name"
              placeholder="Your Name"
              autocomplete="name"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="email" class="sr-only">Email Address</label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="Email Address"
              autocomplete="email"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <div>
            <label for="company" class="sr-only">Company Name</label>
            <input
              id="company"
              type="text"
              name="company"
              placeholder="Company Name"
              autocomplete="organization"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
            />
          </div>

          <div>
            <label for="website" class="sr-only">Website</label>
            <input
              id="website"
              type="url"
              name="website"
              placeholder="Website"
              inputmode="url"
              autocomplete="url"
              class="w-full border border-gray-300 rounded-lg px-4 py-3.5 text-base focus:outline-none focus:ring-2 focus:ring-[#f56b2a]/40"
              required
            />
          </div>

          <button
            type="submit"
            class="mt-1.5 px-7 py-3.5 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#f34e00] transition"
            data-evt="cta_hero_free_audit"
          >
            Get My Free Audit
          </button>
        </form>

        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </div>
    </div>
  </section>

  <!-- BLOG LIST (identical to index.astro, but fed by page.data) -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4">
      {
        page.data.length === 0 ? (
          <p class="text-gray-600">No posts published yet.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {page.data.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      <!-- Pager: identical look, links without trailing slash -->
      <nav class="mt-10 flex items-center justify-center gap-3">
        <a
          href={page.current > 2 ? `/blog/${page.current - 1}` : page.current > 1 ? `/blog` : '#'}
          class="btn btn-outline-primary btn-sm disabled:opacity-40"
          aria-disabled={page.current === 1}
        >
          Prev
        </a>
        <span class="text-sm">Page {page.current} of {page.last}</span>
        <a
          href={page.current < page.last ? `/blog/${page.current + 1}` : '#'}
          class="btn btn-outline-primary btn-sm disabled:opacity-40"
          aria-disabled={page.current === page.last}
        >
          Next
        </a>
      </nav>
    </div>
  </section>
</Layout>

---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../../../components/BlogCard.astro";
import { toListing, byTag, getSlug, type BlogEntry } from "../../../../lib/blog";

export async function getStaticPaths() {
  const posts: BlogEntry[] = await getCollection("blog");
  const published = toListing(posts); // removes drafts unless LOCAL_DRAFTS=1
  const tags = new Set<string>();
  for (const p of published) {
    const t = (p.data as Record<string, unknown>).tags;
    if (Array.isArray(t)) for (const x of t) tags.add(String(x));
  }
  return Array.from(tags).map((t) => ({ params: { tag: t } }));
}

const tag = String(Astro.params.tag ?? "").trim();

const page = 1;
const pageSize = 12;

const all: BlogEntry[] = await getCollection("blog");
const filtered = toListing(all, byTag(tag)); // newest-first, drafts filtered

const slice = filtered.slice(0, pageSize);
const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));

const title = `Posts tagged “${tag}”`;
const description = `Actionable articles about ${tag} for home-service SEO and growth.`;
---

<Layout title={title} description={description} metadata={{ title, description }} noIndex={true}>
  <!-- HERO (same structure as homepage; copy with tag-specific copy) -->
  <section
    class="relative flex min-h-[680px] items-center overflow-hidden bg-secondary pb-20 pt-10"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light">
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-6xl flex-col gap-14 px-4 md:flex-row md:items-center"
    >
      <!-- Left -->
      <div class="flex-1">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-10 w-40 logo--halo" />
        <h1
          class="mb-2 font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
        >
          Articles about <span class="text-primary">{tag}</span>
        </h1>
        <div class="mb-8 h-1.5 w-28 rounded-full bg-primary"></div>
        <p class="mb-9 max-w-lg text-lg font-medium text-white/80 md:text-xl">
          Guides and case-study style posts focused on {tag}. Learn what to implement next to win
          more local, high-intent searches.
        </p>
        <div class="flex flex-wrap gap-3.5">
          <a
            href="/packages"
            class="inline-flex items-center rounded-2xl bg-primary px-8 py-3.5 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
          >
            Get More Calls Today
            <svg
              class="ml-2 h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center rounded-2xl bg-secondary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-secondary-hover"
          >
            Book a Call
            <svg
              class="ml-2 h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 18l6-6-6-6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: lead form -->
      <div
        id="contact"
        class="mx-auto max-w-md flex-1 rounded-3xl border border-gray-100 bg-white p-10 shadow-xl md:mx-0"
      >
        <h2 class="mb-4 text-left font-heading text-xl font-bold text-heading">
          Free SEO Website Audit for Home Service Pros!
        </h2>
        <form method="POST" action="https://formspree.io/f/movlbqdk" class="gap-4.5 flex flex-col">
          <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />

          <label class="sr-only" for="name">Your Name</label>
          <input
            id="name"
            name="name"
            placeholder="Your Name"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-primary/40"
          />

          <label class="sr-only" for="email">Email Address</label>
          <input
            id="email"
            type="email"
            name="_replyto"
            placeholder="Email Address"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-primary/40"
          />

          <label class="sr-only" for="company">Company Name</label>
          <input
            id="company"
            name="company"
            placeholder="Company Name"
            class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-primary/40"
          />

          <label class="sr-only" for="website">Website</label>
          <input
            id="website"
            type="url"
            name="website"
            placeholder="Website"
            required
            class="w-full rounded-lg border border-gray-300 px-4 py-3.5 focus:outline-none focus:ring-2 focus:ring-primary/40"
          />

          <button
            type="submit"
            class="mt-1.5 rounded-xl bg-primary px-7 py-3.5 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-dark"
          >
            Get My Free Audit
          </button>
        </form>
        <p class="mt-3 text-sm text-gray-600">No spam. We’ll reply within 1 business day.</p>
      </div>
    </div>
  </section>

  <!-- LIST -->
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4">
      {
        slice.length === 0 ? (
          <p class="text-gray-600">No posts found for this tag.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {slice.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      {
        totalPages > 1 && (
          <nav class="mt-10 flex items-center justify-center gap-3">
            <a
              href="#"
              class="btn btn-sm btn-outline-primary disabled:opacity-40"
              aria-disabled={true}
            >
              Prev
            </a>
            <span class="text-sm">
              Page {page} of {totalPages}
            </span>
            <a
              href={`/blog/tag/${encodeURIComponent(tag)}/${Math.min(totalPages, page + 1)}`}
              class="btn btn-sm btn-outline-primary disabled:opacity-40"
              aria-disabled={page === totalPages}
            >
              Next
            </a>
          </nav>
        )
      }
    </div>
  </section>
</Layout>

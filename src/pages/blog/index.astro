---
import Layout from "~/layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { toListing, getSlug, type BlogEntry } from "../../lib/blog";

const page = 1;
const pageSize = 12;

const entries: BlogEntry[] = await getCollection("blog");
const ordered = toListing(entries); // newest first, drafts hidden unless LOCAL_DRAFTS=1

const total = ordered.length;
const slice = ordered.slice(0, pageSize);
const totalPages = Math.max(1, Math.ceil(total / pageSize));

const categories = Array.from(new Set(ordered.map((entry) => entry.data.category))).sort();
const tags = Array.from(
  new Set(
    ordered.flatMap((entry) => entry.data.tags ?? []).filter((tag) => tag && tag.trim().length > 0)
  )
).sort((a, b) => a.localeCompare(b));

const pageTitle = "Blog";
const pageDescription =
  "Latest articles on Local SEO, Google Business Profile, websites, and growth.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  metadata={{ title: pageTitle, description: pageDescription }}
>
  <!-- HERO SECTION -->
  <section
    class="relative flex min-h-[280px] items-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-12 pt-12"
  >
    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 text-center">
      <h1
        class="mb-3 font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-4xl lg:text-5xl"
      >
        Blog
      </h1>
      <p class="mx-auto max-w-2xl text-base font-medium leading-relaxed text-white/90 md:text-lg">
        Latest articles on Local SEO, Google Business Profile, websites, and growth strategies for
        home service businesses.
      </p>
    </div>
  </section>

  <!-- BLOG LIST -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      {
        slice.length === 0 ? (
          <p class="text-center text-base text-body">No posts published yet.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {slice.map((p) => (
              <BlogCard
                href={`/blog/${getSlug(p)}`}
                title={p.data.title}
                description={p.data.description}
                datePublished={p.data.datePublished ?? p.data.pubDate}
                category={p.data.category}
                tags={p.data.tags}
              />
            ))}
          </div>
        )
      }

      {
        totalPages > 1 && (
          <nav class="mt-10 flex items-center justify-center gap-4">
            <a
              href="#"
              class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-body transition hover:bg-gray-50 disabled:opacity-40"
              aria-disabled={true}
            >
              Prev
            </a>
            <span class="text-sm font-medium text-body">
              Page {page} of {totalPages}
            </span>
            <a
              href={`/blog/${Math.min(totalPages, page + 1)}`}
              class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-body transition hover:bg-gray-50 disabled:opacity-40"
              aria-disabled={page === totalPages}
            >
              Next
            </a>
          </nav>
        )
      }
    </div>
  </section>

  <section class="border-t border-gray-100 bg-gray-50 py-10">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 lg:grid-cols-2">
      <div>
        <h2 class="mb-3 text-lg font-bold text-heading">Browse Categories</h2>
        <ul class="flex flex-wrap gap-2">
          {
            categories.map((category) => (
              <li>
                <a
                  href={`/blog/category/${encodeURIComponent(category)}`}
                  class="inline-flex rounded-full border border-gray-300 bg-white px-3 py-1 text-sm text-body transition hover:border-primary hover:text-primary"
                >
                  {category}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-3 text-lg font-bold text-heading">Browse Tags</h2>
        <ul class="flex flex-wrap gap-2">
          {
            tags.map((tag) => (
              <li>
                <a
                  href={`/blog/tag/${encodeURIComponent(tag)}`}
                  class="inline-flex rounded-full border border-gray-300 bg-white px-3 py-1 text-sm text-body transition hover:border-primary hover:text-primary"
                >
                  #{tag}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Layout>

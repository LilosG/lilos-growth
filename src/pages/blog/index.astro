---
import PageLayout from '~/layouts/PageLayout.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const title = 'Blog | Lilos Growth';
const description =
  'Insights on Local SEO, Google Business Profile, and conversion-focused websites for home-service pros.';
---

<PageLayout
  {title}
  {description}
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
>
  <section class="container mx-auto max-w-5xl px-6 md:px-8 py-16 md:py-24">
    <h1 class="font-heading text-4xl md:text-5xl tracking-tight">Blog</h1>
    <p class="mt-3 text-base md:text-lg text-gray-600">
      Articles on Local SEO, Google Business Profile, and high-converting websites—written for home-service businesses.
    </p>

    <div class="mt-10">
      <BlogLatestPosts />
    </div>
  </section>
</PageLayout>

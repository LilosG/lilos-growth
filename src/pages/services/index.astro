---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>SEO & Digital Marketing Services for Home Service Businesses | Lilos Growth</title>
    <meta
      name="description"
      content="Get more calls and booked jobs with proven Google Business Profile optimization, Local SEO, and web design for home service businesses. Transparent pricing and real results."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- HERO SECTION -->
    <section
      class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
          Local SEO & Digital Marketing
        </h1>
        <span class="block text-xl md:text-2xl font-semibold mt-2 mb-2 text-[#f56b2a] tracking-wider uppercase">
          Services For Home Service Businesses
        </span>
        <p class="text-lg md:text-xl text-white/80 mb-7 max-w-2xl font-medium">
          Get more calls and booked jobs with services tailored for plumbers, HVAC, cleaning, pest control, landscaping,
          and other local trades. No contracts, no fluff—just results.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="#core-services"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            Explore Services <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <a
            href="#packages"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            See Packages <svg
              class="ml-2 w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <!-- WHO WE HELP -->
    <section class="py-16 bg-cream border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">Who We Help</h2>
        <p class="text-lg text-body mb-6">
          We work with all types of local home service businesses—if you book jobs in your city or town, our services
          are for you:
        </p>
        <div class="flex flex-wrap gap-3 justify-center mb-2">
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Plumbers</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">HVAC</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Electricians</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Roofers</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Cleaning</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Pest Control</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Landscaping</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Painters</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Other Trades</span>
        </div>
        <p class="text-sm text-body/70 mt-3">
          Not sure if we can help your niche? <a href="#contact" class="text-primary underline hover:text-[#f56b2a]"
            >Ask us today</a
          >—chances are, we’ve worked with your industry!
        </p>
      </div>
    </section>

    <!-- CORE SERVICES -->
    <section id="core-services" class="py-24 bg-white border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-10 text-center">
          Our Core Services
          <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-10">
          <!-- Service 1 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col group"
          >
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a] flex items-center gap-2">
              <span>Google Business Profile Optimization</span>
            </h3>
            <p class="mb-4">
              Rank higher in the Google Map Pack and get more calls with full profile optimization, posting, and review
              management built for home service businesses.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Claim, optimize, and manage your GBP listing</li>
              <li>Ongoing reviews & photo updates</li>
              <li>Monthly reporting & progress tracking</li>
            </ul>
            <a
              href="/services/google-business-profile"
              class="text-primary underline mt-auto font-semibold group-hover:text-[#f56b2a]">Learn more &rarr;</a
            >
          </div>
          <!-- Service 2 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col group"
          >
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a] flex items-center gap-2">
              <span>Local SEO & Content</span>
            </h3>
            <p class="mb-4">
              Own your service area with expert local SEO, weekly blogs, location/service pages, and high-intent
              keywords—plus full technical optimization for Google and AI search.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Weekly content & blog posting</li>
              <li>Service/location pages for your city</li>
              <li>Citation building & cleanup</li>
            </ul>
            <a
              href="/services/local-seo-content"
              class="text-primary underline mt-auto font-semibold group-hover:text-[#f56b2a]">Learn more &rarr;</a
            >
          </div>
          <!-- Service 3 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col group"
          >
            <h3 class="font-heading text-xl font-bold mb-4 text-[#f56b2a] flex items-center gap-2">
              <span>Website Design & Conversion</span>
            </h3>
            <p class="mb-4">
              Modern, mobile-friendly websites and landing pages that build trust and convert visitors into booked jobs.
              Easy editing and support included.
            </p>
            <ul class="mb-3 list-disc list-inside text-body text-base">
              <li>Lightning-fast, secure hosting</li>
              <li>Conversion-focused landing pages</li>
              <li>Lead capture, reviews, and calls built in</li>
            </ul>
            <a
              href="/services/web-design"
              class="text-primary underline mt-auto font-semibold group-hover:text-[#f56b2a]">Learn more &rarr;</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US -->
    <section class="py-24 bg-cream border-t border-gray-100" id="why">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
          Why Home Service Pros Trust Lilos Growth
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-14">
          <!-- Value 1: Built by Home Service Owners -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M3 12l6 6l12-12"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Built by Home Service Owners</h3>
            <p class="text-body text-center">
              Lilos Growth was created by former home service business owners who know what works—and what doesn’t—when
              marketing for local trades. We get it because we’ve lived it.
            </p>
          </div>
          <!-- Value 2: Specialists in Home Services -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="10"></circle></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Specialists in Home Services</h3>
            <p class="text-body text-center">We know the industry inside and out—no generic marketing here.</p>
          </div>
          <!-- Value 3: No Long-Term Contract -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M4 7l8 8l8-8"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Long-Term Contract</h3>
            <p class="text-body text-center">
              Stay as long as we’re delivering real results. We work to earn your business every month—no setup fees, no
              hidden terms.
            </p>
          </div>
          <!-- Value 4: Results You Can See -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M5 12l5 5L20 7"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Results You Can See</h3>
            <p class="text-body text-center">
              Local rankings, calls, and jobs—measurable improvements, not vanity metrics.
            </p>
          </div>
          <!-- Value 5: No Big Agency Fluff -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><path d="M12 8v4l3 3"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Big Agency Fluff</h3>
            <p class="text-body text-center">
              Direct, personal attention from a dedicated strategist. No “account managers” or runarounds.
            </p>
          </div>
          <!-- Value 6: Easy, Honest, & Human -->
          <div
            class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
          >
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                ><circle cx="9" cy="10" r="1"></circle><circle cx="15" cy="10" r="1"></circle><path
                  d="M8 15s1.5-2 4-2 4 2 4 2"></path></svg
              >
            </span>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Easy, Honest, & Human</h3>
            <p class="text-body text-center">Clear reporting, no confusing jargon, and a process that makes sense.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS (4-Step System) -->
    <section class="py-24 bg-white border-t border-gray-100" id="process">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-6 text-center">
          Our Proven 4-Step Local SEO System
          <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-lg text-center text-body mb-12">
          Here's exactly how we get your business ranking higher and bringing in more local calls—no guesswork, just
          results.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Step 1 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col items-center"
          >
            <div
              class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-2xl font-extrabold"
            >
              1
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Keyword & Market Research</h3>
            <p class="text-body text-center">
              We start with data—uncovering what your local customers actually search for. Every strategy is built on
              real search volume and opportunity, not guesses.
            </p>
          </div>
          <!-- Step 2 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col items-center"
          >
            <div
              class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-2xl font-extrabold"
            >
              2
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Profile & Website Optimization</h3>
            <p class="text-body text-center">
              We fully optimize your Google Business Profile and website—fixing technical issues, adding your best
              services, and making it easy for customers to find and contact you.
            </p>
          </div>
          <!-- Step 3 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col items-center"
          >
            <div
              class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-2xl font-extrabold"
            >
              3
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Content & Authority Building</h3>
            <p class="text-body text-center">
              We publish location-focused pages and helpful blog content, then build high-quality links that increase
              your authority, visibility, and trust with Google.
            </p>
          </div>
          <!-- Step 4 -->
          <div
            class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 hover:shadow-2xl transition duration-200 p-8 flex flex-col items-center"
          >
            <div
              class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-2xl font-extrabold"
            >
              4
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Ongoing Management & Results</h3>
            <p class="text-body text-center">
              We track your progress, report wins, and keep optimizing—new content, smart updates, and regular strategy
              tweaks. You get clear results and more calls, month after month.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- MINI CASE STUDY / REVIEW (optional, for proof and trust) -->
    <section class="py-12 bg-white border-t border-gray-100">
      <div class="max-w-3xl mx-auto px-4">
        <div class="bg-cream rounded-2xl shadow p-8 text-center mx-auto">
          <p class="text-lg font-medium mb-2">
            “After just 60 days, we jumped from the bottom of Google Maps to the top 3. The phones ring every week now.
            Wish we’d switched sooner.”
          </p>
          <div class="flex items-center justify-center gap-2 text-sm text-body/70">
            <span>— John T., Plumbing Business Owner</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE PACKAGES SECTION - UNIFIED STYLE WITH ADD-ON CHECKBOX -->
    <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
          Service Packages for Home Service Companies
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-xl text-body mb-14 text-center font-medium">
          Choose the package that fits your goals. No contracts. Real results.
        </p>
        <div class="flex flex-col md:flex-row gap-10 items-stretch justify-center">
          <!-- GBP Card -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto"
          >
            <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">
              Google Business Profile Services
            </h3>
            <div class="text-base font-semibold mb-1 text-center">Basic: Profile Management</div>
            <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
              Best for: Maintaining Your Google Presence
            </span>
            <div class="text-3xl font-bold text-[#f56b2a] mb-2">
              $199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
              <li>Basic GBP setup</li>
              <li>Monthly listing maintenance</li>
              <li>Photo uploads</li>
            </ul>
            <div class="w-full">
              <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
                <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
                <div>
                  <div class="font-semibold text-[#f56b2a] mb-1">
                    Add-on: Boost Package <span class="font-bold">$299/mo</span>
                  </div>
                  <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                    <li>Full GBP setup & optimization</li>
                    <li>Monthly listing management</li>
                    <li>Review & reputation guidance</li>
                    <li>Posts, photos, updates</li>
                  </ul>
                </div>
              </div>
              <a
                href="#contact"
                class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >
                Get Started
              </a>
            </div>
          </div>
          <!-- SEO Card -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto relative"
          >
            <div
              class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10"
            >
              Most Popular
            </div>
            <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center mt-3">Organic &amp; Local SEO</h3>
            <div class="text-base font-semibold mb-1 text-center">Regular: Local SEO Essentials</div>
            <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
              Best for: Steady, Consistent Growth
            </span>
            <div class="text-3xl font-bold text-[#f56b2a] mb-2">
              $499<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
              <li>On-page SEO optimization</li>
              <li>Keyword research</li>
              <li>Technical SEO</li>
              <li>2 new service/location pages per month</li>
              <li>5 new blog posts per month</li>
            </ul>
            <div class="w-full">
              <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
                <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
                <div>
                  <div class="font-semibold text-[#f56b2a] mb-1">
                    Add-on: Boost Package <span class="font-bold">$799/mo</span>
                  </div>
                  <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                    <li>Everything in Regular, plus:</li>
                    <li>10 new service/location pages per month</li>
                    <li>10 new blog posts per month</li>
                    <li>Local citation cleanup & building</li>
                    <li>Competitor tracking & reporting</li>
                    <li>Monthly strategy call</li>
                  </ul>
                </div>
              </div>
              <a
                href="#contact"
                class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >
                Get Started
              </a>
            </div>
          </div>
          <!-- Website Card -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto"
          >
            <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">
              Website Design &amp; Development
            </h3>
            <div class="text-base font-semibold mb-1 text-center">Regular: Website Essentials</div>
            <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
              Best for: Professional, Conversion-Ready Websites
            </span>
            <div class="text-3xl font-bold text-[#f56b2a] mb-2">
              $199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
            <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
              <li>Mobile-friendly design</li>
              <li>Fast, secure hosting</li>
              <li>Updates for up to 5 pages/month</li>
              <li>Basic support & edits</li>
            </ul>
            <div class="w-full">
              <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
                <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
                <div>
                  <div class="font-semibold text-[#f56b2a] mb-1">
                    Add-on: Boost Package <span class="font-bold">$399/mo</span>

          <!-- Website as a Service -->
          <div class="bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col min-h-[600px]">
            <h3 class="text-xl font-heading font-bold text-heading mb-1 text-center">Website as a Service</h3>
            <div class="text-sm font-semibold mb-2 text-center">Base: Website Essentials</div>
            <span class="block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mb-4 font-semibold text-center"

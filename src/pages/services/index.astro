---
import Layout from "~/layouts/PageLayout.astro";
import CheckListItem from "~/components/ui/CheckListItem.astro";
import Card from "~/components/ui/Card.astro";
import Button from "~/components/ui/Button.astro";
import { packages } from "~/data/packages";

export const title = "Local SEO & Website Services for Home Service Businesses | Lilos Growth";
export const description =
  "Premium web design, Google Business Profile optimization, and Local SEO built for home service businesses. Month-to-month pricing, GBP management included in every plan.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-secondary pb-28 pt-20" aria-label="Services hero">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[600px] w-[600px] -translate-y-1/4 translate-x-1/3 rounded-full opacity-[0.10]"
      style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-widest text-primary">Services</p>
          <h1
            class="mb-5 font-heading text-5xl font-extrabold leading-[1.08] text-white md:text-6xl"
          >
            Premium Websites<br />+ Local SEO
          </h1>
          <p class="mb-3 text-xl font-bold uppercase tracking-wider text-primary">
            GBP Optimization Included
          </p>
          <p class="mb-10 max-w-lg text-lg font-medium text-white/65">
            Built for plumbers, HVAC, cleaning, pest control, landscaping, and other local trades.
            We deliver web design, GBP management, and local SEO that drives calls.
          </p>
          <div class="flex flex-wrap gap-4">
            <Button
              href="/contact#book"
              data-evt="cta_services_book_call"
              variant="primary"
              size="lg"
              icon="tabler:arrow-right"
            >
              Book a Free Call
            </Button>
            <a
              href="#packages"
              data-evt="cta_services_view_packages"
              class="hover:bg-white/8 inline-flex items-center gap-2 rounded-full border-2 border-white/25 px-8 py-4 font-heading text-base font-bold text-white transition hover:border-white/50"
            >
              View Packages
            </a>
          </div>
        </div>
        <!-- Trust block -->
        <div class="grid grid-cols-2 gap-4">
          {
            [
              { value: "+1,430%", label: "Keyword growth", sub: "Wheyland Electric, 5 months" },
              { value: "~9×", label: "Website leads", sub: "Wheyland Electric, sustained" },
              { value: "+909%", label: "Organic traffic", sub: "Wheyland Electric, 5 months" },
              { value: "96%", label: "Client retention", sub: "Month-over-month" },
            ].map((stat, i) => (
              <div
                class:list={[
                  "rounded-2xl border p-6 text-center",
                  i === 1 ? "bg-primary/10 border-primary" : "border-white/10 bg-white/5",
                ]}
              >
                <p
                  class:list={[
                    "font-heading text-3xl font-extrabold",
                    i === 1 ? "text-primary" : "text-white",
                  ]}
                >
                  {stat.value}
                </p>
                <p class="mt-1 text-sm font-bold text-white">{stat.label}</p>
                <p class="mt-1 text-xs text-white/40">{stat.sub}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <section class="border-b border-border-subtle bg-white py-10">
    <div class="mx-auto max-w-5xl px-6">
      <p class="mb-6 text-center text-xs font-bold uppercase tracking-widest text-muted">
        Trusted by service companies across the U.S.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-10 md:gap-16">
        <img
          src="/clients/blue-door-pest-control.jpg"
          alt="Blue Door Pest Control"
          class="h-9 w-auto max-w-[120px] object-contain opacity-50 grayscale transition hover:opacity-90 hover:grayscale-0"
          loading="lazy"
        />
        <img
          src="/clients/tamarack-restoration.webp"
          alt="Tamarack Restoration"
          class="h-9 w-auto max-w-[120px] object-contain opacity-50 grayscale transition hover:opacity-90 hover:grayscale-0"
          loading="lazy"
        />
        <img
          src="/clients/carlsbad-fixit.svg"
          alt="Carlsbad Fix It"
          class="h-9 w-auto max-w-[120px] object-contain opacity-50 grayscale transition hover:opacity-90 hover:grayscale-0"
          loading="lazy"
        />
        <img
          src="/clients/carlsbad-home-services.png"
          alt="Carlsbad Home Services"
          class="h-9 w-auto max-w-[120px] object-contain opacity-50 grayscale transition hover:opacity-90 hover:grayscale-0"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- CORE SERVICES — compact directory, links to the dedicated pages -->
  <section id="core-services" class="bg-white py-24" aria-label="Core services">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">What We Do</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">
          Three services. Stand alone or stack together.
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- GBP -->
        <Card class="!bg-background-cream flex flex-col">
          <div
            class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-service-gbp-light px-4 py-2 text-xs font-bold uppercase tracking-wider text-service-gbp"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
              ></path></svg
            >
            GBP Management
          </div>
          <h3 class="mb-3 font-heading text-xl font-extrabold text-heading">
            Rank higher in Maps and local search
          </h3>
          <p class="mb-6 flex-1 text-sm leading-relaxed text-body">
            We fully optimize your Google Business Profile, then actively manage it every week —
            posts, photos, Q&amp;A, reviews, category strategy. $300/mo, one plan, no setup fee.
          </p>
          <a
            href="/services/google-business-profile-optimization"
            class="inline-flex items-center gap-1.5 font-heading text-sm font-bold text-primary transition hover:text-primary-dark"
          >
            See GBP management &rarr;
          </a>
        </Card>

        <!-- Local SEO -->
        <Card class="!bg-background-cream flex flex-col">
          <div
            class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-service-seo-light px-4 py-2 text-xs font-bold uppercase tracking-wider text-service-seo"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg
            >
            Local SEO
          </div>
          <h3 class="mb-3 font-heading text-xl font-extrabold text-heading">
            Rank for the searches that matter most
          </h3>
          <p class="mb-6 flex-1 text-sm leading-relaxed text-body">
            On-page fixes, service &amp; location content, citations, local link building, and AEO
            schema for AI search. Structured for how search works now, not just classic blue links.
          </p>
          <a
            href="/services/local-seo"
            class="inline-flex items-center gap-1.5 font-heading text-sm font-bold text-primary transition hover:text-primary-dark"
          >
            See local SEO plans &rarr;
          </a>
        </Card>

        <!-- Website -->
        <Card class="!bg-background-cream flex flex-col">
          <div
            class="mb-4 inline-flex w-fit items-center gap-2 rounded-full bg-service-website-light px-4 py-2 text-xs font-bold uppercase tracking-wider text-service-website"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 8h10M7 12h6"
              ></path></svg
            >
            Website Design
          </div>
          <h3 class="mb-3 font-heading text-xl font-extrabold text-heading">
            Websites that convert, built to rank
          </h3>
          <p class="mb-6 flex-1 text-sm leading-relaxed text-body">
            Mobile-first, fast, same scalable Astro framework on every tier. Starting at $1,250
            one-time, or $1,000 bundled with any ongoing GBP/SEO package.
          </p>
          <a
            href="/services/web-design"
            class="inline-flex items-center gap-1.5 font-heading text-sm font-bold text-primary transition hover:text-primary-dark"
          >
            See website pricing &rarr;
          </a>
        </Card>
      </div>
    </div>
  </section>


  <!-- AI AUDIT SECTION -->
  <section class="bg-secondary py-24" aria-label="AI Audit">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <div
            class="bg-primary/20 mb-5 inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-bold uppercase tracking-wider text-primary"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path></svg
            >
            AI-Powered SEO Audit
          </div>
          <h2 class="mb-4 font-heading text-3xl font-extrabold text-white md:text-4xl">
            Know exactly what's costing you calls
          </h2>
          <p class="mb-6 text-base leading-relaxed text-white/60">
            We use AI-assisted auditing to analyze your GBP, website, and local citations at once —
            surfacing the exact gaps suppressing your rankings. No generic checklist. Specific,
            prioritized action items.
          </p>
          <ul class="mb-8 space-y-3 text-sm text-white/70">
            {
              [
                "GBP health score with specific action items",
                "Competitor gap analysis — what they rank for that you don't",
                "Citation inconsistencies across 50+ directories",
                "AI search visibility (AEO) readiness score",
                "Technical fixes ranked by revenue impact",
              ].map((item) => (
                <CheckListItem>{item}</CheckListItem>
              ))
            }
          </ul>
          <Button
            href="/contact#book"
            data-evt="cta_services_ai_audit"
            variant="primary"
            size="lg"
            icon="tabler:arrow-right"
          >
            Get Your Free Audit
          </Button>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-8">
          <p class="text-primary/60 mb-5 text-xs font-bold uppercase tracking-wider">
            Sample Audit Output
          </p>
          <div class="space-y-4">
            {
              [
                { label: "GBP Health Score", score: 43, grade: "Needs Work", color: "bg-red-500" },
                { label: "On-Page SEO", score: 61, grade: "Improving", color: "bg-warning" },
                {
                  label: "Citation Consistency",
                  score: 38,
                  grade: "Critical",
                  color: "bg-red-500",
                },
                { label: "Local Pack Visibility", score: 22, grade: "Low", color: "bg-red-500" },
                {
                  label: "AI Search Readiness",
                  score: 15,
                  grade: "Not Started",
                  color: "bg-red-500",
                },
              ].map((row) => (
                <div>
                  <div class="mb-1.5 flex justify-between">
                    <span class="text-xs font-semibold text-white/70">{row.label}</span>
                    <span class="text-xs text-white/40">{row.grade}</span>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-white/10">
                    <div class={`h-full rounded-full ${row.color}`} style={`width:${row.score}%`} />
                  </div>
                </div>
              ))
            }
          </div>
          <div class="border-primary/30 bg-primary/10 mt-6 rounded-xl border p-4">
            <p class="text-xs font-bold text-primary">Top Priority Fix Identified</p>
            <p class="mt-1 text-xs text-white/60">
              Primary GBP category is wrong. Correcting it could move you from #11 to top 3 in the
              Map Pack within 30 days.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="bg-background-cream py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-14 text-center">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Why us</p>
        <h2 class="font-heading text-4xl font-extrabold text-heading md:text-5xl">
          Why Home Service Pros Trust Lilos Growth
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
        {
          [
            [
              "Built by Home Service Owners",
              "We've lived it — we build what actually generates booked jobs.",
            ],
            [
              "Specialists in Home Services",
              "No generic agency fluff. Trades-focused growth only.",
            ],
            [
              "No Long-Term Contracts",
              "Month-to-month. We earn your business with results every month.",
            ],
            [
              "Results You Can See",
              "Local rankings, calls, and jobs — measurable, reported monthly.",
            ],
            ["No Big Agency Layers", "Direct access to your strategist. No runarounds."],
            [
              "AI-Assisted Auditing",
              "We use AI tools to find and prioritize exactly what's suppressing your rankings.",
            ],
          ].map(([title, body]) => (
            <Card class="hover:border-primary/20 flex flex-col shadow-sm transition duration-200 hover:shadow-md">
              <Card
                icon="tabler:check"
                iconColor="primary"
                iconSize="sm"
                iconShape="rounded"
                iconPosition="inline"
                class="!mb-4 !border-0 !bg-transparent !p-0 !shadow-none"
              />
              <h3 class="mb-2 font-heading text-base font-bold text-heading">{title}</h3>
              <p class="text-sm text-body">{body}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6">
      <p class="mb-3 text-center text-xs font-bold uppercase tracking-widest text-primary">
        What clients say
      </p>
      <h2 class="mb-14 text-center font-heading text-4xl font-extrabold text-heading md:text-5xl">
        Service teams choose Lilos Growth for results
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          [
            {
              q: "After 60 days we went from the bottom of Google Maps to the top 3. The phones ring every week now.",
              name: "Luis R.",
              role: "Plumbing Business Owner · Carlsbad, CA",
            },
            {
              q: "Straightforward reporting and real results. We're booking more jobs without paid ads.",
              name: "Brandon A.",
              role: "Electrical Contractor · San Diego, CA",
            },
            {
              q: "Fast turnaround, real strategy, and a site that feels like a premium brand. We're really proud of our web presence.",
              name: "Brandon B.",
              role: "Electrical Contractor",
            },
          ].map((t) => (
            <Card as="article" class="hover:border-primary/30 flex flex-col shadow-sm transition hover:shadow-md">
              <div class="mb-4 flex gap-0.5">
                {Array(5)
                  .fill(null)
                  .map(() => (
                    <svg class="h-4 w-4 text-warning" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
              </div>
              <blockquote class="mb-6 flex-1 text-base leading-relaxed text-body">
                "{t.q}"
              </blockquote>
              <footer>
                <p class="text-sm font-bold text-heading">{t.name}</p>
                <p class="text-xs text-muted">{t.role}</p>
              </footer>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PACKAGES TEASER -->
  <section id="packages" class="bg-background-cream py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Pricing</p>
      <h2 class="mb-4 font-heading text-4xl font-extrabold text-heading md:text-5xl">
        Simple, Honest Pricing
      </h2>
      <p class="mx-auto mb-10 max-w-xl text-base text-muted">
        Month-to-month. No setup fees. No contracts. GBP management included in every bundled
        plan, starting at $750/mo.
      </p>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
        {
          packages.map((pkg) => (
            <div
              class={`rounded-2xl border p-6 ${pkg.featured ? "border-2 border-primary shadow-lg" : "border-border-subtle bg-white"}`}
            >
              {pkg.featured && (
                <span class="mb-2 inline-block rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
                  {pkg.badge}
                </span>
              )}
              <h3 class="font-heading text-lg font-bold text-heading">{pkg.name}</h3>
              <div class="mt-1 flex items-baseline justify-center gap-1">
                <span class="font-heading text-3xl font-extrabold text-primary">
                  ${pkg.price.toLocaleString()}
                </span>
                <span class="text-sm text-body">/mo</span>
              </div>
            </div>
          ))
        }
      </div>
      <Button href="/packages" variant="primary" size="lg" icon="tabler:arrow-right" class="mt-8">
        See Full Pricing &amp; What's Included
      </Button>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-white py-24">
    <div class="mx-auto max-w-3xl px-6">
      <p class="mb-3 text-center text-xs font-bold uppercase tracking-widest text-primary">FAQ</p>
      <h2 class="mb-12 text-center font-heading text-4xl font-extrabold text-heading md:text-5xl">
        Frequently Asked Questions
      </h2>
      <div class="space-y-2">
        {
          [
            [
              "Do you work with my industry or niche?",
              "If you're a local service business — even if not listed above — there's a 99% chance we can help. Reach out and ask.",
            ],
            [
              "How quickly will I see results?",
              "Most companies start seeing more calls, leads, and improved rankings within 30–60 days. We focus on quick wins from day one.",
            ],
            [
              "Are there any setup fees?",
              "Some one-time projects (like a full site build) have a flat fee. Ongoing services are month-to-month and fully transparent.",
            ],
            [
              "Do I need to understand SEO or websites to get results?",
              "Nope. You run your business; we handle the digital work — clear communication, no jargon.",
            ],
            [
              "Can you help if I already have a website or GBP?",
              "Absolutely. We improve and optimize existing sites and profiles — or build new if that's the better path.",
            ],
            [
              "Will I have a dedicated point of contact?",
              "Yes — direct access to a home service marketing strategist. No call centers or handoffs.",
            ],
          ].map(([q, a]) => (
            <details class="hover:border-primary/30 group rounded-2xl border border-border-base bg-white shadow-sm transition">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-heading text-base font-bold text-heading">
                {q}
                <svg
                  class="h-5 w-5 flex-shrink-0 text-primary transition-transform duration-200 group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-base leading-relaxed text-body">{a}</div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="relative overflow-hidden bg-secondary py-32" aria-label="Final CTA">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[500px] w-[500px] -translate-y-1/4 translate-x-1/3 rounded-full opacity-[0.10]"
      style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <h2 class="mb-6 font-heading text-5xl font-extrabold leading-tight text-white md:text-6xl">
        Ready to get<br /><span class="text-primary">more calls?</span>
      </h2>
      <p class="mb-10 text-xl font-medium text-white/70">
        Book a free 15-minute audit. We review your GBP and site, find the biggest gaps, and tell
        you exactly what to do next.
      </p>
      <Button
        href="/contact#book"
        data-evt="cta_services_final"
        variant="primary"
        size="lg"
        icon="tabler:arrow-right"
      >
        Book a Call
      </Button>
    </div>
  </section>
</Layout>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lilosgrowth.com/" },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Services",
        "item": "https://lilosgrowth.com/services"
      }
    ]
  }
</script>

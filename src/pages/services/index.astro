---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'SEO & Digital Marketing Services for Home Service Businesses | Lilos Growth';
export const description =
  'Get more calls and booked jobs with proven Google Business Profile optimization, Local SEO, and conversion-focused web design. Transparent pricing and real results—no contracts.';
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
    <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-6 px-4 mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold leading-tight tracking-tight">
        Local SEO &amp; Digital Marketing
      </h1>
      <span class="block text-xl md:text-2xl font-semibold -mt-1 text-[#f56b2a] tracking-wider uppercase">
        Services for Home Service Businesses
      </span>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl font-medium">
        Built for plumbers, HVAC, cleaning, pest control, landscaping, and other local trades. No contracts, no
        fluff—just results.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#core-services"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
        >
          Explore Services
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
            ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
        <a
          href="#packages"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
        >
          See Packages
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
            ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- WHO WE HELP -->
  <section class="py-16 bg-cream border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">Who We Help</h2>
      <p class="text-lg text-body mb-6">
        We work with all types of local home service businesses—if you book jobs in your city or town, our services are
        for you:
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        {
          [
            'Plumbers',
            'HVAC',
            'Electricians',
            'Roofers',
            'Cleaning',
            'Pest Control',
            'Landscaping',
            'Painters',
            'Other Trades',
          ].map((x) => <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">{x}</span>)
        }
      </div>
      <p class="text-sm text-body/70 mt-4">
        Not sure if we can help your niche? <a href="#contact" class="text-primary underline hover:text-[#f56b2a]"
          >Ask us today</a
        >—chances are, we’ve worked with your industry!
      </p>
    </div>
  </section>

  <!-- CORE SERVICES -->
  <section id="core-services" class="py-24 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-10 text-center">
        Our Core Services
        <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        {
          [
            [
              'Google Business Profile Optimization',
              '/services/google-business-profile-optimization',
              [
                'Claim, optimize, and manage your GBP listing',
                'Ongoing reviews & photos',
                'Monthly reporting & tracking',
              ],
            ],
            [
              'Local SEO & Content',
              '/services/local-seo',
              ['Service/location pages for your city', 'Weekly content & blog posting', 'Citation building & cleanup'],
            ],
            [
              'Website Design & Conversion',
              '/services/web-design',
              [
                'Lightning-fast, secure hosting',
                'Conversion-focused landing pages',
                'Lead capture, reviews, and calls built in',
              ],
            ],
          ].map(([title, href, bullets]) => (
            <article class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-8 grid grid-rows-[auto_1fr_auto]">
              <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">{title}</h3>
              <ul class="text-body list-disc list-inside space-y-1">
                {(bullets as string[]).map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
              <a
                href={href as string}
                class="mt-6 inline-flex items-center text-primary font-semibold underline hover:text-[#f56b2a]"
              >
                Learn more &rarr;
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-24 bg-cream border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">
        Why Home Service Pros Trust Lilos Growth
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {
          [
            ['Built by Home Service Owners', 'We’ve lived it—so we build what actually generates booked jobs.'],
            ['Specialists in Home Services', 'No generic agency fluff, just trades-focused growth.'],
            ['No Long-Term Contract', 'Month-to-month. We earn your business with results.'],
            ['Results You Can See', 'Local rankings, calls, and jobs—measurable improvements.'],
            ['No Big Agency Fluff', 'Direct access to your strategist. No runarounds.'],
            ['Easy, Honest, & Human', 'Clear reporting, plain English, and a process that makes sense.'],
          ].map(([title, body]) => (
            <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
              <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
                <svg
                  class="w-7 h-7 text-[#f56b2a]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M3 12l6 6l12-12" />
                </svg>
              </span>
              <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">{title}</h3>
              <p class="text-body text-center text-[15px]">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4-STEP SYSTEM -->
  <section class="py-24 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-6 text-center">
        Our Proven 4-Step Local SEO System
        <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-lg text-center text-body mb-12">
        Exactly how we get you ranking higher and driving more local calls.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        {
          [
            ['1', 'Keyword & Market Research', 'We start with data—what your local customers actually search for.'],
            ['2', 'Profile & Website Optimization', 'We fully optimize your GBP and website to boost visibility.'],
            ['3', 'Content & Authority Building', 'Location pages, blogs, and high-quality local links.'],
            ['4', 'Ongoing Management & Results', 'We track, report, and keep optimizing so results improve.'],
          ].map(([num, title, body]) => (
            <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-8 flex flex-col items-center">
              <div class="w-14 h-14 mb-4 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-2xl font-extrabold">
                {num}
              </div>
              <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">{title}</h3>
              <p class="text-body text-center text-[15px]">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MINI TESTIMONIAL -->
  <section class="py-12 bg-white border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4">
      <div class="bg-cream rounded-2xl shadow p-8 text-center">
        <p class="text-lg font-medium mb-2">
          “After just 60 days, we jumped from the bottom of Google Maps to the top 3. The phones ring every week now.”
        </p>
        <div class="text-sm text-body/70">— John T., Plumbing Business Owner</div>
      </div>
    </div>
  </section>

  <!-- PACKAGES (aligned buttons) -->
  <section id="packages" class="py-24 bg-bluelight border-t border-gray-100 shadow-xl">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
        Service Packages for Home Service Companies
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Choose the package that fits your goals. No contracts. Real results.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-stretch">
        {
          [
            [
              'Google Business Profile',
              'Base: Profile Management',
              '$199/mo',
              [
                'GBP setup or audit',
                'Monthly listing updates & photos',
                'Category & keyword targeting',
                'Basic performance tracking',
              ],
              'Boost Add-on + $300/mo (Total $499)',
              [
                'Weekly posts & updates',
                'Review request & response strategy',
                'Competitor monitoring & insights',
                'Citation build & cleanup (core listings)',
              ],
              '/services/google-business-profile-optimization',
            ],
            [
              'Local SEO',
              'Base: Growth Essentials',
              '$499/mo',
              [
                'SEO audit, keyword research & on-page fixes',
                'Technical SEO improvements',
                '5 new service/location pages / mo',
                '5 blog posts / mo',
              ],
              'Boost Add-on $799/mo',
              [
                '10–15 service/location pages / mo',
                '10 blog posts / mo',
                'Citations build & cleanup',
                'Competitor tracking & strategy call',
              ],
              '/services/local-seo',
              'Most Popular',
            ],
            [
              'Website as a Service',
              'Base: Website Essentials',
              '$250/mo',
              [
                'Mobile-friendly, SEO-ready design',
                'Secure hosting & monitoring',
                'Updates for up to 5 pages / mo',
                'Lead form integration & monthly health check',
              ],
              'Boost Add-on + $500/mo (Total $750)',
              [
                'Updates for up to 15 pages / mo',
                'New landing pages & CRO',
                'Quarterly design refresh',
                'Priority support',
              ],
              '/services/web-design',
            ],
            [
              'Local SEO + GBP Mgmt',
              'Base: Complete Local Presence',
              '$799/mo',
              [
                'Includes Local SEO Base + GBP Base',
                'Unified reporting dashboard',
                'Monthly rank/map visibility review',
                'Quarterly competitor snapshot',
              ],
              'Boost Package + $500/mo (Total $1,299)',
              [
                'Includes Local SEO Boost + GBP Boost',
                'Citation cleanup (software + manual core)',
                'Custom quarterly local growth plan',
                'GBP heatmap tracking + priority support',
              ],
              '/services/local-seo',
            ],
          ].map(([name, subtitle, price, bullets, addOnTitle, addOnBullets, href, badge]) => (
            <article class="relative h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]">
              {badge ? (
                <div class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10">
                  {badge as string}
                </div>
              ) : null}
              <header class="text-center mt-[var(--badge-offset,0px)]">
                <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">{name as string}</h3>
                <div class="text-sm font-semibold mt-1">{subtitle as string}</div>
                <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold">
                  Best for:{' '}
                  {name === 'Google Business Profile'
                    ? 'Maintain Your Google Presence'
                    : name === 'Website as a Service'
                      ? 'Modern, Conversion-Ready Sites'
                      : name === 'Local SEO + GBP Mgmt'
                        ? 'Map Pack + Organic Results'
                        : 'Steady Organic Growth'}
                </span>
                <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-3">
                  {(price as string).replace('/mo', '')}
                  <span class="text-base font-normal text-gray-500">/mo</span>
                </div>
              </header>
              <div class="mt-5 space-y-4">
                <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
                  {(bullets as string[]).map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4">
                  <div class="font-semibold text-[#f56b2a] mb-1">{addOnTitle as string}</div>
                  <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
                    {(addOnBullets as string[]).map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="pt-4 border-t border-gray-100">
                <a
                  href={href as string}
                  class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
                >
                  Get Started
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center">
        Frequently Asked Questions
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="space-y-6">
        {
          [
            [
              'Do you work with my industry or niche?',
              'If you’re a local service business—even if not listed above—there’s a 99% chance we can help. Reach out and ask!',
            ],
            [
              'How quickly will I see results?',
              'Most companies start seeing more calls, leads, and improved rankings within 30–60 days. We focus on quick wins from day one.',
            ],
            [
              'Are there any setup fees?',
              'Some one-time projects (like a full site build) may have setup fees. Ongoing services are month-to-month and transparent.',
            ],
            [
              'Do I need to understand SEO or websites to get results?',
              'Nope! You run your business; we handle the digital work—clear communication, no jargon.',
            ],
            [
              'Can you help if I already have a website or GBP?',
              'Absolutely. We improve and optimize existing sites and profiles—or build new if that’s the better path.',
            ],
            [
              'Will I have a dedicated point of contact?',
              'Yes—direct access to a home service marketing strategist. No call centers or handoffs.',
            ],
          ].map(([q, a]) => (
            <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
              <h3 class="font-heading text-lg font-semibold mb-2 text-heading">{q}</h3>
              <p class="text-body text-base">{a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://lilosgrowth.com/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://lilosgrowth.com/services" }
    ]
  }
</script>

---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import Card from "~/components/ui/Card.astro";
import CheckListItem from "~/components/ui/CheckListItem.astro";
import FeatureCard from "~/components/sections/FeatureCard.astro";
import { Icon } from "astro-icon/components";
import { gbpManagement } from "~/data/packages";

export const title =
  "Google Business Profile Optimization & Maps SEO for Home Service Businesses | Lilos Growth";
export const description =
  "Rank higher in the Google Map Pack and turn searches into booked jobs. Purpose-built Google Business Profile (GBP) optimization, posting, reviews, and reporting for local service pros.";

const features = [
  "Map Pack Visibility",
  "Profile Build & Cleanup",
  "Posts & Photos",
  "Reviews & Q&A",
  "Tracking & Reporting",
];

const trustReasons = [
  {
    icon: "tabler:users",
    title: "Built by Home Service Owners",
    description: "We've lived it—so we build what actually generates booked jobs.",
  },
  {
    icon: "tabler:tool",
    title: "Specialists in Home Services",
    description: "No generic agency fluff, just trades-focused growth.",
  },
  {
    icon: "tabler:calendar-x",
    title: "No Long-Term Contract",
    description: "Month-to-month. We earn your business with results.",
  },
  {
    icon: "tabler:chart-line",
    title: "Results You Can See",
    description: "Local rankings, calls, and jobs—measurable improvements.",
  },
  {
    icon: "tabler:shield-check",
    title: "No Big Agency Fluff",
    description: "Direct access to your strategist. No runarounds.",
  },
  {
    icon: "tabler:heart-handshake",
    title: "Easy, Honest, & Human",
    description: "Clear reporting, plain English, and a process that makes sense.",
  },
];

const faqs = [
  {
    question: "How fast can you improve my Google Maps ranking?",
    answer:
      "Most see measurable gains in 30–60 days with consistent posting, reviews, and ongoing profile updates.",
  },
  {
    question: "Can you optimize my profile if I already have a GBP listing?",
    answer: "Absolutely—audits, rebuilds, and ongoing optimization are our bread and butter.",
  },
  {
    question: "Do you guarantee Map Pack rankings?",
    answer:
      "No one can guarantee specific positions, but we provide consistent, data-driven work and transparent reporting.",
  },
  {
    question: "Will you manage my reviews and add Q&A?",
    answer:
      "Yes—review strategy, reply templates, requests, and Q&A setup/monitoring are included (Growth handles replies with no cap).",
  },
  {
    question: "Is there a setup fee or long contract?",
    answer: "No setup fees and no contracts—cancel anytime.",
  },
  {
    question: "Will I have a dedicated strategist?",
    answer: "Yes—direct access to a home service marketing strategist.",
  },
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Services", item: "https://lilosgrowth.com/services" },
    {
      name: "Google Business Profile",
      item: "https://lilosgrowth.com/services/google-business-profile-optimization",
    },
  ]}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://lilosgrowth.com/services/google-business-profile-optimization#service",
      name: "Google Business Profile Optimization & Maps SEO",
      description:
        "End-to-end Google Business Profile management for home service businesses — optimization, weekly posts, EXIF-optimized photos, review management, Q&A, and monthly reporting.",
      provider: { "@id": "https://lilosgrowth.com/#org" },
      areaServed: { "@type": "Country", name: "United States" },
      url: "https://lilosgrowth.com/services/google-business-profile-optimization",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How fast can you improve my Google Maps ranking?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most clients see measurable gains in 30-60 days with consistent posting, reviews, and ongoing profile updates.",
          },
        },
        {
          "@type": "Question",
          name: "Can you optimize my profile if I already have a GBP listing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Audits, rebuilds, and ongoing optimization are our core service.",
          },
        },
        {
          "@type": "Question",
          name: "Do you guarantee Map Pack rankings?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No one can guarantee specific positions, but we provide consistent, data-driven work and transparent reporting.",
          },
        },
        {
          "@type": "Question",
          name: "Is there a setup fee or long contract?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No setup fees and no long-term contracts. All plans are month-to-month.",
          },
        },
      ],
    },
  ]}
>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 text-center"
    >
      <h1
        class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Google Business Profile Optimization <span class="mt-1 block text-xl md:text-3xl"
          >&amp; Maps SEO</span
        >
      </h1>
      <span class="text-accent block text-base font-semibold uppercase tracking-wider md:text-lg">
        For Home Service Businesses
      </span>
      <p class="max-w-2xl text-base font-medium leading-relaxed text-white/90">
        Get found where it matters most—the Map Pack. More calls, more reviews, and measurable local
        growth for plumbers, HVAC, pest control, cleaning, landscaping &amp; more.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="#gbp-package" variant="primary" size="lg">
          See Packages
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
        <Button href="#faq" variant="secondary" size="lg">
          FAQ
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
      </div>
    </div>
  </section>

  <!-- WHAT IS GBP -->
  <section class="border-t border-gray-100 bg-background-cream py-12">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">
        What Is Google Business Profile Optimization?
      </h2>
      <p class="mb-6 text-base text-body">
        Your GBP is the #1 driver of local calls. We optimize your profile end-to-end—categories,
        services, photos, posts, reviews, Q&amp;A, tracking—so you rank in the Map Pack and stay
        there. Structured for how search works now — Google, Maps, and AI answer engines like AI
        Overviews and ChatGPT Search, not just classic blue links.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        {
          features.map((feature) => (
            <Badge variant="primary" size="lg">
              {feature}
            </Badge>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WHY TRUST -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Why Home Service Pros Trust Lilos Growth
      </h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {
          trustReasons.map((reason) => (
            <FeatureCard icon={reason.icon} title={reason.title} description={reason.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- GBP PACKAGE -->
  <section id="gbp-package" class="border-t border-gray-100 bg-background-cream py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Google Business Profile Management
      </h2>
      <p class="mb-10 text-center text-base text-body">
        One plan. Everything included. Month-to-month, no setup fee, no contract.
      </p>

      <div class="mx-auto max-w-md">
        <div class="rounded-3xl border-2 border-primary bg-white p-8 text-center shadow-lg">
          <h3 class="mb-1 font-heading text-lg font-bold text-heading">{gbpManagement.name}</h3>
          <div class="mb-4 font-heading text-4xl font-extrabold text-primary">
            ${gbpManagement.price}<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="mb-6 space-y-2 text-left text-sm text-body">
            {
              gbpManagement.inclusions.map((inc) => (
                <CheckListItem align="center">{inc}</CheckListItem>
              ))
            }
          </ul>
          <Button href="#contact" variant="primary" size="lg" class="w-full">Get Started</Button>
        </div>
        <p class="mt-4 text-center text-sm text-body">
          Already want ongoing Local SEO too? <a href="/packages" class="font-semibold text-primary underline"
            >See the bundled plans</a
          > — GBP management comes included, not as an extra line item.
        </p>
      </div>
    </div>
  </section>

  <!-- CROSS-SELL PACKAGES -->
  <section class="border-t border-gray-100 bg-white py-16" id="packages">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Service Packages for Home Service Companies
      </h2>
      <p class="mb-10 text-center text-base text-body">Choose the package that fits your goals.</p>

      <div class="grid auto-rows-fr grid-cols-1 items-stretch gap-6 md:grid-cols-2 lg:grid-cols-4">
        <!-- Local SEO, standalone -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-center">
            <h3 class="font-heading text-base font-semibold text-heading md:text-lg">Local SEO</h3>
            <div class="mt-2 text-xl font-bold text-primary md:text-2xl">
              From $399<span class="text-sm font-normal text-gray-500">/mo</span>
            </div>
          </div>
          <ul class="mt-4 flex-1 list-disc space-y-1 pl-5 text-sm text-body">
            <li>Audit, keywords, on-page + technical</li>
            <li>Content &amp; internal linking</li>
            <li>Citations + reporting</li>
          </ul>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <Button href="/services/local-seo" variant="primary" size="md" class="w-full">
              View Details
            </Button>
          </div>
        </Card>

        <!-- GBP + Local SEO bundle -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-center">
            <h3 class="font-heading text-base font-semibold text-heading md:text-lg">
              GBP + Local SEO
            </h3>
            <div class="mt-2 text-xl font-bold text-primary md:text-2xl">
              From $599<span class="text-sm font-normal text-gray-500">/mo</span>
            </div>
          </div>
          <ul class="mt-4 flex-1 list-disc space-y-1 pl-5 text-sm text-body">
            <li>Everything in Local SEO</li>
            <li>GBP management included, not billed separately</li>
            <li>Posts, photos, reviews &amp; Q&amp;A</li>
          </ul>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <Button href="/packages" variant="primary" size="md" class="w-full"> View Details </Button>
          </div>
        </Card>

        <!-- Website build -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-center">
            <h3 class="font-heading text-base font-semibold text-heading md:text-lg">
              Website Build
            </h3>
            <div class="mt-2 text-xl font-bold text-primary md:text-2xl">
              From $1,250<span class="text-sm font-normal text-gray-500"> one-time</span>
            </div>
          </div>
          <ul class="mt-4 flex-1 list-disc space-y-1 pl-5 text-sm text-body">
            <li>Same scalable Astro framework, every tier</li>
            <li>Mobile-first, SEO-native, schema included</li>
            <li>Lead forms + click-to-call tracking</li>
          </ul>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <Button href="/services/web-design" variant="primary" size="md" class="w-full">
              View Details
            </Button>
          </div>
        </Card>

        <!-- Full bundle -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-center">
            <h3 class="font-heading text-base font-semibold text-heading md:text-lg">
              GBP + SEO + Website
            </h3>
            <div class="mt-2 text-xl font-bold text-primary md:text-2xl">
              Custom<span class="text-sm font-normal text-gray-500"> quote</span>
            </div>
          </div>
          <ul class="mt-4 flex-1 list-disc space-y-1 pl-5 text-sm text-body">
            <li>New site, then GBP + Local SEO on top</li>
            <li>One strategist, one plan, no gaps</li>
            <li>Best value if you're starting from scratch</li>
          </ul>
          <div class="mt-4 border-t border-gray-100 pt-4">
            <Button href="/packages" variant="primary" size="md" class="w-full">
              Compare Plans
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-gray-100 bg-background-cream py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Google Business Profile &amp; Maps SEO: FAQs
      </h2>

      <div class="space-y-4">
        {
          faqs.map((faq, index) => (
            <Card variant={index % 2 === 0 ? "elevated" : "default"}>
              <h3 class="mb-2 font-heading text-base font-semibold text-heading md:text-lg">
                {faq.question}
              </h3>
              <p class="text-sm text-body md:text-base">{faq.answer}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
        Ready to Dominate the Map Pack?
      </h2>
      <p class="mb-6 text-base text-white/90">
        Get a free GBP audit and action plan—no hard sell, just what to do next.
      </p>
      <Button href="#contact" variant="white" size="lg"> Book My Free Audit </Button>
    </div>
  </section>
</Layout>

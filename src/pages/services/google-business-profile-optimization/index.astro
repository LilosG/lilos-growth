    <section class="py-20 bg-bluelight border-t border-gray-100 shadow-xl" id="gbp-packages">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
          Service Packages for Home Service Companies
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-xl text-body mb-10 text-center font-medium">
          Choose the package that fits your goals. No contracts. Real results.
        </p>

        <div class="flex flex-col md:flex-row gap-8 items-stretch justify-center">
          <!-- GBP Card -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-6 pt-6 pb-5 flex flex-col items-center min-h-[560px] max-w-md mx-auto"
          >
            <h3 class="text-xl font-heading font-bold text-heading mb-1 text-center">
              Google Business Profile Services
            </h3>
            <div class="text-base font-semibold mb-1 text-center">Basic: Profile Management</div>
            <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-3 font-semibold text-center">

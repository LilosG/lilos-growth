---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>Google Business Profile Optimization & Maps SEO | Lilos Growth</title>
    <meta
      name="description"
      content="Rank higher in the Google Map Pack and get more calls. Full GBP optimization, posting, reviews, and defense for home service businesses. No contracts, just results."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- HERO SECTION -->
    <section
      class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
          Google Business Profile Optimization & Maps SEO

            <a
              href="/services/local-seo"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              >Get Started</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center">
        Google Business Profile &amp; Maps SEO: FAQs
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="space-y-6">
        {
          [
            [
              'How fast can you improve my Google Maps ranking?',
              'Most see measurable gains in 30–60 days with consistent posting, reviews, and ongoing profile updates.',
            ],
            [
              'Can you optimize my profile if I already have GBP listing?',
              'Absolutely—audits, rebuilds, and ongoing optimization are our bread and butter.',
            ],
            [
              'Do you guarantee Map Pack rankings?',
              'No one can guarantee specific positions, but we provide consistent, data-driven work and transparent reporting.',
            ],
            [
              'Will you manage my reviews and add Q&A?',
              'Yes—review strategy, reply templates, requests, and Q&A setup/monitoring are included with Boost.',
            ],
            ['Is there a setup fee or long contract?', 'No setup fees and no contracts—cancel anytime.'],
            ['Will I have a dedicated strategist?', 'Yes—direct access to a home service marketing strategist.'],
          ].map(([q, a]) => (
            <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
              <h3 class="font-heading text-lg font-semibold mb-2 text-heading">{q}</h3>
              <p class="text-body text-base">{a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",

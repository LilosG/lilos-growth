---
import Layout from "~/layouts/PageLayout.astro";

export const title =
  "Google Business Profile Optimization & Maps SEO for Home Service Businesses | Lilos Growth";
export const description =
  "Rank higher in the Google Map Pack and turn searches into booked jobs. Purpose-built Google Business Profile (GBP) optimization, posting, reviews, and reporting for local service pros.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] flex-col items-center justify-center overflow-hidden bg-secondary pb-20 pt-16"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light">
    </div>
    <div
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center gap-6 px-4 text-center"
    >
      <h1
        class="font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Google Business Profile Optimization <span class="mt-1 block text-3xl md:text-4xl"
          >&amp; Maps SEO</span
        >
      </h1>
      <span
        class="-mt-1 block text-xl font-semibold uppercase tracking-wider text-primary md:text-2xl"
      >
        For Home Service Businesses
      </span>
      <p class="max-w-2xl text-lg font-medium text-white/80 md:text-xl">
        Get found where it matters most—the Map Pack. More calls, more reviews, and measurable local
        growth for plumbers, HVAC, pest control, cleaning, landscaping &amp; more.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#gbp-package"
          class="inline-flex items-center rounded-2xl bg-primary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
        >
          See Packages
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
        <a
          href="#faq"
          class="inline-flex items-center rounded-2xl bg-secondary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-secondary-hover"
        >
          FAQ
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT IS GBP -->
  <section class="border-t border-gray-100 bg-cream py-16">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-heading md:text-4xl">
        What Is Google Business Profile Optimization?
      </h2>
      <p class="text-lg text-body">
        Your GBP is the #1 driver of local calls. We optimize your profile end-to-end—categories,
        services, photos, posts, reviews, Q&amp;A, tracking—so you rank in the Map Pack and stay
        there.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Map Pack Visibility</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Profile Build &amp; Cleanup</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Posts &amp; Photos</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Reviews &amp; Q&amp;A</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Tracking &amp; Reporting</span
        >
      </div>
    </div>
  </section>

  <!-- WHY TRUST -->
  <section class="border-t border-gray-100 bg-white py-24">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-center font-heading text-4xl font-bold text-heading md:text-5xl">
        Why Home Service Pros Trust Lilos Growth
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3">
        {
          [
            [
              "Built by Home Service Owners",
              "We’ve lived it—so we build what actually generates booked jobs.",
            ],
            [
              "Specialists in Home Services",
              "No generic agency fluff, just trades-focused growth.",
            ],
            ["No Long-Term Contract", "Month-to-month. We earn your business with results."],
            ["Results You Can See", "Local rankings, calls, and jobs—measurable improvements."],
            ["No Big Agency Fluff", "Direct access to your strategist. No runarounds."],
            [
              "Easy, Honest, & Human",
              "Clear reporting, plain English, and a process that makes sense.",
            ],
          ].map(([title, body]) => (
            <div class="flex flex-col items-center rounded-2xl border border-primary/10 bg-white p-8 shadow-lg">
              <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
                <svg
                  class="h-7 w-7 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M3 12l6 6l12-12" />
                </svg>
              </span>
              <h3 class="mb-1 text-center font-heading text-lg font-semibold text-heading">
                {title}
              </h3>
              <p class="text-center text-[15px] text-body">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- GBP PACKAGES -->
  <section id="gbp-package" class="border-t border-gray-100 bg-cream py-24">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-4 text-center font-heading text-4xl font-bold text-heading md:text-5xl">
        Google Business Profile Packages
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>
      <p class="mb-12 text-center text-xl font-medium text-body">
        Clear value. Month-to-month. No rollovers.
      </p>

      <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2">
        <!-- Google Business Profile— $299/mo -->
        <article
          class="grid grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
          aria-labelledby="gbp-starter-title"
        >
          <header class="text-center">
            <h3
              id="gbp-starter-title"
              class="font-heading text-lg font-semibold text-heading md:text-xl"
            >
              Google Business Profile
            </h3>
            <div class="mt-2 text-2xl font-bold text-primary md:text-3xl">
              $299<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
            <p class="mt-2 text-[15px] text-body">
              Essential GBP management for steady local visibility.
            </p>
          </header>

          <ul class="mt-5 list-disc space-y-2 pl-5 text-[15px] text-body">
            <li>
              Setup or audit with <span class="font-semibold"
                >keyword research &amp; category mapping</span
              >
            </li>
            <li>Business info, services &amp; products maintained (quarterly refresh)</li>
            <li><span class="font-semibold">6 posts/mo</span> (offers, updates) — no rollovers</li>
            <li>
              <span class="font-semibold">6 photos/mo</span>, <span class="font-semibold"
                >EXIF/alt optimized</span
              > for local relevance — no rollovers
            </li>
            <li>Review replies <span class="font-semibold">up to 30/mo</span> + templates</li>
            <li>Q&amp;A monitored weekly; profile improvements &amp; testing</li>
            <li>Citation cleanup (quarterly core listings)</li>
            <li>Monthly performance report</li>
          </ul>

          <div class="border-t border-gray-100 pt-6">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              aria-label="Get Started — open contact form">Get Started</a
            >
          </div>
        </article>

        <!-- GBP + Local Seo -  -->
        <article
          class="relative grid grid-rows-[auto_1fr_auto] rounded-2xl border-2 border-primary bg-white p-8 shadow-md"
          aria-labelledby="gbp-growth-title"
        >
          <div
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1 text-xs font-bold text-white shadow"
          >
            Most Popular
          </div>
          <header class="mt-2 text-center">
            <h3
              id="gbp-growth-title"
              class="font-heading text-lg font-semibold text-heading md:text-xl"
            >
              GBP + Local SEO
            </h3>
            <div class="mt-1 text-sm font-semibold">Includes everything in Starter</div>
            <div class="mt-2 text-2xl font-bold text-primary md:text-3xl">
              $699<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
            <p class="mt-2 text-[15px] text-body">
              Win more service-area searches and outpace competitors.
            </p>
          </header>

          <ul class="mt-5 list-disc space-y-2 pl-5 text-[15px] text-body">
            <li>
              <span class="font-semibold">3 posts/week</span> (offers, FAQs, highlights) — no rollovers
            </li>
            <li>
              Fresh photos ongoing, <span class="font-semibold">EXIF/alt optimized</span> for geo &amp;
              keywords
            </li>
            <li>
              Review replies <span class="font-semibold">no cap</span> + proactive request prompts
            </li>
            <li>Services &amp; products <span class="font-semibold">refreshed monthly</span></li>
            <li>
              <span class="font-semibold">Ongoing citations</span> incl. <span class="font-semibold"
                >200+ directories</span
              > (core + industry/niche)
            </li>
            <li>Quarterly heatmap &amp; competitor snapshot</li>
            <li>Monthly report + <span class="font-semibold">30-min strategy call</span></li>
          </ul>

          <div class="border-t border-gray-100 pt-6">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              aria-label="Upgrade — open contact form">Upgrade to Growth</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CROSS-SELL PACKAGES (aligned 4-up grid for consistency) -->
  <section class="border-t border-gray-100 bg-bluelight py-24 shadow-xl" id="packages">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-4 text-center font-heading text-4xl font-bold text-heading md:text-5xl">
        Service Packages for Home Service Companies
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>
      <p class="mb-14 text-center text-xl font-medium text-body">
        Choose the package that fits your goals.
      </p>

      <div class="grid auto-rows-fr grid-cols-1 items-stretch gap-8 md:grid-cols-2 lg:grid-cols-4">
        <!-- GBP (condensed; mirrors above) -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <h3 class="font-heading text-lg font-semibold text-heading md:text-xl">
              Local SEO - Growth
            </h3>
            <div class="mt-1 text-2xl font-bold text-primary md:text-3xl">
              From $999<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-[15px] text-body">
            <li>Audit, categories &amp; keywords</li>
            <li>Posts &amp; EXIF-optimized photos</li>
            <li>Reviews, Q&amp;A, citations</li>
          </ul>
          <div class="border-t border-gray-100 pt-4">
            <a
              href="#gbp-package"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >View Details</a
            >
          </div>
        </article>

        <!-- Local SEO (Essentials preview) -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <h3 class="font-heading text-lg font-semibold text-heading md:text-xl">Local SEO</h3>
            <div class="mt-1 text-2xl font-bold text-primary md:text-3xl">
              From $599<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-[15px] text-body">
            <li>Audit, keywords, on-page + technical</li>
            <li>Content &amp; internal linking</li>
            <li>Citations + reporting</li>
          </ul>
          <div class="border-t border-gray-100 pt-4">
            <a
              href="/services/local-seo"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >View Details</a
            >
          </div>
        </article>

        <!-- Website as a Service (Base $199/mo per latest guardrails) -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <h3 class="font-heading text-lg font-semibold text-heading md:text-xl">
              Website as a Service
            </h3>
            <div class="mt-1 text-2xl font-bold text-primary md:text-3xl">
              $199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-[15px] text-body">
            <li>Modern, mobile-ready site</li>
            <li>Hosting, edits &amp; monitoring</li>
            <li>Lead forms + basic SEO</li>
          </ul>
          <div class="border-t border-gray-100 pt-4">
            <a
              href="/services/web-design"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >View Details</a
            >
          </div>
        </article>

        <!-- Local SEO + GBP Bundle -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <h3 class="font-heading text-lg font-semibold text-heading md:text-xl">
              One-Time Website Build
            </h3>
            <div class="mt-1 text-2xl font-bold text-primary md:text-3xl">
              $499<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <ul class="mt-5 list-disc space-y-1 pl-5 text-[15px] text-body">
            <li>Unified plan &amp; reporting</li>
            <li>Monthly visibility review</li>
            <li>Quarterly competitor snapshot</li>
          </ul>
          <div class="border-t border-gray-100 pt-4">
            <a
              href="/packages"
              class="block w-full rounded-xl bg-primary px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >Compare Plans</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Google Business Profile &amp; Maps SEO: FAQs
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-primary"></span>
      </h2>

      <div class="space-y-6">
        {
          [
            [
              "How fast can you improve my Google Maps ranking?",
              "Most see measurable gains in 30–60 days with consistent posting, reviews, and ongoing profile updates.",
            ],
            [
              "Can you optimize my profile if I already have a GBP listing?",
              "Absolutely—audits, rebuilds, and ongoing optimization are our bread and butter.",
            ],
            [
              "Do you guarantee Map Pack rankings?",
              "No one can guarantee specific positions, but we provide consistent, data-driven work and transparent reporting.",
            ],
            [
              "Will you manage my reviews and add Q&A?",
              "Yes—review strategy, reply templates, requests, and Q&A setup/monitoring are included (Growth handles replies with no cap).",
            ],
            [
              "Is there a setup fee or long contract?",
              "No setup fees and no contracts—cancel anytime.",
            ],
            [
              "Will I have a dedicated strategist?",
              "Yes—direct access to a home service marketing strategist.",
            ],
          ].map(([q, a]) => (
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
              <h3 class="mb-2 font-heading text-lg font-semibold text-heading">{q}</h3>
              <p class="text-base text-body">{a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Google Business Profile Management",
    "serviceType": "Google Business Profile Management",
    "provider": { "@id": "https://lilosgrowth.com/#local" },
    "areaServed": { "@type": "Country", "name": "United States" },
    "offers": [
      {
        "@type": "Offer",
        "name": "GBP — Starter",
        "priceCurrency": "USD",
        "price": "199",
        "availability": "https://schema.org/InStock"
      },
      {
        "@type": "Offer",
        "name": "GBP — Growth",
        "priceCurrency": "USD",
        "price": "399",
        "availability": "https://schema.org/InStock"
      }
    ]
  }
</script>

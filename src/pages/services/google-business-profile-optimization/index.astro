          <a
            href="#contact"
            class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition"
          >
            Get Started
          </a>
        </div>
      </div>
    </div>


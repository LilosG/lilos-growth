          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7 flex flex-col items-center">
            <div
              class="w-12 h-12 mb-3 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-xl font-extrabold"
            >
              1
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">GBP Audit & Strategy</h3>
            <p class="text-body text-center">
              Audit of profile, rankings, reviews & spam. Clear roadmap for quick wins.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7 flex flex-col items-center">
            <div
              class="w-12 h-12 mb-3 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-xl font-extrabold"
            >
              2
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Full Optimization & Defense</h3>
            <p class="text-body text-center">
              We optimize all ranking factors and defend against fake competitors/edits.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7 flex flex-col items-center">
            <div
              class="w-12 h-12 mb-3 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-xl font-extrabold"
            >
              3
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Content & Engagement</h3>
            <p class="text-body text-center">Posts, photos, Q&amp;A, and review generation keep your profile active.</p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7 flex flex-col items-center">
            <div
              class="w-12 h-12 mb-3 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] text-xl font-extrabold"
            >
              4
            </div>
            <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Tracking & Reporting</h3>
            <p class="text-body text-center">Transparent reports & call tracking so you always know ROI.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- STANDALONE GBP BLOCK -->
    <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-6 text-center">
      Standalone Google Business Profile Management
    </h2>
    <div class="flex justify-center py-10 bg-bluelight">
      <div class="bg-white rounded-2xl shadow-xl border border-gray-100 px-8 py-8 max-w-lg w-full flex flex-col">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-heading mb-1 text-center">
          Google Business Profile Services
        </h2>
        <div class="text-lg font-semibold text-center mb-1">Basic: Profile Management</div>
        <span class="block text-base bg-[#f56b2a] text-white px-5 py-2 rounded-full mb-4 font-semibold text-center"
          >Best for: Maintaining Your Google Presence</span
        >
        <div class="text-4xl font-bold text-[#f56b2a] mb-1 text-center">
          $199<span class="text-lg font-normal text-gray-500">/mo</span>
        </div>
        <ul class="text-body text-base mb-4 space-y-1 list-disc pl-5">
          <li>Basic GBP setup</li>
          <li>Monthly listing maintenance</li>
          <li>Photo uploads</li>
        </ul>
        <div>
          <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-4 py-3 mb-4 flex items-start gap-3">
            <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
            <div>
              <div class="font-bold text-[#f56b2a] mb-1 text-base">
                Add-on: Boost Package <span class="font-bold">$299/mo</span>
              </div>
              <ul class="text-body text-sm space-y-1 list-disc pl-5">
                <li>Full GBP setup & optimization</li>
                <li>Monthly listing management</li>

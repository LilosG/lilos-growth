                class="w-7 h-7 text-[#f56b2a]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><circle cx="9" cy="10" r="1"></circle><circle cx="15" cy="10" r="1"></circle><path

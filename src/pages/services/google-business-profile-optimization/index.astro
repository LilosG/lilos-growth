---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>Google Business Profile Optimization & Maps SEO | Lilos Growth</title>
    <meta
      name="description"
      content="Rank higher in the Google Map Pack and get more calls. Full GBP optimization, posting, reviews, and defense for home service businesses. No contracts, just results."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <Layout>
    <!-- HERO -->
    <section
      class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
          Google Business Profile Optimization & Maps SEO
        </h1>
        <span class="block text-xl md:text-2xl font-semibold mt-2 mb-2 text-[#f56b2a] tracking-wider uppercase">
          For Home Service Businesses
        </span>
        <p class="text-lg md:text-xl text-white/80 mb-7 max-w-2xl font-medium">
          Get found where it matters most—Google Maps. More calls, more reviews, less spam. No contracts, no fluff—just
          real local growth for plumbing, HVAC, pest control, cleaning, landscaping & more.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="#gbp-packages"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            See Packages
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <a
            href="#faq"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            FAQ
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <!-- WHAT IS GBP -->
    <section class="py-16 bg-cream border-t border-gray-100">
      <div class="max-w-5xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">
          What Is Google Business Profile Optimization?
        </h2>
        <p class="text-lg text-body mb-6">
          Your Google Business Profile (GBP) is the single most important tool for ranking in the Google Map Pack and
          driving calls from local customers. We fully optimize, manage, and defend your GBP—so you stay visible, get
          more reviews, and never lose out to spam or competitors.
        </p>
        <div class="flex flex-wrap gap-3 justify-center mb-2">
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Maps SEO</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">GBP Management</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Review Generation</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Photo & Post Updates</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Spam Defense</span>
          <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Reporting</span>
        </div>
        <p class="text-sm text-body/70 mt-3">
          Want to know how your current profile stacks up?
          <a href="#contact" class="text-primary underline hover:text-[#f56b2a]">Get a free audit</a>.
        </p>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="gbp-features" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">
          Our Google Business Profile Optimization Includes:
          <span class="block mx-auto mt-2 h-1 w-20 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">GBP Setup, Claim & Verification</h3>
            <p class="text-body">
              We claim or create your listing, verify ownership, and lock down your business details to prevent
              hijacking.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">Full Profile Optimization</h3>
            <p class="text-body">
              Services, categories, photos, Q&amp;A, hours, and more—optimized to maximize ranking and relevance.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">Map Pack Ranking & Maps SEO</h3>
            <p class="text-body">
              Targeted keywords across your service area to win visibility where customers look first.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">Review Generation & Management</h3>
            <p class="text-body">
              Proven review requests and response guidance, plus monitoring for negative or fake reviews.
            </p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">Ongoing Posts, Photos & Updates</h3>
            <p class="text-body">Regular posts, photos, and updates keep your profile fresh—Google loves activity.</p>
          </div>
          <div class="bg-bluelight rounded-2xl shadow-xl border-2 border-[#f56b2a]/10 p-7">
            <h3 class="font-heading text-xl font-bold mb-3 text-[#f56b2a]">Spam Fighting & Profile Defense</h3>
            <p class="text-body">We monitor competitors and fake edits—protecting your rankings 24/7.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHY US -->
    <section class="py-20 bg-cream border-t border-gray-100" id="why">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">

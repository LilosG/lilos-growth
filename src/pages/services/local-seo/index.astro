---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Local SEO Services for Home Service Businesses | Lilos Growth';
export const description =
  'Rank higher, win more calls, and grow consistently. Local SEO purpose-built for trades—on-page fixes, content, citations, and local links with transparent reporting. Month-to-month. No rollovers.';
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="bg-[#253242] min-h-[420px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-3xl px-4 mx-auto text-center">
      <h1 class="text-4xl md:text-5xl leading-snug font-heading text-white font-extrabold tracking-tight">
        Local SEO for Home Service Businesses
      </h1>
      <p class="mt-4 text-lg md:text-xl text-white/85 font-medium">
        Show up for the jobs that matter. We combine on-page fixes, high-intent content, citations, and local links to
        improve rankings in both Organic and the Map Pack—without long contracts.
      </p>
      <div class="mt-6 flex flex-wrap gap-4 justify-center">
        <a
          href="#plans"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#e65c1e] text-white font-heading font-semibold text-lg shadow transition"
        >
          See Plans
        </a>
        <a
          href="#faq"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
        >
          FAQ
        </a>
      </div>
      <div class="mt-3 flex items-center justify-center gap-2">
        <svg class="w-5 h-5 text-[#f6b100]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"
          ><path d="M10 15l-5.878 3.09L5.854 12 1 7.91l6.066-.49L10 2l2.934 5.42L19 7.91 14.146 12l1.732 6.09z"
          ></path></svg
        >
        <span class="text-white/90 font-semibold text-sm">5-Star Rated by Local Businesses</span>
      </div>
    </div>
  </section>

  <!-- OVERVIEW PILL ROW -->
  <section class="py-12 bg-cream border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-heading">What You Get with Local SEO</h2>
      <p class="text-lg text-body mb-6">
        A practical, repeatable system to improve local visibility and convert more searches into booked jobs.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">On-Page Optimization</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Service &amp; Location Pages</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Citations &amp; Local Links</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Map Pack Support</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Reporting &amp; Strategy Calls</span>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-10 text-center text-heading">
        Our Local SEO System (5 Steps)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {
          [
            {
              t: 'Audit & Strategy',
              d: 'Baseline rankings, competitors, and site health. Clear roadmap aligned to services & city coverage.',
            },
            {
              t: 'On-Page Fixes',
              d: 'Titles, metas, headers, internal links, indexation/crawl, CWV, and schema foundations.',
            },
            {
              t: 'Content',
              d: 'High-intent service/location pages and helpful blog content that converts searches into calls.',
            },
            {
              t: 'Citations & Links',
              d: 'Clean NAP across directories, add niche/trade sites, and earn trustworthy local backlinks.',
            },
            {
              t: 'Reports & Calls',
              d: 'Transparent metrics and monthly strategy calls to prioritize what moves the needle.',
            },
          ].map((s, i) => (
            <div class="rounded-2xl bg-bluelight border border-gray-100 shadow p-6 text-center">
              <div class="mx-auto mb-2 w-10 h-10 flex items-center justify-center rounded-full bg-[#f56b2a]/10 text-[#f56b2a] font-extrabold">
                {i + 1}
              </div>
              <div class="font-heading font-semibold text-heading">{s.t}</div>
              <div class="text-body text-sm mt-1">{s.d}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="py-20 bg-cream border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4 text-heading text-center">
        Local SEO Plans &amp; Pricing
      </h2>
      <p class="text-lg text-body mb-10 text-center">
        Month-to-month. No setup fees. Transparent deliverables. <span class="font-semibold">No rollovers.</span>
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
        <!-- Essentials -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <span
              class="inline-block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full font-heading font-semibold uppercase tracking-wide"
              >Single Location</span
            >
            <h3 class="mt-3 text-xl font-heading font-bold text-heading">Essentials</h3>
            <div class="mt-1 text-3xl font-heading font-extrabold text-[#f56b2a]">
              $499<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc pl-5 text-body text-[15px] space-y-1">
              <li>
                Keyword research &amp; on-page technical fixes (titles, metas, H1-H2, internal linking, schema basics)
              </li>
              <li><span class="font-semibold">Up to 5</span> new/optimized service or location pages per month</li>
              <li><span class="font-semibold">Up to 5</span> blog posts per month (≈750–1,000 words each)</li>
              <li>
                Citations: <span class="font-semibold">10–20</span> initial, then <span class="font-semibold"
                  >5–10/mo</span
                > ongoing
              </li>
              <li>Internal linking &amp; titles/metas refresh as pages are added</li>
              <li>Monthly performance report + <span class="font-semibold">30-min</span> strategy call</li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Get Started
            </a>
          </div>
        </article>

        <!-- Growth -->
        <article
          class="h-full rounded-2xl bg-white shadow-xl border-2 border-primary p-8 grid grid-rows-[auto_1fr_auto] relative"
        >
          <div
            class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-white text-xs font-heading font-bold px-4 py-1 rounded-2xl shadow"
          >
            Most Popular
          </div>
          <header class="text-center">
            <span
              class="inline-block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full font-heading font-semibold uppercase tracking-wide"
              >Includes Essentials</span
            >
            <h3 class="mt-3 text-xl font-heading font-bold text-heading">Growth</h3>
            <div class="mt-1 text-3xl font-heading font-extrabold text-[#f56b2a]">
              $799<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc pl-5 text-body text-[15px] space-y-1">
              <li><span class="font-semibold">Up to 10</span> new/optimized service or location pages per month</li>
              <li><span class="font-semibold">Up to 10</span> blog posts per month</li>
              <li>
                <span class="font-semibold">2–4</span> local backlinks per month (association, partner, sponsor, or guest)
              </li>
              <li>CWV/schema/crawl priority; ongoing citations maintenance</li>
              <li>Quarterly heatmap &amp; competitor review</li>
              <li>Monthly report + <span class="font-semibold">45-min</span> strategy call</li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Choose Growth
            </a>
          </div>
        </article>

        <!-- Pro (on request) -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <span
              class="inline-block text-xs bg-[#f56b2a]/10 text-[#f56b2a] px-3 py-1 rounded-full font-heading font-semibold uppercase tracking-wide"
              >On Request</span
            >
            <h3 class="mt-3 text-xl font-heading font-bold text-heading">Pro</h3>
            <div class="mt-1 text-3xl font-heading font-extrabold text-[#f56b2a]">
              $1,199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc pl-5 text-body text-[15px] space-y-1">
              <li>Includes everything in Growth</li>
              <li><span class="font-semibold">Up to 20</span> new/optimized service or location pages per month</li>
              <li><span class="font-semibold">Up to 10</span> blog posts per month</li>
              <li><span class="font-semibold">4–6</span> local backlinks per month</li>
              <li>Conversion testing on top pages (CRO experiments)</li>
              <li>Bi-weekly check-ins with your strategist</li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Request Pro
            </a>
          </div>
        </article>
      </div>

      <!-- Notes -->
      <p class="mt-6 text-sm text-body/70 text-center">
        Multi-location: +$200/mo per extra SEO location. Add-ons available (LSA management, call tracking, citation
        bursts, PR/guest posts).
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-8 text-center text-heading">Local SEO — FAQs</h2>
      <div class="space-y-6">
        <div class="bg-bluelight rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">How soon will I see results?</h3>
          <p class="text-body text-base">
            Most clients see measurable gains in 30–60 days. We prioritize high-impact fixes and pages first.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
            Do you require contracts or charge setup fees?
          </h3>
          <p class="text-body text-base">No contracts and no setup fees. Month-to-month. Stay because it’s working.</p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
            Can you cover multiple cities or locations?
          </h3>
          <p class="text-body text-base">
            Yes. We right-size page creation and tracking for your footprint. Multi-location fees apply.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Will I get reports and strategy time?</h3>
          <p class="text-body text-base">
            Every plan includes transparent reporting plus scheduled calls (Essentials: 30-min, Growth: 45-min, Pro:
            bi-weekly check-ins).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 bg-primary">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-heading text-white text-3xl font-extrabold mb-3">Ready to Win More Local Jobs?</h2>
      <p class="font-body text-white/85 text-lg mb-6">
        Get a free audit and action plan—no hard sell, just what to do next.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center px-8 py-4 rounded-2xl bg-white hover:bg-bluelight text-primary font-heading font-semibold text-lg shadow transition"
        aria-label="Get Started — open contact form"
      >
        Book My Free Audit
      </a>
    </div>
  </section>
</Layout>

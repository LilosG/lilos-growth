---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import Card from "~/components/ui/Card.astro";
import PricingCard from "~/components/sections/PricingCard.astro";
import ProcessStep from "~/components/sections/ProcessStep.astro";
import { Icon } from "astro-icon/components";
import { seoTiers } from "~/data/packages";

export const title = "Local SEO Services for Home Service Businesses";
export const description =
  "Rank higher, win more calls, and grow consistently. Local SEO purpose-built for trades—on-page fixes, content, citations, and local links with transparent reporting. Month-to-month. No rollovers.";

const processSteps = [
  {
    number: 1,
    title: "Audit & Strategy",
    description:
      "Baseline rankings, competitors, and site health. Clear roadmap aligned to services & city coverage.",
  },
  {
    number: 2,
    title: "On-Page Fixes",
    description:
      "Titles, metas, headers, internal links, indexation/crawl, CWV, and schema foundations.",
  },
  {
    number: 3,
    title: "Content",
    description:
      "High-intent service/location pages and helpful blog content that converts searches into calls.",
  },
  {
    number: 4,
    title: "Citations & Links",
    description:
      "Clean NAP across directories, add niche/trade sites, and earn trustworthy local backlinks.",
  },
  {
    number: 5,
    title: "Reports & Calls",
    description:
      "Transparent metrics and monthly strategy calls to prioritize what moves the needle.",
  },
];

const features = [
  "On-Page Optimization",
  "Service & Location Pages",
  "Citations & Local Links",
  "Map Pack Support",
  "Reporting & Strategy Calls",
];

const faqs = [
  {
    question: "How soon will I see results?",
    answer:
      "Most clients see measurable gains in 30–60 days. We prioritize high-impact fixes and pages first.",
  },
  {
    question: "Do you require contracts or charge setup fees?",
    answer: "No contracts and no setup fees. Month-to-month. Stay because it's working.",
  },
  {
    question: "Can you cover multiple cities or locations?",
    answer:
      "Yes. We right-size page creation and tracking for your footprint. Multi-location fees apply.",
  },
  {
    question: "Will I get reports and strategy time?",
    answer:
      "Every plan includes transparent monthly reporting plus scheduled strategy calls. SEO Local and SEO Growth include monthly calls; SEO Authority includes bi-weekly check-ins.",
  },
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Services", item: "https://lilosgrowth.com/services" },
    { name: "Local SEO", item: "https://lilosgrowth.com/services/local-seo" },
  ]}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://lilosgrowth.com/services/local-seo#service",
      name: "Local SEO for Home Service Businesses",
      description:
        "Local SEO services including on-page optimization, service and location pages, citation building, local link acquisition, and Google Business Profile management for home service businesses.",
      provider: { "@id": "https://lilosgrowth.com/#org" },
      areaServed: { "@type": "Country", name: "United States" },
      url: "https://lilosgrowth.com/services/local-seo",
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "How soon will I see results from local SEO?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most clients see measurable gains in 30-60 days. We prioritize high-impact fixes and pages first.",
          },
        },
        {
          "@type": "Question",
          name: "Do you require contracts or charge setup fees?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No contracts and no setup fees. All plans are month-to-month.",
          },
        },
        {
          "@type": "Question",
          name: "Can you cover multiple cities or locations?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. We right-size page creation and tracking for your service footprint. Multi-location fees apply.",
          },
        },
        {
          "@type": "Question",
          name: "Will I get reports and strategy time?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Every plan includes transparent monthly reporting plus scheduled strategy calls.",
          },
        },
      ],
    },
  ]}
>
  <!-- HERO -->
  <section
    class="relative flex min-h-[420px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
      <h1
        class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Local SEO for Home Service Businesses
      </h1>
      <p class="mt-4 text-base font-medium leading-relaxed text-white/90">
        Show up for the jobs that matter. We combine on-page fixes, high-intent content, citations,
        and local links to improve rankings in both Organic and the Map Pack—without long contracts.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href="#plans" variant="primary" size="lg"> See Plans </Button>
        <Button href="#faq" variant="secondary" size="lg"> FAQ </Button>
      </div>
      <div class="mt-4 flex items-center justify-center gap-2">
        <Icon name="tabler:star-filled" class="text-accent h-5 w-5" />
        <span class="text-sm font-semibold text-white/90">5-Star Rated by Local Businesses</span>
      </div>
    </div>
  </section>

  <!-- OVERVIEW PILL ROW -->
  <section class="border-t border-gray-100 bg-background-cream py-12">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">
        What You Get with Local SEO
      </h2>
      <p class="mb-6 text-base text-body">
        A practical, repeatable system to turn local searches into booked jobs — built for Google,
        Maps, and AI answer engines like AI Overviews and ChatGPT Search, not just classic blue
        links.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {
          features.map((feature) => (
            <Badge variant="primary" size="lg">
              {feature}
            </Badge>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Our Local SEO System (5 Steps)
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
        {
          processSteps.map((step) => (
            <ProcessStep number={step.number} title={step.title} description={step.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="border-t border-gray-100 bg-background-cream py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Local SEO Plans &amp; Pricing
      </h2>
      <p class="mb-10 text-center text-base text-body">
        Month-to-month. No setup fees. Transparent deliverables. <span class="font-semibold"
          >No rollovers.</span
        >
      </p>

      <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3">
        {
          seoTiers.map((tier) => (
            <PricingCard
              title={tier.name}
              price={`$${tier.price.toLocaleString()}`}
              period="mo"
              featured={tier.featured}
              features={[tier.bestFor, ...tier.inclusions, "No rollovers."]}
              ctaText={tier.featured ? "Choose " + tier.name : "Get Started"}
              ctaHref="#contact"
            />
          ))
        }
      </div>

      <!-- Notes -->
      <p class="mt-6 text-center text-sm text-body-light">
        GBP management isn't included at these prices — add it for a flat $250/mo on any tier, or{
          " "
        }
        <a href="/packages" class="font-semibold text-primary underline">see bundled pricing</a>.
        Multi-location: +$200/mo per extra SEO location.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Local SEO — FAQs
      </h2>
      <div class="space-y-4">
        {
          faqs.map((faq, index) => (
            <Card variant={index % 2 === 0 ? "elevated" : "default"}>
              <h3 class="mb-2 font-heading text-base font-semibold text-heading">{faq.question}</h3>
              <p class="text-sm text-body">{faq.answer}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
        Ready to Win More Local Jobs?
      </h2>
      <p class="mb-6 text-base text-white/90">
        Get a free audit and action plan—no hard sell, just what to do next.
      </p>
      <Button href="#contact" variant="white" size="lg"> Book My Free Audit </Button>
    </div>
  </section>
</Layout>

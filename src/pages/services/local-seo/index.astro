---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Local SEO Services for Home Service Businesses | Lilos Growth";
export const description =
  "Rank higher, win more calls, and grow consistently. Local SEO purpose-built for trades—on-page fixes, content, citations, and local links with transparent reporting. Month-to-month. No rollovers.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[420px] flex-col items-center justify-center overflow-hidden bg-[#253242] pb-20 pt-16"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]">
    </div>

    <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
      <h1
        class="font-heading text-4xl font-extrabold leading-snug tracking-tight text-white md:text-5xl"
      >
        Local SEO for Home Service Businesses
      </h1>
      <p class="mt-4 text-lg font-medium text-white/85 md:text-xl">
        Show up for the jobs that matter. We combine on-page fixes, high-intent content, citations,
        and local links to improve rankings in both Organic and the Map Pack—without long contracts.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a
          href="#plans"
          class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#e65c1e]"
        >
          See Plans
        </a>
        <a
          href="#faq"
          class="inline-flex items-center rounded-2xl bg-secondary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#27394b]"
        >
          FAQ
        </a>
      </div>
      <div class="mt-3 flex items-center justify-center gap-2">
        <svg
          class="h-5 w-5 text-[#f6b100]"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
          ><path
            d="M10 15l-5.878 3.09L5.854 12 1 7.91l6.066-.49L10 2l2.934 5.42L19 7.91 14.146 12l1.732 6.09z"
          ></path></svg
        >
        <span class="text-sm font-semibold text-white/90">5-Star Rated by Local Businesses</span>
      </div>
    </div>
  </section>

  <!-- OVERVIEW PILL ROW -->
  <section class="border-t border-gray-100 bg-cream py-12">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-heading md:text-4xl">
        What You Get with Local SEO
      </h2>
      <p class="mb-6 text-lg text-body">
        A practical, repeatable system to improve local visibility and convert more searches into
        booked jobs.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >On-Page Optimization</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Service &amp; Location Pages</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Citations &amp; Local Links</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Map Pack Support</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Reporting &amp; Strategy Calls</span
        >
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-10 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Our Local SEO System (5 Steps)
      </h2>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
        {
          [
            {
              t: "Audit & Strategy",
              d: "Baseline rankings, competitors, and site health. Clear roadmap aligned to services & city coverage.",
            },
            {
              t: "On-Page Fixes",
              d: "Titles, metas, headers, internal links, indexation/crawl, CWV, and schema foundations.",
            },
            {
              t: "Content",
              d: "High-intent service/location pages and helpful blog content that converts searches into calls.",
            },
            {
              t: "Citations & Links",
              d: "Clean NAP across directories, add niche/trade sites, and earn trustworthy local backlinks.",
            },
            {
              t: "Reports & Calls",
              d: "Transparent metrics and monthly strategy calls to prioritize what moves the needle.",
            },
          ].map((s, i) => (
            <div class="rounded-2xl border border-gray-100 bg-bluelight p-6 text-center shadow">
              <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-full bg-[#f56b2a]/10 font-extrabold text-[#f56b2a]">
                {i + 1}
              </div>
              <div class="font-heading font-semibold text-heading">{s.t}</div>
              <div class="mt-1 text-sm text-body">{s.d}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PLANS -->
  <section id="plans" class="border-t border-gray-100 bg-cream py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-4 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Local SEO Plans &amp; Pricing
      </h2>
      <p class="mb-10 text-center text-lg text-body">
        Month-to-month. No setup fees. Transparent deliverables. <span class="font-semibold"
          >No rollovers.</span
        >
      </p>

      <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-3">
        <!-- Essentials -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <span
              class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-[#f56b2a]"
              >Single Location</span
            >
            <h3 class="mt-3 font-heading text-xl font-bold text-heading">Essentials</h3>
            <div class="mt-1 font-heading text-3xl font-extrabold text-[#f56b2a]">
              $499<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc space-y-1 pl-5 text-[15px] text-body">
              <li>
                Keyword research &amp; on-page technical fixes (titles, metas, H1-H2, internal
                linking, schema basics)
              </li>
              <li>
                <span class="font-semibold">Up to 5</span> new/optimized service or location pages per
                month
              </li>
              <li>
                <span class="font-semibold">Up to 5</span> blog posts per month (≈750–1,000 words each)
              </li>
              <li>
                Citations: <span class="font-semibold">10–20</span> initial, then <span
                  class="font-semibold">5–10/mo</span
                > ongoing
              </li>
              <li>Internal linking &amp; titles/metas refresh as pages are added</li>
              <li>
                Monthly performance report + <span class="font-semibold">30-min</span> strategy call
              </li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="border-t border-gray-100 pt-5">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              aria-label="Get Started — open contact form"
            >
              Get Started
            </a>
          </div>
        </article>

        <!-- Growth -->
        <article
          class="relative grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border-2 border-primary bg-white p-8 shadow-xl"
        >
          <div
            class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-2xl bg-primary px-4 py-1 font-heading text-xs font-bold text-white shadow"
          >
            Most Popular
          </div>
          <header class="text-center">
            <span
              class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-[#f56b2a]"
              >Includes Essentials</span
            >
            <h3 class="mt-3 font-heading text-xl font-bold text-heading">Growth</h3>
            <div class="mt-1 font-heading text-3xl font-extrabold text-[#f56b2a]">
              $799<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc space-y-1 pl-5 text-[15px] text-body">
              <li>
                <span class="font-semibold">Up to 10</span> new/optimized service or location pages per
                month
              </li>
              <li><span class="font-semibold">Up to 10</span> blog posts per month</li>
              <li>
                <span class="font-semibold">2–4</span> local backlinks per month (association, partner,
                sponsor, or guest)
              </li>
              <li>CWV/schema/crawl priority; ongoing citations maintenance</li>
              <li>Quarterly heatmap &amp; competitor review</li>
              <li>Monthly report + <span class="font-semibold">45-min</span> strategy call</li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="border-t border-gray-100 pt-5">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              aria-label="Get Started — open contact form"
            >
              Choose Growth
            </a>
          </div>
        </article>

        <!-- Pro (on request) -->
        <article
          class="grid h-full grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header class="text-center">
            <span
              class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 font-heading text-xs font-semibold uppercase tracking-wide text-[#f56b2a]"
              >On Request</span
            >
            <h3 class="mt-3 font-heading text-xl font-bold text-heading">Pro</h3>
            <div class="mt-1 font-heading text-3xl font-extrabold text-[#f56b2a]">
              $1,199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>
          <div class="mt-5 space-y-3">
            <ul class="list-disc space-y-1 pl-5 text-[15px] text-body">
              <li>Includes everything in Growth</li>
              <li>
                <span class="font-semibold">Up to 20</span> new/optimized service or location pages per
                month
              </li>
              <li><span class="font-semibold">Up to 10</span> blog posts per month</li>
              <li><span class="font-semibold">4–6</span> local backlinks per month</li>
              <li>Conversion testing on top pages (CRO experiments)</li>
              <li>Bi-weekly check-ins with your strategist</li>
              <li class="text-xs text-body/70">No rollovers.</li>
            </ul>
          </div>
          <div class="border-t border-gray-100 pt-5">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              aria-label="Get Started — open contact form"
            >
              Request Pro
            </a>
          </div>
        </article>
      </div>

      <!-- Notes -->
      <p class="mt-6 text-center text-sm text-body/70">
        Multi-location: +$200/mo per extra SEO location. Add-ons available (LSA management, call
        tracking, citation bursts, PR/guest posts).
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Local SEO — FAQs
      </h2>
      <div class="space-y-6">
        <div class="rounded-2xl border border-gray-100 bg-bluelight p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            How soon will I see results?
          </h3>
          <p class="text-base text-body">
            Most clients see measurable gains in 30–60 days. We prioritize high-impact fixes and
            pages first.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Do you require contracts or charge setup fees?
          </h3>
          <p class="text-base text-body">
            No contracts and no setup fees. Month-to-month. Stay because it’s working.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Can you cover multiple cities or locations?
          </h3>
          <p class="text-base text-body">
            Yes. We right-size page creation and tracking for your footprint. Multi-location fees
            apply.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Will I get reports and strategy time?
          </h3>
          <p class="text-base text-body">
            Every plan includes transparent reporting plus scheduled calls (Essentials: 30-min,
            Growth: 45-min, Pro: bi-weekly check-ins).
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-3xl font-extrabold text-white">
        Ready to Win More Local Jobs?
      </h2>
      <p class="mb-6 font-body text-lg text-white/85">
        Get a free audit and action plan—no hard sell, just what to do next.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center rounded-2xl bg-white px-8 py-4 font-heading text-lg font-semibold text-primary shadow transition hover:bg-bluelight"
        aria-label="Get Started — open contact form"
      >
        Book My Free Audit
      </a>
    </div>
  </section>
</Layout>

            >
              Get Started
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE PACKAGES SECTION - UNIFIED STYLE WITH ADD-ON CHECKBOX -->
    <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
          Service Packages for Home Service Companies
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-xl text-body mb-14 text-center font-medium">
          Choose the package that fits your goals. No contracts. Real results.
        </p>
        <div class="flex flex-col md:flex-row gap-10 items-stretch justify-center">
          <!-- GBP Card -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto"

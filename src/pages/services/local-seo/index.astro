              <li>✓ Get clear, monthly reporting</li>
            </ul>
            <div class="text-xs text-gray-500 font-medium mb-4">No contract, cancel anytime</div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
            >
              Get Started
            </a>
          </div>
          <!-- Growth Package -->
          <div
            class="flex-1 bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[480px] max-w-md mx-auto"
          >
            <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">Local SEO Growth Package</h3>
            <div class="text-base font-semibold mb-1 text-center">

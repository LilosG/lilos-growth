---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Website Design & Development for Service Businesses | Lilos Growth';
export const description = 'Get a modern, mobile-optimized website that converts visitors into customers. We design, build, and manage high-performance sites for local service companies, with SEO built-in from day one.';

// Breadcrumbs + Service schema
const breadcrumbs = [
  { name: "Home", item: "/" },
  { name: "Services", item: "/services" },
  { name: "Website Design & Development", item: "/services/web-design" },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Website Design & Development",
  "serviceType": "Website Design & Development",
  "provider": { "@id": "https://lilosgrowth.com/#local" },
  "areaServed": { "@type": "Country", "name": "United States" }
};
---

<Layout {title} {description} breadcrumbs={breadcrumbs} schema={[serviceSchema]}>
  <!-- HERO -->
  <section
    class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
      <h1 class="text-4xl md:text-5xl leading-snug font-heading text-white font-extrabold tracking-tight">
        Website Design &amp; Development
      </h1>
      <span class="block text-xl md:text-2xl font-semibold mt-1 text-[#f56b2a] tracking-wider uppercase">
        For Home Service Businesses
      </span>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl font-medium">
        Turn your website into a lead machine—fast, mobile-friendly, and built for local service pros. Unlimited
        support, no contracts, conversion-first.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#waas-package"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
        >
          See Packages
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
            ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
        <a
          href="#faq"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
        >
          FAQ
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
            ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT’S INCLUDED -->
  <section class="py-16 bg-cream border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">What’s Included With Your Website</h2>
      <p class="text-lg text-body mb-6">
        Everything you need for a high-converting, low-maintenance website—built, hosted, and managed for you.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Mobile-Responsive Design</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Lightning-Fast Hosting</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">On-Brand Copywriting</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">SEO-Friendly Structure</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Lead Capture Forms</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Ongoing Edits &amp; Support</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Security &amp; Backups</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Analytics Tracking</span>
      </div>

      <p class="text-sm text-body/70 mt-3">
        Want to see sample sites or get a website audit?
        <a
          href="#contact"
          class="text-primary underline hover:text-[#f56b2a]"
          aria-label="Get Started — open contact form">Contact us</a
        >.
      </p>
    </div>
  </section>

  <!-- MAIN WAAS PACKAGE (single aligned card) -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="waas-package">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
        Website Design &amp; Development Packages
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-12 text-center font-medium">
        One simple monthly plan. No contracts. Real results.
      </p>

      <article
        class="mx-auto max-w-xl rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
      >
        <header class="text-center">
          <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Website Design &amp; Development</h3>
          <div class="text-sm font-semibold mt-1">Regular: Website Essentials</div>
          <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold">
            Best for: Professional, Conversion-Ready Sites
          </span>
          <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-3">
            $199<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
        </header>

        <div class="mt-5 space-y-4">
          <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
            <li>Mobile-friendly design</li>
            <li>Fast, secure hosting</li>
            <li>Updates for up to 5 pages / month</li>
            <li>Basic support &amp; edits</li>
          </ul>

          <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4">
            <div class="font-semibold text-[#f56b2a] mb-1">
              Add-on: Boost Package <span class="font-bold">$399/mo</span>
            </div>
            <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
              <li>Everything in Regular, plus:</li>
              <li>Updates for up to 15 pages / month</li>
              <li>New landing / service pages</li>
              <li>Advanced conversion optimization</li>
              <li>Quarterly design refresh</li>
              <li>Priority support</li>
            </ul>
          </div>
        </div>

        <div class="pt-4 border-t border-gray-100">
          <a
            href="#contact"
            class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
            aria-label="Get Started — open contact form"
          >
            Get Started
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-24 bg-cream border-t border-gray-100" id="why">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">
        Why Home Service Pros Choose Lilos Growth
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M3 12l6 6l12-12"></path></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Built by Home Service Owners</h3>
          <p class="text-body text-center text-[15px]">We design with your customers in mind.</p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><circle cx="12" cy="12" r="10"></circle></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">No Long-Term Contracts</h3>
          <p class="text-body text-center text-[15px]">Stay because you love your site.</p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M4 7l8 8l8-8"></path></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Unlimited Support</h3>
          <p class="text-body text-center text-[15px]">Request changes anytime—we’ve got you.</p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M5 12l5 5L20 7"></path></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Fast, Secure Hosting</h3>
          <p class="text-body text-center text-[15px]">Lightning-quick loads + protection.</p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M12 8v4l3 3"></path></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Conversion-Focused</h3>
          <p class="text-body text-center text-[15px]">Built to turn visits into booked jobs.</p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><circle cx="9" cy="10" r="1"></circle><circle cx="15" cy="10" r="1"></circle><path
                d="M8 15s1.5-2 4-2 4 2 4 2"></path></svg
            >
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Simple &amp; Human</h3>
          <p class="text-body text-center text-[15px]">Plain English, clear next steps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-PACKAGE GRID (all CTAs aligned) -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
        Service Packages for Home Service Companies
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Choose the package that fits your goals. No contracts. Real results.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-stretch auto-rows-fr">
        <!-- GBP -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Google Business Profile Services</h3>
            <div class="text-sm font-semibold mt-1">Basic: Profile Management</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >Best for: Maintain Your Google Presence</span
            >
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-3">
              $199<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>

          <div class="mt-5 space-y-4">
            <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
              <li>GBP setup or audit</li>
              <li>Monthly listing updates &amp; photos</li>
              <li>Category &amp; keyword targeting</li>
              <li>Basic performance tracking</li>
            </ul>
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4">
              <div class="font-semibold text-[#f56b2a] mb-1">
                Add-on: Boost Package <span class="font-bold">+ $300/mo</span> (Total $499)
              </div>
              <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
                <li>Weekly posts &amp; updates</li>
                <li>Review request &amp; response strategy</li>
                <li>Competitor monitoring &amp; insights</li>
                <li>Citation build &amp; cleanup (core listings)</li>
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form">Get Started</a
            >
          </div>
        </article>

        <!-- Organic & Local SEO (Most Popular) -->
        <article
          class="h-full relative rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <div
            class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10"
          >
            Most Popular
          </div>
          <header class="text-center mt-3">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Organic &amp; Local SEO</h3>
            <div class="text-sm font-semibold mt-1">Regular: Local SEO Essentials</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >Best for: Steady, Consistent Growth</span
            >
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-3">
              $499<span class="text-base font-normal text-gray-500">/mo</span>
            </div>
          </header>

          <div class="mt-5 space-y-4">
            <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
              <li>On-page SEO optimization</li>
              <li>Keyword research</li>
              <li>Technical SEO improvements</li>
              <li><span class="font-semibold">5</span> service/location pages per month</li>
              <li><span class="font-semibold">5</span> blog posts per month</li>
            </ul>
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4">
              <div class="font-semibold text-[#f56b2a] mb-1">
                Add-on: Boost Package <span class="font-bold">$799/mo</span>
              </div>
              <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
                <li>Everything in Regular, plus:</li>
                <li><span class="font-semibold">10–15</span> service/location pages per month</li>
                <li><span class="font-semibold">10</span> blog posts per month</li>
                <li>Local citation build &amp; cleanup</li>
                <li>Competitor tracking &amp; strategy call</li>
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form">Get Started</a
            >
          </div>
        </article>

        <!-- One-Time Website Build -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">One-Time Website Build</h3>
            <div class="text-sm font-semibold mt-1">Base: Up to 10 Pages</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >Best for: Pay-Once, Own Your Site</span
            >
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-3">$1,500</div>
          </header>

          <div class="mt-5 space-y-4">
            <ul class="text-body text-[15px] space-y-1 list-disc pl-5">
              <li>Custom mobile-friendly design</li>
              <li>On-page SEO setup (titles, meta, schema)</li>
              <li>Contact / lead form setup</li>
              <li>Launch &amp; technical testing</li>
              <li>Training on site updates</li>
              <li>Support: 2 hrs/month for 6 months</li>
            </ul>

            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4">
              <div class="font-semibold text-[#f56b2a] mb-1">

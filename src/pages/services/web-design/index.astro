---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Website Design & Development for Service Businesses | Lilos Growth';
export const description =
  'Modern, mobile-optimized websites that convert. One-time website builds for home-service companies — fast launches, SEO-ready structure, and conversion-first design.';
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
      <h1 class="text-4xl md:text-5xl leading-snug font-heading text-white font-extrabold tracking-tight">
        Website Design &amp; Development
      </h1>
      <span class="block text-xl md:text-2xl font-semibold mt-1 text-[#f56b2a] tracking-wider uppercase">
        Built for Home-Service Pros
      </span>
      <p class="text-lg md:text-xl text-white/80 max-w-2xl font-medium">
        One-time website builds that launch fast and win more calls. Conversion-first, SEO-ready, and easy to update.
      </p>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#packages"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition"
        >
          See Packages
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="#faq"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition"
        >
          FAQ
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT’S INCLUDED (high-value, non-restrictive) -->
  <section class="py-16 bg-cream border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">What You Get</h2>
      <p class="text-lg text-body mb-6">
        A conversion-ready site with clean structure, local SEO fundamentals, and everything needed for a strong launch.
      </p>

      <div class="flex flex-wrap gap-3 justify-center">
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Mobile-Responsive Design</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">On-Brand Copy &amp; CTAs</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">SEO-Friendly Architecture</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Titles, Metas &amp; Headings</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Schema Markup</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Lead Forms / Click-to-Call</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Analytics &amp; Tracking Setup</span>
      </div>

      <p class="text-sm text-body/70 mt-3">
        Need ongoing hosting/updates? See <a
          href="/packages#packages"
          class="text-primary underline hover:text-[#f56b2a]">Website-as-a-Service</a
        >.
      </p>
    </div>
  </section>

  <!-- ONE-TIME WEBSITE BUILDS -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center">
        One-Time Website Packages
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Own your site outright. Transparent scope, fast timelines, and SEO best practices from day one.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch auto-rows-fr">
        <!-- Launch Lite -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Launch Lite</h3>
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-1">$499</div>
            <div class="text-sm text-body mt-1">Approx. 10 pages</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >3–5 business-day launch</span
            >
          </header>

          <ul class="mt-5 text-body text-[15px] space-y-1 list-disc pl-5">
            <li>Home, 3 service pages, About, Contact, + essentials</li>
            <li>Clean site structure with internal linking scaffold</li>
            <li>Titles, metas, H1–H2 setup &amp; basic schema</li>
            <li>Lead capture (form + click-to-call)</li>
            <li>Analytics setup (GA4/GTM if provided)</li>
          </ul>

          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Get Started
            </a>
          </div>
        </article>

        <!-- Starter -->
        <article
          class="h-full relative rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <div
            class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10"
          >
            Most Popular
          </div>
          <header class="text-center mt-3">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Starter</h3>
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-1">$750</div>
            <div class="text-sm text-body mt-1">Up to 15 pages</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >5–7 business-day launch</span
            >
          </header>

          <ul class="mt-5 text-body text-[15px] space-y-1 list-disc pl-5">
            <li>Everything in Launch Lite, plus capacity for more services/areas</li>
            <li>Expanded internal linking &amp; conversion blocks (badges, FAQs, reviews)</li>
            <li>SEO foundations: titles/metas/H1–H2 at scale</li>
            <li>Blog setup (ready for publishing)</li>
            <li>Stock image library (curated, royalty-free)</li>
          </ul>

          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Get Started
            </a>
          </div>
        </article>

        <!-- Standard -->
        <article
          class="h-full rounded-2xl bg-white shadow-md border border-gray-200 p-8 grid grid-rows-[auto_1fr_auto]"
        >
          <header class="text-center">
            <h3 class="text-lg md:text-xl font-heading font-semibold text-heading">Standard</h3>
            <div class="text-2xl md:text-3xl font-bold text-[#f56b2a] mt-1">$1,500</div>
            <div class="text-sm text-body mt-1">Approx. 25 pages</div>
            <span class="inline-block text-xs bg-[#f56b2a] text-white px-3 py-1.5 rounded-full mt-3 font-semibold"
              >10–14 business-day launch</span
            >
          </header>

          <ul class="mt-5 text-body text-[15px] space-y-1 list-disc pl-5">
            <li>Large buildout for services + multiple areas</li>
            <li>Enhanced schema (LocalBusiness + Services)</li>
            <li>Advanced conversion UX (sticky CTAs, trust elements)</li>
            <li>Performance pass (Core Web Vitals-minded)</li>
            <li>Pre-launch QA &amp; handoff with update training</li>
          </ul>

          <div class="pt-5 border-t border-gray-100">
            <a
              href="#contact"
              class="block w-full text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-base shadow hover:bg-[#c9400a] transition"
              aria-label="Get Started — open contact form"
            >
              Get Started
            </a>
          </div>
        </article>
      </div>

      <p class="text-sm text-body/70 mt-6 text-center">
        Need ongoing edits, hosting, and growth support? Our <a
          href="/packages#packages"
          class="text-primary underline hover:text-[#f56b2a]">Website-as-a-Service</a
        > starts at <span class="font-semibold">$199/mo</span>.
      </p>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-24 bg-cream border-t border-gray-100" id="why">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">
        Why Home-Service Pros Choose Lilos Growth
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 12l6 6l12-12"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Built for Real-World Leads</h3>
          <p class="text-body text-center text-[15px]">
            Clear calls-to-action, trust elements, and fast paths to call or book.
          </p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">SEO-Ready Structure</h3>
          <p class="text-body text-center text-[15px]">
            Titles, headings, internal links, and schema done right from day one.
          </p>
        </div>

        <div class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10">
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 7l8 8l8-8"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-semibold text-heading mb-1 text-center">Fast Turnarounds</h3>
          <p class="text-body text-center text-[15px]">Tight timelines without cutting corners.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white border-t border-gray-100" id="faq">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center">
        Website Design &amp; Development: FAQs
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>

      <div class="space-y-6">
        <div class="bg-bluelight rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Do I own the website?</h3>
          <p class="text-body text-base">Yes. These are one-time projects — you fully own the finished site.</p>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Is hosting included?</h3>
          <p class="text-body text-base">
            Hosting/ongoing updates are available through our Website-as-a-Service starting at <span
              class="font-semibold">$199/mo</span
            >.
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">How quickly can my site be live?</h3>
          <p class="text-body text-base">
            Launch Lite: 3–5 business days; Starter: 5–7 business days; Standard: 10–14 business days (content readiness
            affects timelines).
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Can you help with SEO after launch?</h3>
          <p class="text-body text-base">Absolutely — pair your site with our Local SEO plans for steady growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="py-12 bg-primary">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="font-heading text-white text-3xl font-extrabold mb-4">Ready to Launch a Site That Converts?</h2>
      <p class="font-body text-white/80 text-lg mb-7">
        Book a quick call. We’ll map your pages, timeline, and next steps.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center px-8 py-4 rounded-2xl bg-white hover:bg-bluelight text-primary font-heading font-semibold text-lg shadow transition"
        aria-label="Get Started — open contact form"
      >
        Book My Free Website Plan
      </a>
    </div>
  </section>
</Layout>

<!-- JSON-LD (kept; aligned to page topic) -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Website Design & Development",
    "serviceType": "Website Design & Development",
    "provider": { "@id": "https://lilosgrowth.com/#local" },
    "areaServed": { "@type": "Country", "name": "United States" }
  }
</script>

---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/core/Button.astro";
import Badge from "~/components/core/Badge.astro";
import Card from "~/components/core/Card.astro";
import PricingCard from "~/components/composed/PricingCard.astro";
import FeatureCard from "~/components/composed/FeatureCard.astro";
import { Icon } from "astro-icon/components";

export const title = "Website Design & Development for Service Businesses";
export const description =
  "Modern, mobile-optimized websites that convert. One-time website builds for home-service companies — fast launches, SEO-ready structure, and conversion-first design.";

const features = [
  "Mobile-Responsive Design",
  "On-Brand Copy & CTAs",
  "SEO-Friendly Architecture",
  "Titles, Metas & Headings",
  "Schema Markup",
  "Lead Forms / Click-to-Call",
  "Analytics & Tracking Setup",
];

const trustReasons = [
  {
    icon: "tabler:target",
    title: "Built for Real-World Leads",
    description: "Clear calls-to-action, trust elements, and fast paths to call or book.",
  },
  {
    icon: "tabler:seo",
    title: "SEO-Ready Structure",
    description: "Titles, headings, internal links, and schema done right from day one.",
  },
  {
    icon: "tabler:clock-bolt",
    title: "Fast Turnarounds",
    description: "Tight timelines without cutting corners.",
  },
];

const faqs = [
  {
    question: "Do I own the website?",
    answer: "Yes. These are one-time projects — you fully own the finished site.",
  },
  {
    question: "Is hosting included?",
    answer:
      "Hosting/ongoing updates are available through our Website-as-a-Service starting at <strong>$199/mo</strong>.",
  },
  {
    question: "How quickly can my site be live?",
    answer:
      "Launch Lite: 3–5 business days; Starter: 5–7 business days; Standard: 10–14 business days (content readiness affects timelines).",
  },
  {
    question: "Can you help with SEO after launch?",
    answer: "Absolutely — pair your site with our Local SEO plans for steady growth.",
  },
];
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 text-center"
    >
      <h1
        class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Website Design &amp; Development
      </h1>
      <span class="text-accent block text-base font-semibold uppercase tracking-wider md:text-lg">
        Built for Home-Service Pros
      </span>
      <p class="max-w-2xl text-base font-medium leading-relaxed text-white/90">
        One-time website builds that launch fast and win more calls. Conversion-first, SEO-ready,
        and easy to update.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        <Button href="#packages" variant="primary" size="lg">
          See Packages
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
        <Button href="#faq" variant="secondary" size="lg">
          FAQ
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="bg-cream border-t border-gray-100 py-12">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">What You Get</h2>
      <p class="mb-6 text-base text-body">
        A conversion-ready site with clean structure, local SEO fundamentals, and everything needed
        for a strong launch.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        {
          features.map((feature) => (
            <Badge variant="primary" size="lg">
              {feature}
            </Badge>
          ))
        }
      </div>

      <p class="mt-4 text-sm text-body-light">
        Need ongoing hosting/updates? See <a
          href="/packages#packages"
          class="text-primary underline hover:text-primary-dark">Website-as-a-Service</a
        >.
      </p>
    </div>
  </section>

  <!-- WAAS PRICING -->
  <section id="waas" class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Website-as-a-Service Plans
      </h2>
      <p class="mb-10 text-center text-base text-body">
        Modern, conversion-ready website + support. Month-to-month. No long contracts.
      </p>

      <div class="grid auto-rows-fr grid-cols-1 gap-6 md:grid-cols-3">
        <!-- WaaS Starter -->
        <PricingCard
          title="WaaS — Starter"
          price="$199"
          period="mo"
          description="Modern, conversion-ready site + support"
          features={[
            "<strong>Mobile-first site</strong> with SEO baked in",
            "<strong>Secure hosting & monitoring</strong>",
            "<strong>Unlimited minor edits</strong> via support tickets",
            "<strong>Analytics & lead tracking</strong> set up",
            "<strong>Month-to-month support</strong> — no long contracts",
          ]}
          ctaText="Choose $199 Plan"
          ctaHref="/packages#packages"
        />

        <!-- WaaS Growth -->
        <PricingCard
          title="WaaS — Growth"
          price="$299"
          period="mo"
          description="More pages, CRO elements, and priority support"
          featured={true}
          features={[
            "<strong>Everything in Starter</strong>, plus",
            "<strong>More pages & optimizations</strong> monthly",
            "<strong>Expanded citations & link acquisition</strong> guidance",
            "<strong>Quarterly competitor review</strong> & snapshot",
          ]}
          ctaText="Choose $299 Plan"
          ctaHref="/packages#packages"
        />

        <!-- WaaS Scale -->
        <PricingCard
          title="WaaS — Scale"
          price="$399"
          period="mo"
          description="Higher-volume monthly execution"
          features={[
            "<strong>Everything in Growth</strong>, plus",
            "<strong>Ongoing citations</strong> at scale",
            "<strong>Expanded content volume</strong> as needed",
            "<strong>Monthly report</strong> + strategy call",
          ]}
          ctaText="Choose $399 Plan"
          ctaHref="/packages#packages"
        />
      </div>
    </div>
  </section>

  <!-- ONE-TIME BUILDS -->
  <section id="one-time" class="bg-cream border-t border-gray-100 py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        One-Time Website Packages
      </h2>
      <p class="mb-10 text-center text-base text-body">
        Own your site outright. Transparent scope, fast timelines, and SEO best practices from day
        one.
      </p>

      <div class="grid auto-rows-fr grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Starter $499 -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-left">
            <h3 class="font-heading text-lg font-bold text-heading md:text-xl">Starter</h3>
            <div class="mt-2 text-2xl font-extrabold text-primary md:text-3xl">$499</div>
            <div class="mt-1 text-sm text-body">Approx. 10 pages</div>
            <Badge variant="primary" size="sm" class="mt-3">3–5 business-day launch</Badge>
          </div>
          <ul class="mt-5 flex-1 space-y-2 text-sm text-body">
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Home, 3 service pages, About, Contact, + essentials</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Clean site structure with internal linking scaffold</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Titles, metas, H1–H2 setup & basic schema</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Lead capture (form + click-to-call)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Analytics setup (GA4/GTM if provided)</span>
            </li>
          </ul>
          <div class="mt-6 border-t border-gray-100 pt-4">
            <Button href="#contact" variant="primary" size="md" class="w-full">
              Get Started
            </Button>
          </div>
        </Card>

        <!-- Standard $750 -->
        <Card variant="elevated" class="relative flex h-full flex-col border-2 border-primary">
          <Badge
            variant="primary"
            size="sm"
            class="absolute -top-3 left-1/2 -translate-x-1/2 shadow-md"
          >
            Most Popular
          </Badge>
          <div class="mt-2 text-left">
            <h3 class="font-heading text-lg font-extrabold text-heading md:text-xl">Standard</h3>
            <div class="mt-2 text-2xl font-extrabold text-primary md:text-3xl">$750</div>
            <div class="mt-1 text-sm text-body">Up to 15 pages</div>
            <Badge variant="primary" size="sm" class="mt-3">5–7 business-day launch</Badge>
          </div>
          <ul class="mt-5 flex-1 space-y-2 text-sm text-body">
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Everything in Launch Lite, plus capacity for more services/areas</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Expanded internal linking & conversion blocks (badges, FAQs, reviews)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>SEO foundations: titles/metas/H1–H2 at scale</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Blog setup (ready for publishing)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Stock image library (curated, royalty-free)</span>
            </li>
          </ul>
          <div class="mt-6 border-t border-gray-100 pt-4">
            <Button href="#contact" variant="primary" size="md" class="w-full">
              Get Started
            </Button>
          </div>
        </Card>

        <!-- Growth Site $1,500 -->
        <Card variant="elevated" class="flex h-full flex-col">
          <div class="text-left">
            <h3 class="font-heading text-lg font-bold text-heading md:text-xl">Growth Site</h3>
            <div class="mt-2 text-2xl font-extrabold text-primary md:text-3xl">$1,500</div>
            <div class="mt-1 text-sm text-body">Approx. 25 pages</div>
            <Badge variant="primary" size="sm" class="mt-3">10–14 business-day launch</Badge>
          </div>
          <ul class="mt-5 flex-1 space-y-2 text-sm text-body">
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Large buildout for services + multiple areas</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Enhanced schema (LocalBusiness + Services)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Advanced conversion UX (sticky CTAs, trust elements)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Performance pass (Core Web Vitals-minded)</span>
            </li>
            <li class="flex items-start">
              <Icon
                name="tabler:circle-check-filled"
                class="mr-2 mt-0.5 h-4 w-4 flex-shrink-0 text-primary"
              />
              <span>Pre-launch QA & handoff with update training</span>
            </li>
          </ul>
          <div class="mt-6 border-t border-gray-100 pt-4">
            <Button href="#contact" variant="primary" size="md" class="w-full">
              Get Started
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-white py-16" id="why">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Why Home-Service Pros Choose Lilos Growth
      </h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {
          trustReasons.map((reason) => (
            <FeatureCard icon={reason.icon} title={reason.title} description={reason.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream border-t border-gray-100 py-16" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Website Design &amp; Development: FAQs
      </h2>

      <div class="space-y-4">
        {
          faqs.map((faq, index) => (
            <Card variant={index % 2 === 0 ? "elevated" : "default"}>
              <h3 class="mb-2 font-heading text-base font-semibold text-heading md:text-lg">
                {faq.question}
              </h3>
              <p class="text-sm text-body md:text-base" set:html={faq.answer} />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
        Ready to Launch a Site That Converts?
      </h2>
      <p class="mb-6 text-base text-white/90">
        Book a quick call. We'll map your pages, timeline, and next steps.
      </p>
      <Button href="#contact" variant="white" size="lg"> Book My Free Website Plan </Button>
    </div>
  </section>
</Layout>

<!-- JSON-LD -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Website Design & Development",
    "serviceType": "Website Design & Development",
    "provider": { "@id": "https://lilosgrowth.com/#local" },
    "areaServed": { "@type": "Country", "name": "United States" }
  }
</script>

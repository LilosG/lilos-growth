---
import Layout from '~/layouts/PageLayout.astro';
export const title = 'Website Design & Development | Lilos Growth';
export const description =
  'Custom website design & ongoing support for home service businesses. Modern, conversion-focused sites with fast hosting, edits, and optional Boost package. No contracts, just results.';
---

<Layout>
  <!-- HERO SECTION -->
  <section
    class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
    <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
      <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
      <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
        Website Design & Development
      </h1>
      <span class="block text-xl md:text-2xl font-semibold mt-2 mb-2 text-[#f56b2a] tracking-wider uppercase">
        For Home Service Businesses
      </span>
      <p class="text-lg md:text-xl text-white/80 mb-7 max-w-2xl font-medium">
        Turn your website into a lead machine. Fast, mobile-friendly, and custom built for local service pros—with
        unlimited support, no contracts, and a conversion-first approach.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="#waas-package"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition duration-200"
        >
          See Packages
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="#faq"
          class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition duration-200"
        >
          FAQ
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED / FEATURES -->
  <section class="py-16 bg-cream border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold mb-5 text-heading">What’s Included With Your Website</h2>
      <p class="text-lg text-body mb-6">
        Everything you need for a high-converting, low-maintenance website—built, hosted, and managed for you.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mb-2">
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Mobile-Responsive Design</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Lightning-Fast Hosting</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">On-Brand Copywriting</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">SEO-Friendly Structure</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Lead Capture Forms</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Ongoing Edits & Support</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Security & Backups</span>
        <span class="px-4 py-2 rounded-xl bg-bluelight font-heading font-semibold">Analytics Tracking</span>
      </div>
      <p class="text-sm text-body/70 mt-3">
        Want to see sample sites or get a website audit? <a
          href="#contact"
          class="text-primary underline hover:text-[#f56b2a]">Contact us</a
        >.
      </p>
    </div>
  </section>

  <!-- MAIN SERVICE: SINGLE LARGE CARD -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="waas-package">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
        Website Design & Development Packages
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        One simple monthly plan. No contracts. Real results.
      </p>
      <div class="flex flex-col items-center">
        <div
          class="bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px] max-w-md mx-auto"
        >
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">Website Design & Development</h3>
          <div class="text-base font-semibold mb-1 text-center">Regular: Website Essentials</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Professional, Conversion-Ready Websites
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $199<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>Mobile-friendly design</li>
            <li>Fast, secure hosting</li>
            <li>Updates for up to 5 pages/month</li>
            <li>Basic support & edits</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">$399/mo</span>
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Everything in Regular, plus:</li>
                  <li>Updates for up to 15 pages/month</li>
                  <li>New service or landing pages</li>
                  <li>Advanced conversion optimization</li>
                  <li>Quarterly design refresh</li>
                  <li>Priority support</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >Get Started</a
            >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="py-24 bg-cream border-t border-gray-100" id="why">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center relative">
        Why Home Service Pros Choose Lilos Growth
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-14">
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M3 12l6 6l12-12"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Built by Home Service Owners</h3>
          <p class="text-body text-center">We know your industry and design with your customers in mind.</p>
        </div>
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">No Long-Term Contracts</h3>
          <p class="text-body text-center">Stay because you love your site, not because you’re locked in.</p>
        </div>
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 7l8 8l8-8"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Unlimited Support</h3>
          <p class="text-body text-center">Request changes or edits anytime. We keep your site fresh.</p>
        </div>
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 12l5 5L20 7"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Fast, Secure Hosting</h3>
          <p class="text-body text-center">Your site loads instantly and stays protected 24/7.</p>
        </div>
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 8v4l3 3"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Conversion-Focused</h3>
          <p class="text-body text-center">Designed for leads, bookings, and more business—period.</p>
        </div>
        <div
          class="flex flex-col items-center bg-white rounded-2xl p-8 shadow-lg border border-[#f56b2a]/10 hover:shadow-xl transition"
        >
          <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
            <svg class="w-7 h-7 text-[#f56b2a]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="9" cy="10" r="1"></circle><circle cx="15" cy="10" r="1"></circle>
              <path d="M8 15s1.5-2 4-2 4 2 4 2"></path>
            </svg>
          </span>
          <h3 class="text-lg font-heading font-bold text-heading mb-2 text-center">Simple & Human</h3>
          <p class="text-body text-center">We speak your language and keep things easy for you.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4-CARD LAYOUT (GBP now matches home-page content; alignment normalized) -->
  <section class="py-24 bg-bluelight border-t border-gray-100 shadow-xl" id="packages">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-4 text-center relative">
        Service Packages for Home Service Companies
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <p class="text-xl text-body mb-14 text-center font-medium">
        Choose the package that fits your goals. No contracts. Real results.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 items-stretch">
        <!-- GBP Services (updated to mirror home page) -->
        <article
          class="bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px]"
        >
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">Google Business Profile Services</h3>
          <div class="text-base font-semibold mb-1 text-center">Basic: Profile Management</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Maintaining Your Google Presence
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $199<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>GBP setup or audit</li>
            <li>Monthly listing updates &amp; photos</li>
            <li>Category &amp; keyword targeting</li>
            <li>Basic performance tracking</li>
            <li>Q&amp;A and Services setup for key offerings</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">+$300/mo</span> (Total $499)
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Weekly posts &amp; updates</li>
                  <li>Review request &amp; response strategy</li>
                  <li>Competitor monitoring &amp; insights</li>
                  <li>Citation build &amp; cleanup: 500+ listings + BBB, Bing, YP, Yelp</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >Get Started</a
            >
          </div>
        </article>

        <!-- Organic & Local SEO (Most Popular) – now mirrors home page counts -->
        <article
          class="relative bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px]"
        >
          <div
            class="absolute -top-7 left-1/2 -translate-x-1/2 bg-[#f56b2a] text-white text-xs font-bold px-6 py-1 rounded-full shadow z-10"
          >
            Most Popular
          </div>
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center mt-3">Organic &amp; Local SEO</h3>
          <div class="text-base font-semibold mb-1 text-center">Regular: Local SEO Essentials</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Steady, Consistent Growth
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $499<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>On-page SEO optimization</li>
            <li>Keyword research</li>
            <li>Technical SEO improvements</li>
            <li><span class="font-semibold">5</span> new service/location pages per month</li>
            <li><span class="font-semibold">5</span> new blog posts per month</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">$799/mo</span>
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Everything in Regular, plus:</li>
                  <li><span class="font-semibold">10</span> new service/location pages per month</li>
                  <li><span class="font-semibold">10</span> new blog posts per month</li>
                  <li>Local citation cleanup &amp; building</li>
                  <li>Competitor tracking &amp; reporting</li>
                  <li>Monthly strategy call</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >Get Started</a
            >
          </div>
        </article>

        <!-- One-Time Website Build (unchanged) -->
        <article
          class="bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px]"
        >
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">One-Time Website Build</h3>
          <div class="text-base font-semibold mb-1 text-center">Base: Up to 10 Pages</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Pay-Once, Own Your Site
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">$1,500</div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>Custom mobile-friendly design</li>
            <li>On-page SEO setup (titles, meta, schema)</li>
            <li>Contact/lead form setup</li>
            <li>Launch &amp; technical testing</li>
            <li>Training on site updates</li>
            <li>Support: 2 hrs/month for 6 months</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">$3,000</span>
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Up to 20 total pages</li>
                  <li>Advanced conversion features (sticky CTAs, booking/chat)</li>
                  <li>Custom integrations (payments, CRM, etc.)</li>
                  <li>Support: 4 hrs/month for 12 months</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >Get Started</a
            >
          </div>
        </article>

        <!-- Local SEO + GBP Mgmt (kept consistent) -->
        <article
          class="bg-white rounded-2xl shadow-md border border-gray-200 px-8 pt-8 pb-6 flex flex-col items-center min-h-[600px]"
        >
          <h3 class="text-xl font-heading font-bold text-heading mb-2 text-center">Local SEO + GBP Mgmt</h3>
          <div class="text-base font-semibold mb-1 text-center">Base: Complete Local Presence</div>
          <span class="block text-sm bg-[#f56b2a] text-white px-4 py-2 rounded-full mb-4 font-semibold text-center">
            Best for: Map Pack + Organic Results
          </span>
          <div class="text-3xl font-bold text-[#f56b2a] mb-2">
            $799<span class="text-base font-normal text-gray-500">/mo</span>
          </div>
          <ul class="text-body text-base mb-6 space-y-1 text-left list-disc pl-5 w-full">
            <li>Includes Local SEO Base + GBP Base</li>
            <li>Unified reporting dashboard</li>
            <li>Monthly rank/map visibility review</li>
            <li>Quarterly competitor snapshot</li>
          </ul>
          <div class="w-full">
            <div class="bg-[#fff7f0] border border-[#f56b2a] rounded-xl px-5 py-4 mb-6 flex items-start gap-3">
              <input type="checkbox" class="mt-1 accent-[#f56b2a]" disabled />
              <div>
                <div class="font-semibold text-[#f56b2a] mb-1">
                  Add-on: Boost Package <span class="font-bold">$500/mo (Total $1,299)</span>
                </div>
                <ul class="text-body text-base space-y-1 text-left list-disc pl-5">
                  <li>Includes Local SEO Boost + GBP Boost</li>
                  <li>Citation build &amp; cleanup (software + manual core listings)</li>
                  <li>Custom quarterly local growth plan</li>
                  <li>GBP heatmap tracking across service area</li>
                  <li>Priority support</li>
                </ul>
              </div>
            </div>
            <a
              href="#contact"
              class="block mx-auto w-5/6 text-center px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#c9400a] transition mt-2"
              >Get Started</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-20 bg-white border-t border-gray-100" id="faq">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center relative">
        Website Design & Development: FAQs
        <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
      </h2>
      <div class="space-y-6">
        <div class="bg-bluelight rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">What makes your websites different?</h3>
          <p class="text-body text-base">
            Our sites are built for home service pros—conversion-focused, blazing fast, and optimized for local search.
            We handle everything, so you can focus on running your business.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
            Can I request changes or edits to my site?
          </h3>
          <p class="text-body text-base">
            Absolutely! Monthly plans include edits or updates for up to 5 pages. Boost plans include up to 15 pages and
            even new page builds.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">Is there a setup fee or contract?</h3>
          <p class="text-body text-base">
            Never. There are no setup fees, and you're never locked in. Stay as long as you love your results.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">
            Do you provide hosting, security, and backups?
          </h3>
          <p class="text-body text-base">
            Yes—all plans include ultra-fast hosting, SSL security, daily backups, and peace of mind.
          </p>
        </div>
        <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
          <h3 class="font-heading text-lg font-semibold mb-2 text-heading">How quickly can my site be live?</h3>
          <p class="text-body text-base">
            Most sites are built and launched within 2-4 weeks from our kickoff call—depending on content and feedback.

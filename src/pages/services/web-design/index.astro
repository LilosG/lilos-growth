---
import Layout from "~/layouts/PageLayout.astro";
import CheckListItem from "~/components/ui/CheckListItem.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import Card from "~/components/ui/Card.astro";
import FeatureCard from "~/components/sections/FeatureCard.astro";
import { Icon } from "astro-icon/components";
import { websiteBuilds, websiteAsAService } from "~/data/packages";

export const title = "Website Design & Development for Service Businesses";
export const description =
  "Modern, mobile-optimized websites that convert. One-time website builds for home-service companies — fast launches, SEO-ready structure, and conversion-first design.";

const features = [
  "Mobile-Responsive Design",
  "On-Brand Copy & CTAs",
  "SEO-Friendly Architecture",
  "Titles, Metas & Headings",
  "Schema Markup",
  "Lead Forms / Click-to-Call",
  "Analytics & Tracking Setup",
];

const trustReasons = [
  {
    icon: "tabler:target",
    title: "Built for Real-World Leads",
    description: "Clear calls-to-action, trust elements, and fast paths to call or book.",
  },
  {
    icon: "tabler:seo",
    title: "SEO-Ready Structure",
    description: "Titles, headings, internal links, and schema done right from day one.",
  },
  {
    icon: "tabler:clock-bolt",
    title: "Fast Turnarounds",
    description: "Tight timelines without cutting corners.",
  },
];

const faqs = [
  {
    question: "Do I own the website?",
    answer: "Yes. These are one-time projects — you fully own the finished site.",
  },
  {
    question: "Is hosting included?",
    answer:
      "Hosting and ongoing updates are available through our $199/mo Website as a Service plan — optional and month-to-month.",
  },
  {
    question: "How quickly can my site be live?",
    answer: "Starter: 1–2 weeks; Growth: 2–4 weeks (content readiness affects timelines).",
  },
  {
    question: "Can you help with SEO after launch?",
    answer: "Absolutely — pair your site with our Local SEO plans for steady growth.",
  },
  {
    question: "Do the two tiers use different technology?",
    answer:
      "No. Both tiers are built on the exact same scalable Astro framework. Starter launches with your core pages live; Growth launches with your full city × service matrix live. You can add cities or services to either one later, cheaply, because the framework's already built.",
  },
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Services", item: "https://lilosgrowth.com/services" },
    { name: "Website Design", item: "https://lilosgrowth.com/services/web-design" },
  ]}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "@id": "https://lilosgrowth.com/services/web-design#service",
      name: "Website Design & Development for Home Service Businesses",
      description:
        "Website builds on Astro and Tailwind CSS for home service businesses. Conversion-ready, SEO-native, schema-marked up, same scalable framework on every tier.",
      provider: { "@id": "https://lilosgrowth.com/#org" },
      areaServed: { "@type": "Country", name: "United States" },
      url: "https://lilosgrowth.com/services/web-design",
      offers: [
        {
          "@type": "Offer",
          name: "Starter Build",
          priceCurrency: "USD",
          price: "1250",
          availability: "https://schema.org/InStock",
        },
        {
          "@type": "Offer",
          name: "Growth Build",
          priceCurrency: "USD",
          price: "2250",
          availability: "https://schema.org/InStock",
        },
      ],
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Do I own the website after the build?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. Website builds are one-time projects, starting at $1,250. You own the finished site outright.",
          },
        },
        {
          "@type": "Question",
          name: "Is hosting included?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Hosting and ongoing updates are available through our $199/mo Website as a Service plan. It is optional and month-to-month.",
          },
        },
        {
          "@type": "Question",
          name: "How quickly can my site be live?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Starter delivery is 1-2 weeks; Growth is 2-4 weeks. Timeline depends on how quickly client content is provided.",
          },
        },
        {
          "@type": "Question",
          name: "Can you help with SEO after launch?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Yes. The site build includes SEO foundations. Pair it with a monthly retainer for ongoing local SEO management.",
          },
        },
      ],
    },
  ]}
>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center gap-4 px-4 text-center"
    >
      <h1
        class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Website Design &amp; Development
      </h1>
      <span class="text-accent block text-base font-semibold uppercase tracking-wider md:text-lg">
        Built for Home-Service Pros
      </span>
      <p class="max-w-2xl text-base font-medium leading-relaxed text-white/90">
        Fast-launching sites built to win calls — the same scalable Astro framework on every tier,
        SEO-ready and structured for how search works now.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        <Button href="#packages" variant="primary" size="lg">
          See Packages
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
        <Button href="#faq" variant="secondary" size="lg">
          FAQ
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="border-t border-gray-100 bg-background-cream py-12">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">What You Get</h2>
      <p class="mb-6 text-base text-body">
        A conversion-ready site with clean structure, local SEO fundamentals, and everything needed
        for a strong launch.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        {
          features.map((feature) => (
            <Badge variant="primary" size="lg">
              {feature}
            </Badge>
          ))
        }
      </div>

      <p class="mt-4 text-sm text-body-light">
        Need ongoing hosting/updates? See <a
          href="/packages#packages"
          class="text-primary underline hover:text-primary-dark">Website-as-a-Service</a
        >.
      </p>
    </div>
  </section>

  <!-- BUILD + MAINTENANCE PRICING -->
  <section id="pricing" class="border-t border-gray-100 bg-white py-20">
    <div class="mx-auto max-w-5xl px-4">
      <div class="mb-10 text-center">
        <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">Website Build</h2>
        <p class="mt-3 text-base text-body">
          Same scalable Astro framework, every tier. Tiers differ by how much of your city × service
          matrix is live at launch — not by rationing pages.
        </p>
      </div>

      <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          websiteBuilds.map((build) => (
            <div
              class={`overflow-hidden rounded-3xl border p-8 shadow-sm ${build.featured ? "border-primary ring-2 ring-primary/20" : "border-gray-200"}`}
            >
              {build.featured && (
                <span class="mb-3 inline-block rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
                  Most Popular
                </span>
              )}
              <h3 class="font-heading text-xl font-bold text-heading">{build.name}</h3>
              <div class="mt-2 flex items-baseline gap-1">
                <span class="font-heading text-4xl font-extrabold text-primary">
                  ${build.price.toLocaleString()}
                </span>
                <span class="text-sm text-body">one-time</span>
              </div>
              <p class="mt-1 text-xs font-semibold text-primary">
                ${build.bundledPrice.toLocaleString()} flat if bundled with any ongoing GBP/SEO
                package
              </p>
              <p class="mt-2 text-xs text-muted">{build.timeline}</p>
              <div class="my-5 h-px bg-gray-100" />
              <p class="mb-1 text-sm text-body">{build.description}</p>
              <p class="mb-5 text-xs italic text-muted">{build.bestFor}</p>
              <ul class="space-y-2.5 text-sm text-body">
                {build.inclusions.map((inc) => (
                  <CheckListItem>{inc}</CheckListItem>
                ))}
              </ul>
              <a
                href="/contact#book"
                data-evt="cta_webdesign_build"
                class={`mt-8 inline-block w-full rounded-xl px-6 py-3 text-center text-sm font-semibold shadow transition ${build.featured ? "bg-primary text-white hover:bg-primary-dark" : "border-2 border-primary text-primary hover:bg-primary hover:text-white"}`}
              >
                Start Your Build
              </a>
            </div>
          ))
        }
      </div>

      <div class="mx-auto max-w-md rounded-2xl border border-gray-200 bg-cream p-8">
        <h3 class="mb-1 font-heading text-base font-bold text-heading">
          {websiteAsAService.name}
        </h3>
        <div class="flex items-baseline gap-1">
          <span class="font-heading text-2xl font-extrabold text-primary"
            >${websiteAsAService.price}</span
          >
          <span class="text-sm text-body">/mo</span>
        </div>
        <p class="mt-3 text-sm text-body">
          Keep your site fast, secure, and up to date. Month-to-month, no commitment.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-body">
          {
            websiteAsAService.inclusions.map((inc) => (
              <CheckListItem>{inc}</CheckListItem>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-white py-16" id="why">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Why Home-Service Pros Choose Lilos Growth
      </h2>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        {
          trustReasons.map((reason) => (
            <FeatureCard icon={reason.icon} title={reason.title} description={reason.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-gray-100 bg-background-cream py-16" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
        Website Design &amp; Development: FAQs
      </h2>

      <div class="space-y-4">
        {
          faqs.map((faq, index) => (
            <Card variant={index % 2 === 0 ? "elevated" : "default"}>
              <h3 class="mb-2 font-heading text-base font-semibold text-heading md:text-lg">
                {faq.question}
              </h3>
              <p class="text-sm text-body md:text-base" set:html={faq.answer} />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
        Ready to Launch a Site That Converts?
      </h2>
      <p class="mb-6 text-base text-white/90">
        Book a quick call. We'll map your pages, timeline, and next steps.
      </p>
      <Button href="#contact" variant="white" size="lg"> Book My Free Website Plan </Button>
    </div>
  </section>
</Layout>

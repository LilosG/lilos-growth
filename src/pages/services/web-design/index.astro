---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Website Design & Development for Service Businesses | Lilos Growth";
export const description =
  "Modern, mobile-optimized websites that convert. One-time website builds for home-service companies — fast launches, SEO-ready structure, and conversion-first design.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[440px] flex-col items-center justify-center overflow-hidden bg-[#253242] pb-20 pt-16"
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]">
    </div>

    <div
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center gap-7 px-4 text-center"
    >
      <h1
        class="font-heading text-4xl font-extrabold leading-snug tracking-tight text-white md:text-5xl"
      >
        Website Design &amp; Development
      </h1>
      <span
        class="mt-1 block text-xl font-semibold uppercase tracking-wider text-[#f56b2a] md:text-2xl"
      >
        Built for Home-Service Pros
      </span>
      <p class="max-w-2xl text-lg font-medium text-white/80 md:text-xl">
        One-time website builds that launch fast and win more calls. Conversion-first, SEO-ready,
        and easy to update.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#packages"
          class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#f34e00]"
        >
          See Packages
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="#faq"
          class="inline-flex items-center rounded-2xl bg-secondary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-[#27394b]"
        >
          FAQ
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- WHAT’S INCLUDED (high-value, non-restrictive) -->
  <section class="border-t border-gray-100 bg-cream py-16">
    <div class="mx-auto max-w-5xl px-4 text-center">
      <h2 class="mb-5 font-heading text-3xl font-bold text-heading md:text-4xl">What You Get</h2>
      <p class="mb-6 text-lg text-body">
        A conversion-ready site with clean structure, local SEO fundamentals, and everything needed
        for a strong launch.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Mobile-Responsive Design</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >On-Brand Copy &amp; CTAs</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >SEO-Friendly Architecture</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Titles, Metas &amp; Headings</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Schema Markup</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Lead Forms / Click-to-Call</span
        >
        <span class="rounded-xl bg-bluelight px-4 py-2 font-heading font-semibold"
          >Analytics &amp; Tracking Setup</span
        >
      </div>

      <p class="mt-3 text-sm text-body/70">
        Need ongoing hosting/updates? See <a
          href="/packages#packages"
          class="text-primary underline hover:text-[#f56b2a]">Website-as-a-Service</a
        >.
      </p>
    </div>
  </section>

  <!-- WAA S PRICING (TOP ROW) — Match homepage pricing card formatting -->
  <section id="waas" class="border-t border-gray-100 bg-bluelight py-20">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-2 text-center font-heading text-4xl font-bold text-heading md:text-5xl">
        Website-as-a-Service Plans
      </h2>
      <p class="mb-12 text-center text-lg font-medium text-body">
        Modern, conversion-ready website + support. Month-to-month. No long contracts.
      </p>

      <div class="grid auto-rows-fr grid-cols-1 gap-8 md:grid-cols-3">
        <!-- $199/mo -->
        <article
          class="relative flex h-full flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-xl"
        >
          <header>
            <h3 class="font-heading text-xl font-bold text-heading">WaaS — Starter</h3>
            <p class="text-body">Modern, conversion-ready site + support</p>
            <div class="mt-3 text-4xl font-extrabold text-[#f56b2a]">
              $199<span class="ml-1 text-base font-semibold text-body">/mo</span>
            </div>
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Mobile-first site</strong> with SEO baked in</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Secure hosting &amp; monitoring</strong></span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Unlimited minor edits</strong> via support tickets</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Analytics &amp; lead tracking</strong> set up</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Month-to-month support</strong> — no long contracts</span>
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="/packages#packages"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
            >
              Choose $199 Plan
            </a>
          </div>
        </article>

        <!-- $299/mo (Most Popular) -->
        <article
          class="relative flex h-full flex-col rounded-3xl border-2 border-[#f56b2a] bg-white p-8 shadow-2xl"
        >
          <div
            class="absolute -top-6 left-1/2 -translate-x-1/2 rounded-full bg-[#f56b2a] px-5 py-1 text-xs font-bold text-white shadow"
          >
            Most Popular
          </div>
          <header class="mt-2">
            <h3 class="font-heading text-xl font-extrabold text-heading">WaaS — Growth</h3>
            <p class="text-body">More pages, CRO elements, and priority support</p>
            <div class="mt-3 text-4xl font-extrabold text-[#f56b2a]">
              $299<span class="ml-1 text-base font-semibold text-body">/mo</span>
            </div>
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Everything in Starter</strong>, plus</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>More pages &amp; optimizations</strong> monthly</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span
                ><strong>Expanded citations &amp; link acquisition</strong> guidance</span
              >
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Quarterly competitor review</strong> &amp; snapshot</span>
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="/packages#packages"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
            >
              Choose $299 Plan
            </a>
          </div>
        </article>

        <!-- $399/mo -->
        <article
          class="relative flex h-full flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-xl"
        >
          <header>
            <h3 class="font-heading text-xl font-bold text-heading">WaaS — Scale</h3>
            <p class="text-body">Higher-volume monthly execution</p>
            <div class="mt-3 text-4xl font-extrabold text-[#f56b2a]">
              $399<span class="ml-1 text-base font-semibold text-body">/mo</span>
            </div>
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Everything in Growth</strong>, plus</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Ongoing citations</strong> at scale</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Expanded content volume</strong> as needed</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span><span><strong>Monthly report</strong> + strategy call</span>
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="/packages#packages"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
            >
              Choose $399 Plan
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ONE-TIME BUILDS (BOTTOM ROW) — Match homepage card style -->
  <section id="one-time" class="border-t border-gray-100 bg-bluelight py-10">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-2 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        One-Time Website Packages
      </h2>
      <p class="mb-10 text-center text-lg font-medium text-body">
        Own your site outright. Transparent scope, fast timelines, and SEO best practices from day
        one.
      </p>

      <div class="grid auto-rows-fr grid-cols-1 gap-8 md:grid-cols-3">
        <!-- Starter $499 -->
        <article
          class="flex h-full flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-xl"
        >
          <header class="text-left">
            <h3 class="font-heading text-xl font-bold text-heading">Starter</h3>
            <div class="mt-1 text-3xl font-extrabold text-[#f56b2a]">$499</div>
            <div class="mt-1 text-sm text-body">Approx. 10 pages</div>
            <span
              class="mt-3 inline-block rounded-full bg-[#f56b2a] px-3 py-1.5 text-xs font-semibold text-white"
              >3–5 business-day launch</span
            >
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Home, 3 service pages, About, Contact, + essentials
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Clean site structure with internal linking scaffold
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Titles, metas, H1–H2 setup &amp; basic schema
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Lead capture (form + click-to-call)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Analytics setup (GA4/GTM if provided)
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >Get Started</a
            >
          </div>
        </article>

        <!-- Starter $750 (Most Popular) -->
        <article
          class="relative flex h-full flex-col rounded-3xl border-2 border-[#f56b2a] bg-white p-8 shadow-2xl"
        >
          <div
            class="absolute -top-6 left-1/2 -translate-x-1/2 rounded-full bg-[#f56b2a] px-6 py-1 text-xs font-bold text-white shadow"
          >
            Most Popular
          </div>
          <header class="mt-2 text-left">
            <h3 class="font-heading text-xl font-extrabold text-heading">Standard</h3>
            <div class="mt-1 text-3xl font-extrabold text-[#f56b2a]">$750</div>
            <div class="mt-1 text-sm text-body">Up to 15 pages</div>
            <span
              class="mt-3 inline-block rounded-full bg-[#f56b2a] px-3 py-1.5 text-xs font-semibold text-white"
              >5–7 business-day launch</span
            >
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Everything in Launch Lite, plus capacity for more services/areas
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Expanded internal linking &amp; conversion blocks (badges, FAQs, reviews)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>SEO foundations: titles/metas/H1–H2 at scale
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Blog setup (ready for publishing)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Stock image library (curated, royalty-free)
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >Get Started</a
            >
          </div>
        </article>

        <!-- Standard $1,500 -->
        <article
          class="flex h-full flex-col rounded-3xl border border-gray-200 bg-white p-8 shadow-xl"
        >
          <header class="text-left">
            <h3 class="font-heading text-xl font-bold text-heading">Growth Site</h3>
            <div class="mt-1 text-3xl font-extrabold text-[#f56b2a]">$1,500</div>
            <div class="mt-1 text-sm text-body">Approx. 25 pages</div>
            <span
              class="mt-3 inline-block rounded-full bg-[#f56b2a] px-3 py-1.5 text-xs font-semibold text-white"
              >10–14 business-day launch</span
            >
          </header>
          <ul class="mt-5 space-y-3 text-[15px] text-body">
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Large buildout for services + multiple areas
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Enhanced schema (LocalBusiness + Services)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Advanced conversion UX (sticky CTAs, trust elements)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Performance pass (Core Web Vitals-minded)
            </li>
            <li class="flex">
              <span class="mr-2 mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#f56b2a]"
              ></span>Pre-launch QA &amp; handoff with update training
            </li>
          </ul>
          <div class="mt-8">
            <a
              href="#contact"
              class="block w-full rounded-xl bg-[#f56b2a] px-6 py-3 text-center font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >Get Started</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE US -->
  <section class="border-t border-gray-100 bg-cream py-24" id="why">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-8 text-center font-heading text-4xl font-bold text-heading md:text-5xl">
        Why Home-Service Pros Choose Lilos Growth
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-[#f56b2a]"></span>
      </h2>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 md:grid-cols-3">
        <div
          class="flex flex-col items-center rounded-2xl border border-[#f56b2a]/10 bg-white p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-[#f56b2a]/10">
            <svg
              class="h-7 w-7 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M3 12l6 6l12-12"></path>
            </svg>
          </span>
          <h3 class="mb-1 text-center font-heading text-lg font-semibold text-heading">
            Built for Real-World Leads
          </h3>
          <p class="text-center text-[15px] text-body">
            Clear calls-to-action, trust elements, and fast paths to call or book.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-[#f56b2a]/10 bg-white p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-[#f56b2a]/10">
            <svg
              class="h-7 w-7 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
            </svg>
          </span>
          <h3 class="mb-1 text-center font-heading text-lg font-semibold text-heading">
            SEO-Ready Structure
          </h3>
          <p class="text-center text-[15px] text-body">
            Titles, headings, internal links, and schema done right from day one.
          </p>
        </div>

        <div
          class="flex flex-col items-center rounded-2xl border border-[#f56b2a]/10 bg-white p-8 shadow-lg"
        >
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-[#f56b2a]/10">
            <svg
              class="h-7 w-7 text-[#f56b2a]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 7l8 8l8-8"></path>
            </svg>
          </span>
          <h3 class="mb-1 text-center font-heading text-lg font-semibold text-heading">
            Fast Turnarounds
          </h3>
          <p class="text-center text-[15px] text-body">Tight timelines without cutting corners.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-gray-100 bg-white py-20" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Website Design &amp; Development: FAQs
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-[#f56b2a]"></span>
      </h2>

      <div class="space-y-6">
        <div class="rounded-2xl border border-gray-100 bg-bluelight p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Do I own the website?
          </h3>
          <p class="text-base text-body">
            Yes. These are one-time projects — you fully own the finished site.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">Is hosting included?</h3>
          <p class="text-base text-body">
            Hosting/ongoing updates are available through our Website-as-a-Service starting at <span
              class="font-semibold">$199/mo</span
            >.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            How quickly can my site be live?
          </h3>
          <p class="text-base text-body">
            Launch Lite: 3–5 business days; Starter: 5–7 business days; Standard: 10–14 business
            days (content readiness affects timelines).
          </p>
        </div>

        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-2 font-heading text-lg font-semibold text-heading">
            Can you help with SEO after launch?
          </h3>
          <p class="text-base text-body">
            Absolutely — pair your site with our Local SEO plans for steady growth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-primary py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-extrabold text-white">
        Ready to Launch a Site That Converts?
      </h2>
      <p class="mb-7 font-body text-lg text-white/80">
        Book a quick call. We’ll map your pages, timeline, and next steps.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center rounded-2xl bg-white px-8 py-4 font-heading text-lg font-semibold text-primary shadow transition hover:bg-bluelight"
        aria-label="Get Started — open contact form"
      >
        Book My Free Website Plan
      </a>
    </div>
  </section>

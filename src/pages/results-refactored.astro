---
/**
 * Results Page - Refactored with Design System
 * 
 * Showcases client case studies and results using the new component system.
 */
import PageLayout from "~/layouts/PageLayout.astro";
import Badge from "~/components/core/Badge.astro";
import Button from "~/components/core/Button.astro";
import StatCard from "~/components/composed/StatCard.astro";
import CaseStudyCard from "~/components/composed/CaseStudyCard.astro";
import FilterTab from "~/components/composed/FilterTab.astro";

const title = "Client Results & Case Studies | Lilos Growth";
const description = "Real results for home service businesses: more calls, better rankings, faster websites. See how we help pest control, HVAC, restoration, and other local businesses grow.";

// Stats data
const stats = [
  {
    label: "Avg. lead growth",
    value: "+142%",
    note: "12-month median across active clients"
  },
  {
    label: "GBP calls increase",
    value: "3.2×",
    note: "After profile optimization & posting"
  },
  {
    label: "Cost per lead",
    value: "−38%",
    note: "Landing page + tracking improvements"
  },
  {
    label: "Core Web Vitals",
    value: "96%",
    note: "Pass rate on Astro-built sites"
  }
];

// Case studies data
const caseStudies = [
  {
    client: "Blue Door Pest Control",
    location: "Jupiter, FL",
    sector: "Pest Control",
    serviceTypes: ['website', 'gbp', 'local-seo'] as const,
    description: "Full-service engagement: Astro website rebuild, GBP optimization with weekly posts, and local SEO strategy targeting Jupiter and surrounding Palm Beach County cities.",
    metrics: [
      { label: "organic leads", value: "+118%" },
      { label: "cost per lead", value: "−41%" },
      { label: "GBP calls", value: "+89%" }
    ],
    screenshot: {
      src: "/images/case-studies/blue-door-screenshot.jpg",
      alt: "Blue Door Pest Control website"
    },
    logo: {
      src: "/images/case-studies/blue-door-logo.png",
      alt: "Blue Door Pest Control"
    },
    websiteUrl: "https://bluedoorpestcontrol.com",
    caseStudyUrl: "/results/blue-door-pest-control",
    featured: true
  },
  {
    client: "Tamarack Restoration",
    location: "Carlsbad, CA",
    sector: "Restoration",
    serviceTypes: ['website', 'gbp', 'local-seo'] as const,
    description: "Fast Astro build with service-area pages, GBP optimization, and local link building for water damage and mold remediation searches.",
    metrics: [
      { label: "Maps top-3 keywords", value: "+5" },
      { label: "page load time", value: "<1s" }
    ],
    caseStudyUrl: "/results/tamarack-restoration"
  },
  {
    client: "Carlsbad Home Services",
    location: "Carlsbad, CA",
    sector: "Home Services",
    serviceTypes: ['website', 'local-seo'] as const,
    description: "Conversion-focused website with service pages and FAQ schema, plus local SEO targeting North County San Diego service areas.",
    metrics: [
      { label: "quote requests", value: "+52%" },
      { label: "cost per lead", value: "−33%" }
    ],
    caseStudyUrl: "/results/carlsbad-home-services"
  },
  {
    client: "Carlsbad Fix It",
    location: "Carlsbad, CA",
    sector: "Handyman",
    serviceTypes: ['website', 'gbp', 'local-seo'] as const,
    description: "Complete local presence overhaul: fast website, optimized GBP with service menus, and location-specific content for handyman searches.",
    metrics: [
      { label: "Maps visibility", value: "+73%" },
      { label: "avg. session time", value: "+45%" }
    ],
    caseStudyUrl: "/results/carlsbad-fix-it"
  },
  {
    client: "Postal Systems",
    location: "San Diego, CA",
    sector: "Commercial Services",
    serviceTypes: ['website', 'gbp', 'local-seo'] as const,
    description: "Niche B2B focus: productized service pages for mailbox installation, GBP optimization with product listings, and local SEO for commercial property managers.",
    metrics: [
      { label: "GBP calls", value: "3.1×" },
      { label: "form conversion", value: "+22%" }
    ],
    caseStudyUrl: "/results/postal-systems"
  }
];

// Service type labels for filtering
const serviceTypeLabels = {
  all: "All Results",
  website: "Websites",
  gbp: "GBP Optimization",
  'local-seo': "Local SEO"
};

// FAQs
const faqs = [
  {
    question: "How quickly will I see results?",
    answer: "Technical improvements (speed, structure) are immediate. Local SEO momentum typically builds over 6–12 weeks as Google re-crawls and trusts the changes."
  },
  {
    question: "Do I need to increase my ad spend?",
    answer: "Usually no. We focus on organic visibility first. Paid ads only make sense once tracking is solid and landing pages convert well."
  },
  {
    question: "Can you work with my existing website?",
    answer: "Yes. We can optimize an existing site or rebuild on Astro for better speed and maintainability. We preserve URLs and redirects either way."
  },
  {
    question: "How do you measure success?",
    answer: "Leads and booked jobs are the primary metrics. We also track GBP actions (calls, directions, clicks), conversion rates, page speed, and keyword rankings."
  },
  {
    question: "What do you need from me to get started?",
    answer: "Access to Google Analytics, Search Console, and your GBP. Quick feedback loops on content approvals help us move faster."
  },
  {
    question: "Are there long-term contracts?",
    answer: "Month-to-month is available. Most clients choose 3–6 month engagements to let organic SEO compound, but you're never locked in."
  }
];
---

<PageLayout {title} {description}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-secondary">
    <div class="absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light" aria-hidden="true"></div>
    
    <div class="relative mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">
          Proven Results
        </p>
        
        <h1 class="mt-3 font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">
          More calls. Better rankings.<br class="hidden sm:block" />
          <span class="text-primary">Real growth.</span>
        </h1>
        
        <p class="mt-4 text-lg text-white/80 md:text-xl">
          We help home service businesses dominate local search with fast websites, 
          optimized Google Business Profiles, and local SEO that actually drives calls.
        </p>
        
        <div class="mt-6 flex flex-wrap gap-2">
          <Badge variant="info">Website Design</Badge>
          <Badge variant="info">GBP Optimization</Badge>
          <Badge variant="info">Local SEO</Badge>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-b border-border-subtle bg-surface-base section-padding-sm">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        {stats.map((stat) => (
          <StatCard {...stat} />
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED CASE STUDY -->
  {caseStudies.filter(cs => cs.featured).map((study) => (
    <section class="border-b border-border-subtle bg-background-cream section-padding-sm">
      <div class="mx-auto max-w-6xl px-4">
        <div class="mb-8 flex items-center gap-3">
          <Badge variant="primary">Featured</Badge>
          <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">
            Client Spotlight
          </h2>
        </div>

        <CaseStudyCard {...study} />
      </div>
    </section>
  ))}

  <!-- MORE CASE STUDIES -->
  <section class="bg-surface-base section-padding">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-4 text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        More Client Wins
      </h2>
      <p class="mb-12 text-center text-lg text-body">
        From pest control to restoration to handyman services—we help home service businesses across industries dominate their local markets.
      </p>

      <!-- Filter Tabs -->
      <div class="mb-8 flex flex-wrap justify-center gap-3" role="tablist">
        <FilterTab id="all" label={serviceTypeLabels.all} active={true} />
        <FilterTab id="website" label={serviceTypeLabels.website} />
        <FilterTab id="gbp" label={serviceTypeLabels.gbp} />
        <FilterTab id="local-seo" label={serviceTypeLabels['local-seo']} />
      </div>

      <!-- Case Studies Grid -->
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2" id="case-studies-grid">
        {caseStudies.filter(cs => !cs.featured).map((study) => (
          <CaseStudyCard {...study} data-services={study.serviceTypes.join(',')} />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="border-t border-border-subtle bg-background-cream section-padding" id="faq">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-4 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        Common Questions
      </h2>
      <p class="mb-8 text-center text-body">
        Answers about working together, timelines, and what to expect.
      </p>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="card group">
            <summary class="flex cursor-pointer items-center justify-between font-semibold text-heading">
              {faq.question}
              <span class="ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-background-subtle text-muted transition-colors group-open:bg-primary group-open:text-white">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <p class="mt-4 text-sm text-body leading-relaxed">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="border-t border-border-subtle bg-surface-base section-padding">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-4 font-heading text-3xl font-bold text-heading md:text-4xl">
        See what this could look like in your city
      </h2>
      <p class="mb-8 text-lg text-body">
        We'll audit your GBP and top pages, outline quick wins, and map a 90-day plan to lift calls.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button variant="primary" size="lg" href="/contact">
          Get a Free Growth Plan
        </Button>
        <Button variant="outline" size="lg" href="/services">
          Explore Services
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  // Filter functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.filter-tab');
    const caseStudies = document.querySelectorAll('[data-services]');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');
        
        // Update active tab
        tabs.forEach(t => {
          t.classList.remove('bg-primary', 'text-white', 'shadow-md');
          t.classList.add('bg-background-subtle', 'text-body');
          t.setAttribute('aria-selected', 'false');
        });
        
        tab.classList.remove('bg-background-subtle', 'text-body');
        tab.classList.add('bg-primary', 'text-white', 'shadow-md');
        tab.setAttribute('aria-selected', 'true');
        
        // Filter case studies
        caseStudies.forEach(study => {
          const services = study.getAttribute('data-services') || '';
          const shouldShow = filter === 'all' || services.includes(filter);
          
          if (shouldShow) {
            study.style.display = '';
            study.classList.add('animate-fade-in');
          } else {
            study.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }
  
  /* Smooth accordion animation */
  details summary::-webkit-details-marker {
    display: none;
  }
  
  details[open] summary svg {
    transform: rotate(180deg);
  }
  
  details summary svg {
    transition: transform 0.2s ease;
  }
</style>

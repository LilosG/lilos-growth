---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import Badge from "~/components/ui/Badge.astro";
import Card from "~/components/ui/Card.astro";
import ProcessStep from "~/components/sections/ProcessStep.astro";
import { Icon } from "astro-icon/components";
import { industries, type IndustryData } from "~/data/industries";
import { locations, type LocationData } from "~/data/locations";
import { packages } from "~/data/packages";

export async function getStaticPaths() {
  const industryPaths = industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { type: "industry" as const, industry, location: undefined as LocationData | undefined },
  }));
  const locationPaths = locations.map((location) => ({
    params: { slug: location.slug },
    props: { type: "location" as const, location, industry: undefined as IndustryData | undefined },
  }));
  return [...industryPaths, ...locationPaths];
}

interface Props {
  type: "industry" | "location";
  industry?: IndustryData;
  location?: LocationData;
}

const { type, industry, location } = Astro.props;

const isIndustry = type === "industry" && industry !== undefined;
const isLocation = type === "location" && location !== undefined;

const pageTitle = isIndustry ? industry!.title : location!.title;
const pageDescription = isIndustry ? industry!.description : location!.description;
const pageSlug = isIndustry ? industry!.slug : location!.slug;

const breadcrumbs = isIndustry
  ? [
      { name: "Home", item: "https://lilosgrowth.com/" },
      { name: industry!.headline, item: `https://lilosgrowth.com/${industry!.slug}` },
    ]
  : [
      { name: "Home", item: "https://lilosgrowth.com/" },
      { name: `Local SEO ${location!.city}`, item: `https://lilosgrowth.com/${location!.slug}` },
    ];

const processSteps = [
  {
    number: 1,
    title: "Audit & Strategy",
    description: isLocation
      ? `Baseline rankings across your ${location!.city} service area, competitor analysis, and a clear roadmap tailored to your market.`
      : "Baseline rankings, competitor gap analysis, and a clear roadmap built around your specific trade and service area.",
  },
  {
    number: 2,
    title: "On-Page Fixes",
    description:
      "Titles, metas, headers, schema, and Core Web Vitals — the technical foundation Google needs to trust and rank your site.",
  },
  {
    number: 3,
    title: "Content",
    description: isLocation
      ? `Service pages, neighborhood pages, and helpful content that targets high-intent ${location!.city}-area searches.`
      : "Service-specific and location pages that target high-intent searches and convert visitors into calls.",
  },
  {
    number: 4,
    title: "Citations & Links",
    description: isLocation
      ? `NAP consistency across directories, ${location!.stateAbbr}-specific citation sources, and local link acquisition.`
      : "Clean NAP across directories, trade-specific citation sources, and local link acquisition to build authority.",
  },
  {
    number: 5,
    title: "Reports & Calls",
    description: "Monthly ranking and traffic reports plus strategy calls — clear metrics, no fluff.",
  },
];

const industrySchema = isIndustry
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `https://lilosgrowth.com/${industry!.slug}#service`,
        name: industry!.headline,
        description: industry!.description,
        provider: { "@id": "https://lilosgrowth.com/#org" },
        areaServed: { "@type": "Country", name: "United States" },
        url: `https://lilosgrowth.com/${industry!.slug}`,
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: industry!.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      },
    ]
  : [];

const locationSchema = isLocation
  ? [
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": `https://lilosgrowth.com/${location!.slug}#service`,
        name: `Local SEO for ${location!.city} Businesses`,
        description: location!.description,
        provider: { "@id": "https://lilosgrowth.com/#org" },
        areaServed: {
          "@type": "City",
          name: location!.city,
          containedInPlace: { "@type": "State", name: location!.state },
        },
        url: `https://lilosgrowth.com/${location!.slug}`,
      },
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": `https://lilosgrowth.com/${location!.slug}#localbiz-city`,
        name: "Lilos Growth",
        description: `Local SEO agency serving ${location!.city}, ${location!.stateAbbr} businesses.`,
        url: "https://lilosgrowth.com",
        telephone: "+1-858-722-2920",
        areaServed: {
          "@type": "City",
          name: location!.city,
          containedInPlace: { "@type": "State", name: location!.state },
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: location!.geo.latitude,
          longitude: location!.geo.longitude,
        },
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: location!.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer },
        })),
      },
    ]
  : [];

const schema = isIndustry ? industrySchema : locationSchema;

const locationServices = isLocation
  ? [
      {
        title: "Local SEO",
        description: `On-page optimization, service pages, citations, and local links to rank your ${location!.city} business in organic search and the Map Pack.`,
        href: "/services/local-seo",
        icon: "tabler:map-pin",
      },
      {
        title: "Google Business Profile",
        description:
          "Full GBP management — optimization, weekly posts, review replies, photos, and monthly audits.",
        href: "/services/google-business-profile-optimization",
        icon: "tabler:brand-google",
      },
      {
        title: "Website Design",
        description:
          "Fast, conversion-focused websites built on Astro + Tailwind. The technical foundation your SEO runs on.",
        href: "/services/web-design",
        icon: "tabler:device-laptop",
      },
    ]
  : [];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  {isIndustry && (
    <>
      <!-- INDUSTRY HERO -->
      <section class="relative flex min-h-[420px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12">
        <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
          <h1 class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl">
            {industry!.headline}
          </h1>
          <p class="mt-4 text-base font-medium leading-relaxed text-white/90">{industry!.intro}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <Button href="/contact#book" variant="primary" size="lg">Get a Free Audit</Button>
            <Button href="#plans" variant="secondary" size="lg">See Plans</Button>
          </div>
          <div class="mt-4 flex items-center justify-center gap-2">
            <Icon name="tabler:star-filled" class="text-accent h-5 w-5" />
            <span class="text-sm font-semibold text-white/90">5-Star Rated by Local Businesses</span>
          </div>
        </div>
      </section>

      <!-- PAIN POINTS -->
      <section class="border-t border-gray-100 bg-background-cream py-12">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Why {industry!.name} Struggle to Rank
          </h2>
          <p class="mb-8 text-center text-base text-body">These are the gaps we close — fast.</p>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {industry!.painPoints.map((point) => (
              <Card variant="elevated">
                <div class="flex items-start gap-3">
                  <Icon name="tabler:alert-circle" class="text-primary mt-0.5 h-5 w-5 shrink-0" />
                  <p class="text-sm text-body">{point}</p>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </section>

      <!-- WHAT YOU GET -->
      <section class="border-t border-gray-100 bg-white py-12">
        <div class="mx-auto max-w-5xl px-4 text-center">
          <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">What You Get</h2>
          <p class="mb-6 text-base text-body">
            A practical local SEO system built for {industry!.name.toLowerCase()} — not a generic package with your trade name swapped in.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {industry!.whatYouGet.map((item) => (
              <Badge variant="primary" size="lg">{item}</Badge>
            ))}
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="border-t border-gray-100 bg-background-cream py-16">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="mb-10 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Our Local SEO System (5 Steps)
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
            {processSteps.map((step) => (
              <ProcessStep number={step.number} title={step.title} description={step.description} />
            ))}
          </div>
        </div>
      </section>

      <!-- PLANS -->
      <section id="plans" class="border-t border-gray-100 bg-white py-16">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Plans & Pricing
          </h2>
          <p class="mb-10 text-center text-base text-body">Month-to-month. No setup fees. No rollovers.</p>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {packages.map((pkg) => (
              <div class={`rounded-2xl border p-6 ${pkg.featured ? "border-primary bg-primary text-white shadow-lg" : "border-gray-200 bg-background-cream"}`}>
                {pkg.badge && (
                  <span class={`mb-3 inline-block rounded-full px-3 py-1 text-xs font-bold ${pkg.featured ? "bg-white/20 text-white" : "bg-primary/10 text-primary"}`}>
                    {pkg.badge}
                  </span>
                )}
                <h3 class={`font-heading text-lg font-extrabold ${pkg.featured ? "text-white" : "text-heading"}`}>
                  {pkg.name}
                </h3>
                <p class={`mb-4 text-sm ${pkg.featured ? "text-white/80" : "text-body"}`}>{pkg.tagline}</p>
                <p class={`mb-6 text-3xl font-extrabold ${pkg.featured ? "text-white" : "text-heading"}`}>
                  ${pkg.price.toLocaleString()}
                  <span class={`text-base font-normal ${pkg.featured ? "text-white/70" : "text-body"}`}>/mo</span>
                </p>
                <ul class="mb-6 space-y-2">
                  {pkg.inclusions.map((inc) => (
                    <li class="flex items-start gap-2">
                      <Icon name="tabler:check" class={`mt-0.5 h-4 w-4 shrink-0 ${pkg.featured ? "text-white" : "text-primary"}`} />
                      <span class={`text-sm ${pkg.featured ? "text-white/90" : "text-body"}`}>{inc}</span>
                    </li>
                  ))}
                </ul>
                <Button href="/contact#book" variant={pkg.featured ? "white" : "primary"} size="md" class="w-full justify-center">
                  {pkg.featured ? `Choose ${pkg.name}` : "Get Started"}
                </Button>
              </div>
            ))}
          </div>
          <p class="mt-6 text-center text-sm text-body-light">
            Need just GBP management? Add it for $250/mo, or{" "}
            <a href="/packages" class="font-semibold text-primary underline">view all packages</a>.
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="border-t border-gray-100 bg-background-cream py-16">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Frequently Asked Questions
          </h2>
          <div class="space-y-4">
            {industry!.faqs.map((faq, index) => (
              <Card variant={index % 2 === 0 ? "elevated" : "default"}>
                <h3 class="mb-2 font-heading text-base font-semibold text-heading">{faq.question}</h3>
                <p class="text-sm text-body">{faq.answer}</p>
              </Card>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
        <div class="mx-auto max-w-3xl px-4 text-center">
          <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
            Ready to Win More Jobs?
          </h2>
          <p class="mb-6 text-base text-white/90">
            Get a free local SEO audit — no hard sell, just a clear picture of where you stand and what to fix first.
          </p>
          <Button href="/contact#book" variant="white" size="lg">Book My Free Audit</Button>
        </div>
      </section>
    </>
  )}

  {isLocation && (
    <>
      <!-- LOCATION HERO -->
      <section class="relative flex min-h-[420px] flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12">
        <div class="relative z-10 mx-auto w-full max-w-3xl px-4 text-center">
          <h1 class="font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-5xl">
            Local SEO for {location!.city} Businesses
          </h1>
          <p class="mt-4 text-base font-medium leading-relaxed text-white/90">{location!.intro}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <Button href="/contact#book" variant="primary" size="lg">Get a Free Audit</Button>
            <Button href="#services" variant="secondary" size="lg">Our Services</Button>
          </div>
          <div class="mt-4 flex items-center justify-center gap-2">
            <Icon name="tabler:star-filled" class="text-accent h-5 w-5" />
            <span class="text-sm font-semibold text-white/90">5-Star Rated by Local Businesses</span>
          </div>
        </div>
      </section>

      <!-- MARKETS SERVED -->
      <section class="border-t border-gray-100 bg-background-cream py-12">
        <div class="mx-auto max-w-5xl px-4 text-center">
          <h2 class="mb-3 font-heading text-xl font-bold text-heading md:text-2xl">
            Areas We Serve in {location!.city}
          </h2>
          <p class="mb-6 text-base text-body">
            We build city-level SEO targeting for each community in your service area — not just broad metro optimization.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {location!.neighborhoods.map((neighborhood) => (
              <Badge variant="secondary" size="lg">{neighborhood}</Badge>
            ))}
          </div>
        </div>
      </section>

      <!-- INDUSTRIES SERVED -->
      <section class="border-t border-gray-100 bg-white py-12">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Industries We Serve in {location!.city}
          </h2>
          <p class="mb-8 text-center text-base text-body">
            We specialize in local SEO for home service and trade businesses across the {location!.city} metro.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {location!.trades.map((trade) => {
              const match = industries.find((i) => i.name === trade || i.name.startsWith(trade));
              return match ? (
                <a
                  href={`/${match.slug}`}
                  class="rounded-full border border-gray-200 bg-background-cream px-4 py-2 text-sm font-medium text-heading transition hover:border-primary hover:text-primary"
                >
                  {trade}
                </a>
              ) : (
                <span class="rounded-full border border-gray-200 bg-background-cream px-4 py-2 text-sm font-medium text-heading">
                  {trade}
                </span>
              );
            })}
          </div>
        </div>
      </section>

      <!-- WHY THIS CITY -->
      <section class="border-t border-gray-100 bg-background-cream py-12">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-4 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            The {location!.city} Local Search Market
          </h2>
          <p class="text-center text-base leading-relaxed text-body">{location!.whyCity}</p>
        </div>
      </section>

      <!-- SERVICES -->
      <section id="services" class="border-t border-gray-100 bg-white py-16">
        <div class="mx-auto max-w-5xl px-4">
          <h2 class="mb-3 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            How We Help {location!.city} Businesses
          </h2>
          <p class="mb-10 text-center text-base text-body">
            Three core services, each built for local search performance.
          </p>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {locationServices.map((service) => (
              <a
                href={service.href}
                class="group rounded-2xl border border-gray-200 bg-background-cream p-6 transition hover:border-primary hover:shadow-md"
              >
                <Icon name={service.icon} class="text-primary mb-3 h-7 w-7" />
                <h3 class="mb-2 font-heading text-base font-bold text-heading group-hover:text-primary">
                  {service.title}
                </h3>
                <p class="text-sm text-body">{service.description}</p>
              </a>
            ))}
          </div>
          <div class="mt-8 text-center">
            <Button href="/packages" variant="outline" size="md">View All Plans & Pricing</Button>
          </div>
        </div>
      </section>

      <!-- PROCESS -->
      <section class="border-t border-gray-100 bg-background-cream py-16">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="mb-10 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            Our Local SEO System (5 Steps)
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
            {processSteps.map((step) => (
              <ProcessStep number={step.number} title={step.title} description={step.description} />
            ))}
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="border-t border-gray-100 bg-white py-16">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-8 text-center font-heading text-xl font-bold text-heading md:text-2xl">
            {location!.city} Local SEO — FAQs
          </h2>
          <div class="space-y-4">
            {location!.faqs.map((faq, index) => (
              <Card variant={index % 2 === 0 ? "elevated" : "default"}>
                <h3 class="mb-2 font-heading text-base font-semibold text-heading">{faq.question}</h3>
                <p class="text-sm text-body">{faq.answer}</p>
              </Card>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
        <div class="mx-auto max-w-3xl px-4 text-center">
          <h2 class="mb-3 font-heading text-xl font-extrabold text-white md:text-2xl">
            Ready to Rank Higher in {location!.city}?
          </h2>
          <p class="mb-6 text-base text-white/90">
            Get a free audit — no hard sell, just a clear picture of where you stand and what to fix first.
          </p>
          <Button href="/contact#book" variant="white" size="lg">Book My Free Audit</Button>
        </div>
      </section>
    </>
  )}
</Layout>

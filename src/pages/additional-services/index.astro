---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/core/Button.astro";
import Card from "~/components/core/Card.astro";
import ServiceOfferingCard from "~/components/composed/ServiceOfferingCard.astro";
import ProcessStep from "~/components/composed/ProcessStep.astro";
import { Icon } from "astro-icon/components";

export const title = "Additional Marketing Services for Home Service Businesses";
export const description =
  "Order stand-alone services like citation building, Google Business Profile setup, and one-time SEO tune-ups. No contracts — just fast, transparent work built for local home services.";
export const breadcrumbs = [
  { name: "Services", item: "/services" },
  { name: "Additional Services", item: "/additional-services" },
];

const services = [
  {
    icon: "tabler:map-pin",
    title: "Citation Builder",
    price: "$49",
    period: "month",
    badge: "Best for: New locations & ranking boosts",
    description: "List your business on 250+ top directories to build consistent citations.",
    features: [
      "Clean, accurate NAP across 100+ directories",
      "Consistent brand & category data",
      "Improved local rankings over time",
    ],
  },
  {
    icon: "tabler:briefcase",
    title: "Google Business Profile Setup",
    price: "$399",
    period: "one-time",
    badge: "Best for: New businesses or GBP resets",
    description:
      "Complete profile creation & verification — optimized and ready to attract new customers.",
    features: [
      "Full GBP creation & verification",
      "Business info, logo & photos added",
      "First Google Post & Q&A",
      "Login & live profile link delivered",
    ],
  },
  {
    icon: "tabler:star",
    title: "GBP 30-Day Optimization",
    price: "$499",
    period: "one-time",
    badge: "Best for: Fast visibility & profile fixes",
    description:
      "A focused 30-day sprint to clean up, optimize, and grow visibility in the Map Pack.",
    features: [
      "Full audit & expert optimizations",
      "Keyword-rich services & categories",
      "Weekly posts & photo updates",
      "Review responses & reporting",
    ],
  },
  {
    icon: "tabler:chart-line",
    title: "SEO Consulting & Website Tune-Up",
    price: "$499",
    period: "30 days",
    badge: "Best for: Quick website wins & SEO clarity",
    description: "A clear SEO roadmap plus a 30-day execution burst on the highest-impact fixes.",
    features: [
      "Website SEO audit & strategy call",
      "Meta, headings, content & internal links",
      "Tech & UX tune-ups as needed",
      "Results report with next steps",
    ],
  },
];

const processSteps = [
  {
    number: 1,
    title: "Pick Your Service",
    description: "Choose any one-time service above — or ask for a custom solution.",
  },
  {
    number: 2,
    title: "Share Your Details",
    description: "We'll collect essentials with a quick form so we can get started.",
  },
  {
    number: 3,
    title: "We Get to Work",
    description: "Our experts implement the work quickly and keep you updated.",
  },
  {
    number: 4,
    title: "You Get Results",
    description: "Receive a clear report, outcomes, and recommendations — done.",
  },
];

const faqs = [
  {
    question: "Can I order an additional service without a monthly package?",
    answer:
      "<strong>Yes.</strong> Every service on this page is available individually — no contract or ongoing bundle required.",
  },
  {
    question: "What if I need help choosing the right service?",
    answer:
      'Just <a href="#contact" class="text-primary underline hover:text-primary-dark">contact us</a> and we\'ll recommend the best fit for your goals and budget.',
  },
  {
    question: "How fast will I get results?",
    answer:
      "Most one-time services are completed in <strong>7–14 days</strong>. We'll keep you updated the whole way.",
  },
  {
    question: "Can I combine these with a monthly package?",
    answer:
      "Absolutely. Many monthly plans include these services for added savings — ask for details.",
  },
  {
    question: "Is there support after the service is complete?",
    answer:
      "Yes — you'll get a results report, actionable next steps, and 14 days of email support.",
  },
  {
    question: "Can I talk to someone before ordering?",
    answer:
      'Definitely. <a href="#contact" class="text-primary underline hover:text-primary-dark">Reach out</a> for honest, pressure-free advice from a strategist.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={breadcrumbs}>
  <!-- HERO -->
  <section
    class="relative overflow-hidden bg-gradient-to-br from-secondary to-secondary-dark pb-16 pt-12"
  >
    <div class="relative z-10 mx-auto max-w-3xl px-4 text-center">
      <img src="/logo-lcp-320.webp" alt="Lilos Growth Logo" class="logo--halo mx-auto mb-6 w-32" />
      <h1
        class="mb-2 font-heading text-3xl font-extrabold leading-tight tracking-tight text-white md:text-4xl lg:text-5xl"
      >
        Additional Services &amp; One-Time Projects
      </h1>
      <span
        class="text-accent mb-3 mt-2 block font-heading text-lg font-semibold uppercase tracking-wider md:text-xl"
        >No Contract • No Commitment • Just Results</span
      >
      <p class="mx-auto mb-6 max-w-2xl text-base leading-relaxed text-white/90 md:text-lg">
        Stand-alone services and quick projects you can order anytime. Pay only for what you need —
        no long-term commitments or fluff.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="#services" variant="primary" size="lg">
          Explore Services
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
        <Button href="#faq" variant="secondary" size="lg">
          FAQ
          <Icon name="tabler:arrow-right" class="ml-2 h-4 w-4" slot="icon-right" />
        </Button>
      </div>
    </div>
  </section>

  <!-- SERVICES GRID -->
  <section id="services" class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        Order Additional Services Individually
      </h2>
      <p class="mx-auto mb-10 max-w-3xl text-center text-base text-body md:text-lg">
        Every option below is available as a one-time purchase — no monthly plan required.
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        {
          services.map((service) => (
            <ServiceOfferingCard
              icon={service.icon}
              title={service.title}
              price={service.price}
              period={service.period}
              badge={service.badge}
              description={service.description}
              features={service.features}
              ctaText="Order Now"
              ctaHref="#contact"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="border-t border-gray-100 bg-background-cream py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        How Our Additional Services Work
      </h2>
      <p class="mx-auto mb-10 max-w-3xl text-center text-base text-body md:text-lg">
        Simple, fast, and transparent — no pushy sales calls, just a straightforward process.
      </p>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-4">
        {
          processSteps.map((step) => (
            <ProcessStep number={step.number} title={step.title} description={step.description} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="mb-8 text-center font-heading text-2xl font-bold text-heading md:text-3xl">
        Additional Services FAQ
      </h2>

      <div class="space-y-4">
        {
          faqs.map((faq) => (
            <Card variant="elevated" class="border-l-4 border-primary">
              <h3 class="mb-2 font-heading text-base font-bold text-primary md:text-lg">
                {faq.question}
              </h3>
              <p class="text-sm text-body md:text-base" set:html={faq.answer} />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-br from-primary to-primary-dark py-12">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="mb-3 font-heading text-2xl font-extrabold text-white md:text-3xl">
        Ready to Get Started?
      </h2>
      <p class="mb-6 text-base text-white/90 md:text-lg">
        Order a service or talk to a strategist — no pressure, just honest advice.
      </p>
      <Button href="#contact" variant="white" size="lg"> Contact Us Today </Button>
    </div>
  </section>
</Layout>

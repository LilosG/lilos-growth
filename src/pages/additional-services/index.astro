---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>Additional Services & One-Time SEO Projects | Lilos Growth</title>
    <meta
      name="description"
      content="Order citation building, Google Business Profile setup, one-time SEO consulting, and more—no contract or bundle required. Fast, transparent, and proven for local home service businesses."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <Layout>
    <!-- HERO SECTION -->
    <section
      class="bg-[#253242] min-h-[440px] flex flex-col items-center justify-center pt-16 pb-20 relative overflow-hidden"
    >
      <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159] pointer-events-none"></div>
      <div class="relative z-10 w-full max-w-3xl flex flex-col items-center gap-7 px-4 mx-auto text-center">
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-36 mx-auto" />
        <h1 class="text-4xl md:text-5xl font-heading text-white font-extrabold mb-1 leading-tight tracking-tight">
          Additional Services & One-Time Projects
        </h1>
        <span class="text-xl md:text-2xl font-semibold text-[#f56b2a] tracking-wider uppercase font-sans antialiased">
          No Contract &bull; No Commitment &bull; Just Results
        </span>
        <p class="text-lg md:text-xl text-white/80 mb-7 max-w-2xl font-medium">
          Order stand-alone services, quick one-time projects, or test us out—no long-term contracts or fluff. Pay only
          for what you need, when you need it.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="#services"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-[#f56b2a] hover:bg-[#f34e00] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            Explore Services
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <a
            href="#faq"
            class="inline-flex items-center px-8 py-4 rounded-2xl bg-secondary hover:bg-[#27394b] text-white font-heading font-semibold text-lg shadow transition duration-200"
          >
            FAQ
            <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"
              ><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <section id="services" class="py-24 bg-white border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-heading text-heading font-bold mb-8 text-center">
          Order Additional Services Individually
          <span class="block mx-auto mt-2 h-1 w-16 bg-[#f56b2a] rounded"></span>
        </h2>
        <p class="text-lg text-body mb-12 text-center max-w-3xl mx-auto">
          Every service below is available as a stand-alone, one-time project—no package or long-term commitment
          required.
        </p>
        <div class="grid gap-6 md:grid-cols-2">
          <!-- CARD 1 -->
          <div
            class="bg-white rounded-xl shadow-lg border border-gray-100 p-5 flex flex-col justify-between min-h-[340px] hover:shadow-xl transition group"
          >
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span
                  class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[#f56b2a]/10 group-hover:bg-[#f56b2a]/20 transition"
                >
                  <!-- Map Pin SVG -->
                  <svg
                    width="22"
                    height="22"
                    fill="none"
                    stroke="#f56b2a"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
                    ></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </span>
                <h3 class="font-heading text-xl font-bold text-heading">Citation Builder</h3>
              </div>
              <div class="mb-1">
                <span class="text-xl font-extrabold text-heading">$49</span>
                <span class="text-base font-medium text-body/70">/ month</span>
              </div>
              <div class="mb-1">
                <span
                  class="inline-block bg-[#f56b2a]/10 text-[#f56b2a] text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider"
                >
                  Best for: New locations & ranking boosts
                </span>
              </div>
              <p class="text-base text-body mb-3">List your business on 250+ top directories.</p>
              <ul class="mb-4 space-y-1 text-base text-body list-disc list-inside pl-2">
                <li>Your business is spread across 100+ directories.</li>
                <li>Consistent, accurate business info.</li>
                <li>Climb local search rankings.</li>
              </ul>
            </div>
            <button
              class="w-full py-2 rounded-lg bg-[#f56b2a] hover:bg-[#c94c13] text-white font-heading font-bold text-base shadow transition"
              >Order Now</button
            >
          </div>
          <!-- CARD 2 -->
          <div
            class="bg-[#f7fafc] rounded-xl shadow-lg border border-gray-100 p-5 flex flex-col justify-between min-h-[340px] hover:shadow-xl transition group"
          >
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span
                  class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[#f56b2a]/10 group-hover:bg-[#f56b2a]/20 transition"
                >
                  <!-- Briefcase SVG -->
                  <svg
                    width="22"
                    height="22"
                    fill="none"
                    stroke="#f56b2a"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 12h.01"></path>
                    <path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
                    <path d="M22 13a18.15 18.15 0 0 1-20 0"></path>
                    <rect width="20" height="14" x="2" y="6" rx="2"></rect>
                  </svg>
                </span>
                <h3 class="font-heading text-xl font-bold text-heading">Google Business Profile Setup</h3>
              </div>
              <div class="mb-1">
                <span class="text-xl font-extrabold text-heading">$399</span>
                <span class="text-base font-medium text-body/70">/ one-time</span>
              </div>
              <div class="mb-1">
                <span
                  class="inline-block bg-[#f56b2a]/10 text-[#f56b2a] text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider"
                >
                  Best for: New businesses or GMB resets
                </span>
              </div>
              <p class="text-base text-body mb-3">
                We’ll create and verify your Google Business Profile from scratch—optimized and ready to attract new
                customers.
              </p>
              <ul class="mb-4 space-y-1 text-base text-body list-disc list-inside pl-2">
                <li>Complete GBP creation & verification</li>
                <li>Business details, logo, & photos added</li>
                <li>First Google Post & Q&A</li>
                <li>Profile login & live link delivered</li>
              </ul>
            </div>
            <button
              class="w-full py-2 rounded-lg bg-[#f56b2a] hover:bg-[#c94c13] text-white font-heading font-bold text-base shadow transition"
              >Order Now</button
            >
          </div>
          <!-- CARD 3 -->
          <div
            class="bg-white rounded-xl shadow-lg border border-gray-100 p-5 flex flex-col justify-between min-h-[340px] hover:shadow-xl transition group"
          >
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span
                  class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[#f56b2a]/10 group-hover:bg-[#f56b2a]/20 transition"
                >
                  <!-- Star SVG -->
                  <svg
                    width="22"
                    height="22"
                    fill="none"
                    stroke="#f56b2a"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                  >
                    <path
                      d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
                    ></path>
                  </svg>
                </span>
                <h3 class="font-heading text-xl font-bold text-heading">GBP 30-Day Optimization</h3>
              </div>
              <div class="mb-1">
                <span class="text-xl font-extrabold text-heading">$499</span>
                <span class="text-base font-medium text-body/70">/ one-time</span>
              </div>
              <div class="mb-1">
                <span
                  class="inline-block bg-[#f56b2a]/10 text-[#f56b2a] text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider"
                >
                  Best for: Fast visibility & profile changes
                </span>
              </div>
              <p class="text-base text-body mb-3">
                We'll fully optimize your Google Business Profile for 30 days—posting updates, boosting visibility, and
                fixing issues fast.
              </p>
              <ul class="mb-4 space-y-1 text-base text-body list-disc list-inside pl-2">
                <li>Full audit & expert optimization</li>
                <li>Keyword-rich content & categories</li>
                <li>Weekly posts & photo updates</li>
                <li>Review responses & reporting</li>
              </ul>
            </div>
            <button
              class="w-full py-2 rounded-lg bg-[#f56b2a] hover:bg-[#c94c13] text-white font-heading font-bold text-base shadow transition"
              >Order Now</button
            >
          </div>
          <!-- CARD 4 -->
          <div
            class="bg-[#f7fafc] rounded-xl shadow-lg border border-gray-100 p-5 flex flex-col justify-between min-h-[340px] hover:shadow-xl transition group"
          >
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span
                  class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-[#f56b2a]/10 group-hover:bg-[#f56b2a]/20 transition"
                >
                  <!-- Trending Up SVG -->
                  <svg
                    width="22"
                    height="22"
                    fill="none"
                    stroke="#f56b2a"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 16v5"></path><path d="M16 14v7"></path><path d="M20 10v11"></path>
                    <path d="m22 3-8.646 8.646a.5.5 0 0 1-.708 0L9.354 8.354a.5.5 0 0 0-.707 0L2 15"></path>
                    <path d="M4 18v3"></path><path d="M8 14v7"></path>
                  </svg>
                </span>
                <h3 class="font-heading text-xl font-bold text-heading">SEO Consulting & Website Tune-Up</h3>
              </div>
              <div class="mb-1">
                <span class="text-xl font-extrabold text-heading">$499</span>
                <span class="text-base font-medium text-body/70">/ 30 days</span>
              </div>
              <div class="mb-1">
                <span
                  class="inline-block bg-[#f56b2a]/10 text-[#f56b2a] text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider"
                >
                  Best for: Quick website wins & SEO clarity
                </span>
              </div>
              <p class="text-base text-body mb-3">
                Get a clear SEO roadmap and 30 days of hands-on optimization—titles, content, internal links, and more.
              </p>
              <ul class="mb-4 space-y-1 text-base text-body list-disc list-inside pl-2">
                <li>Website SEO audit & strategy call</li>
                <li>On-page optimization (meta, headings, content)</li>
                <li>Internal link & technical fixes</li>
                <li>30 days of support & results report</li>
              </ul>
            </div>
            <button
              class="w-full py-2 rounded-lg bg-[#f56b2a] hover:bg-[#c94c13] text-white font-heading font-bold text-base shadow transition"
              >Order Now</button
            >
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS SECTION (now fully stacked above FAQ) -->
    <section class="py-24 bg-[#fdf7f3] border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center">
          How Our Additional Services Work
        </h2>
        <p class="text-lg text-center text-body mb-12">
          Here's how easy it is to get started with a one-time project. No phone tag, no pushy sales, just real results:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 justify-center">
          <div class="bg-white rounded-2xl shadow border p-8 flex flex-col items-center">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                fill="none"
                stroke="#f56b2a"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </span>
            <h3 class="font-heading font-bold mb-2 text-center">Pick Your Service</h3>
            <p class="text-body text-center text-base">
              Select any additional service above, or ask us if you need a custom solution.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border p-8 flex flex-col items-center">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                fill="none"
                stroke="#f56b2a"
                stroke-width="2"><circle cx="14" cy="14" r="10"></circle></svg
              >
            </span>
            <h3 class="font-heading font-bold mb-2 text-center">Share Your Details</h3>
            <p class="text-body text-center text-base">
              Complete a short intake form, and we’ll get everything we need to get started.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border p-8 flex flex-col items-center">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                fill="none"
                stroke="#f56b2a"
                stroke-width="2"
                ><circle cx="14" cy="14" r="2"></circle><path d="M14 2v2"></path><path d="M14 24v-2"></path><path
                  d="M2 14h2"></path><path d="M24 14h-2"></path></svg
              >
            </span>
            <h3 class="font-heading font-bold mb-2 text-center">We Get to Work</h3>
            <p class="text-body text-center text-base">
              Our expert team completes the service fast, accurately, and with regular updates.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow border p-8 flex flex-col items-center">
            <span class="mb-4 flex items-center justify-center w-14 h-14 rounded-xl bg-[#f56b2a]/10">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="28"
                height="28"
                fill="none"
                stroke="#f56b2a"
                stroke-width="2"><polyline points="6 12 12 18 18 12"></polyline></svg
              >
            </span>
            <h3 class="font-heading font-bold mb-2 text-center">You Get Results</h3>
            <p class="text-body text-center text-base">
              We deliver your final report, results, and recommendations. No ongoing contracts—just value, delivered.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="py-20 bg-white border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-heading text-heading font-bold mb-8 text-center relative">
          Additional Services FAQ
          <span class="block mx-auto mt-2 h-1 w-14 bg-[#f56b2a] rounded"></span>
        </h2>
        <div class="space-y-7">
          <!-- FAQ 1 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">
              Can I order an additional service without a monthly package?
            </h3>
            <p class="text-body text-base text-gray-900">
              <span class="font-semibold text-[#f56b2a]">Yes!</span> Every service on this page is available individually,
              no contract or ongoing package required.
            </p>
          </div>
          <!-- FAQ 2 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">
              What if I need help choosing the right service?
            </h3>
            <p class="text-body text-base text-gray-900">
              Just <a href="#contact" class="text-[#f56b2a] underline hover:text-[#e25c15]">contact us</a> for free, no-pressure
              guidance—we'll recommend the best fit for your goals and budget.
            </p>
          </div>
          <!-- FAQ 3 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">How fast will I get results?</h3>
            <p class="text-body text-base text-gray-900">
              Most one-time services are delivered in <span class="font-bold text-[#f56b2a]">7-14 days</span>. We'll
              keep you updated every step of the way.
            </p>
          </div>
          <!-- FAQ 4 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">
              Can I combine an additional service with a monthly package?
            </h3>
            <p class="text-body text-base text-gray-900">
              Absolutely! Most of our monthly packages include these services for even more savings. Ask us for details!
            </p>
          </div>
          <!-- FAQ 5 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">
              Is there support after the service is complete?
            </h3>
            <p class="text-body text-base text-gray-900">
              Yes. We provide clear reports, actionable recommendations, and 14 days of email support after delivery.
              For ongoing help, check out our monthly options.
            </p>
          </div>
          <!-- FAQ 6 -->
          <div class="bg-white rounded-2xl shadow-lg border-l-4 border-[#f56b2a] p-6">
            <h3 class="font-heading text-lg font-bold mb-2 text-[#f56b2a]">Can I talk to someone before ordering?</h3>
            <p class="text-body text-base text-gray-900">
              Definitely! <a href="#contact" class="text-[#f56b2a] underline hover:text-[#e25c15]">Just reach out</a> for
              honest, pressure-free advice from a real strategist.
            </p>
          </div>
        </div>
      </div>
    </section>
  </Layout>


</html>

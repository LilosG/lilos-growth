<!-- Calendly widget assets (power the popup) -->
<link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
<script src="https://assets.calendly.com/assets/external/widget.js" defer is:inline></script>

<!-- Bind any link with data-calendly="URL" to open the Calendly popup -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const utms = {
      utm_source: params.get("utm_source") || "",
      utm_medium: params.get("utm_medium") || "",
      utm_campaign: params.get("utm_campaign") || "",
      utm_content: params.get("utm_content") || "",
    };

    const form = document.getElementById("offerLeadForm");
    if (form) {
      Object.entries(utms).forEach(([key, value]) => {
        const input = form.querySelector(`input[name="${key}"]`);
        if (input && value) input.value = value;
      });
    }

    const calendlyParams = new URLSearchParams();
    Object.entries(utms).forEach(([key, value]) => {
      if (value) calendlyParams.set(key, value);
    });
    const calendlyBase = "https://calendly.com/lilosgrowth/15min";
    const calendlyUrl = calendlyParams.toString()
      ? `${calendlyBase}?${calendlyParams.toString()}`
      : calendlyBase;

    document.querySelectorAll("[data-calendly]").forEach((el) => {
      el.setAttribute("data-calendly", calendlyUrl);
      el.addEventListener("click", (e) => {
        e.preventDefault();
        const url = el.getAttribute("data-calendly");
        if (window.Calendly && url) Calendly.initPopupWidget({ url });
      });
    });
  });
</script>


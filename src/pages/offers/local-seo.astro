---
import Layout from "~/layouts/PageLayout.astro";

/* ====== LINKS (ready-to-run) ====== */
const baseCalendly = "https://calendly.com/lilosgrowth/15min";
const CALENDLY = baseCalendly;

const FORM_ACTION = "https://formspree.io/f/movlbqdk";

export const title = "Rank Higher on Google Maps in 7 Days | $149 GBP Fixes & 30-Day Sprint";
export const description =
  "Two fast paths to more calls from Google Maps. $149 Top-5 GBP Fixes or a $499 30-Day Local SEO Sprint. Built for home-service businesses.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#253242] pb-20 pt-16">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]"></div>

    <div class="relative mx-auto max-w-6xl px-4">
      <div class="grid gap-8 md:grid-cols-2 md:items-center">
        <!-- Left -->
        <div class="text-center md:text-left">
          <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">
            Rank Higher on Google Maps in 7 Days
          </h1>
          <p class="mt-4 max-w-xl text-lg text-white/80 md:max-w-none md:pr-6 md:text-xl">
            We fix the 5 issues holding your GBP back—then track lifts in calls, views, and
            rankings. Month-to-month. Simple guarantee.
          </p>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3 md:justify-start">
            <!-- This button submits the hero form -->
            <button
              form="offerLeadForm"
              type="submit"
              name="path"
              value="149-fixes"
              class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-7 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#f34e00]"
              data-analytics="begin_checkout"
              data-offer="gbp_top5_149"
            >
              Start the $149 Fix
              <svg
                class="ml-2 h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                viewBox="0 0 24 24"
              >
                <path d="M5 12h14M13 18l6-6-6-6"></path>
              </svg>
            </button>

            <!-- Calendly popup trigger (data-attr + binder script at bottom) -->
            <a
              href="#"
              data-calendly={CALENDLY}
              class="inline-flex items-center rounded-2xl bg-secondary px-7 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#27394b]"
              data-analytics="generate_lead"
              data-offer="sprint_499"
            >
              Book 15-min Call
              <svg
                class="ml-2 h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                viewBox="0 0 24 24"
              >
                <path d="M5 12h14M13 18l6-6-6-6"></path>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Hero form -->
        <div class="rounded-2xl border border-white/40 bg-white/95 p-6 shadow-lg backdrop-blur">
          <h2 class="font-heading text-xl font-semibold text-[#253242]">
            Get the $149 Fix or a Free 3-min Audit
          </h2>
          <p class="mt-1 text-sm text-slate-600">
            Tell us where to look—we’ll reply with next steps today.
          </p>

          <form
            id="offerLeadForm"
            action={FORM_ACTION}
            method="POST"
            class="mt-4 grid grid-cols-1 gap-3"
            data-analytics="lead_form_submit"
          >
            <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />
            <input type="hidden" name="utm_source" value="" />
            <input type="hidden" name="utm_medium" value="" />
            <input type="hidden" name="utm_campaign" value="" />
            <input type="hidden" name="utm_content" value="" />

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <input
                required
                name="name"
                type="text"
                placeholder="Your name"
                class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#f56b2a]"
              />
              <input
                name="business"
                type="text"
                placeholder="Business name"
                class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#f56b2a]"
              />
            </div>

            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <input
                required
                name="_replyto"
                type="email"
                placeholder="Email"
                class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#f56b2a]"
              />
              <input
                name="phone"
                type="tel"
                inputmode="tel"
                placeholder="Phone (optional)"
                class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#f56b2a]"
              />
            </div>

            <input
              name="url"
              type="url"
              placeholder="Website or Google Business Profile URL"
              class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-[#f56b2a]"
            />

            <div class="flex flex-wrap gap-3 pt-1">
              <button
                type="submit"
                name="path"
                value="149-fixes"
                class="inline-flex items-center rounded-xl bg-[#f56b2a] px-5 py-2.5 font-heading text-sm font-semibold text-white shadow transition hover:bg-[#c9400a]"
              >
                Start $149 Fix
              </button>
              <button
                type="submit"
                name="path"
                value="free-audit"
                class="inline-flex items-center rounded-xl border border-slate-300 px-5 py-2.5 font-heading text-sm font-semibold text-[#253242] transition hover:bg-slate-50"
              >
                Send 3-min Audit
              </button>
            </div>

            <p class="pt-2 text-[12px] text-slate-500">
              By submitting, you agree to be contacted about this request. No spam—ever.
            </p>
          </form>
        </div>
      </div>

      <!-- trust bar -->
      <div class="relative mt-8">
        <div class="mx-auto max-w-6xl px-4">
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-xl bg-white/10 px-4 py-3 text-center text-sm text-white/90">
              Home-service specialists
            </div>
            <div class="rounded-xl bg-white/10 px-4 py-3 text-center text-sm text-white/90">
              Month-to-month • No long contracts
            </div>
            <div class="rounded-xl bg-white/10 px-4 py-3 text-center text-sm text-white/90">
              If no lift in 30 days, we keep working free
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- OFFERS -->
  <section class="border-t border-gray-100 bg-cream py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid grid-cols-1 items-stretch gap-8 md:grid-cols-2">
        <article
          class="grid grid-rows-[auto_1fr_auto] rounded-2xl border border-gray-200 bg-white p-8 shadow-md"
        >
          <header>
            <h2 class="font-heading text-xl font-semibold text-heading md:text-2xl">
              Top-5 Google Business Profile Fixes
            </h2>
            <p class="mt-2 text-[15px] text-body">
              Quick wins implemented in 2–3 days to lift Maps visibility.
            </p>
          </header>
          <ul class="mt-5 list-disc space-y-2 pl-5 text-[15px] text-body">
            <li>Primary + secondary categories aligned</li>
            <li>Services list completed with city-modified terms</li>
            <li>Homepage title &amp; H1 mapped to core local term</li>
            <li>10 on-brand, geo-tagged photos uploaded to GBP</li>
            <li>1 GBP post published with a clear CTA</li>
            <li>Mini before/after PDF with next steps</li>
          </ul>
          <div class="mt-6 flex items-end justify-between border-t border-gray-100 pt-6">
            <div>
              <div class="text-3xl font-bold text-[#f56b2a]">$149</div>
              <div class="text-xs text-gray-500">90-minute cap • 2–3 day turnaround</div>
            </div>
            <button
              form="offerLeadForm"
              type="submit"
              name="path"
              value="149-fixes"
              class="rounded-xl bg-[#f56b2a] px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#c9400a]"
              data-analytics="begin_checkout"
              data-offer="gbp_top5_149"
            >
              Start Now
            </button>
          </div>
        </article>

        <article
          class="relative grid grid-rows-[auto_1fr_auto] rounded-2xl border-2 border-[#f56b2a] bg-white p-8 shadow-md"
        >
          <div
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[#f56b2a] px-4 py-1 text-xs font-bold text-white shadow"
          >
            Most Popular
          </div>
          <header class="mt-2">
            <h2 class="font-heading text-xl font-semibold text-heading md:text-2xl">
              30-Day Local SEO Sprint
            </h2>
            <p class="mt-2 text-[15px] text-body">
              Measurable local growth in 30 days—sets you up for ongoing wins.
            </p>
          </header>
          <ul class="mt-5 list-disc space-y-2 pl-5 text-[15px] text-body">
            <li>Everything in the Top-5 Fixes</li>
            <li>GBP description, FAQs, Products + 4 posts over 30 days</li>
            <li>Top-20 citations (submit/clean NAP)</li>
            <li>Tune 3–5 core pages (titles/H1s/internal links/schema)</li>
            <li>1 new service-area page</li>
            <li>Tracking baseline + 90-day roadmap</li>
          </ul>
          <div class="mt-6 flex items-end justify-between border-t border-gray-100 pt-6">
            <div>
              <div class="text-3xl font-bold text-[#f56b2a]">$499</div>
              <div class="text-xs text-gray-500">3–4 weeks • ~5–6 hrs effort</div>
            </div>
            <!-- Calendly popup trigger -->
            <a
              href="#"
              data-calendly={CALENDLY}
              class="rounded-xl bg-secondary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-[#27394b]"
              data-analytics="generate_lead"
              data-offer="sprint_499"
            >
              Book 15-min Call
            </a>
          </div>
        </article>
      </div>

      <!-- proof row -->
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-1 font-heading text-lg font-semibold text-heading">Outcome</h3>
          <p class="text-base text-body">
            More calls from Maps within 2–4 weeks (category &amp; on-page alignment).
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-1 font-heading text-lg font-semibold text-heading">NAP Safe</h3>
          <p class="text-base text-body">
            Optional tracking number only on GBP (primary) with the real number listed as
            additional.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow">
          <h3 class="mb-1 font-heading text-lg font-semibold text-heading">Guarantee</h3>
          <p class="text-base text-body">
            If no measurable lift in 30 days, we’ll keep working free until you do.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        How Our Process Works
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-[#f56b2a]"></span>
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-4">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#f56b2a] text-sm font-bold text-white"
              >1</span
            >
            <h3 class="font-heading text-lg font-semibold text-heading">Quick Intake</h3>
          </div>
          <p class="mt-3 text-[15px] text-body">Share your website/GBP URL + service areas.</p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#f56b2a] text-sm font-bold text-white"
              >2</span
            >
            <h3 class="font-heading text-lg font-semibold text-heading">Implement</h3>
          </div>
          <p class="text:[15px] mt-3 text-body">
            We apply the fixes that move Maps visibility now.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#f56b2a] text-sm font-bold text-white"
              >3</span
            >
            <h3 class="font-heading text-lg font-semibold text-heading">Verify</h3>
          </div>
          <p class="mt-3 text-[15px] text-body">
            Screenshots + tracking to confirm changes &amp; impact.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span
              class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-[#f56b2a] text-sm font-bold text-white"
              >4</span
            >
            <h3 class="font-heading text-lg font-semibold text-heading">Next Wins</h3>
          </div>
          <p class="mt-3 text-[15px] text-body">
            30-day roadmap or month-to-month. Cancel anytime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="border-t border-gray-100 bg-cream py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        What You Get (Both Offers)
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-[#f56b2a]"></span>
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-heading">GBP Essentials</h3>
          <ul class="mt-4 space-y-2 text-[15px] text-body">
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Correct primary + secondary categories
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Services with location modifiers
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Conversion-ready GBP post
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Fresh photo upload (geo-tag batch)
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-heading">Website Alignment</h3>
          <ul class="mt-4 space-y-2 text-[15px] text-body">
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Local keyword-aligned title &amp; H1
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Internal links to high-intent pages
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Basic schema + meta cleanup
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="font-heading text-lg font-semibold text-heading">Proof &amp; Tracking</h3>
          <ul class="mt-4 space-y-2 text-[15px] text-body">
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Before/after screenshots
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >GBP Insights baseline
            </li>
            <li class="flex items-start gap-2">
              <svg
                class="mt-1 h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
              >Simple leads sheet (calls/forms)
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- MINI CASE RESULTS -->
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        Recent Results (Snapshots)
        <span class="mx-auto mt-2 block h-1 w-14 rounded bg-[#f56b2a]"></span>
      </h2>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
          <span
            class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 text-xs font-semibold text-[#f56b2a]"
            >Water Damage • SoCal</span
          >
          <p class="mt-3 text-[15px] text-body">
            +38% calls from Maps in 30 days after category and homepage alignment.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
          <span
            class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 text-xs font-semibold text-[#f56b2a]"
            >Pest Control • FL</span
          >
          <p class="mt-3 text-[15px] text-body">
            Top-3 for “service + city” terms within 3 weeks; four GBP posts during the sprint.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
          <span
            class="inline-block rounded-full bg-[#f56b2a]/10 px-3 py-1 text-xs font-semibold text-[#f56b2a]"
            >Plumbing • Inland Empire</span
          >
          <p class="mt-3 text-[15px] text-body">
            First-page for “emergency plumber – city” after adding one service-area page.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARISON -->
  <section class="border-t border-gray-100 bg-cream py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-center font-heading text-3xl font-bold text-heading md:text-4xl">
        At-a-Glance Comparison
        <span
          class="mx-auto mt-2 block h-1 w-20 rounded bg-gradient-to-r from-[#253242] via-[#f56b2a] to-[#253242]"
        ></span>
      </h2>

      <div
        class="mt-8 overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-xl ring-1 ring-black/5"
      >
        <div class="h-1 w-full bg-gradient-to-r from-[#253242] via-[#f56b2a] to-[#253242]"></div>

        <table class="w-full text-left text-[15px] text-body">
          <thead>
            <tr class="bg-slate-50/80">
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider text-[#253242]">
                Features
              </th>
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider"
                ><span
                  class="inline-flex items-center gap-2 rounded-full bg-[#253242]/90 px-3 py-1 text-white"
                  >GBP</span
                ></th
              >
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider"
                ><span
                  class="inline-flex items-center gap-2 rounded-full bg-[#f56b2a]/90 px-3 py-1 text-white"
                  >Local SEO</span
                ></th
              >
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider">Websites</th>
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider">WaS</th>
              <th class="px-5 py-4 text-xs font-semibold uppercase tracking-wider">Bundles</th>
            </tr>
          </thead>
          <tbody class="[&_tr]:border-t [&_tr]:border-gray-100">
            <tr class="transition even:bg-slate-50/40 hover:bg-[#f56b2a]/5">
              <td class="border-l-4 border-transparent px-5 py-4 font-medium text-heading">
                Map Pack management
              </td>
              <td class="px-5 py-4"
                ><span class="inline-flex items-center gap-2 text-[#253242]"
                  ><svg
                    class="h-4 w-4 text-emerald-600"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
                  ></span
                ></td
              >
              <td class="px-5 py-4"
                ><svg
                  class="h-4 w-4 text-emerald-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
                ></td
              >
              <td class="px-5 py-4 text-slate-400">&mdash;</td>
              <td class="px-5 py-4 text-slate-400">&mdash;</td>
              <td class="px-5 py-4"
                ><svg
                  class="h-4 w-4 text-emerald-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"><path d="M20 6 9 17l-5-5"></path></svg
                ></td
              >
            </tr>
            <tr class="transition even:bg-slate-50/40 hover:bg-[#f56b2a]/5">
              <td class="border-l-4 border-transparent px-5 py-4 font-medium text-heading">
                On-page &amp; technical SEO
              </td>
              <td class="px-5 py-4 text-slate-400">&mdash;</td>
              <td class="px-5 py-4"
                ><svg

---
import Layout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import { locations } from "~/data/locations";
import { metroServices } from "~/data/metroServices";
import { LOCATIONS_INDEX, locationPath } from "~/lib/routes";

const title = "Local SEO, Web Design & GBP Markets | Lilos Growth";
const description =
  "Local SEO, web design, and Google Business Profile management for San Diego, Los Angeles, Orange County, Las Vegas, Phoenix, and Dallas businesses.";

const breadcrumbs = [
  { name: "Home", item: "https://lilosgrowth.com/" },
  { name: "Markets We Serve", item: `https://lilosgrowth.com${LOCATIONS_INDEX}` },
];

const markets = locations.map((location) => ({
  location,
  webDesign: metroServices.find(
    (p) => p.locationSlug === location.slug && p.service === "web-design"
  ),
  gbp: metroServices.find(
    (p) => p.locationSlug === location.slug && p.service === "google-business-profile-optimization"
  ),
}));

const linkClass =
  "inline-flex rounded-md py-1 font-medium text-primary underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary";
---

<Layout title={title} description={description} ignoreTitleTemplate breadcrumbs={breadcrumbs}>
  <section class="relative overflow-hidden bg-secondary pb-28 pt-20" aria-label="Hero">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[600px] w-[600px] -translate-y-1/4 translate-x-1/3 rounded-full opacity-[0.10]"
      style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto w-full max-w-3xl px-6 text-center">
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-primary">Locations</p>
      <h1 class="mb-5 font-heading text-5xl font-extrabold leading-[1.08] text-white md:text-6xl">
        Markets We Serve
      </h1>
      <p class="mb-10 text-lg font-medium leading-relaxed text-white/70">
        Lilos Growth works with local businesses in six metro areas across California, Nevada,
        Arizona, and Texas. Choose your market to see how local SEO, web design, and Google Business
        Profile management apply to the way customers search there.
      </p>
    </div>
  </section>

  <section class="border-t border-gray-100 bg-white py-24" aria-label="Markets">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          markets.map(({ location, webDesign, gbp }) => (
            <div class="flex flex-col rounded-2xl border border-border-base bg-background-cream p-8">
              <p class="mb-2 text-xs font-bold uppercase tracking-widest text-primary">
                {location.state}
              </p>
              <h2 class="mb-4 font-heading text-2xl font-extrabold text-heading">
                {location.city}
              </h2>
              <ul class="space-y-1">
                <li>
                  <a href={locationPath(location.slug)} class={linkClass}>
                    Local SEO in {location.city}
                  </a>
                </li>
                {webDesign && (
                  <li>
                    <a href={webDesign.path} class={linkClass}>
                      Web design in {location.city}
                    </a>
                  </li>
                )}
                {gbp && (
                  <li>
                    <a href={gbp.path} class={linkClass}>
                      Google Business Profile in {location.city}
                    </a>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-secondary py-24" aria-label="CTA">
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <h2 class="mb-6 font-heading text-4xl font-extrabold leading-tight text-white md:text-5xl">
        Not sure where to start?
      </h2>
      <p class="mb-10 text-lg font-medium text-white/70">
        Get a free audit — no hard sell, just a clear picture of where you stand and what to fix
        first.
      </p>
      <Button
        href="/contact#book"
        data-evt="cta_locations_book"
        variant="primary"
        size="lg"
        icon="tabler:arrow-right"
      >
        Book My Free Audit
      </Button>
    </div>
  </section>
</Layout>

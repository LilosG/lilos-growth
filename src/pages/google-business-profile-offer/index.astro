---
import PageLayout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import GbpProofCard from "~/components/results/GbpProofCard.astro";
import { gbpIntroOffer as offer, getGbpCheckoutUrl, getGbpOfferFaqs } from "~/data/gbpIntroOffer";
import { gbpProof } from "~/data/gbpProof";

const formAction = "https://formspree.io/f/movlbqdk";
const checkoutUrl = getGbpCheckoutUrl(import.meta.env.PUBLIC_GBP_INTRO_CHECKOUT_URL);
const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: offer.currency,
  maximumFractionDigits: 0,
}).format(offer.price);
const profileLabel = offer.profileCount === 1 ? "one profile" : `${offer.profileCount} profiles`;
const ctaHref = checkoutUrl ?? "#request";
const ctaText = checkoutUrl ? `Get the offer — ${price}` : `Get started for ${price}`;
const ctaHelp = checkoutUrl
  ? "Secure, one-time checkout. For an existing, verified Google profile."
  : "Send your details. We’ll check your profile and email a secure payment link.";
const groups = [
  {
    title: "Get the details right",
    description: "Help customers understand what you do, where you work, and how to reach you.",
    items: offer.optimization,
  },
  {
    title: "Keep your profile active",
    description: `We handle the updates and review responses for ${offer.managementDays} days after optimization.`,
    items: offer.management,
  },
  {
    title: "Make review requests easier",
    description: "Give customers a simple way to leave a review, and see what we completed.",
    items: offer.handoff,
  },
];
const steps = checkoutUrl
  ? [
      {
        title: "Get the offer",
        body: `Pay ${price} once through our secure checkout. This offer is for an existing, verified profile.`,
      },
      {
        title: "Keep ownership",
        body: "After we confirm payment, we email instructions to add us as a manager. You keep your account and ownership.",
      },
      {
        title: "We get to work",
        body: `We optimize your profile, then start your ${offer.managementDays} days of management. You receive a completed-work summary.`,
      },
    ]
  : [
      {
        title: "Tell us your business",
        body: "Send your name, email, business name, and city. We’ll look up your existing profile and confirm eligibility.",
      },
      {
        title: "Pay once. Keep ownership.",
        body: `We email a secure ${price} payment link. After payment is confirmed, we send manager-access instructions. No Google password needed.`,
      },
      {
        title: "We get to work",
        body: `We optimize your profile, then start your ${offer.managementDays} days of management. You receive a completed-work summary.`,
      },
    ];
const faqs = getGbpOfferFaqs(Boolean(checkoutUrl));
---

<PageLayout
  title={`${price} Google Business Profile Optimization + ${offer.managementDays} Days | Lilos Growth`}
  description={`Get your existing Google Business Profile optimized, then managed for ${offer.managementDays} days for ${price} total. Four weekly posts, review responses, photo updates, and a review link + QR code. No automatic renewal.`}
  showFloatingCalendly={false}
  headerVariant="focused"
  footerVariant="focused"
  focusedHeaderCtaHref={ctaHref}
  focusedHeaderCtaText={checkoutUrl ? `Get the offer — ${price}` : "Get started"}
  focusedHeaderCtaTracking={checkoutUrl ? "checkout" : "header"}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Google Business Profile Offer", item: "/google-business-profile-offer" },
  ]}
>
  <section
    class="border-b border-border-base bg-background-cream px-4 py-12 sm:px-6 sm:py-16 lg:py-20"
  >
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14">
      <div class="flex flex-col">
        <p class="mb-5 text-sm font-bold uppercase tracking-widest text-heading">
          Google profile tune-up · {price} one-time
        </p>
        <h1
          class="max-w-2xl font-heading text-[2.5rem] font-extrabold leading-[1.08] tracking-tight text-heading sm:text-[3.25rem] lg:text-[3.75rem]"
        >
          {offer.headline}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-body sm:text-xl">
          Get your existing Google Business Profile optimized, then managed for {
            offer.managementDays
          } days—for <strong class="text-heading">{price} total.</strong>
        </p>
        <ul
          class="order-2 mt-6 grid gap-x-5 gap-y-3 text-base font-medium text-heading sm:grid-cols-2 lg:order-none"
        >
          {
            offer.highlights.map((item) => (
              <li class="flex gap-2">
                <>
                  <span aria-hidden="true" class="font-bold text-heading">
                    ✓
                  </span>
                  <span>{item}</span>
                </>
              </li>
            ))
          }
        </ul>
        <div class="order-1 mt-6 lg:order-none lg:mt-8">
          <Button
            href={ctaHref}
            variant="primary"
            size="lg"
            class="w-full justify-center sm:w-auto"
            data-offer-cta={checkoutUrl ? "checkout" : "hero"}>{ctaText}</Button
          >
          <p class="mt-3 text-sm font-semibold text-heading">
            One profile. One payment. No automatic renewal.
          </p>
          <p class="mt-2 max-w-md text-sm leading-relaxed text-body">{ctaHelp}</p>
        </div>
      </div>
      <div>
        <GbpProofCard result={gbpProof[0]} compact={true} eager={true} />
        <p class="mt-3 text-sm text-body">
          Actual client reporting. Tap the screenshot to see the source.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-12 sm:px-6 sm:py-16" aria-labelledby="included-title">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-widest text-muted">
          The {price} profile tune-up
        </p>
        <h2
          id="included-title"
          class="mt-3 font-heading text-3xl font-bold text-heading sm:text-4xl"
        >
          A clearer profile. A month of work off your plate.
        </h2>
        <p class="mt-4 text-lg text-body">
          You run the business. We handle the profile details, posts, and review responses.
        </p>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          groups.map((group, i) => (
            <article class="border-t-2 border-heading pt-6">
              <p class="text-sm font-semibold text-muted">0{i + 1}</p>
              <h3 class="mt-3 font-heading text-xl font-bold text-heading">{group.title}</h3>
              <p class="mt-3 text-body">{group.description}</p>
              <ul class="mt-5 space-y-3 text-body">
                {group.items.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="font-semibold text-heading">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mt-8 border-t border-border-base pt-5 text-sm text-body">
        Your {offer.managementDays} days start after the initial optimization. Photo updates use images
        you provide.
      </p>
    </div>
  </section>

  <section class="bg-background-blue px-4 py-12 sm:px-6 sm:py-16" aria-labelledby="about-title">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-muted">
          Meet your point of contact
        </p>
        <h2 id="about-title" class="mt-3 font-heading text-3xl font-bold text-heading sm:text-4xl">
          Hi, I’m Mike. I founded Lilos Growth.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-body">
          Our background is in running home service businesses, including pest control and general
          contracting. We understand that your time belongs on the job, with your crew, and with
          your customers.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-body">
          That’s why this offer is straightforward: specific work on your Google profile, a month of
          management, and a clear summary of what was done.
        </p>
        <div class="mt-6 border-l-2 border-heading pl-4">
          <p class="font-semibold text-heading">Mike Prickett · Founder, Lilos Growth</p>
          <a
            href="mailto:mike@lilosgrowth.com"
            class="mt-2 inline-block font-semibold text-heading underline underline-offset-4"
            >mike@lilosgrowth.com</a
          >
        </div>
      </div>
      <GbpProofCard result={gbpProof[1]} />
    </div>
  </section>

  <section class="bg-white px-4 py-12 sm:px-6 sm:py-16" aria-labelledby="process-title">
    <div class="mx-auto max-w-6xl">
      <h2 id="process-title" class="font-heading text-3xl font-bold text-heading sm:text-4xl">
        A simple start. We handle the work.
      </h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-heading font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 font-heading text-xl font-bold text-heading">{step.title}</h3>
              <p class="mt-3 text-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    id="request"
    class="border-y border-border-base bg-background-cream px-4 py-12 sm:px-6 sm:py-16"
    aria-labelledby="request-title"
  >
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-muted">
          Let’s get your profile handled
        </p>
        <h2
          id="request-title"
          class="mt-3 font-heading text-3xl font-bold text-heading sm:text-4xl"
        >
          Optimization + {offer.managementDays} days. {price} total.
        </h2>
        <p class="mt-5 text-lg text-body">
          A fresh start for your existing Google profile, with the updates and review responses
          handled for a month.
        </p>
        <p class="mt-4 font-semibold text-heading">One payment. No automatic renewal.</p>
        <p class="mt-4 text-body">
          {
            checkoutUrl
              ? "For an existing, verified Google Business Profile. You keep ownership; we work through manager access."
              : "Send your details below. We’ll look up your existing profile, check eligibility, and email a secure payment link. This form doesn’t take payment."
          }
        </p>
        <p class="mt-5 text-sm text-body">
          Questions? <a
            class="font-semibold text-heading underline underline-offset-4"
            href="mailto:mike@lilosgrowth.com">Ask Mike directly.</a
          >
        </p>
      </div>
      {
        checkoutUrl ? (
          <div class="rounded-2xl border border-border-base bg-white p-7 shadow-sm sm:p-8">
            <h3 class="font-heading text-2xl font-bold text-heading">
              Your Google profile. Handled.
            </h3>
            <p class="mt-4 text-body">
              Profile optimization, four weekly posts, review responses, client-supplied photo
              updates, and a review link + QR code.
            </p>
            <Button
              href={checkoutUrl}
              variant="primary"
              size="lg"
              fullWidth={true}
              class="mt-6 justify-center"
              data-offer-cta="checkout"
            >
              Get the offer — {price}
            </Button>
            <p class="mt-4 text-sm text-body">
              One-time payment through our checkout provider. After payment is confirmed, we’ll
              email manager-access instructions.
            </p>
            <p class="mt-3 text-sm text-body">
              Read our{" "}
              <a href="/terms" class="underline">
                terms
              </a>{" "}
              and{" "}
              <a href="/privacy" class="underline">
                privacy policy
              </a>
              .
            </p>
          </div>
        ) : (
          <>
            <form
              id="gbp-offer-form"
              action={formAction}
              method="POST"
              class="grid gap-5 rounded-2xl border border-border-base bg-white p-6 shadow-sm sm:grid-cols-2 sm:p-8"
            >
              <input type="hidden" name="_subject" value={`GBP ${price} offer inquiry`} />
              <input
                type="hidden"
                name="offer"
                value={`GBP optimization + ${offer.managementDays} days management, ${price} one-time`}
              />
              <div>
                <>
                  <label for="offer-name" class="mb-2 block font-semibold text-heading">
                    Your name
                  </label>
                  <input
                    id="offer-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    maxlength="100"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-email" class="mb-2 block font-semibold text-heading">
                    Email address
                  </label>
                  <input
                    id="offer-email"
                    name="_replyto"
                    type="email"
                    autocomplete="email"
                    required
                    maxlength="200"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-business" class="mb-2 block font-semibold text-heading">
                    Business name
                  </label>
                  <input
                    id="offer-business"
                    name="business_name"
                    type="text"
                    autocomplete="organization"
                    required
                    maxlength="150"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-city" class="mb-2 block font-semibold text-heading">
                    Business city
                  </label>
                  <input
                    id="offer-city"
                    name="business_city"
                    type="text"
                    autocomplete="address-level2"
                    required
                    maxlength="100"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <details class="sm:col-span-2">
                <summary class="cursor-pointer font-semibold text-heading underline underline-offset-4">
                  Add a profile link (optional)
                </summary>
                <div class="mt-4">
                  <label for="offer-profile" class="mb-2 block font-semibold text-heading">
                    Public Google profile link
                  </label>
                  <input
                    id="offer-profile"
                    name="profile_url"
                    type="url"
                    inputmode="url"
                    placeholder="https://..."
                    maxlength="500"
                    aria-describedby="profile-help"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                  <p id="profile-help" class="mt-2 text-sm text-body">
                    No link handy? We can look up your business by name and city.
                  </p>
                </div>
              </details>
              <p
                id="offer-form-status"
                role="alert"
                tabindex="-1"
                class="hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900 sm:col-span-2"
              />
              <div class="sm:col-span-2">
                <Button type="submit" variant="primary" size="lg" fullWidth={true}>
                  Get started for {price}
                </Button>
              </div>
              <p class="text-sm text-body sm:col-span-2">
                By submitting, you agree to our{" "}
                <a href="/privacy" class="text-primary underline">
                  privacy policy
                </a>
                . No payment is collected here.
              </p>
            </form>
            <div
              id="offer-form-success"
              role="status"
              tabindex="-1"
              class="hidden rounded-2xl border border-green-300 bg-green-50 p-7 text-heading"
            >
              <h3 class="font-heading text-2xl font-bold">Thanks. Your profile request is in.</h3>
              <p class="mt-3 text-body">
                We’ll check your existing profile and email you about the next step. If it is
                eligible, we’ll send a secure link to pay {price}. No payment was taken here.
              </p>
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="bg-white px-4 py-12 sm:px-6 sm:py-16" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl">
      <h2 id="faq-title" class="font-heading text-3xl font-bold text-heading">
        A few things to know
      </h2>
      <div class="mt-6 divide-y divide-border-base border-y border-border-base">
        {
          faqs.map((faq) => (
            <details class="py-5">
              <summary class="cursor-pointer text-base font-semibold text-heading">
                {faq.question}
              </summary>
              <p class="mt-3 text-base leading-relaxed text-body">{faq.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-5 text-sm leading-relaxed text-body">
        This offer covers {profileLabel} that is already verified. Verification, reinstatement, website
        work, and ongoing SEO are outside this offer. Profile edits depend on Google access and policies.
      </p>
    </div>
  </section>

  <section class="bg-secondary px-4 py-12 text-white sm:px-6 sm:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-heading text-3xl font-bold !text-white sm:text-4xl">
        Your next month of profile work, handled.
      </h2>
      <p class="mt-4 text-lg text-white">
        Optimization + {offer.managementDays} days of management. {price} one-time.
      </p>
      <Button
        href={ctaHref}
        variant="primary"
        size="lg"
        class="mt-6 justify-center"
        data-offer-cta={checkoutUrl ? "checkout" : "final"}>{ctaText}</Button
      >
      <p class="mt-4 text-sm text-white">
        No automatic renewal. You keep ownership of your profile.
      </p>
    </div>
  </section>
</PageLayout>

<script>
  const consentKey = "lg_cookie_consent";
  const trackOfferEvent = (name: string) => {
    try {
      if (localStorage.getItem(consentKey) === "accepted") window.trackEvent?.(name);
    } catch {
      // Analytics must never block the form.
    }
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-offer-cta]").forEach((link) => {
    link.addEventListener("click", () =>
      trackOfferEvent(
        link.dataset.offerCta === "checkout" ? "gbp_offer_checkout_started" : "gbp_offer_cta_click"
      )
    );
  });

  const form = document.querySelector<HTMLFormElement>("#gbp-offer-form");
  const error = document.querySelector<HTMLElement>("#offer-form-status");
  const success = document.querySelector<HTMLElement>("#offer-form-success");
  let submitting = false;

  form?.addEventListener("submit", async (event) => {
    if (!form.reportValidity()) return;
    event.preventDefault();
    if (submitting) return;
    submitting = true;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    form.setAttribute("aria-busy", "true");
    if (error) error.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok || !response.headers.get("content-type")?.includes("application/json")) {
        throw new Error("Form service did not confirm submission");
      }
      const result = await response.json();
      if (
        typeof result !== "object" ||
        result === null ||
        typeof result.next !== "string" ||
        "error" in result ||
        "errors" in result
      ) {
        throw new Error("Form service did not accept submission");
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.focus();
      trackOfferEvent("gbp_offer_inquiry_submitted");
    } catch {
      if (error) {
        error.textContent =
          "We could not confirm your request. Please try again or email hello@lilosgrowth.com.";
        error.classList.remove("hidden");
        error.focus();
      }
    } finally {
      submitting = false;
      form.removeAttribute("aria-busy");
      if (submit) submit.disabled = false;
    }
  });
</script>

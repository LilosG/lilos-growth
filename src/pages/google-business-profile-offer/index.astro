---
import PageLayout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import { gbpIntroOffer as offer, getGbpCheckoutUrl, getGbpOfferFaqs } from "~/data/gbpIntroOffer";
import { gbpProof } from "~/data/gbpProof";

const formAction = "https://formspree.io/f/movlbqdk";
const checkoutUrl = getGbpCheckoutUrl(import.meta.env.PUBLIC_GBP_INTRO_CHECKOUT_URL);
const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: offer.currency,
  maximumFractionDigits: 0,
}).format(offer.price);
const profileLabel = offer.profileCount === 1 ? "one profile" : `${offer.profileCount} profiles`;
const ctaHref = checkoutUrl ?? "#request";
const ctaText = checkoutUrl ? `Get the offer — ${price}` : `Get started for ${price}`;
const ctaHelp = checkoutUrl
  ? "Secure, one-time checkout. For an existing, verified Google profile."
  : "Send your details. We’ll check your profile and email a secure payment link.";
const groups = [
  {
    title: "Get the details right",
    description: "Help customers understand what you do, where you work, and how to reach you.",
    items: offer.optimization,
  },
  {
    title: "Keep your profile active",
    description: `We handle the updates and review responses for ${offer.managementDays} days after optimization.`,
    items: offer.management,
  },
  {
    title: "Make review requests easier",
    description: "Give customers a simple way to leave a review, and see what we completed.",
    items: offer.handoff,
  },
];
const steps = checkoutUrl
  ? [
      {
        title: "Get the offer",
        body: `Pay ${price} once through our secure checkout. This offer is for an existing, verified profile.`,
      },
      {
        title: "Keep ownership",
        body: "After we confirm payment, we email instructions to add us as a manager. You keep your account and ownership.",
      },
      {
        title: "We get to work",
        body: `We optimize your profile, then start your ${offer.managementDays} days of management. You receive a completed-work summary.`,
      },
    ]
  : [
      {
        title: "Tell us your business",
        body: "Send your name, email, business name, and city. We’ll look up your existing profile and confirm eligibility.",
      },
      {
        title: "Pay once. Keep ownership.",
        body: `We email a secure ${price} payment link. After payment is confirmed, we send manager-access instructions. No Google password needed.`,
      },
      {
        title: "We get to work",
        body: `We optimize your profile, then start your ${offer.managementDays} days of management. You receive a completed-work summary.`,
      },
    ];
const faqs = getGbpOfferFaqs(Boolean(checkoutUrl));
---

<PageLayout
  title={`${price} Google Business Profile Optimization + ${offer.managementDays} Days | Lilos Growth`}
  description={`Get your existing Google Business Profile optimized, then managed for ${offer.managementDays} days for ${price} total. Four weekly posts, review responses, photo updates, and a review link + QR code. No automatic renewal.`}
  showFloatingCalendly={false}
  headerVariant="focused"
  footerVariant="focused"
  focusedHeaderCtaHref={ctaHref}
  focusedHeaderCtaText={checkoutUrl ? `Get the offer — ${price}` : "Get started"}
  focusedHeaderCtaTracking={checkoutUrl ? "checkout" : "header"}
  breadcrumbs={[
    { name: "Home", item: "/" },
    { name: "Google Business Profile Offer", item: "/google-business-profile-offer" },
  ]}
>
  <section class="relative overflow-hidden border-b border-border-base bg-background-cream px-4 py-14 sm:px-6 sm:py-20 lg:py-24" aria-labelledby="offer-title">
    <div class="pointer-events-none absolute -right-24 -top-32 h-96 w-96 rounded-full bg-primary/5 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16">
      <div>
        <p class="inline-flex rounded-full border border-border-base bg-white px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-heading sm:text-sm">
          Google Business Profile · One-time tune-up
        </p>
        <h1 id="offer-title" class="mt-7 max-w-3xl font-heading text-[2.65rem] font-extrabold leading-[1.08] tracking-tight text-heading sm:text-[3.6rem] lg:text-[4.15rem]">
          Your Google Business Profile, <span class="text-primary">professionally handled.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-body sm:text-xl">
          We optimize your existing, verified profile and manage it for <strong class="text-heading">{offer.managementDays} days.</strong>
          Clear deliverables, one payment, and no automatic renewal.
        </p>
        <ul class="mt-7 grid max-w-2xl gap-3 sm:grid-cols-2" aria-label="Included services">
          {offer.highlights.map((item) => (
            <li class="flex items-start gap-3 text-base font-medium leading-snug text-heading">
              <span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <div class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
          <Button href={ctaHref} variant="primary" size="lg" class="w-full justify-center sm:w-auto" data-offer-cta={checkoutUrl ? "checkout" : "hero"}>{ctaText}</Button>
          <a href="#included-title" class="text-base font-semibold text-heading underline decoration-primary underline-offset-4">See what’s included</a>
        </div>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-body">{ctaHelp}</p>
      </div>
      <aside class="rounded-3xl border border-border-base bg-white p-7 shadow-lg sm:p-9" aria-label="Offer summary">
        <p class="text-sm font-bold uppercase tracking-widest text-muted">One clear starting point</p>
        <div class="mt-5 flex items-end gap-3 border-b border-border-base pb-6">
          <span class="font-heading text-6xl font-extrabold leading-none tracking-tight text-heading">{price}</span>
          <span class="pb-1 text-sm font-semibold text-body">total · one time</span>
        </div>
        <div class="mt-7 space-y-6">
          <div>
            <p class="text-lg font-bold text-heading">Profile optimization</p>
            <p class="mt-1 text-base leading-relaxed text-body">Business details, categories, services, and presentation reviewed.</p>
          </div>
          <div>
            <p class="text-lg font-bold text-heading">{offer.managementDays} days of management</p>
            <p class="mt-1 text-base leading-relaxed text-body">Four weekly posts, review support, and client-supplied photo updates.</p>
          </div>
          <div>
            <p class="text-lg font-bold text-heading">A clear handoff</p>
            <p class="mt-1 text-base leading-relaxed text-body">Review-request tools and a summary of completed work.</p>
          </div>
        </div>
        <div class="mt-7 rounded-xl bg-background-cream px-5 py-4 text-sm leading-relaxed text-heading">
          <strong>One verified profile.</strong> You retain ownership. No subscription or automatic renewal.
        </div>
      </aside>
    </div>
  </section>

  <section class="bg-white px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="fit-title">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-muted">Before you begin</p>
        <h2 id="fit-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-heading sm:text-4xl">Is this the right fit for your business?</h2>
        <p class="mt-4 text-lg leading-relaxed text-body">Designed for a business with one existing, verified Google Business Profile that needs a professional tune-up and a month of hands-on support.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="rounded-2xl border border-border-base bg-background-cream p-6">
          <h3 class="font-heading text-xl font-bold text-heading">A good fit</h3>
          <ul class="mt-5 space-y-4 text-base leading-relaxed text-body">
            <li>✓ Your business already has a verified profile</li>
            <li>✓ You want profile details and services reviewed</li>
            <li>✓ You need help with posts, photos, and reviews</li>
            <li>✓ You prefer a defined, one-time engagement</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-border-base p-6">
          <h3 class="font-heading text-xl font-bold text-heading">Need something different?</h3>
          <p class="mt-4 text-base leading-relaxed text-body">New profile verification, reinstatements, multiple locations, website projects, and ongoing local SEO are outside this package.</p>
          <a href="/contact#book" class="mt-5 inline-block font-semibold text-heading underline decoration-primary underline-offset-4">Discuss a custom project</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background-cream px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="included-title">
    <div class="mx-auto max-w-6xl">
      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-widest text-muted">
          The {price} profile tune-up
        </p>
        <h2
          id="included-title"
          class="mt-3 font-heading text-3xl font-bold text-heading sm:text-4xl"
        >
          A clearer profile. A month of work off your plate.
        </h2>
        <p class="mt-4 text-lg text-body">
          You run the business. We handle the profile details, posts, and review responses.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          groups.map((group, i) => (
            <article class="rounded-2xl border border-border-base bg-white p-6 shadow-sm sm:p-7">
              <p class="text-sm font-semibold text-muted">0{i + 1}</p>
              <h3 class="mt-3 font-heading text-xl font-bold text-heading">{group.title}</h3>
              <p class="mt-3 text-body">{group.description}</p>
              <ul class="mt-5 space-y-3 text-body">
                {group.items.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="font-semibold text-heading">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="mt-8 border-t border-border-base pt-5 text-sm text-body">
        Your {offer.managementDays} days start after the initial optimization. Photo updates use images
        you provide.
      </p>
    </div>
  </section>

  <section class="border-y border-border-base bg-background-blue px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="proof-title">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-muted">Relevant client experience</p>
        <h2 id="proof-title" class="mt-3 font-heading text-3xl font-bold leading-tight text-heading sm:text-4xl">Real profile work. Clear context.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">We help local businesses maintain a more complete, useful presence across Google and their websites. Here is an example from a broader client engagement—not a promise of results from this introductory package.</p>
        <div class="mt-7 rounded-2xl border border-border-base bg-white p-6 sm:p-7">
          <p class="font-heading text-xl font-bold text-heading">{gbpProof[0].client}</p>
          <p class="mt-2 text-base leading-relaxed text-body">{gbpProof[0].work}</p>
          <div class="mt-5 border-t border-border-base pt-5">
            <p class="font-heading text-5xl font-extrabold text-heading">{gbpProof[0].value}</p>
            <p class="mt-2 font-semibold text-heading">{gbpProof[0].metric}</p>
            <p class="mt-1 text-sm text-body">{gbpProof[0].period}</p>
            {gbpProof[0].comparison && <p class="mt-1 text-sm font-semibold text-heading">{gbpProof[0].comparison}</p>}
          </div>
          <p class="mt-5 text-sm leading-relaxed text-body">Recorded during a broader engagement involving additional website and SEO services. Results vary by business.</p>
          <a href={gbpProof[0].image} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-semibold text-heading underline decoration-primary underline-offset-4">View original profile report</a>
        </div>
      </div>
      <div class="rounded-3xl border border-border-base bg-white p-7 sm:p-9">
        <p class="text-sm font-bold uppercase tracking-widest text-muted">A direct point of contact</p>
        <h2 class="mt-4 font-heading text-3xl font-bold leading-tight text-heading">Hi, I’m Mike. I founded Lilos Growth.</h2>
        <p class="mt-5 text-lg leading-relaxed text-body">Our background includes running home service businesses. We understand the demands on an owner’s time and the importance of clear, practical work.</p>
        <p class="mt-4 text-lg leading-relaxed text-body">That is why this offer has a defined scope: profile optimization, 30 days of management, and a summary of what was completed.</p>
        <div class="mt-7 border-t border-border-base pt-5">
          <p class="font-semibold text-heading">Mike Prickett · Founder, Lilos Growth</p>
          <a href="mailto:mike@lilosgrowth.com" class="mt-2 inline-block font-semibold text-heading underline decoration-primary underline-offset-4">mike@lilosgrowth.com</a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="process-title">
    <div class="mx-auto max-w-6xl">
      <h2 id="process-title" class="font-heading text-3xl font-bold text-heading sm:text-4xl">
        A simple start. We handle the work.
      </h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <li>
              <span
                class="flex h-9 w-9 items-center justify-center rounded-full bg-heading font-bold text-white"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 font-heading text-xl font-bold text-heading">{step.title}</h3>
              <p class="mt-3 text-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    id="request"
    class="scroll-mt-20 border-y border-border-base bg-background-cream px-4 py-14 sm:px-6 sm:py-20"
    aria-labelledby="request-title"
  >
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start lg:gap-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-muted">
          Let’s get your profile handled
        </p>
        <h2
          id="request-title"
          class="mt-3 font-heading text-3xl font-bold text-heading sm:text-4xl"
        >
          Start your profile tune-up.
        </h2>
        <p class="mt-5 text-lg text-body">
          A fresh start for your existing Google profile, with the updates and review responses
          handled for a month.
        </p>
        <p class="mt-4 font-semibold text-heading">One payment. No automatic renewal.</p>
        <p class="mt-4 text-body">
          {
            checkoutUrl
              ? "For an existing, verified Google Business Profile. You keep ownership; we work through manager access."
              : "Send your details below. We’ll look up your existing profile, check eligibility, and email a secure payment link. This form doesn’t take payment."
          }
        </p>
        <p class="mt-5 text-sm text-body">
          Questions? <a
            class="font-semibold text-heading underline underline-offset-4"
            href="mailto:mike@lilosgrowth.com">Ask Mike directly.</a
          >
        </p>
      </div>
      {
        checkoutUrl ? (
          <div class="rounded-2xl border border-border-base bg-white p-7 shadow-sm sm:p-8">
            <h3 class="font-heading text-2xl font-bold text-heading">
              Your Google profile. Handled.
            </h3>
            <p class="mt-4 text-body">
              Profile optimization, four weekly posts, review responses, client-supplied photo
              updates, and a review link + QR code.
            </p>
            <Button
              href={checkoutUrl}
              variant="primary"
              size="lg"
              fullWidth={true}
              class="mt-6 justify-center"
              data-offer-cta="checkout"
            >
              Get the offer — {price}
            </Button>
            <p class="mt-4 text-sm text-body">
              One-time payment through our checkout provider. After payment is confirmed, we’ll
              email manager-access instructions.
            </p>
            <p class="mt-3 text-sm text-body">
              Read our{" "}
              <a href="/terms" class="underline">
                terms
              </a>{" "}
              and{" "}
              <a href="/privacy" class="underline">
                privacy policy
              </a>
              .
            </p>
          </div>
        ) : (
          <>
            <form
              id="gbp-offer-form"
              action={formAction}
              method="POST"
              class="grid gap-5 rounded-3xl border border-border-base bg-white p-6 shadow-lg sm:grid-cols-2 sm:p-9"
            >
              <input type="hidden" name="_subject" value={`GBP ${price} offer inquiry`} />
              <input
                type="hidden"
                name="offer"
                value={`GBP optimization + ${offer.managementDays} days management, ${price} one-time`}
              />
              <div>
                <>
                  <label for="offer-name" class="mb-2 block font-semibold text-heading">
                    Your name
                  </label>
                  <input
                    id="offer-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    required
                    maxlength="100"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-email" class="mb-2 block font-semibold text-heading">
                    Email address
                  </label>
                  <input
                    id="offer-email"
                    name="_replyto"
                    type="email"
                    autocomplete="email"
                    required
                    maxlength="200"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-business" class="mb-2 block font-semibold text-heading">
                    Business name
                  </label>
                  <input
                    id="offer-business"
                    name="business_name"
                    type="text"
                    autocomplete="organization"
                    required
                    maxlength="150"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <div>
                <>
                  <label for="offer-city" class="mb-2 block font-semibold text-heading">
                    Business city
                  </label>
                  <input
                    id="offer-city"
                    name="business_city"
                    type="text"
                    autocomplete="address-level2"
                    required
                    maxlength="100"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                </>
              </div>
              <details class="sm:col-span-2">
                <summary class="cursor-pointer font-semibold text-heading underline underline-offset-4">
                  Add a profile link (optional)
                </summary>
                <div class="mt-4">
                  <label for="offer-profile" class="mb-2 block font-semibold text-heading">
                    Public Google profile link
                  </label>
                  <input
                    id="offer-profile"
                    name="profile_url"
                    type="url"
                    inputmode="url"
                    placeholder="https://..."
                    maxlength="500"
                    aria-describedby="profile-help"
                    class="w-full rounded-lg border border-gray-400 bg-white px-4 py-3 text-heading focus:outline-primary"
                  />
                  <p id="profile-help" class="mt-2 text-sm text-body">
                    No link handy? We can look up your business by name and city.
                  </p>
                </div>
              </details>
              <p
                id="offer-form-status"
                role="alert"
                tabindex="-1"
                class="hidden rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-900 sm:col-span-2"
              />
              <div class="sm:col-span-2">
                <Button type="submit" variant="primary" size="lg" fullWidth={true}>
                  Get started for {price}
                </Button>
              </div>
              <p class="text-sm text-body sm:col-span-2">
                By submitting, you agree to our{" "}
                <a href="/privacy" class="text-primary underline">
                  privacy policy
                </a>
                . No payment is collected here.
              </p>
            </form>
            <div
              id="offer-form-success"
              role="status"
              tabindex="-1"
              class="hidden rounded-2xl border border-green-300 bg-green-50 p-7 text-heading"
            >
              <h3 class="font-heading text-2xl font-bold">Thanks. Your profile request is in.</h3>
              <p class="mt-3 text-body">
                We’ll check your existing profile and email you about the next step. If it is
                eligible, we’ll send a secure link to pay {price}. No payment was taken here.
              </p>
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="bg-white px-4 py-14 sm:px-6 sm:py-20" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl">
      <h2 id="faq-title" class="font-heading text-3xl font-bold text-heading">
        Questions before you start?
      </h2>
      <div class="mt-6 divide-y divide-border-base border-y border-border-base">
        {
          faqs.map((faq) => (
            <details class="py-5">
              <summary class="cursor-pointer text-base font-semibold text-heading">
                {faq.question}
              </summary>
              <p class="mt-3 text-base leading-relaxed text-body">{faq.answer}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-5 text-sm leading-relaxed text-body">
        This offer covers {profileLabel} that is already verified. Verification, reinstatement, website
        work, and ongoing SEO are outside this offer. Profile edits depend on Google access and policies.
      </p>
    </div>
  </section>

  <section class="bg-secondary px-4 py-14 text-white sm:px-6 sm:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-heading text-3xl font-bold !text-white sm:text-4xl">
        Your next month of profile work, handled.
      </h2>
      <p class="mt-4 text-lg text-white">
        Optimization + {offer.managementDays} days of management. {price} one-time.
      </p>
      <Button
        href={ctaHref}
        variant="primary"
        size="lg"
        class="mt-6 justify-center"
        data-offer-cta={checkoutUrl ? "checkout" : "final"}>{ctaText}</Button
      >
      <p class="mt-4 text-sm text-white">
        No automatic renewal. You keep ownership of your profile.
      </p>
    </div>
  </section>
</PageLayout>

<script>
  const consentKey = "lg_cookie_consent";
  const trackOfferEvent = (name: string) => {
    try {
      if (localStorage.getItem(consentKey) === "accepted") window.trackEvent?.(name);
    } catch {
      // Analytics must never block the form.
    }
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-offer-cta]").forEach((link) => {
    link.addEventListener("click", () =>
      trackOfferEvent(
        link.dataset.offerCta === "checkout" ? "gbp_offer_checkout_started" : "gbp_offer_cta_click"
      )
    );
  });

  const form = document.querySelector<HTMLFormElement>("#gbp-offer-form");
  const error = document.querySelector<HTMLElement>("#offer-form-status");
  const success = document.querySelector<HTMLElement>("#offer-form-success");
  let submitting = false;

  form?.addEventListener("submit", async (event) => {
    if (!form.reportValidity()) return;
    event.preventDefault();
    if (submitting) return;
    submitting = true;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submit) submit.disabled = true;
    form.setAttribute("aria-busy", "true");
    if (error) error.classList.add("hidden");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      if (!response.ok || !response.headers.get("content-type")?.includes("application/json")) {
        throw new Error("Form service did not confirm submission");
      }
      const result = await response.json();
      if (
        typeof result !== "object" ||
        result === null ||
        typeof result.next !== "string" ||
        "error" in result ||
        "errors" in result
      ) {
        throw new Error("Form service did not accept submission");
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.focus();
      trackOfferEvent("gbp_offer_inquiry_submitted");
    } catch {
      if (error) {
        error.textContent =
          "We could not confirm your request. Please try again or email hello@lilosgrowth.com.";
        error.classList.remove("hidden");
        error.focus();
      }
    } finally {
      submitting = false;
      form.removeAttribute("aria-busy");
      if (submit) submit.disabled = false;
    }
  });
</script>

---
import Layout from '~/layouts/PageLayout.astro';
---
<html lang="en">
<head>
  <title>Contact Lilos Growth | Home Service Marketing Experts</title>
  <meta name="description" content="Contact Lilos Growth for proven digital marketing and local SEO for home service businesses. Fill out the form or email us to get started." />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
</head>

<Layout>
  <section class="bg-[#253242] min-h-[100vh] flex items-center justify-center py-20 px-4">
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 px-8 py-12 md:p-16 flex flex-col items-center w-full max-w-xl mx-auto">
      <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-24" />
      <h1 class="text-3xl md:text-4xl font-heading font-extrabold text-heading text-center mb-3">
        Let’s Grow Your Business.<br />Get in Touch!
      </h1>
      <p class="text-base text-body mb-7 text-center max-w-lg">
        Fill out the form below and a home service marketing expert will reach out within 24 hours.<br />
        Prefer email? <a href="mailto:hello@lilosgrowth.com" class="text-primary underline">hello@lilosgrowth.com</a>
      </p>
      <form class="flex flex-col gap-5 w-full" name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact" />
        <input type="text" name="name" placeholder="Your Name" required
          class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition" />
        <input type="email" name="email" placeholder="Email Address" required
          class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition" />
        <input type="text" name="phone" placeholder="Phone Number (optional)"
          class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition" />
        <textarea name="message" rows="4" placeholder="How can we help you?"
          class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition"></textarea>
        <button type="submit"
          class="mt-2 px-8 py-4 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#f34e00] transition flex items-center justify-center">
          <svg class="mr-2 w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"/>
          </svg>
          Send Message
        </button>
      </form>
      <div class="mt-8 text-center text-body text-sm">
        <div>Email: <a href="mailto:hello@lilosgrowth.com" class="text-primary underline">hello@lilosgrowth.com</a></div>
        <div>Serving home service businesses nationwide</div>
        <div class="mt-2 text-gray-400 text-xs">We’ll reply within 24 hours. Your info is always confidential.</div>
      </div>
    </div>
  </section>
</Layout>
</html>

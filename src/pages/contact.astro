---
import Layout from '~/layouts/PageLayout.astro';
---

<html lang="en">
  <head>
    <title>Contact Lilos Growth | Home Service Marketing Experts</title>
    <meta
      name="description"
      content="Contact Lilos Growth for proven digital marketing and local SEO for home service businesses. Fill out the form or schedule a call to get started."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Calendly performance + styles -->
    <link rel="preconnect" href="https://assets.calendly.com" />
    <link rel="dns-prefetch" href="https://assets.calendly.com" />
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
  </head>

  <Layout>
    <!-- CONTACT FORM SECTION -->
    <section class="bg-[#253242] py-20 px-4">
      <div
        class="bg-white rounded-3xl shadow-2xl border border-gray-100 px-8 py-12 md:p-16 flex flex-col items-center w-full max-w-xl mx-auto"
      >
        <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-24" />
        <h1 class="text-3xl md:text-4xl font-heading font-extrabold text-heading text-center mb-3">
          Let's Grow Your Business.<br />Get in Touch!
        </h1>
        <p class="text-base text-body mb-7 text-center max-w-lg">
          Fill out the form below and a home service marketing expert will reach out within 24 hours.<br />
          Prefer email? <a href="mailto:hello@lilosgrowth.com" class="text-primary underline">hello@lilosgrowth.com</a>
        </p>

        <form
          class="flex flex-col gap-5 w-full"
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          autocomplete="on"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="bot-field" />

          <input
            type="text"
            name="name"
            placeholder="Your Name"
            required
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition"
            autocomplete="name"
          />

          <input
            type="email"
            name="email"
            placeholder="Email Address"
            required
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition"
            autocomplete="email"
          />

          <input
            type="text"
            name="phone"
            placeholder="Phone Number (optional)"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition"
            autocomplete="tel"
          />

          <textarea
            name="message"
            rows="4"
            required
            placeholder="How can we help you?"
            class="border border-gray-300 rounded-lg px-5 py-4 text-base focus:outline-primary transition"
          ></textarea>

          <button
            type="submit"
            class="mt-2 px-8 py-4 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold text-lg shadow hover:bg-[#f34e00] transition flex items-center justify-center"
          >
            <svg class="mr-2 w-6 h-6" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path d="M5 13l4 4L19 7"></path>
            </svg>
            Send Message
          </button>
        </form>

        <div class="mt-8 text-center text-body text-sm">
          <div>
            <span class="font-medium text-heading">Email:</span>
            <a href="mailto:hello@lilosgrowth.com" class="text-primary underline ml-1">hello@lilosgrowth.com</a>
          </div>
          <div>Serving home service businesses nationwide</div>
          <div class="mt-2 text-gray-400 text-xs">We’ll reply within 24 hours. Your info is always confidential.</div>
        </div>
      </div>
    </section>

    <!-- CALENDLY SCHEDULER SECTION -->
    <section class="bg-gray-50 py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-heading mb-4">
          Book Your Free Local SEO Intro Call
        </h2>
        <p class="text-body mb-10 max-w-2xl mx-auto">
          Choose a date and time that works for you, and we’ll review your current online presence, discuss your goals,
          and share how we can help grow your business.
        </p>

        <div class="max-w-3xl mx-auto px-4">
          <!-- Calendly inline widget begin -->
          <!-- anchor for floating CTA -->
          <div
            id="book"
            class="calendly-inline-widget"
            data-url="https://calendly.com/mprickett-bluedoorsp/30min?text_color=1f2d3d&amp;primary_color=f56b2a"
            style="min-width:320px;height:700px;"
          ></div>
          <!-- Calendly inline widget end -->
        </div>
      </div>
    </section>

    <!-- Calendly lazy-load + smooth scroll + ClientRouter support -->
    <script is:inline>
      // Load Calendly JS once
      const ensureCalendly = () =>
        new Promise((resolve) => {
          if (window.Calendly) return resolve();
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.async = true;
          s.onload = resolve;
          document.body.appendChild(s);
        });

      const initCalendlyOnView = () => {
        const el = document.querySelector('.calendly-inline-widget');
        if (!el) return;

        // Smooth-scroll if arriving via /contact#book
        if (location.hash === '#book') {
          queueMicrotask(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        }

        // Lazy-load Calendly when close to viewport
        const io = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              ensureCalendly(); // Calendly auto-initializes inline widgets
              io.disconnect();
            }
          },
          { rootMargin: '300px' }
        );

        io.observe(el);
      };

      // Run on hard refresh
      if (document.readyState !== 'loading') initCalendlyOnView();
      else document.addEventListener('DOMContentLoaded', initCalendlyOnView);

      // Run after Astro ClientRouter swaps the page
      document.addEventListener('astro:after-swap', initCalendlyOnView);
    </script>
  </Layout>
</html>

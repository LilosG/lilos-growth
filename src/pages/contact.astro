---
import Layout from "~/layouts/PageLayout.astro";

export const title = "Contact Lilos Growth | Free Local SEO Audit & Consultation";
export const description =
  "Have a home service business? Contact Lilos Growth to schedule a free SEO audit or strategy call. We’ll respond within 24 hours and help you start generating more calls.";
---

<Layout {title} {description}>
  <div slot="head">
    <link rel="preconnect" href="https://assets.calendly.com" />
    <link rel="dns-prefetch" href="https://assets.calendly.com" />
    <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />
    <style is:inline>
      #book .calendly-inline-widget {
        min-width: 320px;
        height: 820px;
      }
      @media (min-width: 1024px) {
        #book .calendly-inline-widget {
          height: 820px;
        }
      }
    </style>
  </div>

  <!-- CONTACT FORM -->
  <section class="bg-secondary px-4 py-20">
    <div
      class="mx-auto flex w-full max-w-xl flex-col items-center rounded-3xl border border-gray-100 bg-white px-8 py-12 shadow-2xl md:p-16"
    >
      <img src="/Lilos_Growth_Logo_Corrected.svg" alt="Lilos Growth Logo" class="mb-6 w-24 logo--halo" />
      <h1 class="mb-3 text-center font-heading text-3xl font-extrabold text-heading md:text-4xl">
        Let's Grow Your Business.<br />Get in Touch!
      </h1>
      <p class="mb-7 max-w-lg text-center text-base text-body">
        Fill out the form below and a home service marketing expert will reach out within 24 hours.<br
        />
        Prefer email? <a
          data-evt="contact_email_click"
          href="mailto:hello@lilosgrowth.com"
          class="text-primary underline">hello@lilosgrowth.com</a
        >
      </p>

      <form
        action="https://formspree.io/f/movlbqdk"
        method="POST"
        class="flex w-full flex-col gap-5"
      >
        <input type="hidden" name="_redirect" value="https://lilosgrowth.com/thank-you" />

        <label class="sr-only" for="name">Your Name</label>
        <input
          id="name"
          type="text"
          name="name"
          placeholder="Your Name"
          required
          class="rounded-lg border border-gray-300 px-5 py-4 text-base transition focus:outline-primary"
          autocomplete="name"
        />

        <label class="sr-only" for="email">Email Address</label>
        <input
          id="email"
          type="email"
          name="_replyto"
          placeholder="Email Address"
          required
          class="rounded-lg border border-gray-300 px-5 py-4 text-base transition focus:outline-primary"
          autocomplete="email"
        />

        <label class="sr-only" for="message">How can we help you?</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          placeholder="How can we help you?"
          class="rounded-lg border border-gray-300 px-5 py-4 text-base transition focus:outline-primary"
        ></textarea>

        <button
          type="submit"
          class="mt-2 flex items-center justify-center rounded-xl bg-primary px-8 py-4 font-heading text-lg font-semibold text-white shadow transition hover:bg-primary-dark"
          data-track
          data-track-event="contact_submit"
        >
          <svg
            class="mr-2 h-6 w-6"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg
          >
          Send Message
        </button>
      </form>

      <div class="mt-8 text-center text-sm text-body">
        <div>
          <span class="font-medium text-heading">Email:</span>
          <a
            data-evt="contact_email_click"
            href="mailto:hello@lilosgrowth.com"
            class="ml-1 text-primary underline">hello@lilosgrowth.com</a
          >
        </div>
        <div>Serving home service businesses nationwide</div>
        <div class="mt-2 text-xs text-gray-400">
          We’ll reply within 24 hours. Your info is always confidential.
        </div>
      </div>
    </div>
  </section>

  <!-- CALENDLY SCHEDULER -->
  <section class="bg-gray-50 px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="grid items-start gap-10 lg:grid-cols-2">
        <div class="lg:pr-6">
          <h2 class="mb-3 font-heading text-3xl font-bold text-heading md:text-4xl">
            Book Your Free Local SEO Intro Call
          </h2>
          <p class="mb-6 text-body">
            Choose a date and time that works for you. In this 30-minute call, we’ll review your
            current online presence, discuss your goals, and share actionable next steps to grow
            calls and booked jobs.
          </p>
          <ul class="mb-8 space-y-2 text-body">
            <li class="flex gap-2">
              <span aria-hidden="true">•</span><span>30-min Zoom or phone — your choice</span>
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true">•</span><span>No pressure, just clear recommendations</span>
            </li>
            <li class="flex gap-2">
              <span aria-hidden="true">•</span><span>We’ll send a quick recap after the call</span>
            </li>
          </ul>
          <a
            href="#book"
            class="inline-flex items-center rounded-xl bg-primary px-5 py-3 font-heading font-semibold text-white"
            data-track
            data-track-event="jump_to_calendar"
          >
            Jump to Calendar
            <svg
              class="ml-2 h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
            >
          </a>
          <noscript>
            <p class="mt-4 text-sm">
              JavaScript is required to load the calendar. You can book directly
              <a
                class="underline"
                href="https://calendly.com/mprickett-bluedoorsp/30min?text_color=1f2d3d&primary_color=f56b2a"
                >on Calendly</a
              >.
            </p>
          </noscript>
        </div>

        <div id="book" role="region" aria-label="Schedule a call">
          <div
            class="calendly-inline-widget rounded-2xl border border-gray-100 bg-white shadow"
            data-url="https://calendly.com/mprickett-bluedoorsp/30min?text_color=1f2d3d&primary_color=f56b2a"
            style="min-width:320px;height:820px;"
          >
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Calendly: single-loader guard (no var; empty catch blocks; idempotent) -->
  <script is:inline>
    (() => {
      const init = () => {
        try {
          if (window.Calendly && typeof window.Calendly.initInlineWidgets === "function") {
            window.Calendly.initInlineWidgets();
          }
        } catch {}
      };

      const loadCalendly = () => {
        try {
          if (window.__calendlyLoaded) {
            init();
            return;
          }
          if (
            document.querySelector('script[src*="assets.calendly.com/assets/external/widget.js"]')
          ) {
            window.__calendlyLoaded = true;
            init();
            return;
          }
          const s = document.createElement("script");
          s.src = "https://assets.calendly.com/assets/external/widget.js";
          s.async = true;
          s.setAttribute("data-calendly-widget", "true");
          s.onload = () => {
            window.__calendlyLoaded = true;
            init();
          };
          document.head.appendChild(s);
        } catch {}
      };

      const onReady = () => {
        loadCalendly();
        let tries = 0;
        const timer = setInterval(() => {
          try {
            if (window.Calendly && window.Calendly.initInlineWidgets) {
              init();
              clearInterval(timer);
            }
            tries += 1;
            if (tries > 30) clearInterval(timer);
          } catch {
            clearInterval(timer);
          }
        }, 250);
      };

      if (document.readyState === "complete" || document.readyState === "interactive") {
        onReady();
      } else {
        document.addEventListener("DOMContentLoaded", onReady, { once: true });
      }
      // Re-bind after Astro client navigation if used
      document.addEventListener("astro:page-load", onReady);
    })();
  </script>
</Layout>

<script src="/scripts/contact-autoscroll.js" defer is:inline></script>

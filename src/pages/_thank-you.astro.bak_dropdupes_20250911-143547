---
export const title = 'Thank You | Lilos Growth';
export const description = 'We received your message and will reply within 1 business day.';
export const metadata = { title, description };
import Layout from '~/layouts/PageLayout.astro';
const title = 'Thanks — We got your message';
const description = 'Thanks for reaching out. We will get back within 1 business day.';
---

<Layout title={title} description={description} metadata={metadata}>
  <section class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-heading">Thanks — we got your message!</h1>
      <p class="mt-4 text-body text-lg">
        We’ll reply within 1 business day. If it’s urgent, email
        <a href="mailto:hello@lilosgrowth.com" class="text-[#f56b2a] font-semibold underline">hello@lilosgrowth.com</a>.
      </p>
      <a href="/" class="inline-flex mt-8 px-6 py-3 rounded-xl bg-[#f56b2a] text-white font-heading font-semibold"
        >Back to Home</a
      >
    </div>
  </section>
</Layout>

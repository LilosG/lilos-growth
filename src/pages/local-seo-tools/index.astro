---
/* FILE: src/pages/local-seo-tools/index.astro */
import Layout from "~/layouts/PageLayout.astro";
import ReviewLinkGenerator from "~/components/Tools/ReviewLinkGenerator.astro";
import GBPCategoryFinder from "~/components/Tools/GBPCategoryFinder.astro";
import LandingPageOutlineGenerator from "~/components/Tools/LandingPageOutlineGenerator.astro";
import FAQSchemaGenerator from "~/components/Tools/FAQSchemaGenerator.astro";
import SERPPreview from "~/components/Tools/SERPPreview.astro";
import UTMLinkBuilder from "~/components/Tools/UTMLinkBuilder.astro";
import LocalBusinessSchema from "~/components/Tools/LocalBusinessSchema.astro";
import GoogleMapsEmbed from "~/components/Tools/GoogleMapsEmbed.astro";
import LocalKeywordIdeas from "~/components/Tools/LocalKeywordIdeas.astro";

export const title = "Free Local SEO Tools for Home Service Businesses";
export const description =
  "Practical, on-brand tools to win the Map Pack, polish your Google Business Profile, and convert more local leads—no logins, no fluff.";
---

<Layout {title} {description}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-[#253242]">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]" aria-hidden="true">
    </div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-20 text-center">
      <img
        src="/Lilos_Growth_Logo_Corrected.svg"
        alt="Lilos Growth"
        class="mx-auto mb-6 w-24 opacity-70 logo--halo"
        loading="lazy"
      />
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-white md:text-5xl">
        Free Local SEO Tools
      </h1>
      <p class="mt-2 text-sm font-semibold uppercase tracking-widest text-[#f56b2a] md:text-base">
        For Home Service Businesses
      </p>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/80 md:text-xl">
        Practical, on-brand tools to help you win the Map Pack, polish your profile, and convert
        more local leads — no logins, no fluff.
      </p>
      <div class="mt-8 flex items-center justify-center gap-3.5">
        <a
          href="#featured-tools"
          class="inline-flex items-center rounded-3xl bg-[#f56b2a] px-6 py-3 font-heading font-semibold text-white"
        >
          Start Using Tools
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
        <a
          href="/contact#book"
          class="inline-flex items-center rounded-3xl bg-[#2b3b50] px-5 py-3 font-heading font-semibold text-white"
        >
          Book a Call
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- PROMISE STRIP -->
  <section class="border-t border-gray-100 bg-cream">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center md:py-20">
      <h2 class="font-heading text-2xl font-bold text-heading md:text-3xl">
        A Clean, Fast Toolbox Built for Local Wins
      </h2>
      <span class="mx-auto mt-2 block h-1 w-12 rounded bg-[#f56b2a]"></span>
      <p class="mx-auto mt-3 max-w-2xl text-body">
        Create conversion-ready pages, dial in your Google Business Profile, and ship SEO assets
        quickly — no logins, no fluff.
      </p>
    </div>
  </section>

  <!-- FEATURED TOOLS -->
  <section id="featured-tools" class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="flex items-start gap-4">
        <div
          class="hidden h-11 w-11 items-center justify-center rounded-full bg-white text-[#f56b2a] shadow-[0_1px_0_rgba(0,0,0,0.03)] ring-2 ring-[#f56b2a] sm:flex"
        >
          <span class="text-[18px] leading-none">⭐</span>
        </div>
        <div>
          <h3 class="font-heading text-2xl font-bold text-heading md:text-3xl">Featured Tools</h3>
          <p class="mt-2 max-w-2xl text-body">
            Our most popular tools to boost your local SEO and convert more customers.
          </p>
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-8 lg:gap-10">
        <!-- Review Link Generator -->
        <ReviewLinkGenerator />

        <!-- GBP Category Finder -->
        <div class="rounded-3xl bg-white p-8 shadow-lg">
          <GBPCategoryFinder />
        </div>

        <!-- Landing Page Outline Generator -->
        <LandingPageOutlineGenerator />
      </div>
    </div>
  </section>

  <!-- MORE TOOLS -->
  <section class="bg-bluelight">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <div class="flex items-start gap-4">
        <div
          class="hidden h-11 w-11 items-center justify-center rounded-full bg-white text-[#f56b2a] shadow-[0_1px_0_rgba(0,0,0,0.03)] ring-2 ring-[#f56b2a] sm:flex"
        >
          <span class="text-[18px] leading-none">🛠️</span>
        </div>
        <div>
          <h3 class="font-heading text-2xl font-bold text-heading md:text-3xl">
            More Free Utilities
          </h3>
          <p class="mt-2 max-w-2xl text-body">
            Additional tools to optimize your local presence and marketing campaigns.
          </p>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-8 lg:gap-10">
        <!-- FAQ Schema Generator -->
        <FAQSchemaGenerator />

        <!-- Google SERP Preview -->
        <SERPPreview />

        <!-- UTM Link Builder -->
        <UTMLinkBuilder />

        <!-- Local Business Schema -->
        <LocalBusinessSchema />

        <!-- Google Maps Embed -->
        <GoogleMapsEmbed />

        <!-- Local Keyword Ideas -->
        <LocalKeywordIdeas />
      </div>

      <div class="mt-12 text-center">
        <p class="mb-4 text-body">
          Want a custom tool for your business or have suggestions?
        </p>
        <a
          href="/contact#book"
          class="inline-flex items-center rounded-3xl bg-[#f56b2a] px-6 py-3 font-heading font-semibold text-white"
        >
          Book a Free Intro Call
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- WAVE -->
  <div class="-mb-1 w-full overflow-hidden leading-none">
    <svg viewBox="0 0 1440 60" class="block h-10 w-full text-white" aria-hidden="true">
      <path fill="currentColor" d="M0,32L1440,0V60H0Z"></path>
    </svg>
  </div>
</Layout>

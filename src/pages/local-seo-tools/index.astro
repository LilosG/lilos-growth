---
import Layout from '~/layouts/PageLayout.astro';

export const title = 'Free Local SEO Tools for Home Service Businesses | Lilos Growth';
export const description =
  'Practical, fast tools to win the Map Pack, polish your Google Business Profile, and ship on-brand SEO assets—built for plumbers, HVAC, roofers, and other home service pros.';
---

<Layout {title} {description}>
  <!-- HERO -->
  <section class="bg-[#253242] relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 py-20 text-center">
      <img
        loading="lazy"
        decoding="async"
        src="/Lilos_Growth_Logo_Corrected.svg"
        alt="Lilos Growth"
        class="mx-auto w-24 opacity-70 mb-6"
      />
      <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-white tracking-tight">Free Local SEO Tools</h1>
      <p class="mt-2 text-[#f56b2a] tracking-widest font-semibold uppercase text-sm md:text-base">
        For Home Service Businesses
      </p>
      <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl mx-auto">
        Practical, on-brand tools to help you win the Map Pack, polish your profile, and convert more local leads — no
        logins, no fluff.
      </p>

      <div class="mt-8 flex items-center justify-center gap-3.5">
        <a
          href="#featured-tools"
          class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-6 py-3 text-white font-heading font-semibold"
        >
          Start Using Tools
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
        <a
          href="#more-utilities"
          class="inline-flex items-center rounded-2xl bg-[#2b3b50] px-5 py-3 text-white font-heading font-semibold"
        >
          More Utilities
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PROMISE STRIP -->
  <section class="bg-cream border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 py-12 text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-heading">
        A Clean, Fast Toolbox Built for Local Wins
      </h2>
      <span class="block mx-auto mt-2 h-1 w-12 bg-[#f56b2a] rounded"></span>
      <p class="mt-3 text-body max-w-2xl mx-auto">
        Create conversion-ready pages, dial in your Google Business Profile, and ship SEO assets quickly — no logins, no
        fluff.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3 text-sm">
        <span class="px-3 py-1.5 rounded-full bg-white border border-gray-200 shadow-sm">No Signups</span>
        <span class="px-3 py-1.5 rounded-full bg-white border border-gray-200 shadow-sm">Free to Use</span>
        <span class="px-3 py-1.5 rounded-full bg-white border border-gray-200 shadow-sm">On-Brand UI</span>
        <span class="px-3 py-1.5 rounded-full bg-white border border-gray-200 shadow-sm">Copy-Paste Outputs</span>
      </div>
    </div>
  </section>

  <!-- FEATURED TOOLS -->
  <section id="featured-tools" class="bg-white">
    <div class="max-w-6xl mx-auto px-4 py-14">
      <h3 class="text-3xl md:text-4xl font-heading font-bold text-heading text-center">Featured Tools</h3>

      <div
        id="tools-grid"
        class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 tools-grid auto-rows-fr items-stretch"
      >
        <!-- Card: Review Link & QR -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8 flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-[#fff7f0] text-[#f56b2a] grid place-items-center" aria-hidden="true">
              🔗
            </div>
            <h4 class="text-xl font-heading font-bold text-heading">Google Review Link &amp; QR</h4>
          </div>
          <p class="text-body text-[15px]">
            Find your business in Google and get one-click links for customers to leave a review. Best when you include
            city and state/ZIP.
          </p>

          <form class="mt-5 grid gap-3">
            <label class="sr-only" for="review-business">Business</label>
            <input
              id="review-business"
              type="text"
              placeholder="Business name"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
            />
            <div class="grid grid-cols-3 gap-3">
              <input type="text" placeholder="City" class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]" />
              <input type="text" placeholder="State" class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]" />
              <input type="text" placeholder="ZIP" class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]" />
            </div>
            <button
              type="button"
              class="mt-2 inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
            >
              Find Place
            </button>
          </form>
        </article>

        <!-- Card: GBP Category Finder -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8 flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-[#fff7f0] text-[#f56b2a] grid place-items-center" aria-hidden="true">
              📇
            </div>
            <h4 class="text-xl font-heading font-bold text-heading">Google Business Profile Category Finder</h4>
          </div>
          <p class="text-body text-[15px]">
            Type what you do (e.g., “plumber”, “roof repair”). We’ll suggest Google Business Profile categories.
          </p>

          <form class="mt-5 grid gap-3">
            <label class="sr-only" for="category-service">Service keyword</label>
            <input
              id="category-service"
              type="text"
              placeholder="Service keyword (e.g., plumber)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
            />
            <button
              type="button"
              class="mt-2 inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
            >
              Find Categories
            </button>
          </form>
        </article>

        <!-- Card: Landing Page Outline -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8 flex flex-col">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full bg-[#fff7f0] text-[#f56b2a] grid place-items-center" aria-hidden="true">
              📝
            </div>
            <h4 class="text-xl font-heading font-bold text-heading">Landing Page Outline Generator</h4>
          </div>
          <p class="text-body text-[15px]">
            Generate a proven, conversion-friendly outline for a local service landing page.
          </p>

          <form class="mt-5 grid gap-3">
            <input
              type="text"
              placeholder="Service (e.g., Water Heater)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Service"
            />
            <input
              type="text"
              placeholder="City/Area (e.g., Denver, CO)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="City or Area"
            />
            <input
              type="text"
              placeholder="Audience (optional)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Audience"
            />
            <input
              type="text"
              placeholder="Primary CTA (optional)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Primary call to action"
            />
            <button
              type="button"
              class="mt-2 inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
            >
              Generate Outline
            </button>
          </form>
        </article>
      </div>
    </div>
  </section>

  <!-- MORE UTILITIES -->
  <section id="more-utilities" class="bg-[#e9f0f7]">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <h3 class="text-3xl md:text-4xl font-heading font-bold text-heading text-center">More Free Utilities</h3>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 tools-grid auto-rows-fr items-stretch">
        <!-- FAQ Schema -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">FAQ Schema Generator</h4>
          <p class="text-body text-[15px] mb-4">Convert a Q&amp;A pair into Google-ready JSON-LD (FAQPage).</p>
          <form class="grid gap-3">
            <input
              type="text"
              placeholder="Question"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Question"
            />
            <textarea
              rows="3"
              placeholder="Answer"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Answer"></textarea>
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Generate Schema</button
            >
          </form>
        </article>

        <!-- SERP Preview -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">Google SERP Preview</h4>
          <p class="text-body text-[15px] mb-4">Preview how your title &amp; description may render.</p>
          <form class="grid gap-3">
            <input
              type="text"
              placeholder="Title (~70 chars)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Title"
            />
            <input
              type="url"
              placeholder="URL (optional)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="URL"
            />
            <textarea
              rows="3"
              placeholder="Meta description (~155 chars)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Meta description"></textarea>
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Preview SERP</button
            >
          </form>
        </article>

        <!-- UTM Builder -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">UTM Link Builder</h4>
          <p class="text-body text-[15px] mb-4">Create trackable URLs for Google Analytics.</p>
          <form class="grid gap-3">
            <input
              type="url"
              placeholder="Destination URL"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Destination URL"
            />
            <div class="grid grid-cols-3 gap-3">
              <input
                type="text"
                placeholder="Source"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="Source"
              />
              <input
                type="text"
                placeholder="Medium"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="Medium"
              />
              <input
                type="text"
                placeholder="Campaign"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="Campaign"
              />
            </div>
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Build UTM Link</button
            >
          </form>
        </article>

        <!-- Local Business Schema -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">Local Business Schema Generator</h4>
          <p class="text-body text-[15px] mb-4">Generate JSON-LD for your business details.</p>
          <form class="grid gap-3">
            <input
              type="text"
              placeholder="Business Name"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Business Name"
            />
            <input
              type="tel"
              placeholder="Phone Number"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Phone Number"
            />
            <input
              type="text"
              placeholder="Street Address"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Street Address"
            />
            <div class="grid grid-cols-3 gap-3">
              <input
                type="text"
                placeholder="City"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="City"
              />
              <input
                type="text"
                placeholder="State"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="State"
              />
              <input
                type="text"
                placeholder="ZIP"
                class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
                aria-label="ZIP"
              />
            </div>
            <input
              type="url"
              placeholder="Website URL (optional)"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Website URL"
            />
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Generate Schema</button
            >
          </form>
        </article>

        <!-- Google Maps Embed -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">Google Maps Embed Generator</h4>
          <p class="text-body text-[15px] mb-4">Generate an embed code for your location.</p>
          <form class="grid gap-3">
            <input
              type="text"
              placeholder="Address or Place"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Address or Place"
            />
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Generate Embed</button
            >
          </form>
        </article>

        <!-- Local Keyword Ideas -->
        <article class="bg-white rounded-3xl border border-gray-200 shadow-md p-6 md:p-8">
          <h4 class="text-lg font-heading font-bold text-heading mb-2">Local Keyword Generator</h4>
          <p class="text-body text-[15px] mb-4">Quick ideas for service + location targeting.</p>
          <form class="grid gap-3">
            <input
              type="text"
              placeholder="e.g., pest control"
              class="rounded-lg border border-gray-300 px-4 py-3 text-[15px]"
              aria-label="Service"
            />
            <button
              type="button"
              class="inline-flex justify-center rounded-xl bg-[#f56b2a] px-5 py-3 text-white font-heading font-semibold"
              >Generate Ideas</button
            >
          </form>
        </article>
      </div>

      <!-- CTA back to funnel -->
      <div class="mt-12 text-center">
        <a
          href="/contact#book"
          class="inline-flex items-center rounded-2xl bg-[#f56b2a] px-6 py-3 text-white font-heading font-semibold"
        >
          Book a Free Intro Call
          <svg
            class="ml-2 h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 18l6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Wavy Divider to footer -->
  <div class="w-full overflow-hidden leading-none -mb-1">
    <svg viewBox="0 0 1440 60" class="block w-full h-10 text-white" aria-hidden="true">
      <path fill="currentColor" d="M0,32L1440,0V60H0Z"></path>
    </svg>
  </div>
</Layout>

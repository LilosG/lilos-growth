---
/**
 * Local SEO Tools Page - Refactored for Professional Polish
 */
import Layout from "~/layouts/PageLayout.astro";
import CheckListItem from "~/components/ui/CheckListItem.astro";
import GBPCategoryFinder from "~/components/tools/GBPCategoryFinder.astro";
import FAQSchemaGenerator from "~/components/tools/FAQSchemaGenerator.astro";
import SERPPreview from "~/components/tools/SERPPreview.astro";
import LandingPageOutlineGenerator from "~/components/tools/LandingPageOutlineGenerator.astro";
import UTMLinkBuilder from "~/components/tools/UTMLinkBuilder.astro";
import LocalBusinessSchema from "~/components/tools/LocalBusinessSchema.astro";
import LocalKeywordIdeas from "~/components/tools/LocalKeywordIdeas.astro";

const title = "Free Local SEO Tools | Lilos Growth";
const description =
  "Free tools to optimize your Google Business Profile, generate schema markup, and plan local SEO content. No login required.";

const stats = [
  { value: "9", label: "Free Tools" },
  { value: "0", label: "Logins Required" },
  { value: "0", label: "Emails Required" },
  { value: "∞", label: "Unlimited Use" },
];
---

<Layout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "Home", item: "https://lilosgrowth.com/" },
    { name: "Local SEO Tools", item: "https://lilosgrowth.com/local-seo-tools" },
  ]}
  schema={[
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": "https://lilosgrowth.com/local-seo-tools#page",
      name: "Free Local SEO Tools for Home Service Businesses",
      description:
        "Free tools to optimize your Google Business Profile, generate schema markup, build review links, and plan local SEO content. No login required.",
      provider: { "@id": "https://lilosgrowth.com/#org" },
      url: "https://lilosgrowth.com/local-seo-tools",
    },
  ]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-secondary pb-24 pt-20" aria-label="Tools hero">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[500px] w-[500px] -translate-y-1/4 translate-x-1/3 rounded-full opacity-[0.10]"
      style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-5xl px-6">
      <p class="mb-3 text-xs font-bold uppercase tracking-widest text-primary">Free Tools</p>
      <h1 class="mb-4 font-heading text-5xl font-extrabold leading-tight text-white md:text-6xl">
        Local SEO Toolkit
      </h1>
      <p class="mb-8 max-w-2xl text-lg font-medium text-white/70">
        Practical tools built for home service businesses. Generate review links, find GBP
        categories, create schema markup, and more.
      </p>
      <div class="mb-8 flex flex-wrap gap-3">
        <span
          class="rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-medium text-white"
          >GBP Tools</span
        >
        <span
          class="rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-medium text-white"
          >Schema Generators</span
        >
        <span
          class="rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-sm font-medium text-white"
          >Content Planning</span
        >
      </div>
      <a
        href="#tools"
        class="inline-flex items-center gap-2 rounded-2xl bg-primary px-8 py-4 font-heading text-base font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.4)] transition hover:bg-primary-dark"
      >
        Start Using Tools
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          ><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg
        >
      </a>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white py-14">
    <div class="mx-auto max-w-5xl px-6">
      <div class="grid grid-cols-2 gap-5 md:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="hover:border-primary/30 rounded-2xl border border-border-subtle bg-white p-6 text-center shadow-sm transition duration-200 hover:shadow-md">
              <p class="font-heading text-3xl font-extrabold text-heading">{stat.value}</p>
              <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-muted">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" class="bg-background-cream py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <!-- Featured Tool -->
      <div class="mb-16">
        <div class="mb-6 flex items-center gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full bg-primary px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-md"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
              ></path>
            </svg>
            Most Popular
          </span>
        </div>
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-lg">
          <div class="grid lg:grid-cols-5">
            <div class="flex flex-col justify-center bg-secondary p-8 text-white lg:col-span-2">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-white/10">
                <svg
                  class="h-6 w-6 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                  ></path>
                </svg>
              </div>
              <h2 class="font-heading text-xl font-bold text-white">Review Link Generator</h2>
              <p class="mt-3 text-white/90">
                Find any business on Google and generate a direct review link plus QR code. Perfect
                for review cards and follow-up messages.
              </p>
              <ul class="mt-6 space-y-2 text-sm text-white/80">
                <CheckListItem align="center">Works for any home service trade</CheckListItem>
                <CheckListItem align="center">Instant results — no email required</CheckListItem>
                <CheckListItem align="center">Based on real GMB click-through data</CheckListItem>
              </ul>
            </div>
            <div class="flex flex-col items-center justify-center p-8 text-center lg:col-span-3">
              <p class="mb-2 text-4xl">📊</p>
              <h3 class="mb-3 font-heading text-xl font-bold text-heading">
                What's a Map Pack ranking worth to your business?
              </h3>
              <p class="mb-6 max-w-sm text-sm text-body">
                Most home service businesses have no idea how much revenue they're leaving on the
                table by not ranking in the top 3. This calculator shows you the number.
              </p>
              <a
                href="/local-seo-roi-calculator"
                data-evt="cta_tools_roi_calc"
                class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 font-heading text-base font-semibold text-white shadow transition hover:bg-primary-dark"
              >
                Open ROI Calculator
                <svg
                  class="ml-2 h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  viewBox="0 0 24 24"
                  aria-hidden="true"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
                >
              </a>
              <p class="mt-3 text-xs text-body">Free · No login · Instant results</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Tools -->
      <div class="mb-16">
        <h2 class="mb-8 font-heading text-xl font-bold text-heading">Quick Tools</h2>
        <div class="grid gap-6 md:grid-cols-3">
          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--green">
              <div class="tool-card-icon tool-card-icon--green">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">GBP Category Finder</h3>
                <p class="text-sm text-gray-500">Search Google's official categories</p>
              </div>
            </div>
            <div class="tool-card-body">
              <GBPCategoryFinder />
            </div>
          </article>

          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--blue">
              <div class="tool-card-icon tool-card-icon--blue">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">Landing Page Outline</h3>
                <p class="text-sm text-gray-500">Get a conversion-ready structure</p>
              </div>
            </div>
            <div class="tool-card-body">
              <LandingPageOutlineGenerator />
            </div>
          </article>

          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--blue">
              <div class="tool-card-icon tool-card-icon--blue">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">Local Keyword Ideas</h3>
                <p class="text-sm text-gray-500">Generate keyword variations</p>
              </div>
            </div>
            <div class="tool-card-body">
              <LocalKeywordIdeas />
            </div>
          </article>
        </div>
      </div>

      <!-- Schema Tools -->
      <div class="mb-16">
        <h2 class="mb-8 font-heading text-xl font-bold text-heading">Schema Generators</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--purple">
              <div class="tool-card-icon tool-card-icon--purple">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">FAQ Schema Generator</h3>
                <p class="text-sm text-gray-500">Create rich FAQ snippets for search</p>
              </div>
            </div>
            <div class="tool-card-body">
              <FAQSchemaGenerator />
            </div>
          </article>

          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--purple">
              <div class="tool-card-icon tool-card-icon--purple">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">Local Business Schema</h3>
                <p class="text-sm text-gray-500">Generate JSON-LD structured data</p>
              </div>
            </div>
            <div class="tool-card-body">
              <LocalBusinessSchema />
            </div>
          </article>
        </div>
      </div>

      <!-- SEO & Marketing -->
      <div>
        <h2 class="mb-8 font-heading text-xl font-bold text-heading">SEO & Marketing</h2>
        <div class="grid gap-6 lg:grid-cols-2">
          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--blue">
              <div class="tool-card-icon tool-card-icon--blue">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">SERP Preview</h3>
                <p class="text-sm text-gray-500">See how your page appears in Google</p>
              </div>
            </div>
            <div class="tool-card-body">
              <SERPPreview />
            </div>
          </article>

          <article class="tool-card group">
            <div class="tool-card-header tool-card-header--green">
              <div class="tool-card-icon tool-card-icon--green">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                  ></path>
                </svg>
              </div>
              <div>
                <h3 class="font-heading font-bold text-heading">UTM Link Builder</h3>
                <p class="text-sm text-gray-500">Create trackable campaign URLs</p>
              </div>
            </div>
            <div class="tool-card-body">
              <UTMLinkBuilder />
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-secondary py-32" aria-label="Final CTA">
    <div
      class="pointer-events-none absolute right-0 top-0 h-[500px] w-[500px] -translate-y-1/4 translate-x-1/3 rounded-full opacity-[0.10]"
      style="background:radial-gradient(circle,#f56b2a 0%,transparent 65%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <h2 class="mb-6 font-heading text-5xl font-extrabold leading-tight text-white md:text-6xl">
        Want results without<br /><span class="text-primary">the DIY?</span>
      </h2>
      <p class="mb-10 text-xl font-medium text-white/70">
        These tools are great for getting started. But if you want expert help dominating local
        search, we're here.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/contact#book"
          data-evt="cta_tools_final"
          class="inline-flex items-center gap-2.5 rounded-2xl bg-primary px-10 py-4 font-heading text-lg font-bold text-white shadow-[0_8px_32px_rgba(245,107,42,0.45)] transition hover:bg-primary-dark"
        >
          Get a Free Audit
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"><path d="M5 12h14M13 18l6-6-6-6"></path></svg
          >
        </a>
        <a
          href="/results"
          class="inline-flex items-center gap-2 rounded-2xl border-2 border-white/30 px-10 py-4 font-heading text-lg font-bold text-white transition hover:border-white/60 hover:bg-white/10"
        >
          See Client Results
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .tool-card {
    @apply flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-lg;
  }

  .tool-card-header {
    @apply flex items-center gap-3 border-b px-5 py-4;
  }
  .tool-card-header--green {
    @apply border-green-100 bg-gradient-to-r from-green-50 to-green-50/50;
  }
  .tool-card-header--blue {
    @apply border-blue-100 bg-gradient-to-r from-blue-50 to-blue-50/50;
  }
  .tool-card-header--purple {
    @apply border-purple-100 bg-gradient-to-r from-purple-50 to-purple-50/50;
  }

  .tool-card-icon {
    @apply flex h-10 w-10 shrink-0 items-center justify-center rounded-xl;
  }
  .tool-card-icon--green {
    @apply bg-green-100 text-green-600;
  }
  .tool-card-icon--blue {
    @apply bg-blue-100 text-blue-600;
  }
  .tool-card-icon--purple {
    @apply bg-purple-100 text-purple-600;
  }

  .tool-card-body {
    @apply flex flex-1 flex-col p-5;
  }

  /* Push buttons to bottom of cards */
  .tool-card-body :global(form) {
    @apply flex flex-1 flex-col;
  }
  .tool-card-body :global(form > button[type="submit"]),
  .tool-card-body :global(form > .btn) {
    @apply mt-auto;
  }
</style>

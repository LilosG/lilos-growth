---
export const title = "Thank You | Lilos Growth";
export const description = "We received your message and will reply within 1 business day.";
export const metadata = { title, description };
import Layout from "~/layouts/PageLayout.astro";
---

<Layout title={title} description={description} metadata={metadata}>
  <meta slot="head" name="robots" content="noindex,follow" />
  <section class="bg-white py-24">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h1 class="font-heading text-3xl font-bold text-heading md:text-4xl">
        Thanks — we got your message!
      </h1>
      <p class="mt-4 text-lg text-body">
        We'll reply within 1 business day. If it's urgent, email
        <a href="mailto:hello@lilosgrowth.com" class="font-semibold text-[#f56b2a] underline"
          >hello@lilosgrowth.com</a
        >.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex rounded-xl bg-[#f56b2a] px-6 py-3 font-heading font-semibold text-white"
        >Back to Home</a
      >
    </div>
  </section>
</Layout>

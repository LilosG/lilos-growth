---
import Layout from "~/layouts/Layout.astro";

export const title = "Privacy Policy";
export const description = "The Lilos Growth Privacy Policy has moved to /privacy.";
---

<Layout title={title} description={description}>
  <section class="border-t border-gray-100 bg-white py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="font-heading text-4xl font-extrabold tracking-tight text-secondary">
        Privacy Policy
      </h1>
      <p class="text-body/80 mt-4 text-lg">
        Our Privacy Policy has moved to <a class="text-primary underline" href="/privacy"
          >/privacy</a
        >.
      </p>
      <p class="mt-6">
        <a
          class="inline-flex rounded-full bg-primary px-5 py-2.5 font-semibold text-white"
          href="/privacy">Read the Privacy Policy</a
        >
      </p>
    </div>
  </section>
</Layout>

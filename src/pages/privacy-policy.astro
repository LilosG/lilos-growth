---
import Layout from "~/layouts/Layout.astro";

export const title = "Privacy Policy";
export const description =
  "Read the Lilos Growth Privacy Policy to understand what information we collect, how we use it, and your choices.";
---

<Layout title={title} description={description}>
  <!-- HERO -->
  <section
    class="relative flex min-h-[320px] items-center overflow-hidden bg-secondary pb-14 pt-14"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-secondary to-secondary-light"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto w-full max-w-4xl px-4 text-center">
      <h1
        class="font-heading text-4xl font-extrabold leading-tight tracking-tight text-white md:text-5xl"
      >
        Privacy Policy
      </h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-white/85">
        Your privacy matters. This page explains what we collect, how we use it, and the choices you
        have.
      </p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="border-t border-gray-100 bg-white py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-body/70 mb-6 text-sm">Last updated: November 2025</p>

      <div class="prose prose-neutral max-w-none">
        <h2 id="who-we-are">Who we are</h2>
        <p>
          Lilos Growth (“we”, “us”, or “our”) provides websites and local SEO services for home
          service businesses. This Privacy Policy describes how we handle information on
          <a href="/">lilosgrowth.com</a> (the “Site”) and in connection with our services.
        </p>

        <h3 id="company-contact">Company &amp; Contact</h3>
        <p>
          Controller: <strong>Lilos Growth</strong><br />
          Address: <strong>401 West A St, Ste 200, San Diego, CA 92101</strong><br />
          Privacy contact: <a href="mailto:privacy@lilosgrowth.com">privacy@lilosgrowth.com</a>
        </p>

        <h2 id="information-we-collect">Information we collect</h2>
        <ul>
          <li>
            <strong>Information you provide</strong>: form submissions (e.g., name, email, company,
            website URL, and any message you include).
          </li>
          <li>
            <strong>Automatic data</strong>: basic usage data such as page views, referrers,
            device/browser type, and approximate location derived from IP (collected by our
            analytics tools).
          </li>
          <li id="cookies">
            <strong>Cookies</strong>: small files used to remember preferences and understand Site
            usage.
          </li>
        </ul>

        <h2 id="how-we-use">How we use information</h2>
        <ul>
          <li>To respond to inquiries and provide requested services.</li>
          <li>To operate, maintain, secure, and improve the Site and our offerings.</li>
          <li>To analyze performance and measure the effectiveness of our marketing.</li>
          <li>To comply with legal obligations and enforce our terms.</li>
        </ul>

        <h2 id="sharing">Sharing &amp; disclosures</h2>
        <p>
          We do <strong>not</strong> sell your personal information. We may share limited data with service
          providers that help us run our Site and services (e.g., hosting, CDN, analytics, advertising
          pixels, form processing/CRM, and email). These providers process data only per our instructions
          and are bound by confidentiality obligations.
        </p>

        <h3 id="service-providers">Service providers (examples)</h3>
        <p>
          Typical providers include: website hosting/CDN, analytics (e.g., Google Analytics),
          advertising pixels (e.g., Meta Pixel), form processing/CRM, and email. A current list is
          available on request.
        </p>

        <h2 id="cookies-analytics">Cookies &amp; analytics</h2>
        <p>
          We may use first- and third-party cookies to operate the Site and understand usage. You
          can control cookies via your browser settings. Disabling cookies may impact certain
          features.
        </p>

        <h3 id="cookie-preferences">Cookie Preferences</h3>
        <p id="cookie-preferences-anchor">
          You can adjust your cookie preferences at any time using
          <a href="#cookie-preferences" id="cookie-preferences-link">Cookie Preferences</a>. If you
          use a consent banner, this link will reopen it.
        </p>

        <h2 id="retention">Data retention</h2>
        <p>
          We retain information for as long as necessary to fulfill the purposes described in this
          Policy, unless a longer retention period is required or permitted by law.
        </p>

        <h2 id="your-rights">Your choices &amp; rights</h2>
        <ul>
          <li>
            You may request access, correction, or deletion of your information where applicable.
          </li>
          <li>
            You can opt out of marketing communications at any time by following the instructions in
            our messages or by contacting us.
          </li>
          <li>Most browsers let you block or delete cookies.</li>
        </ul>

        <h2 id="security">Security</h2>
        <p>
          We use reasonable administrative, technical, and physical safeguards to protect
          information. No method of transmission or storage is completely secure; we cannot
          guarantee absolute security.
        </p>

        <h2 id="children">Children’s privacy</h2>
        <p>
          Our Site and services are not directed to children under 13, and we do not knowingly
          collect personal information from children.
        </p>

        <h2 id="california">Notice to California residents (Do Not Sell/Share)</h2>
        <p>
          We do <strong>not</strong> sell personal information. Some analytics or advertising cookies
          may be considered a “share” under California law. You can opt out of such sharing by declining
          non-essential cookies in our banner or by revisiting your
          <a href="#cookie-preferences" id="cookie-preferences-link-2">Cookie Preferences</a>. We
          will honor opt-out preferences expressed via your browser or device to the extent required
          by law.
        </p>

        <h2 id="intl">Visitors from the EU/UK (informational)</h2>
        <p>
          Where GDPR applies, our lawful bases for processing are <em>legitimate interests</em> (to operate
          and secure the Site) and <em>consent</em> (for analytics/advertising cookies). You may exercise
          rights of access, deletion, correction, and objection by emailing
          <a href="mailto:privacy@lilosgrowth.com">privacy@lilosgrowth.com</a>.
        </p>

        <h2 id="requests">Submitting privacy requests</h2>
        <p>
          To request access, deletion, or correction, email
          <a href="mailto:privacy@lilosgrowth.com">privacy@lilosgrowth.com</a>. We may take
          reasonable steps to verify your identity (e.g., replying from the same email address or
          requesting limited additional info) before fulfilling a request.
        </p>

        <h2 id="changes">Changes to this Policy</h2>
        <p>
          We may update this Policy from time to time. The “Last updated” date at the top reflects
          the most recent changes. Your continued use of the Site after updates means you accept the
          revised Policy.
        </p>

        <h2 id="contact">Contact</h2>
        <p>
          Questions or requests? Please <a href="/contact">contact us</a> or email
          <a href="mailto:privacy@lilosgrowth.com">privacy@lilosgrowth.com</a> and we’ll respond promptly.
          Mailing address: 401 West A St, Ste 200, San Diego, CA 92101.
        </p>
      </div>
    </div>
  </section>
</Layout>

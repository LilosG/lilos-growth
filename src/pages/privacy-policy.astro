---
import Layout from '~/layouts/Layout.astro';

export const title = 'Privacy Policy | Lilos Growth';
export const description =
  'Read the Lilos Growth Privacy Policy to understand what information we collect, how we use it, and your choices.';
---

<Layout title={title} description={description}>
  <!-- HERO -->
  <section class="bg-[#253242] min-h-[320px] flex items-center pt-14 pb-14 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#253242] to-[#2e4159]" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto w-full px-4 text-center">
      <h1 class="font-heading text-white text-4xl md:text-5xl font-extrabold leading-tight tracking-tight">
        Privacy Policy
      </h1>
      <p class="mt-3 text-white/85 text-lg max-w-2xl mx-auto">
        Your privacy matters. This page explains what we collect, how we use it, and the choices you have.
      </p>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="py-12 md:py-16 bg-white border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-sm text-body/70 mb-6">Last updated: August 2025</p>

      <div class="prose prose-neutral max-w-none">
        <h2>Who we are</h2>
        <p>
          Lilos Growth (“we”, “us”, or “our”) provides websites and local SEO services for home service businesses. This
          Privacy Policy describes how we handle information on
          <a href="/">lilosgrowth.com</a> (the “Site”) and in connection with our services.
        </p>

        <h2>Information we collect</h2>
        <ul>
          <li>
            <strong>Information you provide</strong>: form submissions (e.g., name, email, company, website URL, and any
            message you include).
          </li>
          <li>
            <strong>Automatic data</strong>: basic usage data such as page views, referrers, and approximate location
            derived from IP (collected by our analytics tools).
          </li>
          <li>
            <strong>Cookies</strong>: small files used to remember preferences and understand Site usage.
          </li>
        </ul>

        <h2>How we use information</h2>
        <ul>
          <li>To respond to inquiries and provide requested services.</li>
          <li>To operate, maintain, and improve the Site and our offerings.</li>
          <li>To analyze performance and measure the effectiveness of our marketing.</li>
          <li>To comply with legal obligations and enforce our terms.</li>
        </ul>

        <h2>Sharing &amp; disclosures</h2>
        <p>
          We do not sell your personal information. We may share limited data with service providers that help us run
          our Site and services (e.g., hosting, analytics, form processing). These providers are bound by
          confidentiality obligations and only process data on our instructions.
        </p>

        <h2>Cookies &amp; analytics</h2>
        <p>
          We may use first- and third-party cookies to operate the Site and understand usage. You can control cookies
          via your browser settings. Disabling cookies may impact certain features.
        </p>

        <h2>Data retention</h2>
        <p>
          We retain information for as long as necessary to fulfill the purposes described in this Policy, unless a
          longer retention period is required or permitted by law.
        </p>

        <h2>Your choices</h2>
        <ul>
          <li>You may request access, correction, or deletion of your information where applicable.</li>
          <li>
            You can opt out of marketing communications at any time by following the instructions in our messages or by
            contacting us.
          </li>
          <li>Most browsers let you block or delete cookies.</li>
        </ul>

        <h2>Security</h2>
        <p>
          We use reasonable administrative, technical, and physical safeguards to protect information. No method of
          transmission or storage is completely secure; we cannot guarantee absolute security.
        </p>

        <h2>Children’s privacy</h2>
        <p>
          Our Site and services are not directed to children under 13, and we do not knowingly collect personal
          information from children.
        </p>

        <h2>Changes to this Policy</h2>
        <p>
          We may update this Policy from time to time. The “Last updated” date at the top reflects the most recent
          changes. Your continued use of the Site after updates means you accept the revised Policy.
        </p>

        <h2>Contact</h2>
        <p>
          Questions or requests? Please <a href="/contact">contact us</a> and we’ll respond promptly.
        </p>
      </div>
    </div>
  </section>
</Layout>

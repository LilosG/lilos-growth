---
import Layout from "~/layouts/PageLayout.astro";
import ServiceCardsInclude from "~/components/sections/ServiceCardsInclude.astro";

export const title = "Cards Preview | Lilos Growth";
export const description =
  "Preview of service cards reused from homepage (no changes to homepage).";

export const metadata = {
  title,
  description,
};
---

<Layout title={title} description={description} metadata={metadata}>
  <section class="py-12">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="text-3xl font-bold text-heading">Cards Preview</h1>
      <p class="mt-2 text-body">
        This page reuses the exact homepage cards via <code>ServiceCardsMarkup</code>. Homepage
        remains untouched.
      </p>
    </div>
  </section>

  <!-- The exact homepage cards appear below once you've pasted the grid into ServiceCardsMarkup -->
  <ServiceCardsInclude />
</Layout>

---
export interface Props {
  href: string; // Calendly link preferred; falls back to open in a new tab
  label?: string;
  position?: 'right' | 'left';
  showOnMobile?: boolean;
}
const { href, label = 'Book a Call', position = 'right', showOnMobile = true } = Astro.props;

const sideClass = position === 'left' ? 'left-4 md:left-6' : 'right-4 md:right-6';
const mobileClass = showOnMobile ? '' : 'hidden md:flex';
---

<button
  type="button"
  class={`fixed ${mobileClass} bottom-4 md:bottom-6 ${sideClass} z-50 shadow-lg rounded-full px-5 py-3 text-white bg-[#f56b2a] hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#f56b2a]`}
  data-evt="cta_floating_calendly"
  data-url={href}
  aria-label={label}
>
  {label}
</button>

<script is:inline>
  const btn = document.currentScript && document.currentScript.previousElementSibling;
  if (btn) {
    btn.addEventListener('click', async function () {
      const url = btn.getAttribute('data-url') || '/contact';

      function tryOpenCalendly() {
        if (window.Calendly && window.Calendly.initPopupWidget) {
          window.Calendly.initPopupWidget({ url: url });
          return true;
        }
        return false;
      }

      // Try immediately
      if (tryOpenCalendly()) return;

      // Lazy-load Calendly script once
      try {
        const existing = document.querySelector('script[data-calendly-widget]');
        if (!existing) {
          const s = document.createElement('script');
          s.src = 'https://assets.calendly.com/assets/external/widget.js';
          s.async = true;
          s.setAttribute('data-calendly-widget', 'true');
          document.head.appendChild(s);
          await new Promise(function (res) {
            s.onload = function () {
              res(null);
            };
          });
        }
      } catch {
        // ignore
      }

      if (!tryOpenCalendly()) {
        window.open(url, '_blank', 'noopener,noreferrer');
      }
    });
  }
</script>
